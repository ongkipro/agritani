---
import { topicName } from '../lib/topics';
import { getCollection, getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShortAnswer from '../components/ShortAnswer.astro';
import FieldSummaryBox, { type FieldTakeaways } from '../components/FieldSummaryBox.astro';
import References from '../components/References.astro';
import ArticleProducts from '../components/ArticleProducts.astro';
import ArticleToc from '../components/ArticleToc.astro';
import { getReadingTime } from '../lib/reading-time';
import { getArticleImage } from '../lib/topic-images';
import { articleImageAlt } from '../lib/image-alt';
import { slugifyTag } from '../lib/tags';
import { promoteHeadingsHtml } from '../lib/headings';
import type { SeoInput } from '../lib/seo';
import type { ImageMetadata } from 'astro';

interface ArticleData {
  title: string;
  metaTitle: string;
  description: string;
  slug: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  topic: string;
  commodities: Array<string | { id: string }>;
  tags: string[];
  answer?: string;
  heroImage?: {
    src: ImageMetadata;
    alt: string;
    credit: string;
  };
  fieldTakeaways?: FieldTakeaways;
  references?: Array<{
    authors: string;
    year: number;
    title: string;
    source: string;
    doi?: string;
    url?: string;
  }>;
  draft?: boolean;
}

interface Props {
  article: {
    body?: string;
    data: ArticleData;
  };
  headings?: any[];
  relatedArticles?: Array<{
    data: {
      title: string;
      slug: string;
      topic: string;
      pubDate: Date;
    };
    body?: string;
  }>;
}

const { article, headings = [], relatedArticles = [] } = Astro.props;
const { data } = article;

const readingTime = getReadingTime(article.body || '');

const topicLabel = topicName(data.topic);

const primaryCommodity = data.commodities?.[0]
  ? typeof data.commodities[0] === 'string'
    ? data.commodities[0]
    : (data.commodities[0] as any).id
  : '';

// Commodity hubs exist only with >= 3 visible articles (DESIGN §4.4.3); otherwise show plain text
const includeDrafts = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;
const commodityCount = primaryCommodity
  ? (await getCollection('articles')).filter(
      (a) => (includeDrafts || !a.data.draft) && a.data.commodities.some((c: any) => (typeof c === 'string' ? c : c.id) === primaryCommodity)
    ).length
  : 0;
const commodityHubExists = commodityCount >= 3;
const commodityLabel = primaryCommodity
  ? (await getEntry('commodities', primaryCommodity))?.data.name ?? primaryCommodity.replace(/-/g, ' ')
  : '';

// Markdown sections mostly start at ###: promote them so the outline never skips h1 -> h3 (src/lib/headings.ts).
const bodyHtml = promoteHeadingsHtml(await Astro.slots.render('default'));

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Jurnal Tani', url: '/jurnal/' },
  { name: topicLabel, url: `/jurnal/topik/${data.topic}/` },
  { name: data.title, url: `/jurnal/${data.slug}/` },
];

const seo: SeoInput = {
  title: data.title,
  metaTitle: data.metaTitle,
  description: data.description,
  canonicalPath: `/jurnal/${data.slug}/`,
  ogType: 'article',
  article: {
    pubDate: new Date(data.pubDate),
    updatedDate: data.updatedDate ? new Date(data.updatedDate) : undefined,
    author: data.author,
    topic: topicLabel,
    tags: data.tags,
  },
  noindex: data.draft ?? false,
};

const formattedPubDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date(data.pubDate));

const formattedUpdatedDate = data.updatedDate
  ? new Intl.DateTimeFormat('id-ID', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(new Date(data.updatedDate))
  : null;

// Only authored data renders; no placeholder takeaways or references (AGENTS.md content integrity).
const activeTakeaways = data.fieldTakeaways;
const activeReferences = data.references;

// Lead image: authored heroImage, else commodity/topic illustration (dummy, DESIGN §3.5.1).
const leadImage = data.heroImage?.src ?? getArticleImage(data);
const leadCaption = data.heroImage?.credit ?? 'Foto ilustrasi, bukan dokumentasi kasus di artikel ini.';

// Next-step tools by topic (DESIGN §4.3.1); hidden tools stay out of production.
const toolsUpcoming = import.meta.env.PUBLIC_INCLUDE_DRAFTS !== 'true';
const nextTools = [
  { title: 'Cuaca Tani', href: '/alat/cuaca-tani/', desc: 'Pilih jam semprot dari prakiraan BMKG per 3 jam di desa Anda.', topics: ['proteksi-tanaman', 'tanah-nutrisi', 'budidaya', 'air-irigasi'] },
  { title: 'Kalkulator Dosis', href: '/alat/kalkulator-dosis/', desc: 'Hitung takaran per tangki sesuai dosis pada label kemasan.', topics: ['proteksi-tanaman', 'tanah-nutrisi', 'budidaya'] },
  ...(toolsUpcoming ? [] : [{ title: 'Diagnosa Gejala', href: `/alat/diagnosa-gejala/${primaryCommodity ? `?k=${primaryCommodity}` : ''}`, desc: 'Cocokkan tanda di kebun dengan kandidat penyebab.', topics: ['proteksi-tanaman'] }]),
].filter((t) => t.topics.includes(data.topic));
---

<BaseLayout seo={seo}>
  <!-- Mobile reading progress (<1024px): CSS scroll-driven, no JS; desktop shows progress in the TOC. -->
  <div class="reading-progress print:hidden" aria-hidden="true"></div>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <!-- 1. Breadcrumb: Aligned with Column 4-10 matching header and article prose (DESIGN §4.3.2) -->
    <div class="lg:grid lg:grid-cols-12 lg:gap-8 mb-4">
      <div class="lg:col-span-3 hidden lg:block" aria-hidden="true"></div>
      <div class="lg:col-span-7 max-w-[68ch]">
        <Breadcrumb items={breadcrumbItems} />
      </div>
      <div class="lg:col-span-2 hidden lg:block" aria-hidden="true"></div>
    </div>

    {data.draft && (
      <div class="lg:grid lg:grid-cols-12 lg:gap-8 mb-4">
        <div class="lg:col-span-3 hidden lg:block" aria-hidden="true"></div>
        <div class="lg:col-span-7 max-w-[68ch]">
          <div
            role="status"
            class="p-3 rounded-[2px] bg-[var(--color-tint)] border border-[var(--color-border-control)] text-xs font-semibold text-[var(--color-soil)] flex items-center justify-between"
          >
            <span>DRAF — Naskah belum diterbitkan untuk publikasi resmi</span>
            <span class="text-[11px] font-normal">Pratinjau Redaksi</span>
          </div>
        </div>
        <div class="lg:col-span-2 hidden lg:block" aria-hidden="true"></div>
      </div>
    )}

    <!-- Main Article Layout: Unified 12-column grid starting at the very top (DESIGN §4.3.2) -->
    <div class="mt-2 lg:grid lg:grid-cols-12 lg:gap-8 items-start">
      <!-- 1. Sticky table of contents with reading progress (Desktop Columns 1-3, DESIGN §4.3.2 C8) -->
      <aside class="hidden lg:block lg:col-span-3 lg:self-stretch print:hidden">
        <ArticleToc headings={headings} variant="sidebar" />
      </aside>

      <!-- 2. Main Article Content Container (Columns 4-10) -->
      <div class="lg:col-span-7 prose-container max-w-[68ch] min-w-0">
        <!-- Article Header -->
        <header class="mb-8">
          <!-- 2. H1 Title -->
          <h1 class="text-3xl sm:text-4xl lg:text-[2.625rem] font-serif font-semibold text-[var(--color-text)] leading-[1.18] tracking-[-0.015em] mb-4 text-balance" data-pagefind-meta="title">
            {data.title}
          </h1>

          <!-- 3. Dek -->
          <p class="text-base sm:text-lg text-[var(--color-soil)] font-sans leading-[1.65] mb-6 text-pretty">
            {data.description}
          </p>

          <!-- 4. Metadata & Actions (Unified Editorial Meta Bar) -->
          <div class="py-1 border-y border-[var(--color-border)] my-6 flex flex-wrap items-center justify-between gap-x-4 text-sm text-[var(--color-text-muted)]">
            <!-- Separators are ::before of each item; the list overhangs left by one separator width and is
                 clipped horizontally, so a wrapped line never starts with "·" (T-58B). Links grow their hit
                 area vertically to 44px via ::after without changing line height. -->
            <div class="meta-clip grow min-w-0 py-2">
              <ul class="meta-list" aria-label="Info artikel">
                <li class="font-medium text-[var(--color-text)]">
                  Oleh <a href="/penulis/arif-prabowo/" class="meta-link font-semibold text-[var(--color-text)] hover:text-[var(--color-brand-strong)]">{data.author}</a>
                </li>
                <li>Terbit <time datetime={new Date(data.pubDate).toISOString()}>{formattedPubDate}</time></li>
                {formattedUpdatedDate && (
                  <li>Diperbarui <time datetime={new Date(data.updatedDate!).toISOString()}>{formattedUpdatedDate}</time></li>
                )}
                <li>{readingTime.text}</li>
                {primaryCommodity && (
                  <li>
                    {commodityHubExists ? (
                      <a href={`/jurnal/komoditas/${primaryCommodity}/`} class="meta-link font-semibold text-[var(--color-soil)] hover:text-[var(--color-brand-strong)]">
                        {commodityLabel}
                      </a>
                    ) : (
                      <span class="font-medium">{commodityLabel}</span>
                    )}
                  </li>
                )}
              </ul>
            </div>

            <!-- 6. Article Actions -->
            <div class="flex items-center gap-4 print:hidden font-semibold">
              <button
                type="button"
                data-action="share"
                class="text-[var(--color-brand-strong)] hover:text-[var(--color-brand-hover)] hover:underline inline-flex items-center gap-1.5 py-1 min-h-[44px] cursor-pointer"
              >
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                <span data-share-label>Bagikan</span>
              </button>
              <button
                type="button"
                id="print-btn"
                data-action="print"
                class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:underline inline-flex items-center gap-1.5 py-1 min-h-[44px] cursor-pointer"
              >
                <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                <span>Cetak</span>
              </button>
            </div>
          </div>

          <!-- 9. Gambar utama: heroImage bila ada, jika tidak ilustrasi komoditas/topik (DESIGN §4.3.1, §3.5.1) -->
          <figure class="mt-2 mb-8 print:hidden">
            <Picture
              src={leadImage}
              formats={['webp']}
              fallbackFormat="webp"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 68ch, calc(100vw - 2rem)"
              quality={62}
              alt={data.heroImage?.alt || articleImageAlt(data)}
              class="w-full aspect-[16/9] object-cover rounded-[2px]"
              loading="eager"
              fetchpriority="high"
            />
            <figcaption class="mt-2 text-xs text-[var(--color-text-muted)]">{leadCaption}</figcaption>
          </figure>
          <!-- 7. Jawaban singkat & 8. Ringkasan lapangan -->
          {data.answer && <ShortAnswer answer={data.answer} />}
          {activeTakeaways && <FieldSummaryBox takeaways={activeTakeaways} />}

          <!-- 10. Daftar isi (<1024px) -->
          <ArticleToc headings={headings} variant="inline" />
        </header>

        <!-- 11. Article Prose -->
        <article data-pagefind-body>
          <div class="prose text-[var(--color-text)] text-[1.0625rem] sm:text-[1.125rem] leading-[1.75]">
            <Fragment set:html={bodyHtml} />
          </div>

          <!-- Tags: "Tag:" label + inline #links, no chip/card/border (owner 2026-09-30); py-2.5 widens the hit area without loosening the lines -->
          {data.tags && data.tags.length > 0 && (
            <div class="mt-6 text-sm leading-7">
              <span class="font-semibold text-[var(--color-text)] mr-2">Tag:</span>
              <ul class="inline" aria-label="Tag artikel">
                {/* Inline items + a real space between them: long tags wrap inside, the list wraps between tags (no horizontal overflow at 320px, T-51). */}
                {data.tags.map((tag) => (
                  <>
                    <li class="inline mr-2">
                      <a href={`/jurnal/tag/${slugifyTag(tag)}/`} class="py-3 [overflow-wrap:anywhere] text-[var(--color-brand-strong)] hover:underline underline-offset-4 active:text-[var(--color-text)]">
                        <span class="text-[var(--color-soil)]" aria-hidden="true">#</span>{tag}
                      </a>
                    </li>{' '}
                  </>
                ))}
              </ul>
            </div>
          )}

          <!-- Second share action at the natural end of reading; same handler as the meta bar button. -->
          <p class="mt-4 print:hidden" data-pagefind-ignore>
            <button
              type="button"
              data-action="share"
              class="inline-flex items-center gap-1.5 min-h-[44px] text-sm font-semibold text-[var(--color-brand-strong)] hover:underline underline-offset-4 cursor-pointer"
            >
              <span data-share-label>Bagikan artikel ini</span>
            </button>
          </p>
        </article>
      </div>

      <!-- 2/12 spacer on desktop -->
      <div class="lg:col-span-2 hidden lg:block" aria-hidden="true"></div>
    </div>

    <!-- Closing blocks: separate grid row so the sticky TOC stops after the tags (DESIGN §3.3.2) -->
    <div class="lg:grid lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-3 hidden lg:block" aria-hidden="true"></div>
      <div class="lg:col-span-7 max-w-[68ch]">
        <!-- 12. Langkah berikutnya di lahan (alat terkait topik) -->
        {nextTools.length > 0 && (
          <section class="my-10" aria-labelledby="alat-lanjut-heading" data-pagefind-ignore>
            <h2 id="alat-lanjut-heading" class="font-serif text-xl font-semibold text-[var(--color-text)] mb-4">
              Langkah berikutnya di lahan
            </h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {nextTools.map((t) => (
                <a href={t.href} class="card card-link block p-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]">
                  <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">{t.title}</span>
                  <span class="mt-1 block text-sm leading-snug text-[var(--color-text-muted)]">{t.desc}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- 14. Daftar Pustaka -->
        <div data-pagefind-ignore>
          <References references={activeReferences} />
          {(!activeReferences || activeReferences.length === 0) && (
            <p class="my-10 text-sm text-[var(--color-text-muted)]">Rujukan ilmiah untuk artikel ini sedang dilengkapi.</p>
          )}
        </div>

        <!-- 15. Tentang Penulis -->
        <div data-pagefind-ignore>
          <AuthorBio slug={data.slug} title={data.title} />
        </div>

        <!-- 16. Produk Agritani (rujukan; setelah Tentang Penulis) -->
        <ArticleProducts topic={data.topic} commodities={(data.commodities ?? []).map((c: any) => (typeof c === "string" ? c : c.id))} />

        <!-- 17. Lanjut Membaca -->
        {relatedArticles.length > 0 && (
          <nav class="my-10" aria-labelledby="bacaan-terkait-heading" data-pagefind-ignore>
            <h2 id="bacaan-terkait-heading" class="font-serif text-xl font-semibold text-[var(--color-text)] mb-4">
              Bacaan terkait
            </h2>
            <!-- Text cards (one .card per item): topic, title, reading time. No photo: the related set usually
                 shares one commodity, so thumbnails were identical (T-58B). -->
            <ul class="grid gap-3 sm:grid-cols-2">
              {relatedArticles.map((rel) => (
                <li>
                  <a
                    href={`/jurnal/${rel.data.slug}/`}
                    class="card card-link related-card flex h-full flex-col gap-1.5 p-4 min-h-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
                  >
                    <span class={`topic-${rel.data.topic} inline-flex items-center gap-2 text-sm font-medium text-[var(--color-soil)]`}>
                      <span class="topic-marker" aria-hidden="true"></span>
                      {topicName(rel.data.topic)}
                    </span>
                    <span class="font-serif font-semibold text-[1.0625rem] sm:text-lg leading-snug text-[var(--color-text)] text-pretty">{rel.data.title}</span>
                    <span class="mt-auto pt-1 text-sm text-[var(--color-text-muted)] tabular-nums">{getReadingTime(rel.body || '').text}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-col items-start text-sm font-semibold text-[var(--color-brand-strong)]">
              {primaryCommodity && !toolsUpcoming && (
                <a href={`/alat/diagnosa-gejala/?k=${primaryCommodity}`} class="inline-flex items-center min-h-[44px] hover:underline">
                  Diagnosa gejala {commodityLabel} →
                </a>
              )}
              {commodityHubExists && (
                <a href={`/jurnal/komoditas/${primaryCommodity}/`} class="inline-flex items-center min-h-[44px] hover:underline" data-hub-link>
                  Lihat {commodityCount} artikel {commodityLabel} →
                </a>
              )}
              <a href={`/jurnal/topik/${data.topic}/`} class="inline-flex items-center min-h-[44px] hover:underline">
                Lihat semua artikel topik {topicLabel} →
              </a>
            </div>
          </nav>
        )}
      </div>

      <div class="lg:col-span-2 hidden lg:block" aria-hidden="true"></div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Meta bar (T-58B): "·" separators belong to each item's ::before. The list overhangs left by one
     separator width inside a horizontally clipped wrapper, so the first item of every wrapped line hides
     its separator and no line starts or ends with a dangling "·". */
  .meta-clip {
    overflow-x: clip;
  }
  .meta-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.5rem;
    margin-left: -1.25rem;
    line-height: 1.5rem;
  }
  .meta-list > li {
    white-space: nowrap;
  }
  .meta-list > li::before {
    content: '·' / '';
    display: inline-block;
    width: 1.25rem;
    text-align: center;
    color: var(--color-text-muted);
  }
  /* 44px tall hit area around 24px text lines, without loosening the bar. */
  .meta-link {
    position: relative;
    text-decoration: underline;
    text-decoration-color: var(--color-border-control);
    text-underline-offset: 4px;
  }
  .meta-link::after {
    content: '';
    position: absolute;
    /* 18px inline box + 2 x 13px = 44px tall; at least 44px wide for short names ("Padi"). */
    top: -13px;
    bottom: -13px;
    left: 50%;
    width: max(100% + 8px, 44px);
    translate: -50% 0;
  }
  .meta-link:hover {
    text-decoration-color: currentColor;
  }

  /* Mobile reading progress: functional scroll position cue, brand colour, 3px. */
  .reading-progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (max-width: 1023.98px) and (prefers-reduced-motion: no-preference) {
      .reading-progress {
        display: block;
        position: fixed;
        inset: 0 0 auto 0;
        height: 3px;
        z-index: 60;
        background: var(--color-brand);
        transform-origin: 0 50%;
        transform: scaleX(0);
        pointer-events: none;
        animation-name: reading-progress;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }
      /* Separate rule: the CSS minifier folds longhands into an `animation` shorthand that Chrome
         rejects when it carries a timeline; keep the timeline on its own selector. */
      div.reading-progress {
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes reading-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* Ensure article body measure is between 65ch and 72ch (DESIGN §4.3.2) */
  .prose-container {
    max-width: 68ch;
  }

  /* Headings scroll margin so jumps from TOC have generous breathing space */
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 5rem;
  }

  /* Prose typography styling - Editorial Scale (DESIGN §4.3.2) */
  .prose :global(h2) {
    font-family: var(--font-editorial, 'Newsreader', Georgia, serif);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-top: 3rem;
    margin-bottom: 1.125rem;
    color: var(--color-text);
  }

  .prose :global(h3) {
    font-family: var(--font-editorial, 'Newsreader', Georgia, serif);
    font-size: 1.3125rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 2.25rem;
    margin-bottom: 0.875rem;
    color: var(--color-text);
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }

  .prose :global(ul) {
    list-style-type: disc;
  }

  .prose :global(ol) {
    list-style-type: decimal;
  }

  .prose :global(li) {
    margin-bottom: 0.75rem;
    line-height: 1.75;
  }

  /* Suppress divider lines (DESIGN §3, §8: no divider lines between sections or paragraphs) */
  .prose :global(hr) {
    display: none;
  }

  .prose :global(blockquote) {
    background-color: var(--color-surface-raised);
    padding: 1rem 1.25rem;
    border-radius: 2px;
    color: var(--color-text);
    margin: 2rem 0;
  }

  /* FAQ: paragraphs that open with a bold question + line break (DESIGN §4.3.1).
     Pure CSS so article files stay untouched. */
  .prose :global(p:has(> strong:first-child + br)) {
    margin-top: 1.75rem;
  }
  .prose :global(p:has(> strong:first-child + br) > strong:first-child) {
    display: block;
    font-family: var(--font-editorial, 'Newsreader', Georgia, serif);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text);
    margin-bottom: 0.375rem;
    text-wrap: balance;
  }
  .prose :global(p:has(> strong:first-child + br) > strong:first-child + br) {
    display: none;
  }

  /* Editorial Callout Panel (transformed from blockquote) */
  .prose :global(blockquote.callout) {
    background-color: var(--color-tint);
    padding: 1.25rem 1.5rem;
    border-radius: 2px;
    margin: 2rem 0;
    color: var(--color-text);
  }

  .prose :global(blockquote.callout .callout-badge) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-editorial);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-brand-strong);
    margin-bottom: 0.75rem;
  }

  .prose :global(blockquote.callout .callout-dot) {
    width: 0.375rem;
    height: 0.375rem;
    display: none;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
    overflow-x: auto;
    display: block;
  }

  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.625rem 0.875rem;
    text-align: left;
  }

  .prose :global(th) {
    background-color: var(--color-tint);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-soil);
  }

  /* Code & ASCII Diagram styling (light tint, readable, scrollable) */
  .prose :global(pre) {
    background-color: var(--color-tint) !important;
    color: var(--color-text) !important;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 1.5rem 0;
  }

  .prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
    font-size: 0.875em;
  }

  .prose :global(pre code) {
    background: transparent !important;
    color: inherit !important;
    padding: 0;
    font-size: inherit;
    white-space: pre;
  }

  /* LaTeX MathML formula styling (DEC-018) */
  .prose :global(.katex-display),
  .prose :global(math[display="block"]) {
    display: block;
    overflow-x: auto;
    overflow-y: hidden;
    max-width: 100%;
    padding: 0.75rem 0;
    margin: 1.5rem 0;
    font-size: 1rem;
    line-height: normal;
    text-align: center;
    -webkit-overflow-scrolling: touch;
  }

  .prose :global(.katex),
  .prose :global(math) {
    font-size: inherit;
    line-height: normal;
    text-indent: 0;
  }
</style>

<script>
  function initArticleActions() {
    // 1. Print handler
    const printButtons = document.querySelectorAll('[data-action="print"]');
    printButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        window.print();
      });
    });

    // 2. Native Web Share API with clipboard copy fallback (every [data-action="share"] button)
    document.querySelectorAll<HTMLButtonElement>('[data-action="share"]').forEach((btn) => {
      if (btn.dataset.shareBound) return;
      btn.dataset.shareBound = '1';
      const label = btn.querySelector<HTMLElement>('[data-share-label]');
      btn.addEventListener('click', async () => {
        const shareData = {
          title: document.title,
          text: document.querySelector('meta[name="description"]')?.getAttribute('content') || document.title,
          url: window.location.href,
        };
        if (navigator.share) {
          try {
            await navigator.share(shareData);
          } catch {
            // User dismissed share
          }
          return;
        }
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (label) {
            const orig = label.textContent;
            label.textContent = 'Tautan Tersalin!';
            setTimeout(() => {
              label.textContent = orig;
            }, 2000);
          }
        } catch {
          // Clipboard copy failed
        }
      });
    });

    // 3. Keyboard accessibility for pre, table, and scrollable containers (WCAG 2.1.1)
    document.querySelectorAll<HTMLElement>('.prose pre, .prose table, .prose .katex-display').forEach((el) => {
      el.setAttribute('tabindex', '0');
      el.setAttribute('role', 'region');
      el.setAttribute('aria-label', el.tagName === 'PRE' ? 'Diagram / Kode' : el.tagName === 'TABLE' ? 'Tabel data' : 'Rumus matematika');
    });

    // 4. Enhance blockquote callouts in dev mode / client navigation
    document.querySelectorAll<HTMLQuoteElement>('.prose blockquote').forEach((bq) => {
      if (bq.classList.contains('callout-enhanced')) return;
      const firstP = bq.querySelector('p');
      if (!firstP) return;
      const text = firstP.textContent || '';
      const match = text.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*(.*)/i);
      if (match) {
        const kind = match[1].toLowerCase();
        const rest = match[2];
        bq.classList.add('callout', `callout-${kind}`, 'callout-enhanced');
        const labelMap: Record<string, string> = {
          note: 'Catatan Lapangan',
          tip: 'Tips Agronomi',
          important: 'Penting Diperhatikan',
          warning: 'Peringatan Hama',
          caution: 'Perhatian Khusus',
        };
        const label = labelMap[kind] || 'Catatan Lapangan';
        
        const badge = document.createElement('div');
        badge.className = 'callout-badge';
        badge.innerHTML = `<span class="callout-dot"></span><span>${label}</span>`;
        
        if (rest.trim()) {
          firstP.innerHTML = `<span class="callout-title font-semibold text-[var(--color-text)]">${rest.trim()}</span>`;
        } else {
          firstP.remove();
        }
        bq.insertBefore(badge, bq.firstChild);
      }
    });
  }

  initArticleActions();
  document.addEventListener('astro:page-load', initArticleActions);
</script>
