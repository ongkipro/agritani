---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
  /** inline = collapsible list in the article column (<1024px); sidebar = sticky list (>=1024px). */
  variant: 'inline' | 'sidebar';
}

const { headings = [], variant } = Astro.props;

// Filter only H2 (and H3 if H2 count is small, e.g. <= 6)
const filteredHeadings = headings.filter(
  (h) => h.depth === 2 || (headings.filter((x) => x.depth === 2).length <= 6 && h.depth === 3)
);
---

{filteredHeadings.length > 0 && (
  <nav class:list={['article-toc', variant === 'sidebar' && 'h-full']} aria-label="Daftar isi artikel">
    <!-- inline: collapsible list in the article column (DESIGN §4.3.2) -->
    {variant === 'inline' && (
    <details
      class="lg:hidden my-6 border-y border-[var(--color-border)] group"
      id="article-toc-mobile"
    >
      <summary class="flex items-center justify-between py-3 cursor-pointer select-none min-h-[48px] list-none">
        <div class="flex items-center gap-2.5">
          <span class="font-serif font-semibold text-base text-[var(--color-text)]">
            Daftar isi
          </span>
          <span class="text-xs text-[var(--color-text-muted)] tabular-nums">
            {filteredHeadings.length} bagian
          </span>
        </div>
        <svg
          class="w-4 h-4 text-[var(--color-text-muted)] transition-transform duration-200 group-open:rotate-180"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </summary>
      <div class="pb-3 divide-y divide-[var(--color-border)]">
        {filteredHeadings.map((h) => {
          const isH3 = h.depth === 3;
          return (
            <a
              href={`#${h.slug}`}
              class:list={[
                'flex items-center gap-2.5 min-h-[44px] py-2 text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors active:bg-[var(--color-tint)]/50',
                isH3 ? 'pl-5 text-xs text-[var(--color-text-muted)]' : 'text-sm font-medium'
              ]}
              data-mobile-toc-link
            >
              <span class="flex-1 leading-snug">{h.text}</span>
              <span class="text-xs text-[var(--color-text-muted)]" aria-hidden="true">→</span>
            </a>
          );
        })}
      </div>
    </details>
    )}

    <!-- sidebar: sticky list with reading progress (DESIGN §4.3.2) -->
    {variant === 'sidebar' && (
    <div class="hidden lg:block sticky top-6 max-h-[calc(100vh-3rem)] overflow-y-auto pr-4 text-sm toc-scrollbar">
      <div class="mb-4 pb-2.5 border-b border-[var(--color-border)]">
        <div class="flex items-center justify-between">
          <span class="font-serif font-semibold text-base text-[var(--color-text)]">
            Daftar isi
          </span>
          <span
            id="toc-progress-text"
            class="text-xs text-[var(--color-text-muted)] tabular-nums"
            aria-live="polite"
          >
            0% dibaca
          </span>
        </div>
        <div class="w-full bg-[var(--color-border)] h-[2px] mt-2 overflow-hidden">
          <div
            id="toc-progress-fill"
            class="bg-[var(--color-brand)] h-full w-0 transition-all duration-150"
            aria-hidden="true"
          ></div>
        </div>
      </div>
      <ol class="space-y-0.5 border-l border-[var(--color-border)] relative text-[var(--color-text-muted)]" id="toc-nav-list">
        {filteredHeadings.map((h) => {
          const isH3 = h.depth === 3;
          return (
            <li class="relative">
              <a
                href={`#${h.slug}`}
                data-toc-link
                class:list={[
                  'toc-item block transition-all duration-150 leading-snug',
                  isH3
                    ? 'pl-5 pr-2 py-1 text-xs text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)]'
                    : 'pl-3 pr-2 py-1.5 text-[13px] font-medium text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
                  'border-l border-transparent -ml-px hover:border-[var(--color-border-control)]',
                  'focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]'
                ]}
              >
                {h.text}
              </a>
            </li>
          );
        })}
      </ol>
    </div>
    )}
  </nav>
)}

<style>
  /* Slim refined scrollbar for desktop TOC if headings overflow */
  .toc-scrollbar::-webkit-scrollbar {
    width: 3px;
  }
  .toc-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .toc-scrollbar::-webkit-scrollbar-thumb {
    background: var(--color-border-control);
    border-radius: 2px;
  }
  .toc-scrollbar::-webkit-scrollbar-thumb:hover {
    background: var(--color-soil);
  }

  /* Active TOC link state styles: crisp active rail indicator with high-contrast text */
  :global(.toc-item.active-toc-link) {
    color: var(--color-brand-strong) !important;
    font-weight: 600 !important;
    border-left-color: var(--color-brand-strong) !important;
  }
</style>

<script>
  function setupToc() {
    // 1. Mobile TOC: Auto-close accordion on link click
    const mobileDetails = document.getElementById('article-toc-mobile') as HTMLDetailsElement | null;
    const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('[data-mobile-toc-link]');
    if (mobileDetails && mobileLinks.length > 0) {
      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          mobileDetails.open = false;
        });
      });
    }

    // 2. Desktop TOC: Precision Scrollspy & Reading Progress Tracker
    const desktopLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const progressFill = document.getElementById('toc-progress-fill');
    const progressText = document.getElementById('toc-progress-text');
    const articleContainer = document.querySelector<HTMLElement>('[data-pagefind-body]');

    if (desktopLinks.length === 0) return;

    const headingTargets = desktopLinks.map((link) => {
      const id = link.getAttribute('href')?.replace('#', '');
      return id ? document.getElementById(id) : null;
    });

    function updateActiveState() {
      // (a) Reading Progress Percentage
      if (articleContainer && progressText) {
        const rect = articleContainer.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const totalHeight = rect.height - viewportHeight * 0.5;
        const scrolled = -rect.top;
        let pct = 0;
        if (totalHeight > 0) {
          pct = Math.min(100, Math.max(0, Math.round((scrolled / totalHeight) * 100)));
        } else if (rect.top <= 0) {
          pct = 100;
        }
        if (progressFill) progressFill.style.width = `${pct}%`;
        progressText.textContent = `${pct}% dibaca`;
      }

      // (b) Find Active Heading (threshold: top 35% of viewport)
      const threshold = window.innerHeight * 0.35;
      let activeIndex = -1;

      for (let i = 0; i < headingTargets.length; i++) {
        const el = headingTargets[i];
        if (el) {
          const top = el.getBoundingClientRect().top;
          if (top <= threshold) {
            activeIndex = i;
          }
        }
      }

      // If user is inside the article and above first heading, highlight first heading
      if (activeIndex === -1 && articleContainer) {
        const artTop = articleContainer.getBoundingClientRect().top;
        if (artTop <= threshold) {
          activeIndex = 0;
        }
      }

      // Bottom of page: activate last item
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 150) {
        activeIndex = headingTargets.length - 1;
      }

      desktopLinks.forEach((link, idx) => {
        const isMatch = idx === activeIndex;
        link.classList.toggle('active-toc-link', isMatch);
      });
    }

    let isTicking = false;
    function onScroll() {
      if (!isTicking) {
        window.requestAnimationFrame(() => {
          updateActiveState();
          isTicking = false;
        });
        isTicking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateActiveState();
  }

  // Initialize on load and page transition
  setupToc();
  document.addEventListener('astro:page-load', setupToc);
</script>
