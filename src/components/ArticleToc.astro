---
export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: TocHeading[];
}

const { headings = [] } = Astro.props;

// Filter only H2 (and H3 if H2 <= 6)
const filteredHeadings = headings.filter((h) => h.depth === 2 || (headings.filter((x) => x.depth === 2).length <= 6 && h.depth === 3));
---

{filteredHeadings.length > 0 && (
  <nav class="article-toc" aria-label="Daftar isi">
    <!-- Mobile: collapsible <details> -->
    <details class="lg:hidden my-6 p-4 rounded-[2px] bg-[var(--color-tint)] border border-[var(--color-border)]">
      <summary class="font-bold text-sm text-[var(--color-text)] cursor-pointer select-none py-1">
        Daftar Isi ({filteredHeadings.length} bagian)
      </summary>
      <ol class="mt-3 space-y-2 text-sm pl-4 list-decimal text-[var(--color-text-muted)]">
        {filteredHeadings.map((h) => (
          <li class={h.depth === 3 ? 'ml-4' : ''}>
            <a
              href={`#${h.slug}`}
              class="text-[var(--color-text)] hover:text-[var(--color-brand-strong)] hover:underline inline-block py-0.5"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </details>

    <!-- Desktop: sticky sidebar -->
    <div class="hidden lg:block sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto pr-4 text-sm">
      <div class="font-bold text-xs uppercase tracking-wider mb-3 text-[var(--color-soil)]">
        Daftar Isi
      </div>
      <ol class="space-y-2 border-l border-[var(--color-border)] pl-3 text-[var(--color-text-muted)]">
        {filteredHeadings.map((h) => (
          <li class={h.depth === 3 ? 'ml-3' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link
              class="toc-link block py-1 text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)] transition-colors leading-snug"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
)}

<script>
  // TOC active scrollspy (<1 KB)
  if (typeof window !== 'undefined' && 'IntersectionObserver' in window) {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (links.length > 0) {
      const headingTargets = Array.from(links)
        .map((link) => {
          const id = link.getAttribute('href')?.replace('#', '');
          return id ? document.getElementById(id) : null;
        })
        .filter(Boolean) as HTMLElement[];

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.getAttribute('id');
              links.forEach((l) => {
                const match = l.getAttribute('href') === `#${id}`;
                l.classList.toggle('text-[var(--color-brand-strong)]', match);
                l.classList.toggle('font-semibold', match);
              });
            }
          });
        },
        { rootMargin: '-20% 0px -70% 0px' }
      );

      headingTargets.forEach((h) => observer.observe(h));
    }
  }
</script>
