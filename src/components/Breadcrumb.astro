---
/**
 * Breadcrumb (DESIGN §4.4.4). Visible trail + BreadcrumbList come from the same data (SeoHead).
 * <640px: one "back to parent" link (44px target). >=640px: one-line trail; the current page
 * (usually the H1 right below) is truncated and not bold so it never wraps or competes with the H1.
 */
import type { BreadcrumbItem } from '../lib/seo';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const parentItem = items && items.length >= 2 ? items[items.length - 2] : null;
---

{
  items && items.length > 0 && (
    <nav aria-label="Breadcrumb">
      {parentItem && (
        <a
          href={parentItem.url}
          class="sm:hidden inline-flex items-center gap-1.5 min-h-[44px] text-sm font-medium text-[var(--color-brand-strong)] hover:text-[var(--color-brand-hover)] active:text-[var(--color-text)]"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span class="truncate max-w-[18rem]">{parentItem.name}</span>
        </a>
      )}

      <ol class:list={[
        'items-center gap-x-1 text-[13px] text-[var(--color-text-muted)] min-w-0',
        parentItem ? 'sr-only sm:not-sr-only sm:flex' : 'flex',
      ]}>
        {items.map((item, idx) => {
          const isLast = idx === items.length - 1;
          return (
            <li class:list={['flex items-center gap-x-1', isLast ? 'min-w-0 flex-1' : 'shrink-0']}>
              {idx > 0 && (
                <svg class="w-3.5 h-3.5 shrink-0 text-[var(--color-border-control)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              )}
              {isLast ? (
                <span class="truncate text-[var(--color-text)]" aria-current="page" title={item.name}>
                  {item.name}
                </span>
              ) : (
                <a
                  href={item.url}
                  class:list={[
                    'inline-flex items-center min-h-[44px] hover:text-[var(--color-brand-strong)] hover:underline underline-offset-4 active:text-[var(--color-text)]',
                    idx === 0 && item.url === '/' && 'min-w-[44px] justify-center -ml-[14px] -mr-[14px]',
                  ]}
                >
                  {idx === 0 && item.url === '/' ? (
                    <>
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 10.5 12 3l9 7.5"></path>
                        <path d="M5 9.5V21h14V9.5"></path>
                      </svg>
                      <span class="sr-only">{item.name}</span>
                    </>
                  ) : (
                    item.name
                  )}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
