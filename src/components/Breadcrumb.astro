---
import type { BreadcrumbItem } from '../lib/seo';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

{
  items && items.length > 0 && (
    <nav aria-label="Breadcrumb" class="py-3">
      <ol class="flex flex-wrap items-center gap-1.5 text-xs text-[var(--color-text-muted)]">
        {items.map((item, idx) => {
          const isLast = idx === items.length - 1;
          return (
            <li class="flex items-center gap-1.5">
              {idx > 0 && <span class="text-[var(--color-border-control)]" aria-hidden="true">›</span>}
              {isLast ? (
                <span class="text-[var(--color-text)] font-semibold truncate max-w-[280px] sm:max-w-none" aria-current="page">
                  {item.name}
                </span>
              ) : (
                <a
                  href={item.url}
                  class="hover:text-[var(--color-brand-strong)] transition-colors py-1 inline-flex items-center min-h-[32px]"
                >
                  {item.name}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
