---
/**
 * src/components/Footer.astro
 * Footer component strictly conforming to DESIGN §4.2.1 (baris 4a, 4b), §3.1, §3.3, §2.8
 */
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-brand)] text-white pt-12 pb-10 mt-16">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 pb-12">
      <!-- Col 1: Brand & Profile (4 cols wide for comfortable measure) -->
      <div class="space-y-3 lg:col-span-4 pr-0 lg:pr-6">
        <div class="text-xl font-extrabold text-white">Agritani</div>
        <p class="text-sm text-white leading-relaxed max-w-[44ch]">
          Distributor resmi sarana produksi dan biostimulan pertanian presisi. Menghubungkan sains agronomi dengan praktik terbaik di lahan petani Indonesia.
        </p>
        <div class="text-xs text-white pt-2 font-medium">
          PT Agritani Internasional
        </div>
      </div>

      <!-- Col 2: Alat Tani (4 alat per DESIGN §4.2.1 baris 4a) -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-bold text-white mb-3">Alat Tani</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/alat/diagnosa-gejala/" class="text-white hover:underline">Diagnosa Gejala</a></li>
          <li><a href="/alat/kalender-tanam/" class="text-white hover:underline">Kalender Tanam</a></li>
          <li><a href="/alat/cuaca-tani/" class="text-white hover:underline">Cuaca Tani</a></li>
          <li><a href="/alat/kalkulator-dosis/" class="text-white hover:underline">Kalkulator Dosis</a></li>
        </ul>
      </div>

      <!-- Col 3: Jurnal Tani (6 topik per DESIGN §4.2.1 baris 4a) -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-bold text-white mb-3">Jurnal Tani</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/jurnal/topik/proteksi-tanaman/" class="text-white hover:underline">Proteksi Tanaman</a></li>
          <li><a href="/jurnal/topik/tanah-nutrisi/" class="text-white hover:underline">Tanah & Nutrisi</a></li>
          <li><a href="/jurnal/topik/budidaya/" class="text-white hover:underline">Budidaya</a></li>
          <li><a href="/jurnal/topik/air-irigasi/" class="text-white hover:underline">Air & Irigasi</a></li>
          <li><a href="/jurnal/topik/pascapanen-agribisnis/" class="text-white hover:underline">Pascapanen & Agribisnis</a></li>
          <li><a href="/jurnal/topik/sains-tanaman/" class="text-white hover:underline">Sains Tanaman</a></li>
        </ul>
      </div>

      <!-- Col 4: Produk (4 produk per DESIGN §4.2.1 baris 4a) -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-bold text-white mb-3">Produk</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/produk/aussie/" class="text-white hover:underline">Aussie</a></li>
          <li><a href="/produk/bensu/" class="text-white hover:underline">BENSU</a></li>
          <li><a href="/produk/kojien/" class="text-white hover:underline">Kojien</a></li>
          <li><a href="/produk/saratoga/" class="text-white hover:underline">Saratoga</a></li>
        </ul>
      </div>

      <!-- Col 5: Perusahaan & Kontak -->
      <div class="lg:col-span-2">
        <h4 class="text-xs font-bold text-white mb-3">Perusahaan</h4>
        <ul class="space-y-2 text-sm mb-4">
          <li><a href="/tentang-kami/" class="text-white hover:underline">Tentang Kami</a></li>
          <li><a href="/penulis/arif-prabowo/" class="text-white hover:underline">Prof. Arif Prabowo</a></li>
          <li><a href="/konsultasi/" class="text-white hover:underline">Konsultasi</a></li>
          <li><a href="/kemitraan-distributor/" class="text-white hover:underline">Kemitraan Distributor</a></li>
          <li><a href="/kebijakan-privasi/" class="text-white hover:underline">Kebijakan Privasi</a></li>
        </ul>

        <h4 class="text-xs font-bold text-white mb-2 pt-2">Kontak</h4>
        <div class="text-xs text-white space-y-1">
          <div>WhatsApp: <a href="https://wa.me/6287770457256" class="text-white hover:underline whitespace-nowrap">+62 877-7045-7256</a></div>
        </div>
      </div>
    </div>

    <!-- Bottom Legal Bar (DESIGN §4.2.1 baris 4b: spasi tanpa garis per DESIGN §3.3) -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-white gap-4">
      <div>
        © {currentYear} PT Agritani Internasional · Distributor resmi
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: #ffffff;
    text-decoration: none;
  }
  footer a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
</style>
