---
/**
 * src/components/Footer.astro
 * Agritani Footer (Teagasc Bookend UI/UX Architecture):
 *
 * 1. Multi-Disciplinary Taxonomy Strip (6 topic colors bookend)
 * 2. 4-Column Structured Directory Grid:
 *    - Col 1: Sektor Keilmuan Tani (6 topics with dot badges & slide hover)
 *    - Col 2: Organisasi & Riset (Profil, Pengelola Jurnal, Kemitraan, Kebijakan)
 *    - Col 3: Instrumen Lapangan (Diagnosa, Cuaca BMKG, Dosis 16L, Kalender, Konsultasi)
 *    - Col 4: Produk & Rujukan Resmi (4 Produk Unggulan, Katalog, Pencarian)
 * 3. Institutional Sub-Footer:
 *    - Agritani & Pengelola Jurnal Arif Prabowo (DEC-016 compliant)
 *    - WhatsApp Resmi & Hak Cipta
 *    - ShieldedTag™ Protection authentication seal card
 */

import { externalLink } from '../lib/links';

const { noWhatsApp = false } = Astro.props as { noWhatsApp?: boolean };
const currentYear = new Date().getFullYear();
const waExternalAttrs = externalLink('whatsapp');

const topicLinks = [
  {
    href: '/jurnal/topik/proteksi-tanaman/',
    label: 'Proteksi Tanaman',
    colorClass: 'bg-[var(--color-topic-proteksi-tanaman)]',
  },
  {
    href: '/jurnal/topik/tanah-nutrisi/',
    label: 'Tanah & Nutrisi',
    colorClass: 'bg-[var(--color-topic-tanah-nutrisi)]',
  },
  {
    href: '/jurnal/topik/budidaya/',
    label: 'Budidaya',
    colorClass: 'bg-[var(--color-topic-budidaya)]',
  },
  {
    href: '/jurnal/topik/air-irigasi/',
    label: 'Air & Irigasi',
    colorClass: 'bg-[var(--color-topic-air-irigasi)]',
  },
  {
    href: '/jurnal/topik/pascapanen-agribisnis/',
    label: 'Pascapanen & Agribisnis',
    colorClass: 'bg-[var(--color-topic-pascapanen-agribisnis)]',
  },
  {
    href: '/jurnal/topik/sains-tanaman/',
    label: 'Sains Tanaman',
    colorClass: 'bg-[var(--color-topic-sains-tanaman)]',
  },
];

const orgLinks = [
  { href: '/tentang-kami/', label: 'Tentang Kami' },
  { href: '/penulis/arif-prabowo/', label: 'Pengelola Jurnal Tani: Arif Prabowo' },
  { href: '/jurnal/', label: 'Jurnal Tani & Riset Lapangan' },
  { href: '/kemitraan-distributor/', label: 'Kemitraan Kios & Gapoktan' },
  { href: '/kebijakan-privasi/', label: 'Kebijakan Privasi' },
];

const toolLinks = [
  { href: '/alat/diagnosa-gejala/', label: 'Diagnosa Gejala Tanaman' },
  { href: '/alat/cuaca-tani/', label: 'Cuaca Tani & Jendela Semprot BMKG' },
  { href: '/alat/kalkulator-dosis/', label: 'Kalkulator Dosis Tangki 16L' },
  { href: '/alat/kalender-tanam/', label: 'Kalender Tanam & Fase HST' },
  { href: '/konsultasi/', label: 'Konsultasi Agronomi via WhatsApp' },
];

const productAndStandardLinks = [
  { href: '/produk/aussie/', label: 'Aussie (Perkebunan & Batang)' },
  { href: '/produk/bensu/', label: 'BENSU (Hortikultura & Sayuran)' },
  { href: '/produk/kojien/', label: 'Kojien (Padi Sawah & Palawija)' },
  { href: '/produk/saratoga/', label: 'Saratoga (Asam Amino Pembungaan)' },
  { href: '/produk/', label: 'Katalog 4 Produk Resmi' },
  { href: '/cari/', label: 'Pencarian Artikel & Gejala' },
];
---

<footer class="bg-[var(--color-canvas)] text-[var(--color-text)] select-none">
  <!-- 1. Multi-Disciplinary Taxonomy Strip (Teagasc Bookend) -->
  <div class="w-full grid grid-cols-6 h-[4px]" aria-hidden="true">
    <div class="bg-[var(--color-topic-proteksi-tanaman)]"></div>
    <div class="bg-[var(--color-topic-tanah-nutrisi)]"></div>
    <div class="bg-[var(--color-topic-budidaya)]"></div>
    <div class="bg-[var(--color-topic-air-irigasi)]"></div>
    <div class="bg-[var(--color-topic-pascapanen-agribisnis)]"></div>
    <div class="bg-[var(--color-topic-sains-tanaman)]"></div>
  </div>

  <!-- 2. Main 4-Column Directory Grid -->
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-10">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-8 lg:gap-10">
      
      <!-- Col 1: Sektor Jurnal Tani -->
      <div>
        <h2 class="font-serif text-base font-semibold text-[var(--color-text)] mb-1">
          Topik Jurnal Tani
        </h2>
        <ul>
          {
            topicLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-2 text-sm text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]"
                >
                  <span class="flex items-center gap-2">
                    <span class={`w-2 h-2 rounded-full ${item.colorClass} shrink-0`} aria-hidden="true"></span>
                    <span>{item.label}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 2: Organisasi & Riset -->
      <div>
        <h2 class="font-serif text-base font-semibold text-[var(--color-text)] mb-1">
          Tentang Agritani
        </h2>
        <ul>
          {
            orgLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-2 text-sm text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]"
                >
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Instrumen Lapangan -->
      <div>
        <h2 class="font-serif text-base font-semibold text-[var(--color-text)] mb-1">
          Alat Tani
        </h2>
        <ul>
          {
            toolLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-2 text-sm text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]"
                >
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Produk & Standar -->
      <div>
        <h2 class="font-serif text-base font-semibold text-[var(--color-text)] mb-1">
          Produk
        </h2>
        <ul>
          {
            productAndStandardLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-2 text-sm text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]"
                >
                  <span>{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

    </div>

    <!-- 3. Sub-Footer (Institutional Contact & Credentials) -->
    <div class="mt-12">

      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <!-- Left: Office & Contact Info -->
        <div class="space-y-1.5 text-xs text-[var(--color-text-muted)] leading-relaxed">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <strong class="text-[var(--color-text)] font-extrabold text-sm">Agritani</strong>
            <span class="text-[var(--color-border-control)]" aria-hidden="true">&middot;</span>
            <span>Portal Pertanian Resmi &amp; Produk Unggulan Presisi</span>
          </div>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
            {noWhatsApp ? (
              <span>WhatsApp Resmi: <span class="font-bold whitespace-nowrap">+62 877-7045-7256</span></span>
            ) : (
              <span>WhatsApp Resmi: <a href="https://wa.me/6287770457256" target={waExternalAttrs.target} rel={waExternalAttrs.rel} class="font-bold text-[var(--color-brand-strong)] hover:underline whitespace-nowrap">+62 877-7045-7256<span class="sr-only"> {waExternalAttrs.tabNotice}</span></a></span>
            )}
            <span class="text-[var(--color-border-control)]" aria-hidden="true">&middot;</span>
            <span>Pengelola Jurnal Tani: <a href="/penulis/arif-prabowo/" class="text-[var(--color-brand-strong)] hover:underline">Arif Prabowo</a></span>
          </div>
          <div class="text-[11px] text-[var(--color-text-muted)] pt-1">
            &copy; {currentYear} Agritani · Portal pertanian dikelola Arif Prabowo
          </div>
        </div>

        <!-- Right: Official Trust Emblem (ShieldedTag Protection Seal - Clean, No Card, No Border) -->
        <div class="shrink-0 flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-[var(--color-tint)] flex items-center justify-center text-[var(--color-brand-strong)] font-bold text-xs shrink-0" aria-hidden="true">
            ✓
          </div>
          <div class="text-left text-xs">
            <span class="block font-bold text-[var(--color-text)] leading-tight">ShieldedTag™ Protection</span>
            <span class="block text-[11px] text-[var(--color-text-muted)] leading-tight">Segel Autentikasi Kemasan Resmi</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</footer>
