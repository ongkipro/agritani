---
/**
 * src/components/Footer.astro
 * Agritani Footer perfected to match the authoritative, clean, minimal
 * UI/UX architecture of Teagasc.ie (https://teagasc.ie/):
 *
 * 1. 4-Column Structured Directory:
 *    - Col 1: Sektor Jurnal Tani (6 topik keilmuan)
 *    - Col 2: Organisasi & Riset (Profil, Pengelola Jurnal, Kemitraan, Kebijakan)
 *    - Col 3: Instrumen Lapangan (Diagnosa, Kalender, Cuaca BMKG, Dosis 16L, Konsultasi)
 *    - Col 4: Produk & Rujukan Resmi (4 Produk Unggulan, Segel ShieldedTag, Pencarian)
 * 2. Clean Institutional Sub-Footer:
 *    - Head Office address, official WhatsApp & email
 *    - Registration & distributor credentials
 *    - Copyright © {currentYear} PT Agritani Internasional
 *    - Official ShieldedTag authentication emblem
 */

const currentYear = new Date().getFullYear();

const topicLinks = [
  { href: '/jurnal/topik/proteksi-tanaman/', label: 'Proteksi Tanaman', colorClass: 'bg-[var(--color-topic-proteksi-tanaman)]' },
  { href: '/jurnal/topik/tanah-nutrisi/', label: 'Tanah & Nutrisi', colorClass: 'bg-[var(--color-topic-tanah-nutrisi)]' },
  { href: '/jurnal/topik/budidaya/', label: 'Budidaya', colorClass: 'bg-[var(--color-topic-budidaya)]' },
  { href: '/jurnal/topik/air-irigasi/', label: 'Air & Irigasi', colorClass: 'bg-[var(--color-topic-air-irigasi)]' },
  { href: '/jurnal/topik/pascapanen-agribisnis/', label: 'Pascapanen & Agribisnis', colorClass: 'bg-[var(--color-topic-pascapanen-agribisnis)]' },
  { href: '/jurnal/topik/sains-tanaman/', label: 'Sains Tanaman', colorClass: 'bg-[var(--color-topic-sains-tanaman)]' },
];

const orgLinks = [
  { href: '/tentang-kami/', label: 'Tentang Kami' },
  { href: '/penulis/arif-prabowo/', label: 'Pengelola Jurnal Tani: Arif Prabowo' },
  { href: '/jurnal/', label: 'Jurnal Tani & Riset Lapangan' },
  { href: '/kemitraan-distributor/', label: 'Kemitraan Kios & Gapoktan' },
  { href: '/kebijakan-privasi/', label: 'Kebijakan Privasi' },
];

const toolLinks = [
  { href: '/alat/diagnosa-gejala/', label: 'Diagnosa Gejala Tanaman' },
  { href: '/alat/cuaca-tani/', label: 'Cuaca Tani & Jendela Semprot BMKG' },
  { href: '/alat/kalkulator-dosis/', label: 'Kalkulator Dosis Tangki 16L' },
  { href: '/alat/kalender-tanam/', label: 'Kalender Tanam & Fase HST' },
  { href: '/konsultasi/', label: 'Konsultasi Agronomi via WhatsApp' },
];

const productAndStandardLinks = [
  { href: '/produk/aussie/', label: 'Aussie (Perkebunan & Batang)' },
  { href: '/produk/bensu/', label: 'BENSU (Hortikultura & Sayuran)' },
  { href: '/produk/kojien/', label: 'Kojien (Padi Sawah & Palawija)' },
  { href: '/produk/saratoga/', label: 'Saratoga (Asam Amino Pembungaan)' },
  { href: '/produk/', label: 'Katalog 4 Produk Resmi' },
  { href: '/cari/', label: 'Pencarian Artikel & Gejala' },
];
---

<footer class="bg-[var(--color-surface)] text-[var(--color-text)] mt-16 select-none">
  <!-- Main 4-Column Directory Grid -->
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Col 1: Sektor Jurnal Tani -->
      <div>
        <h4 class="text-xs font-bold text-[var(--color-text)] mb-3">
          Sektor Keilmuan Tani
        </h4>
        <ul class="space-y-1">
          {
            topicLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-1.5 text-xs sm:text-sm text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[36px]"
                >
                  <span class="flex items-center gap-2">
                    <span class={`w-1.5 h-1.5 rounded-full ${item.colorClass} shrink-0`} aria-hidden="true"></span>
                    <span>{item.label}</span>
                  </span>
                  <span class="text-[var(--color-text-muted)] opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all text-xs" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 2: Organisasi & Riset -->
      <div>
        <h4 class="text-xs font-bold text-[var(--color-text)] mb-3">
          Organisasi & Riset
        </h4>
        <ul class="space-y-1">
          {
            orgLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-1.5 text-xs sm:text-sm text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[36px]"
                >
                  <span>{item.label}</span>
                  <span class="text-[var(--color-text-muted)] opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all text-xs" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Instrumen Lapangan -->
      <div>
        <h4 class="text-xs font-bold text-[var(--color-text)] mb-3">
          Instrumen Lapangan
        </h4>
        <ul class="space-y-1">
          {
            toolLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-1.5 text-xs sm:text-sm text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[36px]"
                >
                  <span>{item.label}</span>
                  <span class="text-[var(--color-text-muted)] opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all text-xs" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Produk & Standar -->
      <div>
        <h4 class="text-xs font-bold text-[var(--color-text)] mb-3">
          Produk & Rujukan Resmi
        </h4>
        <ul class="space-y-1">
          {
            productAndStandardLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-1.5 text-xs sm:text-sm text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[36px]"
                >
                  <span>{item.label}</span>
                  <span class="text-[var(--color-text-muted)] opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all text-xs" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

    </div>

    <!-- 3. Sub-Footer (Institutional Contact & Credentials) -->
    <div class="mt-12 pt-8 border-t border-[var(--color-border)] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      
      <!-- Left: Office & Contact Info -->
      <div class="space-y-1.5 text-xs text-[var(--color-text-muted)] leading-relaxed">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <strong class="text-[var(--color-text)] font-extrabold text-sm">PT Agritani Internasional</strong>
          <span class="text-[var(--color-border-control)]" aria-hidden="true">&middot;</span>
          <span>Portal Pertanian Resmi & Produk Unggulan Presisi</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
          <span>WhatsApp Resmi: <a href="https://wa.me/6287770457256" class="font-bold text-[var(--color-brand-strong)] hover:underline whitespace-nowrap">+62 877-7045-7256</a></span>
          <span class="text-[var(--color-border-control)]" aria-hidden="true">&middot;</span>
          <span>Pengelola Jurnal Tani: <a href="/penulis/arif-prabowo/" class="text-[var(--color-brand-strong)] hover:underline">Arif Prabowo</a></span>
        </div>
        <div class="text-[11px] text-[var(--color-text-muted)] pt-1">
          &copy; {currentYear} PT Agritani Internasional · Portal pertanian dikelola Arif Prabowo
        </div>
      </div>

      <!-- Right: Official Trust Emblem (ShieldedTag Packaging Protection) -->
      <div class="shrink-0 flex items-center gap-3">
        <div class="w-8 h-8 rounded-[2px] bg-[var(--color-tint)] flex items-center justify-center text-[var(--color-brand-strong)] font-bold text-xs" aria-hidden="true">
          ✓
        </div>
        <div class="text-left text-xs">
          <span class="block font-bold text-[var(--color-text)] leading-tight">Keaslian Kemasan ShieldedTag™</span>
          <span class="block text-[10px] text-[var(--color-text-muted)] leading-tight">Segel Autentikasi Kemasan Resmi</span>
        </div>
      </div>

    </div>

  </div>
</footer>
