---
/**
 * src/components/Footer.astro
 * Agritani Footer perfected to match the authoritative, clean, minimal
 * UI/UX architecture of Teagasc.ie (https://teagasc.ie/):
 *
 * 1. 6-Sector Multi-Disciplinary Color Strip (Teagasc Signature Bookend)
 * 2. 4-Column Structured Directory with subtle hairline dividers per item:
 *    - Col 1: Sektor Jurnal Tani (6 topik keilmuan)
 *    - Col 2: Organisasi & Riset (Profil, Dewan Pakar, Kemitraan, Kebijakan)
 *    - Col 3: Instrumen Lapangan (Diagnosa, Kalender, Cuaca BMKG, Dosis 16L, WhatsApp)
 *    - Col 4: Produk & Standar (4 Produk Resmi, Garansi ShieldedTag, Aksesibilitas)
 * 3. Clean Institutional Sub-Footer:
 *    - Head Office address, official WhatsApp & email
 *    - Registration & distributor credentials
 *    - Copyright © {currentYear} PT Agritani Internasional
 *    - Official ShieldedTag authentication emblem
 */

const currentYear = new Date().getFullYear();

const topicLinks = [
  { href: '/jurnal/topik/proteksi-tanaman/', label: 'Proteksi Tanaman', colorClass: 'bg-[#B3261E]' },
  { href: '/jurnal/topik/tanah-nutrisi/', label: 'Tanah & Nutrisi', colorClass: 'bg-[#7A4A22]' },
  { href: '/jurnal/topik/budidaya/', label: 'Budidaya', colorClass: 'bg-[#2F7D32]' },
  { href: '/jurnal/topik/air-irigasi/', label: 'Air & Irigasi', colorClass: 'bg-[#1F6FA8]' },
  { href: '/jurnal/topik/pascapanen-agribisnis/', label: 'Pascapanen & Agribisnis', colorClass: 'bg-[#B26A00]' },
  { href: '/jurnal/topik/sains-tanaman/', label: 'Sains Tanaman', colorClass: 'bg-[#0F766E]' },
];

const orgLinks = [
  { href: '/tentang-kami/', label: 'Tentang Kami' },
  { href: '/penulis/arif-prabowo/', label: 'Dewan Pakar: Prof. Arif Prabowo' },
  { href: '/jurnal/', label: 'Jurnal Tani & Riset Lapangan' },
  { href: '/kemitraan-distributor/', label: 'Kemitraan Kios & Gapoktan' },
  { href: '/kebijakan-privasi/', label: 'Kebijakan Privasi' },
];

const toolLinks = [
  { href: '/alat/diagnosa-gejala/', label: 'Diagnosa Gejala Tanaman' },
  { href: '/alat/cuaca-tani/', label: 'Cuaca Tani & Jendela Semprot BMKG' },
  { href: '/alat/kalkulator-dosis/', label: 'Kalkulator Dosis Tangki 16L' },
  { href: '/alat/kalender-tanam/', label: 'Kalender Tanam & Fase HST' },
  { href: '/konsultasi/', label: 'Konsultasi Agronomi via WhatsApp' },
];

const productAndStandardLinks = [
  { href: '/produk/aussie/', label: 'Aussie (Perkebunan & Batang)' },
  { href: '/produk/bensu/', label: 'BENSU (Hortikultura & Sayuran)' },
  { href: '/produk/kojien/', label: 'Kojien (Padi Sawah & Palawija)' },
  { href: '/produk/saratoga/', label: 'Saratoga (Asam Amino Pembungaan)' },
  { href: '/produk/', label: 'Katalog 4 Produk Resmi' },
  { href: '/cari/', label: 'Pencarian Artikel & Gejala' },
];
---

<footer class="bg-[#F8F9F8] text-[var(--color-text)] border-t border-[var(--color-border)] mt-16 select-none">
  
  <!-- 1. Multi-Disciplinary Taxonomy Strip (Teagasc Bookend) -->
  <div class="w-full grid grid-cols-6 h-[4px]" aria-hidden="true">
    <div class="bg-[#B3261E]"></div>
    <div class="bg-[#7A4A22]"></div>
    <div class="bg-[#2F7D32]"></div>
    <div class="bg-[#1F6FA8]"></div>
    <div class="bg-[#B26A00]"></div>
    <div class="bg-[#0F766E]"></div>
  </div>

  <!-- 2. Main 4-Column Directory Grid -->
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      
      <!-- Col 1: Sektor Jurnal Tani -->
      <div>
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-[var(--color-text)] pb-2.5 mb-1 border-b-2 border-[var(--color-brand)]">
          Sektor Keilmuan Tani
        </h4>
        <ul class="divide-y divide-[var(--color-border)]">
          {
            topicLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-2.5 text-xs sm:text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]"
                >
                  <span class="flex items-center gap-2">
                    <span class={`w-2 h-2 rounded-full ${item.colorClass} shrink-0`} aria-hidden="true"></span>
                    <span>{item.label}</span>
                  </span>
                  <span class="text-[var(--color-text-muted)] group-hover:text-[var(--color-brand)] group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 2: Organisasi & Riset -->
      <div>
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-[var(--color-text)] pb-2.5 mb-1 border-b-2 border-[var(--color-brand)]">
          Organisasi & Riset
        </h4>
        <ul class="divide-y divide-[var(--color-border)]">
          {
            orgLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-2.5 text-xs sm:text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]"
                >
                  <span>{item.label}</span>
                  <span class="text-[var(--color-text-muted)] group-hover:text-[var(--color-brand)] group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Instrumen Lapangan -->
      <div>
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-[var(--color-text)] pb-2.5 mb-1 border-b-2 border-[var(--color-brand)]">
          Instrumen Lapangan
        </h4>
        <ul class="divide-y divide-[var(--color-border)]">
          {
            toolLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-2.5 text-xs sm:text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]"
                >
                  <span>{item.label}</span>
                  <span class="text-[var(--color-text-muted)] group-hover:text-[var(--color-brand)] group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 4: Produk & Standar -->
      <div>
        <h4 class="text-xs font-extrabold uppercase tracking-wider text-[var(--color-text)] pb-2.5 mb-1 border-b-2 border-[var(--color-brand)]">
          Produk & Rujukan Resmi
        </h4>
        <ul class="divide-y divide-[var(--color-border)]">
          {
            productAndStandardLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group flex items-center justify-between py-2.5 text-xs sm:text-sm font-semibold text-[var(--color-text)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]"
                >
                  <span>{item.label}</span>
                  <span class="text-[var(--color-text-muted)] group-hover:text-[var(--color-brand)] group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

    </div>

    <!-- 3. Sub-Footer (Teagasc Institutional Contact & Credentials) -->
    <div class="mt-12 pt-8 border-t border-[var(--color-border)] flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      
      <!-- Left: Office & Contact Info -->
      <div class="space-y-1.5 text-xs text-[var(--color-text-muted)] leading-relaxed">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <strong class="text-[var(--color-text)] font-extrabold text-sm">PT Agritani Internasional</strong>
          <span class="text-[var(--color-border-control)]" aria-hidden="true">&middot;</span>
          <span>Distributor Resmi Sarana Pertanian & Biostimulan Presisi</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
          <span>WhatsApp Resmi: <a href="https://wa.me/6287770457256" class="font-bold text-[var(--color-brand-strong)] hover:underline whitespace-nowrap">+62 877-7045-7256</a></span>
          <span class="text-[var(--color-border-control)]" aria-hidden="true">&middot;</span>
          <span>Dewan Pakar: <a href="/penulis/arif-prabowo/" class="text-[var(--color-brand-strong)] hover:underline">Prof. Arif Prabowo</a></span>
          <span class="text-[var(--color-border-control)]" aria-hidden="true">&middot;</span>
          <span>Aksesibilitas: <span class="font-bold text-[var(--color-text)]">WCAG AAA (≥ 7:1)</span></span>
        </div>
        <div class="text-[11px] text-[var(--color-text-muted)] pt-1">
          &copy; {currentYear} PT Agritani Internasional. Seluruh hak cipta dilindungi undang-undang. Disajikan untuk rujukan agronomi lapangan Indonesia.
        </div>
      </div>

      <!-- Right: Official Trust Emblem (ShieldedTag Distributor Seal) -->
      <div class="shrink-0 flex items-center gap-3 p-3 bg-white border border-[var(--color-border)] rounded-[4px] shadow-2xs">
        <div class="w-8 h-8 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center text-[var(--color-brand-strong)] font-bold text-xs" aria-hidden="true">
          ✓
        </div>
        <div class="text-left text-xs">
          <span class="block font-bold text-[var(--color-text)] leading-tight">ShieldedTag™ Protection</span>
          <span class="block text-[10px] text-[var(--color-text-muted)] leading-tight">Segel Autentikasi Distributor Resmi</span>
        </div>
      </div>

    </div>

  </div>
</footer>
