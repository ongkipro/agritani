---
import { DEFAULT_WA_PHONE } from '../lib/whatsapp';
---

<footer class="bg-[var(--color-brand)] text-white/90 pt-12 pb-8 mt-16">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-8">
      <!-- Col 1: Brand & Positioning -->
      <div class="md:col-span-2 space-y-3">
        <div class="text-xl font-extrabold text-white">Agritani</div>
        <p class="text-sm text-white/80 max-w-[48ch] leading-relaxed">
          Distributor resmi sarana produksi dan biostimulan pertanian presisi. Menghubungkan sains agronomi dengan praktik terbaik di lahan petani Indonesia.
        </p>
        <div class="text-xs text-white/70 space-y-1 pt-2">
          <div>PT Agritani Internasional</div>
          <div>Alamat Kantor: <!-- TODO(OQ-7): Alamat resmi perusahaan dari pemilik --> Gd. Agritani Nusantara, Jakarta Selatan, DKI Jakarta</div>
          <div>Kontak WhatsApp Resmi: <!-- TODO(OQ-1): Nomor resmi dari pemilik --> +{DEFAULT_WA_PHONE.replace(/(\d{2})(\d{3})(\d{4})(\d{4})/, '$1 $2-$3-$4')}</div>
        </div>
      </div>

      <!-- Col 2: Alat & Solusi -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Alat Tani</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/alat/diagnosa-gejala/" class="hover:text-white transition-colors">Diagnosa Gejala</a></li>
          <li><a href="/alat/kalender-tanam/" class="hover:text-white transition-colors">Kalender Tanam</a></li>
          <li><a href="/alat/cuaca-tani/" class="hover:text-white transition-colors">Cuaca Tani</a></li>
          <li><a href="/alat/kalkulator-dosis/" class="hover:text-white transition-colors">Kalkulator Dosis</a></li>
          <li><a href="/produk/" class="hover:text-white transition-colors">Katalog Produk</a></li>
        </ul>
      </div>

      <!-- Col 3: Informasi & Legalitas -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Informasi</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/jurnal/" class="hover:text-white transition-colors">Jurnal Tani</a></li>
          <li><a href="/konsultasi/" class="hover:text-white transition-colors">Konsultasi Agronomi</a></li>
          <li><a href="/tentang-kami/" class="hover:text-white transition-colors">Tentang Kami</a></li>
          <li><a href="/kemitraan-distributor/" class="hover:text-white transition-colors">Kemitraan Distributor</a></li>
          <li><a href="/kebijakan-privasi/" class="hover:text-white transition-colors">Kebijakan Privasi</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-white/60 gap-4">
      <div>
        © 2026 PT Agritani Internasional. Hak cipta dilindungi undang-undang.
      </div>
      <div class="flex items-center gap-4">
        <span>Distributor Resmi</span>
        <span aria-hidden="true">·</span>
        <a href="/kebijakan-privasi/" class="hover:text-white transition-colors">Privasi & Data</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }
  footer a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
</style>

