---
/**
 * src/components/TopicSidebar.astro
 * Jurnal hub navigation (DESIGN §4.1 C10, adapted from teagasc.ie sector nav).
 * >=1024px: left sidebar list with topic colour marker; <1024px: wrapping link row.
 */
import { getCollection } from 'astro:content';
import { TOPICS } from '../lib/topics';

interface Props {
  currentTopic?: string;
  currentCommodity?: string;
}

const { currentTopic, currentCommodity } = Astro.props;

const includeDrafts = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;
const articles = (await getCollection('articles')).filter((a) => includeDrafts || !a.data.draft);
const commodities = (await getCollection('commodities'))
  .map((c) => ({
    id: c.id,
    name: c.data.name,
    count: articles.filter((a) => a.data.commodities.some((x: any) => (typeof x === 'string' ? x : x.id) === c.id)).length,
  }))
  .filter((c) => c.count >= 3)
  .sort((a, b) => b.count - a.count);
---

<nav aria-label="Topik dan komoditas Jurnal Tani" class="text-sm">
  <p class="font-bold text-[var(--color-text)] mb-2">Topik</p>
  <ul class="flex flex-wrap gap-x-5 gap-y-1 lg:block lg:border-t lg:border-[var(--color-border)]">
    {TOPICS.map((t) => {
      const active = t.slug === currentTopic;
      return (
        <li class:list={[`topic-${t.slug}`, 'lg:border-b lg:border-[var(--color-border)]']}>
          <a
            href={`/jurnal/topik/${t.slug}/`}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'flex items-center gap-2.5 min-h-[44px] py-2 hover:text-[var(--color-brand-strong)] hover:underline underline-offset-4',
              active ? 'font-bold text-[var(--color-text)]' : 'text-[var(--color-text-muted)]',
            ]}
          >
            <span class="w-2 h-2 shrink-0 bg-[var(--topic)]" aria-hidden="true"></span>
            {t.name}
          </a>
        </li>
      );
    })}
  </ul>

  {commodities.length > 0 && (
    <>
      <p class="font-bold text-[var(--color-text)] mt-6 mb-2">Komoditas</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-1 lg:block lg:border-t lg:border-[var(--color-border)]">
        {commodities.map((c) => {
          const active = c.id === currentCommodity;
          return (
            <li class="lg:border-b lg:border-[var(--color-border)]">
              <a
                href={`/jurnal/komoditas/${c.id}/`}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex items-center justify-between gap-3 min-h-[44px] py-2 hover:text-[var(--color-brand-strong)] hover:underline underline-offset-4',
                  active ? 'font-bold text-[var(--color-text)]' : 'text-[var(--color-text-muted)]',
                ]}
              >
                <span>{c.name}</span>
                <span class="tabular-nums text-xs">{c.count}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </>
  )}
</nav>
