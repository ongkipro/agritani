---
/**
 * src/components/TopicSidebar.astro
 * Jurnal hub navigation (DESIGN §4.1 C10, adapted from teagasc.ie sector nav).
 * >=1024px: left sidebar list with topic colour marker; <1024px: wrapping link row.
 */
import { getCollection } from 'astro:content';
import { TOPICS } from '../lib/topics';

interface Props {
  currentTopic?: string;
  currentCommodity?: string;
}

const { currentTopic, currentCommodity } = Astro.props;

const includeDrafts = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;
const articles = (await getCollection('articles')).filter((a) => includeDrafts || !a.data.draft);
const commodities = (await getCollection('commodities'))
  .map((c) => ({
    id: c.id,
    name: c.data.name,
    count: articles.filter((a) => a.data.commodities.some((x: any) => (typeof x === 'string' ? x : x.id) === c.id)).length,
  }))
  .filter((c) => c.count >= 3)
  .sort((a, b) => b.count - a.count);

// Collapsed sidebar fits a 700px-tall viewport without scrolling: top 5 visible, the rest behind a disclosure (open when the current one is inside).
const primary = commodities.slice(0, 5);
const rest = commodities.slice(primary.length);
const restOpen = rest.some((c) => c.id === currentCommodity);
---

<nav aria-label="Topik dan komoditas Jurnal Tani" class="text-sm space-y-8 lg:pr-2 lg:[&:has(details[open])]:max-h-[calc(100vh-3rem)] lg:[&:has(details[open])]:overflow-y-auto">
  <div>
    <h2 class="font-serif text-base font-semibold text-[var(--color-text)] pb-2 border-b border-[var(--color-border)]">Topik</h2>
    <ul class="divide-y divide-[var(--color-border)]">
      {TOPICS.map((t) => {
        const active = t.slug === currentTopic;
        return (
          <li class={`topic-${t.slug}`}>
            <a
              href={`/jurnal/topik/${t.slug}/`}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex items-center gap-2.5 min-h-[44px] py-2 transition-colors',
                active ? 'font-semibold text-[var(--color-brand-strong)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)]',
              ]}
            >
              <span class="w-2 h-2 rounded-[2px] shrink-0 bg-[var(--topic)]" aria-hidden="true"></span>
              <span>{t.name}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>

  {commodities.length > 0 && (
    <div>
      <h2 class="font-serif text-base font-semibold text-[var(--color-text)] pb-2 border-b border-[var(--color-border)]">Komoditas</h2>
      <ul class="divide-y divide-[var(--color-border)]">
        {primary.map((c) => (
          <li>
            <a
              href={`/jurnal/komoditas/${c.id}/`}
              aria-current={c.id === currentCommodity ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between gap-3 min-h-[44px] py-2 transition-colors',
                c.id === currentCommodity ? 'font-semibold text-[var(--color-brand-strong)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)]',
              ]}
            >
              <span>{c.name}</span>
              <span class="text-xs tabular-nums text-[var(--color-text-muted)]">{c.count}</span>
            </a>
          </li>
        ))}
      </ul>
      {rest.length > 0 && (
        <details class="group border-t border-[var(--color-border)]" open={restOpen}>
          <summary class="flex items-center justify-between min-h-[44px] py-2 cursor-pointer list-none text-[var(--color-brand-strong)] font-semibold">
            <span class="group-open:hidden">Lihat {rest.length} komoditas lain</span>
            <span class="hidden group-open:inline">Sembunyikan</span>
          </summary>
          <ul class="divide-y divide-[var(--color-border)]">
            {rest.map((c) => (
              <li>
                <a
                  href={`/jurnal/komoditas/${c.id}/`}
                  aria-current={c.id === currentCommodity ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between gap-3 min-h-[44px] py-2 transition-colors',
                    c.id === currentCommodity ? 'font-semibold text-[var(--color-brand-strong)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-brand-strong)]',
                  ]}
                >
                  <span>{c.name}</span>
                  <span class="text-xs tabular-nums text-[var(--color-text-muted)]">{c.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  )}
</nav>
