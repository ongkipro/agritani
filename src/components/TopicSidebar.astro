---
/**
 * src/components/TopicSidebar.astro
 * Jurnal hub navigation (DESIGN §4.1 C10, adapted from teagasc.ie sector nav).
 * >=1024px: left sidebar list with topic colour marker; <1024px: wrapping link row.
 */
import { getCollection } from 'astro:content';
import { TOPICS } from '../lib/topics';

interface Props {
  currentTopic?: string;
  currentCommodity?: string;
}

const { currentTopic, currentCommodity } = Astro.props;

const includeDrafts = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;
const articles = (await getCollection('articles')).filter((a) => includeDrafts || !a.data.draft);
const commodities = (await getCollection('commodities'))
  .map((c) => ({
    id: c.id,
    name: c.data.name,
    count: articles.filter((a) => a.data.commodities.some((x: any) => (typeof x === 'string' ? x : x.id) === c.id)).length,
  }))
  .filter((c) => c.count >= 3)
  .sort((a, b) => b.count - a.count);
---

<nav aria-label="Topik dan komoditas Jurnal Tani" class="text-sm space-y-6">
  <div>
    <div class="flex items-center justify-between pb-2 mb-1 border-b border-[var(--color-border)]">
      <h3 class="text-xs font-extrabold uppercase tracking-wider text-[var(--color-brand-strong)]">
        Sektor Keilmuan
      </h3>
      <span class="text-[10px] font-bold text-[var(--color-soil)]">
        6 Topik
      </span>
    </div>
    <ul class="divide-y divide-[var(--color-border)]">
      {TOPICS.map((t) => {
        const active = t.slug === currentTopic;
        return (
          <li class={`topic-${t.slug}`}>
            <a
              href={`/jurnal/topik/${t.slug}/`}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between min-h-[40px] py-2 px-2 -mx-2 rounded-[2px] transition-colors',
                active
                  ? 'bg-[var(--color-tint)] font-bold text-[var(--color-brand-strong)] border-l-2 border-[var(--color-brand)]'
                  : 'text-[var(--color-text)] hover:bg-[var(--color-canvas)] hover:text-[var(--color-brand-strong)]',
              ]}
            >
              <span class="flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full shrink-0 bg-[var(--topic)]" aria-hidden="true"></span>
                <span>{t.name}</span>
              </span>
              <span class="text-xs text-[var(--color-border-control)]" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>

  {commodities.length > 0 && (
    <div>
      <div class="flex items-center justify-between pb-2 mb-3 border-b border-[var(--color-border)]">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-[var(--color-brand-strong)]">
          Rujukan Komoditas
        </h3>
        <span class="text-[10px] font-bold text-[var(--color-soil)]">
          {commodities.length} Komoditas
        </span>
      </div>
      <div class="flex flex-wrap gap-1.5">
        {commodities.map((c) => {
          const active = c.id === currentCommodity;
          return (
            <a
              href={`/jurnal/komoditas/${c.id}/`}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-[2px] text-xs font-medium transition-colors border min-h-[34px]',
                active
                  ? 'bg-[var(--color-brand)] text-white border-[var(--color-brand)] font-bold shadow-2xs'
                  : 'bg-[var(--color-canvas)] text-[var(--color-text)] border-[var(--color-border)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)]',
              ]}
            >
              <span>{c.name}</span>
              <span
                class:list={[
                  'text-[10px] tabular-nums font-semibold px-1 py-0.2 rounded-[2px]',
                  active ? 'bg-white/20 text-white' : 'bg-[var(--color-tint)] text-[var(--color-soil)]',
                ]}
              >
                {c.count}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  )}
</nav>
