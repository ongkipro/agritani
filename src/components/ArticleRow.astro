---
import { topicName } from '../lib/topics';
import { getReadingTime } from '../lib/reading-time';

interface Props {
  article: {
    id: string;
    body?: string;
    data: {
      title: string;
      slug: string;
      description: string;
      pubDate: Date;
      topic: string;
      commodities: Array<string | { id: string }>;
      draft?: boolean;
    };
  };
}

const { article } = Astro.props;
const readingTime = getReadingTime(article.body || '');

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date(article.data.pubDate));
---

<article class="py-5 border-b border-[var(--color-border)] last:border-b-0">
  <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--color-soil)] font-medium mb-1.5">
    <a
      href={`/jurnal/topik/${article.data.topic}/`}
      class={`topic-${article.data.topic} inline-flex items-center gap-1.5 min-h-[44px] hover:underline focus-visible:outline-2 focus-visible:outline-[var(--color-harvest)]`}
    >
      <span class="w-2 h-2 bg-[var(--topic)]" aria-hidden="true"></span>
      {topicName(article.data.topic)}
    </a>
    <span aria-hidden="true">·</span>
    <span>{readingTime.text}</span>
    <span aria-hidden="true">·</span>
    <time datetime={new Date(article.data.pubDate).toISOString()}>
      {formattedDate}
    </time>
    {article.data.draft && (
      <span class="ml-2 px-1.5 py-0.5 rounded-[2px] bg-[var(--color-tint)] text-[var(--color-soil)] text-[11px] font-semibold">
        Draf
      </span>
    )}
  </div>

  <h2 class="text-xl sm:text-2xl font-serif font-semibold text-[var(--color-text)] mb-2 leading-snug">
    <a
      href={`/jurnal/${article.data.slug}/`}
      class="hover:text-[var(--color-brand-strong)] hover:underline min-h-[44px] flex items-center"
    >
      {article.data.title}
    </a>
  </h2>

  <p class="text-sm sm:text-base text-[var(--color-text-muted)] line-clamp-2 leading-relaxed">
    {article.data.description}
  </p>
</article>
