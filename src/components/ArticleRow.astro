---
import { Picture } from 'astro:assets';
import { topicName } from '../lib/topics';
import { getReadingTime } from '../lib/reading-time';
import { getTopicImage } from '../lib/topic-images';

interface Props {
  article: {
    id: string;
    body?: string;
    data: {
      title: string;
      slug: string;
      description: string;
      pubDate: Date;
      topic: string;
      commodities: Array<string | { id: string }>;
      draft?: boolean;
    };
  };
}

const { article } = Astro.props;
const readingTime = getReadingTime(article.body || '');

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date(article.data.pubDate));
---

<article class="py-5 sm:py-6 flex flex-col sm:flex-row gap-5 sm:gap-6 items-start group">
  <a
    href={`/jurnal/${article.data.slug}/`}
    class="w-full sm:w-44 md:w-52 aspect-[16/10] rounded-[2px] overflow-hidden shrink-0 bg-[var(--color-canvas)] block"
    tabindex="-1"
    aria-hidden="true"
  >
    <Picture
      src={getTopicImage(article.data.topic)}
      formats={['webp']}
      widths={[240, 420]}
      sizes="(min-width: 640px) 13rem, 100vw"
      quality={70}
      alt={`Ilustrasi ${article.data.title}`}
      class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      loading="lazy"
    />
  </a>
  <div class="flex-1 min-w-0">
    <div class="flex flex-wrap items-center gap-2 text-xs text-[var(--color-soil)] font-medium mb-1.5">
      <a
        href={`/jurnal/topik/${article.data.topic}/`}
        class={`topic-${article.data.topic} topic-link focus-visible:outline-2 focus-visible:outline-[var(--color-harvest)]`}
      >
        <span class="topic-marker" aria-hidden="true"></span>
        <span>{topicName(article.data.topic)}</span>
      </a>
      <span aria-hidden="true">&middot;</span>
      <span>{readingTime.text}</span>
      <span aria-hidden="true">&middot;</span>
      <time datetime={new Date(article.data.pubDate).toISOString()}>
        {formattedDate}
      </time>
      {article.data.draft && (
        <span class="ml-2 px-1.5 py-0.5 rounded-[2px] bg-[var(--color-tint)] text-[var(--color-soil)] text-[11px] font-semibold">
          Draf
        </span>
      )}
    </div>

    <h2 class="text-lg sm:text-xl font-serif font-bold text-[var(--color-text)] mb-2 leading-snug">
      <a
        href={`/jurnal/${article.data.slug}/`}
        class="group-hover:text-[var(--color-brand-strong)] group-hover:underline group-hover:decoration-[var(--color-brand)]/40 group-hover:decoration-2 group-hover:underline-offset-4 transition-all duration-200 inline-block py-0.5"
      >
        {article.data.title}
      </a>
    </h2>

    <p class="text-sm sm:text-base text-[var(--color-text-muted)] line-clamp-2 leading-relaxed">
      {article.data.description}
    </p>

    <div class="mt-2">
      <a
        href={`/jurnal/${article.data.slug}/`}
        class="link-more text-xs"
        tabindex="-1"
        aria-hidden="true"
      >
        Baca telaah agronomi &rarr;
      </a>
    </div>
  </div>
</article>
