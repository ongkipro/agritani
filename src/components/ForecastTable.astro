---
/**
 * src/components/ForecastTable.astro
 * 3-day / 3-hour BMKG weather forecast table with spray suitability indicator (REQ-10, DESIGN §2.6.2).
 * Direct browser client execution, skeleton loading, offline retry, and field consultation prompt.
 */
import fs from 'node:fs';
import path from 'node:path';
import ConsultPrompt from './ConsultPrompt.astro';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { externalLink } from '../lib/links';
import type { SprayThresholds } from '../lib/spray-window';

const refLink = externalLink('reference');

// Load spray thresholds at build time (ARCHITECTURE §5b)
let thresholds: SprayThresholds = null;
try {
  const threshPath = path.resolve('src/data/spray-thresholds.json');
  if (fs.existsSync(threshPath)) {
    const raw = fs.readFileSync(threshPath, 'utf-8').trim();
    thresholds = raw ? JSON.parse(raw) : null;
  }
} catch {
  thresholds = null;
}
---

<section id="forecast-table-root" class="space-y-6" data-thresholds={JSON.stringify(thresholds)}>

  <!-- Initial Placeholder State: Contextual Field Intelligence (Before Location Selection) -->
  <div id="forecast-initial" class="card p-6 sm:p-8 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px]">
    <div class="max-w-[64ch] space-y-3">
      <h2 class="font-serif text-xl sm:text-2xl font-bold text-[var(--color-text)] tracking-tight">
        Integrasi Data Resmi BMKG Tingkat Tapak Desa
      </h2>
      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
        Prakiraan cuaca diambil langsung dari server BMKG Republik Indonesia secara real-time tanpa perantara. Tentukan lokasi lahan Anda pada formulir di atas untuk memantau indikator penting agronomi lapangan:
      </p>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-xs sm:text-sm text-[var(--color-text)]">
        <li class="flex items-start gap-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] mt-1.5 shrink-0" aria-hidden="true"></span>
          <span><strong>Prakiraan Hujan 3 Jam:</strong> Menghindari risiko pencucian bahan aktif pupuk dan pestisida oleh hujan.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] mt-1.5 shrink-0" aria-hidden="true"></span>
          <span><strong>Kecepatan &amp; Arah Angin:</strong> Mencegah semprotan melayang (drift) keluar dari target gulma atau hama.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] mt-1.5 shrink-0" aria-hidden="true"></span>
          <span><strong>Suhu Udara Maksimum:</strong> Mengoptimalkan waktu bukaan stomata tanaman saat aplikasi foliar.</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] mt-1.5 shrink-0" aria-hidden="true"></span>
          <span><strong>Kelembapan Relatif:</strong> Mengantisipasi kondisi mikro lembap pemicu infeksi spora jamur patogen.</span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Loading State (Skeleton Rows, without full-screen spinner per DESIGN §2.6.2) -->
  <div id="forecast-loading" class="hidden space-y-4 animate-pulse" aria-hidden="true">
    <div class="h-7 bg-[var(--color-border)] rounded-[2px] w-1/3"></div>
    <div class="h-4 bg-[var(--color-border)] rounded-[2px] w-1/2"></div>
    <div class="space-y-2 pt-2">
      <div class="h-10 bg-[var(--color-tint)] rounded-[2px] w-full"></div>
      <div class="h-10 bg-[var(--color-tint)] rounded-[2px] w-full"></div>
      <div class="h-10 bg-[var(--color-tint)] rounded-[2px] w-full"></div>
      <div class="h-10 bg-[var(--color-tint)] rounded-[2px] w-full"></div>
    </div>
  </div>

  <!-- Error / Offline State -->
  <div id="forecast-error" class="hidden max-w-[60ch] space-y-3">
    <h2 class="font-serif text-xl font-semibold text-[var(--color-brand-strong)]">Prakiraan BMKG belum dapat dimuat</h2>
    <p id="error-message-text" class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
      Gagal menghubungi layanan BMKG. Pastikan sinyal internet aktif atau coba beberapa saat lagi.
    </p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <button
        type="button"
        id="btn-retry-bmkg"
        class="inline-flex items-center px-5 py-2 min-h-[44px] text-sm font-semibold rounded-[2px] bg-[var(--color-brand)] !text-white hover:bg-[var(--color-brand-hover)] transition-colors cursor-pointer"
      >
        Coba lagi
      </button>
      <a
        href="https://www.bmkg.go.id/cuaca/prakiraan-cuaca.bmkg"
        target={refLink.target}
        rel={refLink.rel}
        class="link-more min-h-[44px]"
      >
        <span>Buka web resmi BMKG</span>
        <ExternalLinkIcon />
        <span class="sr-only"> {refLink.tabNotice}</span>
      </a>
    </div>
  </div>

  <!-- Results Content Area (ARIA Live) -->
  <div id="forecast-results" aria-live="polite" class="hidden space-y-8 w-full">

    <!-- Location & Metadata Header -->
    <div class="space-y-4 pb-3 border-b border-[var(--color-border)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-x-6 gap-y-3">
        <div>
          <h2 id="result-location-title" class="font-serif text-2xl sm:text-3xl font-bold text-[var(--color-text)] tracking-tight mb-1">
            Desa / Kelurahan
          </h2>
          <p id="result-location-sub" class="text-sm text-[var(--color-soil)] font-semibold"></p>
        </div>
        <div class="text-left sm:text-right tabular-nums text-xs text-[var(--color-text-muted)] space-y-0.5">
          <div id="result-analysis-time" class="font-semibold text-[var(--color-text)]">Diperbarui BMKG: -</div>
          <div id="result-coords"></div>
        </div>
      </div>

      <!-- Stale Data Warning (> 24 hours per DESIGN §2.6.2) -->
      <p id="stale-warning-banner" class="hidden px-4 py-3 bg-[var(--color-harvest-tint)] rounded-[2px] text-sm text-[var(--color-soil)]">
        <strong>Perhatian:</strong> Data analisis BMKG ini berumur lebih dari 24 jam. Kondisi cuaca lokal di lapangan mungkin telah mengalami perubahan.
      </p>

      <!-- Spray Summary (Displayed only when thresholds are reviewed) -->
      <p id="spray-summary-banner" class="hidden px-4 py-3 bg-[var(--color-tint)] rounded-[2px] text-sm">
        <span class="font-semibold text-[var(--color-brand-strong)]" id="spray-summary-text"></span>
      </p>
    </div>

    <!-- Current-conditions card: nearest 3-hour slot + today's range (one card, plain definition list) -->
    <div id="forecast-current-hero" class="hidden">
    </div>

    <!-- Daily Forecast Tables Container -->
    <div id="daily-tables-container" class="space-y-8">
    </div>

    <!-- Mandatory BMKG Attribution (DEC-014, DESIGN §2.6.2) -->
    <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-[68ch]">
      <strong class="text-[var(--color-text)]">Sumber data:</strong> BMKG (Badan Meteorologi, Klimatologi, dan Geofisika) Republik Indonesia melalui API Terbuka.
      <a
        href="https://www.bmkg.go.id/"
        target={refLink.target}
        rel={refLink.rel}
        class="inline-flex items-center gap-1 min-h-[44px] font-semibold text-[var(--color-brand-strong)] underline hover:text-[var(--color-brand)]"
      >
        <span>Kunjungi situs resmi BMKG</span>
        <ExternalLinkIcon />
        <span class="sr-only"> {refLink.tabNotice}</span>
      </a>
    </p>

    <!-- Exactly One WhatsApp Consultation Prompt per page (DESIGN §2.6.2 & §2.8) -->
    <ConsultPrompt
      source="Web·Cuaca"
      title="Ragu menentukan jadwal semprot atau aplikasi pupuk?"
      description="Kirim nama desa Anda dan diskusikan rencana tindakan lapangan bersama tim agronomi Agritani melalui WhatsApp."
      label="Konsultasi Jadwal Lahan"
      variant="secondary"
    />

  </div>

</section>

<script>
  import { fetchBmkgForecast, formatSlotTime, formatWindDirection, formatAnalysisDate, type ProcessedForecast } from '../lib/bmkg.ts';
  import { sprayWindow, type SprayThresholds } from '../lib/spray-window.ts';

  function initForecastTable() {
    const root = document.getElementById('forecast-table-root');
    if (!root) return;

    let thresholds: SprayThresholds = null;
    try {
      thresholds = JSON.parse(root.dataset.thresholds || 'null');
    } catch {
      thresholds = null;
    }

    const initialCard = document.getElementById('forecast-initial');
    const loadingCard = document.getElementById('forecast-loading');
    const errorCard = document.getElementById('forecast-error');
    const errorMessageText = document.getElementById('error-message-text');
    const resultsContainer = document.getElementById('forecast-results');
    const btnRetry = document.getElementById('btn-retry-bmkg');

    const currentHeroContainer = document.getElementById('forecast-current-hero');
    const locationTitle = document.getElementById('result-location-title');
    const locationSub = document.getElementById('result-location-sub');
    const analysisTimeEl = document.getElementById('result-analysis-time');
    const coordsEl = document.getElementById('result-coords');
    const staleBanner = document.getElementById('stale-warning-banner');
    const sprayBanner = document.getElementById('spray-summary-banner');
    const spraySummaryText = document.getElementById('spray-summary-text');
    const dailyTablesContainer = document.getElementById('daily-tables-container');

    // BMKG strings are data, never markup: escape before any innerHTML use.
    const esc = (v: unknown) =>
      String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
    // Only BMKG-hosted weather icons (CSP img-src allows api-apps.bmkg.go.id).
    const safeIcon = (url?: string) => (url && /^https:\/\/api-apps\.bmkg\.go\.id\//.test(url) ? url : '');
    // BMKG utc_datetime is "YYYY-MM-DD HH:MM:SS" in UTC; compare in UTC so the "now" slot is right in any browser timezone.
    const slotUtcMs = (sl: { utc_datetime?: string; datetime?: string }) => {
      if (sl.utc_datetime) return Date.parse(sl.utc_datetime.replace(' ', 'T') + 'Z');
      if (sl.datetime && /Z$/.test(sl.datetime)) return Date.parse(sl.datetime);
      return NaN;
    };
    const range = (nums: number[], unit: string) => {
      if (!nums.length) return '';
      const lo = Math.min(...nums);
      const hi = Math.max(...nums);
      return lo === hi ? `${lo}${unit}` : `${lo}–${hi}${unit}`;
    };

    let currentAdm4 = '';
    let currentLabel = '';

    async function loadForecast(adm4: string, label: string) {
      currentAdm4 = adm4;
      currentLabel = label;

      // Update UI states
      initialCard?.classList.add('hidden');
      errorCard?.classList.add('hidden');
      resultsContainer?.classList.add('hidden');
      currentHeroContainer?.classList.add('hidden');
      if (currentHeroContainer) currentHeroContainer.innerHTML = '';
      loadingCard?.classList.remove('hidden');

      try {
        const data = await fetchBmkgForecast(adm4);
        renderForecast(data, label);
      } catch (err: any) {
        loadingCard?.classList.add('hidden');
        errorCard?.classList.remove('hidden');
        if (errorMessageText) {
          errorMessageText.textContent = err.message || 'Gagal memuat prakiraan cuaca dari BMKG.';
        }
      }
    }

    function renderForecast(forecast: ProcessedForecast, customLabel: string) {
      loadingCard?.classList.add('hidden');
      resultsContainer?.classList.remove('hidden');

      const loc = forecast.location;
      if (locationTitle) {
        locationTitle.textContent = loc.desa ? `Desa ${loc.desa}` : customLabel;
      }
      if (locationSub) {
        locationSub.textContent = `Kecamatan ${loc.kecamatan}, ${loc.kotkab}, Provinsi ${loc.provinsi}`;
      }
      if (analysisTimeEl) {
        analysisTimeEl.textContent = forecast.analysisDate
          ? `Diperbarui BMKG: ${formatAnalysisDate(forecast.analysisDate)}`
          : 'Data langsung BMKG';
      }
      if (coordsEl && loc.lat && loc.lon) {
        coordsEl.textContent = `Titik koordinat: ${loc.lat.toFixed(4)}°, ${loc.lon.toFixed(4)}° (${loc.timezone || 'WIB'})`;
      }

      // Stale banner
      if (staleBanner) {
        if (forecast.isStale) {
          staleBanner.classList.remove('hidden');
        } else {
          staleBanner.classList.add('hidden');
        }
      }

      // Check spray recommendation summary for today if thresholds are reviewed
      const hasThresholds = Boolean(thresholds && thresholds.reviewedBy && thresholds.reviewedBy.trim().length > 0);
      if (hasThresholds && forecast.days.length > 0) {
        const todaySlots = forecast.days[0].slots;
        let firstLayakSlot: string | null = null;

        for (let i = 0; i < todaySlots.length; i++) {
          const slot = todaySlots[i];
          const next = todaySlots[i + 1] || null;
          const res = sprayWindow(slot, next, thresholds);
          if (res.status === 'layak') {
            firstLayakSlot = formatSlotTime(slot.local_datetime);
            break;
          }
        }

        if (sprayBanner && spraySummaryText) {
          if (firstLayakSlot) {
            spraySummaryText.textContent = `Rekomendasi semprot hari ini: Waktu kondusif dimulai sekitar pukul ${firstLayakSlot} WIB.`;
            sprayBanner.classList.remove('hidden');
          } else {
            spraySummaryText.textContent = `Kondisi cuaca hari ini kurang kondusif untuk aplikasi semprot (potensi angin/hujan).`;
            sprayBanner.classList.remove('hidden');
          }
        }
      } else if (sprayBanner) {
        sprayBanner.classList.add('hidden');
      }

      // Current-conditions card: the slot closest to now (UTC-based), plus today's ranges
      if (currentHeroContainer && forecast.days.length > 0) {
        const allSlots = forecast.days.flatMap((d) => d.slots);
        let currentSlot = allSlots[0];
        let minDiff = Infinity;
        const nowMs = Date.now();
        for (const sl of allSlots) {
          const ms = slotUtcMs(sl);
          if (Number.isFinite(ms) && Math.abs(ms - nowMs) < minDiff) {
            minDiff = Math.abs(ms - nowMs);
            currentSlot = sl;
          }
        }
        const isNow = minDiff <= 90 * 60 * 1000; // within the 3-hour slot
        const TZ: Record<string, string> = { 'Asia/Jakarta': 'WIB', 'Asia/Pontianak': 'WIB', 'Asia/Makassar': 'WITA', 'Asia/Jayapura': 'WIT' };
        const tz = TZ[loc.timezone] || loc.timezone || 'WIB';
        const todaySlots = forecast.days[0].slots;
        const todayTemps = todaySlots.map((sl) => Number(sl.t)).filter(Number.isFinite);
        const todayHus = todaySlots.map((sl) => Number(sl.hu)).filter(Number.isFinite);
        const todayRain = todaySlots.filter((sl) => Number(sl.tp) > 0);
        const todayRainTotal = Math.round(todayRain.reduce((sum, sl) => sum + Number(sl.tp), 0) * 10) / 10;
        const icon = safeIcon(currentSlot.image);

        currentHeroContainer.innerHTML = `
          <div class="card p-5 sm:p-6 space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4 sm:gap-5">
                ${icon ? `<img src="${esc(icon)}" alt="${esc(`Ikon cuaca ${currentSlot.weather_desc}`)}" width="56" height="56" class="w-14 h-14 sm:w-16 sm:h-16 shrink-0" aria-hidden="true" />` : ''}
                <div>
                  <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-[2px] bg-[var(--color-tint)] text-[var(--color-brand-strong)] text-xs font-semibold mb-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] animate-pulse" aria-hidden="true"></span>
                    <span>${isNow ? 'Perkiraan Saat Ini' : 'Perkiraan Terdekat'} · Pukul ${esc(formatSlotTime(currentSlot.local_datetime))} ${esc(tz)}</span>
                  </div>
                  <div class="flex flex-wrap items-baseline gap-x-3">
                    <span class="font-serif text-3xl sm:text-4xl font-bold text-[var(--color-brand-strong)] tabular-nums">${esc(currentSlot.t)}°C</span>
                    <span class="text-base sm:text-lg font-semibold text-[var(--color-text)]">${esc(currentSlot.weather_desc)}</span>
                  </div>
                </div>
              </div>
            </div>
            <dl class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 pt-5 border-t border-[var(--color-border)]">
              <div class="p-3 sm:p-3.5 bg-[var(--color-canvas)] rounded-[2px] border border-[var(--color-border)] flex flex-col justify-between">
                <dt class="text-xs text-[var(--color-text-muted)] font-medium">Suhu Hari Ini</dt>
                <dd class="mt-1 font-serif text-lg sm:text-xl font-bold text-[var(--color-text)] tabular-nums">${esc(range(todayTemps, '°C') || `${currentSlot.t}°C`)}</dd>
              </div>
              <div class="p-3 sm:p-3.5 bg-[var(--color-canvas)] rounded-[2px] border border-[var(--color-border)] flex flex-col justify-between">
                <dt class="text-xs text-[var(--color-text-muted)] font-medium">Estimasi Hujan</dt>
                <dd class="mt-1 text-sm sm:text-base font-semibold ${todayRainTotal > 0 ? 'text-[var(--color-soil)] font-bold' : 'text-[var(--color-text)]'} tabular-nums">
                  ${todayRain.length ? `${todayRainTotal.toLocaleString('id-ID')} mm` : 'Tanpa Hujan'}
                  ${todayRain.length ? `<span class="block text-xs font-normal text-[var(--color-text-muted)] mt-0.5">Jam ${esc(todayRain.map((sl) => formatSlotTime(sl.local_datetime)).join(', '))}</span>` : ''}
                </dd>
              </div>
              <div class="p-3 sm:p-3.5 bg-[var(--color-canvas)] rounded-[2px] border border-[var(--color-border)] flex flex-col justify-between">
                <dt class="text-xs text-[var(--color-text-muted)] font-medium">Kelembapan Udara</dt>
                <dd class="mt-1 font-serif text-lg sm:text-xl font-bold text-[var(--color-text)] tabular-nums">${esc(currentSlot.hu)}%
                  ${todayHus.length ? `<span class="block font-sans text-xs font-normal text-[var(--color-text-muted)] mt-0.5">Rentang: ${esc(range(todayHus, '%'))}</span>` : ''}
                </dd>
              </div>
              <div class="p-3 sm:p-3.5 bg-[var(--color-canvas)] rounded-[2px] border border-[var(--color-border)] flex flex-col justify-between">
                <dt class="text-xs text-[var(--color-text-muted)] font-medium">Laju Angin</dt>
                <dd class="mt-1 font-serif text-lg sm:text-xl font-bold text-[var(--color-text)] tabular-nums">${esc(currentSlot.ws)} <span class="font-sans text-xs font-normal text-[var(--color-text-muted)]">km/j</span>
                  <span class="block font-sans text-xs font-normal text-[var(--color-text-muted)] mt-0.5">Dari ${esc(formatWindDirection(currentSlot.wd))} (${esc(currentSlot.wd)})</span>
                </dd>
              </div>
            </dl>
          </div>
        `;
        currentHeroContainer.classList.remove('hidden');
      }

      // Render Tables per Day
      if (!dailyTablesContainer) return;
      dailyTablesContainer.innerHTML = '';

      forecast.days.forEach((day, dayIndex) => {
        // One card per day (DESIGN §3.3.3: a tool result is a unit), with a one-line text summary from the BMKG slots.
        const dayCard = document.createElement('div');
        dayCard.className = 'card p-4 sm:p-6 space-y-4';

        // Day Header
        const header = document.createElement('div');
        header.className = 'flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-[var(--color-border)]';
        
        const titleRow = document.createElement('div');
        titleRow.className = 'flex items-center gap-2.5';

        const h3 = document.createElement('h3');
        h3.className = 'font-serif text-lg sm:text-xl font-bold text-[var(--color-brand-strong)]';
        h3.textContent = day.dateStr;
        titleRow.appendChild(h3);

        const badge = document.createElement('span');
        badge.className = 'text-xs font-semibold px-2 py-0.5 rounded-[2px] bg-[var(--color-tint)] text-[var(--color-brand-strong)]';
        badge.textContent = dayIndex === 0 ? 'Hari Ini' : dayIndex === 1 ? 'Besok' : 'Lusa';
        titleRow.appendChild(badge);

        header.appendChild(titleRow);

        const temps = day.slots.map((sl) => Number(sl.t)).filter((n) => Number.isFinite(n));
        const rainSlots = day.slots.filter((sl) => Number(sl.tp) > 0);
        const rainTotal = Math.round(rainSlots.reduce((sum, sl) => sum + Number(sl.tp), 0) * 10) / 10;
        const hus = day.slots.map((sl) => Number(sl.hu)).filter((n) => Number.isFinite(n));
        const wss = day.slots.map((sl) => Number(sl.ws)).filter((n) => Number.isFinite(n));
        const parts = [
          temps.length ? `Suhu ${range(temps, '°C')}` : '',
          rainSlots.length
            ? `hujan ${rainTotal.toLocaleString('id-ID')} mm pada jam ${rainSlots.map((sl) => formatSlotTime(sl.local_datetime)).join(', ')}`
            : 'tanpa hujan',
          hus.length ? `lembap ${range(hus, '%')}` : '',
          wss.length ? `angin maks ${Math.max(...wss).toLocaleString('id-ID')} km/j` : '',
        ].filter(Boolean);
        const line = parts.join(' · ') + '.';
        const summary = document.createElement('p');
        summary.className = 'text-xs sm:text-sm text-[var(--color-text-muted)] tabular-nums';
        summary.textContent = line.charAt(0).toUpperCase() + line.slice(1);
        header.appendChild(summary);

        dayCard.appendChild(header);

        // Responsive Scrollable Table Wrapper (DESIGN §2.6.2)
        const tableWrapper = document.createElement('div');
        tableWrapper.className = 'overflow-x-auto rounded-[2px] border border-[var(--color-border)]';

        const table = document.createElement('table');
        table.className = 'w-full text-left text-xs sm:text-sm border-collapse';

        // Table Head (Jam, Cuaca, Suhu, Hujan always visible; Lembap, Angin visible on md+)
        const thead = document.createElement('thead');
        thead.className = 'bg-[var(--color-canvas)] text-xs text-[var(--color-text-muted)] font-semibold border-b border-[var(--color-border)]';
        thead.innerHTML = `
          <tr>
            <th scope="col" class="py-2.5 sm:py-3 pl-3 pr-2 sm:px-4 font-bold text-[var(--color-text)]">Jam</th>
            <th scope="col" class="py-2.5 sm:py-3 px-2 sm:px-4">Kondisi Cuaca</th>
            <th scope="col" class="py-2.5 sm:py-3 px-2 sm:px-4 text-right">Suhu</th>
            <th scope="col" class="py-2.5 sm:py-3 pl-2 pr-3 sm:px-4 text-right">Hujan</th>
            <th scope="col" class="py-2.5 sm:py-3 px-2 sm:px-4 text-right hidden md:table-cell">Kelembapan</th>
            <th scope="col" class="py-2.5 sm:py-3 px-2 sm:px-4 hidden md:table-cell">Angin</th>
            ${hasThresholds ? '<th scope="col" class="py-2.5 sm:py-3 px-2 sm:px-4">Status Semprot</th>' : ''}
          </tr>
        `;
        table.appendChild(thead);

        // Table Body
        const tbody = document.createElement('tbody');
        tbody.className = 'divide-y divide-[var(--color-border)] tabular-nums bg-[var(--color-surface)]';

        day.slots.forEach((slot, slotIdx) => {
          const nextSlot = day.slots[slotIdx + 1] || null;
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-[var(--color-tint)]/40 transition-colors';

          const timeFormatted = formatSlotTime(slot.local_datetime);
          const windDir = formatWindDirection(slot.wd);

          // Evaluation for spray window (only when thresholds exist)
          let sprayCellHtml = '';
          if (hasThresholds) {
            const sprayRes = sprayWindow(slot, nextSlot, thresholds);
            let badgeClass = 'bg-[var(--color-tint)] text-[var(--color-brand-strong)]';
            let label = 'Layak';
            if (sprayRes.status === 'tunda') {
              badgeClass = 'bg-[var(--color-harvest-tint)] text-[var(--color-soil)] font-bold';
              label = 'Tunda';
            } else if (sprayRes.status === 'hati-hati') {
              badgeClass = 'bg-[var(--color-tint)] text-[var(--color-soil)]';
              label = 'Hati-hati';
            }

            const reasonStr = sprayRes.reasons[0] || '';
            sprayCellHtml = `
              <td class="py-2.5 sm:py-3 px-2 sm:px-4">
                <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-[2px] ${badgeClass}">
                  ${label}
                </span>
                ${reasonStr ? `<span class="block text-xs text-[var(--color-text-muted)] mt-0.5">${esc(reasonStr)}</span>` : ''}
              </td>
            `;
          }

          tr.innerHTML = `
            <td class="py-2.5 sm:py-3 pl-3 pr-2 sm:px-4 font-bold text-[var(--color-text)] whitespace-nowrap">
              ${timeFormatted}
            </td>
            <td class="py-2.5 sm:py-3 px-2 sm:px-4">
              <div class="inline-flex items-center gap-2 font-medium text-[var(--color-text)]">
                ${safeIcon(slot.image) ? `<img src="${esc(safeIcon(slot.image))}" alt="${esc(`Ikon cuaca ${slot.weather_desc}`)}" width="22" height="22" class="w-5 h-5 inline-block shrink-0" aria-hidden="true" />` : ''}
                <span class="whitespace-nowrap font-medium">${esc(slot.weather_desc)}</span>
              </div>
              <div class="block md:hidden text-xs text-[var(--color-text-muted)] tabular-nums mt-1 space-x-1.5">
                <span>Angin ${esc(slot.ws)} km/j (${esc(windDir)})</span>
                <span>·</span>
                <span>Lembap ${esc(slot.hu)}%</span>
              </div>
            </td>
            <td class="py-2.5 sm:py-3 px-2 sm:px-4 text-right font-semibold text-[var(--color-text)] whitespace-nowrap">
              ${esc(slot.t)}°C
            </td>
            <td class="py-2.5 sm:py-3 pl-2 pr-3 sm:px-4 text-right whitespace-nowrap">
              ${Number(slot.tp) > 0 ? `<span class="inline-block px-2 py-0.5 rounded-[2px] bg-[var(--color-harvest-tint)] font-bold text-[var(--color-soil)]">${esc(slot.tp)} mm</span>` : '<span class="text-[var(--color-text-muted)]">0 mm</span>'}
            </td>
            <td class="py-2.5 sm:py-3 px-2 sm:px-4 text-right text-[var(--color-text)] whitespace-nowrap hidden md:table-cell">
              ${esc(slot.hu)}%
            </td>
            <td class="py-2.5 sm:py-3 px-2 sm:px-4 text-[var(--color-text)] whitespace-nowrap hidden md:table-cell">
              <span class="font-medium">${esc(slot.ws)} km/j</span>
              <span class="text-xs text-[var(--color-text-muted)] ml-1">${esc(windDir)} (${esc(slot.wd)})</span>
            </td>
            ${sprayCellHtml}
          `;

          tbody.appendChild(tr);
        });

        table.appendChild(tbody);
        tableWrapper.appendChild(table);
        dayCard.appendChild(tableWrapper);
        dailyTablesContainer.appendChild(dayCard);
      });
    }

    // Listen to Region Picker custom event
    window.addEventListener('agritani:region-selected', ((e: CustomEvent) => {
      const { adm4, label } = e.detail || {};
      if (adm4) {
        loadForecast(adm4, label || adm4);
      }
    }) as EventListener);

    // A selection restored before this listener existed (saved location, fast repeat visit) is picked up here (T-52).
    const pending = (window as unknown as { __agritaniRegion?: { adm4: string; label: string } }).__agritaniRegion;
    if (pending?.adm4 && pending.adm4 !== currentAdm4) {
      loadForecast(pending.adm4, pending.label || pending.adm4);
    }

    // Retry Button Handler
    btnRetry?.addEventListener('click', () => {
      if (currentAdm4) {
        loadForecast(currentAdm4, currentLabel);
      }
    });
  }

  initForecastTable();
  document.addEventListener('astro:page-load', initForecastTable);
</script>
