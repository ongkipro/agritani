---
import AuthorAvatar from './AuthorAvatar.astro';
---

<section class="my-10 pt-8" aria-labelledby="tentang-penulis-heading">
  <h2
    id="tentang-penulis-heading"
    class="text-xl font-bold font-serif mb-4 text-[var(--color-text)]"
  >
    Tentang Penulis
  </h2>
  <div class="flex flex-col sm:flex-row gap-4 items-start">
    <AuthorAvatar size={56} class="w-14 h-14" />
    <div class="flex-1 text-sm leading-relaxed text-[var(--color-text)]">
      <div class="font-bold text-base text-[var(--color-text)] mb-1">
        Arif Prabowo
      </div>
      <p class="text-[var(--color-text-muted)] mb-2">
        Konsultan Pertanian Senior · Pengelola Jurnal Tani
      </p>
      <a
        href="/penulis/arif-prabowo/"
        class="inline-flex items-center text-[var(--color-brand-strong)] font-semibold hover:underline"
      >
        Lihat profil & daftar artikel lengkap
        <span class="ml-1" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
