---
/**
 * src/components/CropTimeline.astro
 * Interactive Crop Calendar & Timeline component (REQ-09, DESIGN §2.6.1, ARCHITECTURE §5b)
 * Clean tap-first workflow, vertical timeline, .ics download, and no-JS fallback.
 */
import { getCollection } from 'astro:content';
import ConsultPrompt from './ConsultPrompt.astro';

const allCalendars = await getCollection('cropCalendars');
const allCommodities = await getCollection('commodities');

const isDraftPreview = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || process.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;

// Filter calendars based on reviewedBy in production mode (ARCHITECTURE §3.1)
const visibleCalendars = allCalendars.filter((cal) => isDraftPreview || Boolean(cal.data.reviewedBy && cal.data.reviewedBy.trim().length > 0));

const commodityMap = new Map(allCommodities.map((c) => [c.id, c.data.name]));

const availableCommodities = visibleCalendars.map((cal) => ({
  id: cal.data.id,
  name: commodityMap.get(cal.data.id) || cal.data.id,
  type: cal.data.type,
})).sort((a, b) => a.name.localeCompare(b.name));

const serializedCalendars = visibleCalendars.map((c) => ({
  id: c.data.id,
  type: c.data.type,
  cycleDays: c.data.cycleDays,
  phases: c.data.phases,
  annualTasks: c.data.annualTasks,
  seasons: c.data.seasons,
  sources: c.data.sources,
  reviewedBy: c.data.reviewedBy || '',
}));

const monthNames = [
  'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
  'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
];
---

<div id="crop-calendar-root" class="space-y-14" data-calendars={JSON.stringify(serializedCalendars)}>

  <!-- Input Form -->
  <div class="space-y-10">
    
    <!-- Step 1: Pilih Komoditas -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <h2 class="section-title !mb-0"><label for="select-crop-commodity">Pilih komoditas tanaman</label></h2>
        <span class="text-sm text-[var(--color-text-muted)] tabular-nums">
          {availableCommodities.length} komoditas terdaftar
        </span>
      </div>

      <!-- Quick Button Chips (Tap-first) -->
      <div class="flex flex-wrap gap-2" id="group-crop-commodity" role="radiogroup" aria-label="Pilih Komoditas">
        {availableCommodities.map((comm) => (
          <button
            type="button"
            role="radio"
            aria-checked="false"
            data-commodity={comm.id}
            data-crop-type={comm.type}
            class="crop-comm-btn px-4 py-2.5 min-h-[44px] text-xs sm:text-sm font-bold border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] text-[var(--color-text)] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] transition-all cursor-pointer inline-flex items-center gap-2"
          >
            <span class="w-1.5 h-1.5 rounded-[2px] bg-[var(--color-border-control)] comm-dot transition-colors" aria-hidden="true"></span>
            <span>{comm.name}</span>
          </button>
        ))}
      </div>

      <!-- Preserved for screen readers / automated tests -->
      <select id="select-crop-commodity" class="sr-only" tabindex="-1" aria-hidden="true">
        {availableCommodities.map((comm) => (
          <option value={comm.id}>{comm.name} ({comm.type === 'semusim' ? 'Semusim' : 'Tahunan'})</option>
        ))}
      </select>
    </div>

    <!-- Step 2: Tanggal Tanam / Pindah Tanam (Shadcn Date Picker Pattern) -->
    <div id="section-plant-date" class="space-y-4">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <h2 class="section-title !mb-0"><label for="input-plant-date">Tanggal tanam atau pindah tanam</label></h2>
        <span id="label-date-mode" class="text-sm font-semibold text-[var(--color-brand-strong)] tabular-nums">
          Hari Ini · 0 HST
        </span>
      </div>

      <!-- Styled Date Input Trigger with Calendar Icon & Actions -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <div class="relative max-w-sm flex-1 group">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-[var(--color-brand)] group-focus-within:text-[var(--color-brand-strong)] transition-colors" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
              <line x1="16" x2="16" y1="2" y2="6"/>
              <line x1="8" x2="8" y1="2" y2="6"/>
              <line x1="3" x2="21" y1="10" y2="10"/>
            </svg>
          </div>
          <input
            type="date"
            id="input-plant-date"
            class="w-full appearance-none pl-10 pr-9 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] font-semibold border border-[var(--color-border-control)] rounded-[2px] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] focus:border-transparent text-sm cursor-pointer transition-colors"
          />
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-[var(--color-soil)]" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 8 4 4 4-4"/>
            </svg>
          </div>
        </div>

        <button
          type="button"
          id="btn-set-today"
          class="px-4 py-2.5 min-h-[44px] text-xs font-bold border border-[var(--color-border-control)] bg-[var(--color-surface)] hover:bg-[var(--color-tint)] hover:border-[var(--color-brand)] text-[var(--color-brand-strong)] rounded-[2px] transition-colors shrink-0 cursor-pointer inline-flex items-center justify-center gap-1.5"
        >
          <span>Set Hari Ini</span>
        </button>
      </div>

      <!-- Quick Date Presets (Agricultural Shortcuts) -->
      <div class="space-y-1.5 pt-1">
        <span class="text-sm font-semibold text-[var(--color-text-muted)] block">
          Pintasan umur tanam atau rencana:
        </span>
        <div class="flex flex-wrap gap-2" id="date-presets-container">
          <button
            type="button"
            data-days="0"
            class="date-preset-btn px-3.5 py-2 min-h-[44px] text-xs font-medium rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-all cursor-pointer"
          >
            Hari Ini (0 HST)
          </button>
          <button
            type="button"
            data-days="-7"
            class="date-preset-btn px-3.5 py-2 min-h-[44px] text-xs font-medium rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-all cursor-pointer"
          >
            7 Hari Lalu (1 Mgg)
          </button>
          <button
            type="button"
            data-days="-14"
            class="date-preset-btn px-3.5 py-2 min-h-[44px] text-xs font-medium rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-all cursor-pointer"
          >
            14 Hari Lalu (2 Mgg)
          </button>
          <button
            type="button"
            data-days="-30"
            class="date-preset-btn px-3.5 py-2 min-h-[44px] text-xs font-medium rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-all cursor-pointer"
          >
            30 Hari Lalu (1 Bln)
          </button>
          <button
            type="button"
            data-days="-45"
            class="date-preset-btn px-3.5 py-2 min-h-[44px] text-xs font-medium rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-all cursor-pointer"
          >
            45 Hari Lalu
          </button>
          <button
            type="button"
            data-days="30"
            class="date-preset-btn px-3.5 py-2 min-h-[44px] text-xs font-medium rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-all cursor-pointer"
          >
            +30 Hari (Rencana)
          </button>
        </div>
      </div>

      <!-- Humanized Context Status Banner -->
      <div id="date-context-banner" class="px-4 py-3 bg-[var(--color-tint)] rounded-[2px] flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm">
        <span id="date-context-text" class="font-medium text-[var(--color-text)]">
          Memuat tanggal acuan...
        </span>
        <span id="date-season-badge" class="font-semibold text-[var(--color-soil)] tabular-nums"></span>
      </div>
    </div>

  </div>

  <!-- Results Section (ARIA Live) -->
  <section id="calendar-results" aria-live="polite" class="space-y-12 hidden">

    <!-- The single results panel (Rencana Tanam Saya) -->
    <div class="p-5 sm:p-7 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 id="plan-title" class="section-title !mb-1">
            Rencana Tanam Saya
          </h2>
          <p id="plan-subtitle" class="text-sm text-[var(--color-text-muted)]"></p>
        </div>
        <div id="plan-badge-container">
          <!-- Dynamic review/draft badge -->
        </div>
      </div>

      <!-- Semusim Status Indicators -->
      <div id="semusim-summary-box" class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="space-y-1">
          <p class="text-sm font-semibold text-[var(--color-soil)]">Status pertumbuhan</p>
          <p id="summary-hst" class="text-2xl font-extrabold text-[var(--color-brand)] tabular-nums"></p>
          <p id="summary-phase-name" class="text-sm text-[var(--color-text-muted)]"></p>
        </div>
        <div class="space-y-1">
          <p class="text-sm font-semibold text-[var(--color-soil)]">Perkiraan panen</p>
          <p id="summary-harvest-range" class="text-2xl font-extrabold text-[var(--color-text)] tabular-nums"></p>
          <p class="text-sm text-[var(--color-text-muted)]">Bergantung pada varietas dan cuaca lokal</p>
        </div>
      </div>

      <!-- Action Buttons Row (DESIGN §2.6.1) -->
      <div class="flex flex-wrap items-center gap-x-3 gap-y-3">
        <button
          type="button"
          id="btn-save-ics"
          class="inline-flex items-center px-5 py-2 min-h-[44px] text-sm font-semibold rounded-[2px] bg-[var(--color-brand)] text-white hover:bg-[var(--color-brand-hover)] transition-colors cursor-pointer"
        >
          Simpan ke kalender HP (.ics)
        </button>

        <button
          type="button"
          id="btn-print-schedule"
          class="inline-flex items-center px-4 py-2 min-h-[44px] text-sm font-semibold rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] text-[var(--color-text)] hover:border-[var(--color-brand)] transition-colors cursor-pointer"
        >
          Cetak jadwal
        </button>

        <button
          type="button"
          id="btn-share-schedule"
          class="inline-flex items-center px-4 py-2 min-h-[44px] text-sm font-semibold rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] text-[var(--color-text)] hover:border-[var(--color-brand)] transition-colors cursor-pointer"
        >
          Bagikan
        </button>

        <a href="/alat/cuaca-tani/" class="link-more min-h-[44px] sm:ml-3">Cek Cuaca Tani &rarr;</a>
      </div>
      <p id="share-feedback" class="text-xs text-[var(--color-brand-strong)] font-semibold hidden"></p>
    </div>

    <!-- Vertical Timeline Container (Semusim) -->
    <div id="timeline-container">
      <h3 class="section-title">
        Tahapan fase tanam dan rencana lapangan
      </h3>
      <div id="phases-list" class="divide-y divide-[var(--color-border)]">
        <!-- Rendered by client script -->
      </div>
    </div>

    <!-- Annual Tasks Container (Kelapa Sawit) -->
    <div id="annual-tasks-container" class="hidden">
      <h3 class="section-title">
        Pola pemeliharaan dan rotasi panen 12 bulan
      </h3>
      <div id="annual-tasks-list" class="divide-y divide-[var(--color-border)]">
        <!-- Rendered by client script -->
      </div>
    </div>

    <!-- Musim Tanam Nasional MT1 - MT3 (DESIGN §2.6.1) -->
    <div id="national-seasons-container" class="space-y-4">
      <div class="max-w-[68ch]">
        <h3 id="seasons-heading" class="section-title !mb-2">
          Musim tanam nasional
        </h3>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          Jadwal rata-rata nasional — waktu pelaksanaan di lapangan dapat bervariasi sesuai curah hujan wilayah dan ketersediaan air irigasi setempat.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs sm:text-sm text-left border-collapse">
          <thead>
            <tr class="border-b border-[var(--color-border-control)] text-[var(--color-text-muted)] font-semibold">
              <th scope="col" class="py-2.5 pr-3">Pola musim</th>
              <th scope="col" class="py-2.5 px-3">Bulan tanam</th>
              <th scope="col" class="py-2.5 pl-3">Bulan panen</th>
            </tr>
          </thead>
          <tbody id="seasons-table-body" class="divide-y divide-[var(--color-border)]">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- About this Data & Credibility -->
    <div class="max-w-[68ch] space-y-2 text-sm text-[var(--color-text-muted)]">
      <h3 class="font-serif text-lg font-semibold text-[var(--color-brand-strong)]">
        Tentang sumber data dan acuan agronomi
      </h3>
      <p id="sources-info" class="leading-relaxed"></p>
      <p id="reviewed-info" class="leading-relaxed tabular-nums"></p>
    </div>

    <!-- Single WhatsApp Consultation Prompt (DESIGN §2.6.1 & §2.8) -->
    <div>
      <ConsultPrompt
        source="[Web·Kalender]"
        title="Butuh penyesuaian jadwal tanam untuk kondisi cuaca daerah Anda?"
        description="Konsultasikan waktu tanam, kebutuhan varietas, dan antisipasi musim bersama tim agronomi Agritani melalui WhatsApp."
        label="Konsultasi Jadwal Tanam"
        variant="secondary"
      />
    </div>

  </section>

  <!-- Static No-JS Fallback: Full National Cropping Calendars (DESIGN §2.6.1) -->
  <noscript>
    <div class="space-y-8">
      <div class="max-w-[68ch]">
        <h2 class="section-title !mb-2">
          Musim tanam nasional komoditas (mode tanpa JavaScript)
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          Peramban Anda menjalankan mode statis. Anda dapat langsung melihat pola musim tanam nasional dan siklus fase budidaya komoditas di bawah ini:
        </p>
      </div>

      <div class="space-y-8">
        {visibleCalendars.map((cal) => {
          const commName = commodityMap.get(cal.data.id) || cal.data.id;
          return (
            <div class="space-y-4">
              <h3 class="font-serif text-xl font-semibold text-[var(--color-brand-strong)]">
                <span>{commName} ({cal.data.type === 'semusim' ? `Siklus ${cal.data.cycleDays?.min}–${cal.data.cycleDays?.max} hari` : 'Tanaman Tahunan'})</span>
              </h3>

              <!-- Seasons Table -->
              <div class="overflow-x-auto">
                <table class="w-full text-sm text-left border-collapse">
                  <thead>
                    <tr class="border-b border-[var(--color-border-control)] text-[var(--color-text-muted)] font-semibold">
                      <th class="py-2 pr-3">Musim</th>
                      <th class="py-2 px-3">Bulan tanam</th>
                      <th class="py-2 pl-3">Bulan panen</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cal.data.seasons.map((s) => (
                      <tr class="border-b border-[var(--color-border)]">
                        <td class="py-2 pr-3 font-semibold">{s.code} ({s.label})</td>
                        <td class="py-2 px-3">{s.plantMonths.map((m) => monthNames[m - 1]).join(', ')}</td>
                        <td class="py-2 pl-3">{s.harvestMonths.map((m) => monthNames[m - 1]).join(', ')}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <!-- Phases List (Semusim) -->
              {cal.data.type === 'semusim' && (
                <div class="space-y-2">
                  <h4 class="text-sm font-semibold text-[var(--color-text)]">Tahapan fase budidaya</h4>
                  <div class="divide-y divide-[var(--color-border)]">
                    {cal.data.phases.map((p) => (
                      <div class="py-3 space-y-1">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-3 text-sm font-semibold text-[var(--color-brand-strong)]">
                          <span>{p.name}</span>
                          <span class="tabular-nums">HST {p.startDay}–{p.endDay}</span>
                        </div>
                        <ul class="text-sm text-[var(--color-text)] list-disc pl-5 space-y-0.5">
                          {p.activities.map((act) => (
                            <li>{act}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </noscript>

</div>

<script>
  import { calculateCropPlan } from '../lib/crop-calendar.ts';
  import type { CropCalendarEntry, CropPlanResult } from '../lib/crop-calendar.ts';
  import { generateCropCalendarIcs } from '../lib/ics.ts';

  const monthNamesId = [
    'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
    'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
  ];

  function initCropCalendar() {
    const root = document.getElementById('crop-calendar-root');
    if (!root) return;

    let calendars: CropCalendarEntry[] = [];
    try {
      calendars = JSON.parse(root.dataset.calendars || '[]');
    } catch {
      calendars = [];
    }

    const commodityBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.crop-comm-btn'));
    const selectCropCommodity = document.getElementById('select-crop-commodity') as HTMLSelectElement | null;
    const plantDateInput = document.getElementById('input-plant-date') as HTMLInputElement | null;
    const btnSetToday = document.getElementById('btn-set-today');
    const datePresetBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.date-preset-btn'));
    const labelDateMode = document.getElementById('label-date-mode');
    const dateContextText = document.getElementById('date-context-text');
    const dateSeasonBadge = document.getElementById('date-season-badge');
    const resultsArea = document.getElementById('calendar-results');

    const planTitle = document.getElementById('plan-title');
    const planSubtitle = document.getElementById('plan-subtitle');
    const planBadgeContainer = document.getElementById('plan-badge-container');
    const semusimSummaryBox = document.getElementById('semusim-summary-box');
    const summaryHst = document.getElementById('summary-hst');
    const summaryPhaseName = document.getElementById('summary-phase-name');
    const summaryHarvestRange = document.getElementById('summary-harvest-range');

    const timelineContainer = document.getElementById('timeline-container');
    const phasesList = document.getElementById('phases-list');
    const annualTasksContainer = document.getElementById('annual-tasks-container');
    const annualTasksList = document.getElementById('annual-tasks-list');

    const seasonsHeading = document.getElementById('seasons-heading');
    const seasonsTableBody = document.getElementById('seasons-table-body');
    const sourcesInfo = document.getElementById('sources-info');
    const reviewedInfo = document.getElementById('reviewed-info');

    const btnSaveIcs = document.getElementById('btn-save-ics');
    const btnPrintSchedule = document.getElementById('btn-print-schedule');
    const btnShareSchedule = document.getElementById('btn-share-schedule');
    const shareFeedback = document.getElementById('share-feedback');

    let selectedCommodityId: string | null = null;
    let selectedPlantDate: string = '';
    let currentPlan: CropPlanResult | null = null;

    // Helper: today YYYY-MM-DD string in local time
    function getTodayIso(): string {
      const now = new Date();
      const y = now.getFullYear();
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const d = String(now.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    // Read URL & LocalStorage state
    function readInitialState() {
      const params = new URLSearchParams(window.location.search);
      const urlK = params.get('k');
      const urlT = params.get('t');

      let savedK: string | null = null;
      let savedT: string | null = null;
      try {
        savedK = localStorage.getItem('agritani_crop_comm');
        savedT = localStorage.getItem('agritani_crop_date');
      } catch {
        // localStorage disabled
      }

      if (urlK && calendars.some((c) => c.id === urlK)) {
        selectedCommodityId = urlK;
      } else if (savedK && calendars.some((c) => c.id === savedK)) {
        selectedCommodityId = savedK;
      } else if (calendars.length > 0) {
        selectedCommodityId = calendars[0].id;
      }

      if (urlT && /^\d{4}-\d{2}-\d{2}$/.test(urlT)) {
        selectedPlantDate = urlT;
      } else if (savedT && /^\d{4}-\d{2}-\d{2}$/.test(savedT)) {
        selectedPlantDate = savedT;
      } else {
        selectedPlantDate = getTodayIso();
      }

      if (plantDateInput) {
        plantDateInput.value = selectedPlantDate;
      }

      syncUI();
    }

    function updateUrlAndStorage() {
      const url = new URL(window.location.href);
      if (selectedCommodityId) {
        url.searchParams.set('k', selectedCommodityId);
      } else {
        url.searchParams.delete('k');
      }

      if (selectedPlantDate) {
        url.searchParams.set('t', selectedPlantDate);
      } else {
        url.searchParams.delete('t');
      }

      window.history.replaceState({ k: selectedCommodityId, t: selectedPlantDate }, '', url.toString());

      try {
        if (selectedCommodityId) localStorage.setItem('agritani_crop_comm', selectedCommodityId);
        if (selectedPlantDate) localStorage.setItem('agritani_crop_date', selectedPlantDate);
      } catch {
        // localStorage unavailable
      }
    }

    function syncUI() {
      // 1. Sync Commodity Radio Buttons
      commodityBtns.forEach((btn) => {
        const id = btn.dataset.commodity;
        const isSelected = id === selectedCommodityId;
        btn.setAttribute('aria-checked', String(isSelected));
        const dot = btn.querySelector('.comm-dot');
        if (isSelected) {
          btn.classList.add('bg-[var(--color-brand)]', 'text-white', 'border-[var(--color-brand)]');
          btn.classList.remove('bg-[var(--color-surface)]', 'text-[var(--color-text)]');
          dot?.classList.add('bg-white');
          dot?.classList.remove('bg-[var(--color-border-control)]');
        } else {
          btn.classList.remove('bg-[var(--color-brand)]', 'text-white', 'border-[var(--color-brand)]');
          btn.classList.add('bg-[var(--color-surface)]', 'text-[var(--color-text)]');
          dot?.classList.remove('bg-white');
          dot?.classList.add('bg-[var(--color-border-control)]');
        }
      });

      // 1b. Sync Commodity Dropdown
      if (selectCropCommodity && selectedCommodityId) {
        selectCropCommodity.value = selectedCommodityId;
      }

      // 1c. Sync Date Context & Presets
      if (selectedPlantDate) {
        const [y, m, d] = selectedPlantDate.split('-').map(Number);
        const chosenDate = new Date(y, m - 1, d);
        const now = new Date();
        const todayMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const chosenMidnight = new Date(chosenDate.getFullYear(), chosenDate.getMonth(), chosenDate.getDate());
        const diffDays = Math.round((chosenMidnight.getTime() - todayMidnight.getTime()) / (1000 * 60 * 60 * 24));

        datePresetBtns.forEach((btn) => {
          const days = parseInt(btn.dataset.days || '9999', 10);
          const isMatch = days === diffDays;
          if (isMatch) {
            btn.classList.add('bg-[var(--color-brand)]', 'text-white', 'border-[var(--color-brand)]', 'font-bold');
            btn.classList.remove('bg-[var(--color-surface)]', 'text-[var(--color-text)]', 'font-medium');
          } else {
            btn.classList.remove('bg-[var(--color-brand)]', 'text-white', 'border-[var(--color-brand)]', 'font-bold');
            btn.classList.add('bg-[var(--color-surface)]', 'text-[var(--color-text)]', 'font-medium');
          }
        });

        const dateFormatted = new Intl.DateTimeFormat('id-ID', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        }).format(chosenDate);

        let contextDesc = '';
        let modeDesc = '';
        if (diffDays === 0) {
          modeDesc = 'Hari Ini · 0 HST';
          contextDesc = `${dateFormatted} — Tanam hari ini (0 HST), permulaan siklus budidaya`;
        } else if (diffDays < 0) {
          const hst = Math.abs(diffDays);
          modeDesc = `${hst} Hari yang Lalu · ${hst} HST`;
          contextDesc = `${dateFormatted} — Sedang berjalan ${hst} hari setelah tanam (${hst} HST)`;
        } else {
          modeDesc = `Rencana +${diffDays} Hari`;
          contextDesc = `${dateFormatted} — Rencana tanam ${diffDays} hari mendatang`;
        }

        if (labelDateMode) labelDateMode.textContent = modeDesc;
        if (dateContextText) dateContextText.textContent = contextDesc;
      }

      // 2. Calculate and render results
      const activeCalendar = calendars.find((c) => c.id === selectedCommodityId);
      if (!activeCalendar || !selectedPlantDate) {
        resultsArea?.classList.add('hidden');
        return;
      }

      // Sync active season badge
      if (dateSeasonBadge && activeCalendar?.seasons) {
        const [, m] = selectedPlantDate.split('-').map(Number);
        const activeSeason = activeCalendar.seasons.find((s) => s.plantMonths.includes(m));
        if (activeSeason) {
          dateSeasonBadge.textContent = `${activeSeason.code} (${activeSeason.label})`;
          dateSeasonBadge.classList.remove('hidden');
        } else {
          dateSeasonBadge.classList.add('hidden');
        }
      }

      resultsArea?.classList.remove('hidden');

      try {
        currentPlan = calculateCropPlan(activeCalendar, selectedPlantDate);
      } catch {
        currentPlan = null;
        resultsArea?.classList.add('hidden');
        return;
      }

      renderPlan(currentPlan, activeCalendar);
    }

    function renderPlan(plan: CropPlanResult, calendar: CropCalendarEntry) {
      const commBtn = commodityBtns.find((b) => b.dataset.commodity === plan.commodityId);
      const commName = commBtn?.textContent?.trim() || plan.commodityId;

      if (planTitle) {
        planTitle.textContent = `Rencana Tanam: ${commName}`;
      }

      if (planSubtitle) {
        planSubtitle.textContent = `Tanggal tanam acuan: ${plan.plantDateStr}`;
      }

      // Review status badge
      if (planBadgeContainer) {
        planBadgeContainer.innerHTML = '';
        const badge = document.createElement('span');
        if (calendar.reviewedBy) {
          badge.className = 'text-xs font-semibold px-2.5 py-1 rounded-[2px] bg-[var(--color-tint)] text-[var(--color-brand-strong)]';
          badge.textContent = `Ditinjau oleh ${calendar.reviewedBy}`;
        } else {
          badge.className = 'text-xs font-semibold px-2.5 py-1 rounded-[2px] bg-[var(--color-harvest-tint)] text-[var(--color-soil)]';
          badge.textContent = 'Draf Agronomi (OQ-11b)';
        }
        planBadgeContainer.appendChild(badge);
      }

      // Check crop type: semusim vs tahunan
      if (plan.type === 'semusim') {
        semusimSummaryBox?.classList.remove('hidden');
        timelineContainer?.classList.remove('hidden');
        annualTasksContainer?.classList.add('hidden');

        // Status pertumbuhan HST
        if (summaryHst) {
          if (plan.currentHst !== null) {
            summaryHst.textContent = `HST ${plan.currentHst}`;
          } else {
            summaryHst.textContent = 'Rencana Mendatang';
          }
        }

        if (summaryPhaseName) {
          if (plan.currentPhase) {
            summaryPhaseName.textContent = `Fase aktif: ${plan.currentPhase.name}`;
          } else if (plan.currentHst !== null && plan.currentHst > (calendar.cycleDays?.max || 120)) {
            summaryPhaseName.textContent = 'Melewati siklus panen standar';
          } else {
            summaryPhaseName.textContent = 'Menunggu tanggal tanam';
          }
        }

        if (summaryHarvestRange) {
          summaryHarvestRange.textContent = plan.harvestRangeStr || 'Sesuai umur varietas';
        }

        // Render phases timeline
        if (phasesList) {
          phasesList.innerHTML = '';
          plan.computedPhases.forEach((ph) => {
            const card = document.createElement('div');
            card.className = `py-5 space-y-2.5 ${
              ph.isCurrent ? 'bg-[var(--color-tint)] px-4 -mx-4 sm:px-5 sm:-mx-5 rounded-[2px]' : ''
            }`;

            // Top Header: Phase step & Dates
            const headRow = document.createElement('div');
            headRow.className = 'flex flex-wrap items-center justify-between gap-2';

            const leftHead = document.createElement('div');
            leftHead.className = 'flex flex-wrap items-center gap-x-3 gap-y-1';

            const stepBadge = document.createElement('span');
            stepBadge.className = `text-xs tabular-nums font-bold px-2 py-0.5 rounded-[2px] ${
              ph.isCurrent
                ? 'bg-[var(--color-brand)] text-white'
                : 'bg-[var(--color-tint)] text-[var(--color-soil)]'
            }`;
            stepBadge.textContent = `HST ${ph.startDay} – ${ph.endDay}`;

            const title = document.createElement('h4');
            title.className = 'font-serif text-lg font-semibold text-[var(--color-brand-strong)]';
            title.textContent = ph.name;

            leftHead.appendChild(stepBadge);
            leftHead.appendChild(title);

            const rightHead = document.createElement('div');
            rightHead.className = 'flex items-center gap-2 text-xs font-semibold tabular-nums';

            if (ph.isCurrent) {
              const activeTag = document.createElement('span');
              activeTag.className = 'px-2 py-0.5 rounded-[2px] bg-[var(--color-harvest)] text-[var(--color-text)] font-bold';
              activeTag.textContent = 'Sedang berjalan';
              rightHead.appendChild(activeTag);
            }

            const dateSpan = document.createElement('span');
            dateSpan.className = 'text-[var(--color-text-muted)]';
            dateSpan.textContent = ph.dateRangeStr;
            rightHead.appendChild(dateSpan);

            headRow.appendChild(leftHead);
            headRow.appendChild(rightHead);
            card.appendChild(headRow);

            // Activities list
            const actBox = document.createElement('div');
            actBox.className = 'space-y-1';
            const actTitle = document.createElement('span');
            actTitle.className = 'block text-sm font-semibold text-[var(--color-soil)]';
            actTitle.textContent = 'Kegiatan kunci lapangan:';
            actBox.appendChild(actTitle);

            const ul = document.createElement('ul');
            ul.className = 'list-disc pl-5 text-sm text-[var(--color-text)] space-y-0.5 leading-relaxed';
            ph.activities.forEach((act) => {
              const li = document.createElement('li');
              li.textContent = act;
              ul.appendChild(li);
            });
            actBox.appendChild(ul);
            card.appendChild(actBox);

            // Watch out pests/diseases
            if (ph.watch.length > 0) {
              const watchBox = document.createElement('div');
              watchBox.className = 'text-sm flex flex-wrap items-center gap-x-3 gap-y-1';

              const wLabel = document.createElement('span');
              wLabel.className = 'font-bold text-[var(--color-soil)]';
              wLabel.textContent = 'Waspadai:';
              watchBox.appendChild(wLabel);

              ph.watch.forEach((w) => {
                if (w.article) {
                  const a = document.createElement('a');
                  a.href = `/jurnal/${w.article}/`;
                  a.className = 'text-[var(--color-brand-strong)] underline font-semibold hover:text-[var(--color-brand)]';
                  a.textContent = w.name;
                  watchBox.appendChild(a);
                } else {
                  const s = document.createElement('span');
                  s.className = 'text-[var(--color-text)]';
                  s.textContent = w.name;
                  watchBox.appendChild(s);
                }
              });

              card.appendChild(watchBox);
            }

            phasesList.appendChild(card);
          });
        }
      } else {
        // Kelapa Sawit (tahunan)
        semusimSummaryBox?.classList.add('hidden');
        timelineContainer?.classList.add('hidden');
        annualTasksContainer?.classList.remove('hidden');

        if (annualTasksList) {
          annualTasksList.innerHTML = '';
          plan.annualTasks.forEach((task) => {
            const card = document.createElement('div');
            card.className = 'py-4 space-y-1';

            const monthsLabel = task.months.map((m) => monthNamesId[m - 1]).join(', ');
            const mSpan = document.createElement('span');
            mSpan.className = 'block text-sm font-semibold text-[var(--color-soil)]';
            mSpan.textContent = `Bulan: ${monthsLabel}`;

            const taskP = document.createElement('p');
            taskP.className = 'text-base text-[var(--color-text)]';
            taskP.textContent = task.task;

            card.appendChild(mSpan);
            card.appendChild(taskP);
            annualTasksList.appendChild(card);
          });
        }
      }

      // National Seasons Table
      if (seasonsHeading) {
        seasonsHeading.textContent = `Musim Tanam Nasional: ${commName}`;
      }
      if (seasonsTableBody) {
        seasonsTableBody.innerHTML = '';
        calendar.seasons.forEach((season) => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-[var(--color-tint)]/40 transition-colors';

          const tdCode = document.createElement('td');
          tdCode.className = 'py-2.5 pr-3 font-bold text-[var(--color-text)]';
          tdCode.textContent = `${season.code} (${season.label})`;

          const tdPlant = document.createElement('td');
          tdPlant.className = 'py-2.5 px-3 text-[var(--color-text-muted)]';
          tdPlant.textContent = season.plantMonths.map((m) => monthNamesId[m - 1]).join(', ');

          const tdHarvest = document.createElement('td');
          tdHarvest.className = 'py-2.5 pl-3 text-[var(--color-text-muted)]';
          tdHarvest.textContent = season.harvestMonths.map((m) => monthNamesId[m - 1]).join(', ');

          tr.appendChild(tdCode);
          tr.appendChild(tdPlant);
          tr.appendChild(tdHarvest);
          seasonsTableBody.appendChild(tr);
        });
      }

      // Sources & Review info
      if (sourcesInfo) {
        sourcesInfo.innerHTML = `<strong>Sumber Data Awal:</strong> ${calendar.sources.join('; ')}.`;
      }
      if (reviewedInfo) {
        if (calendar.reviewedBy) {
          reviewedInfo.textContent = `Status telaah agronomi: Ditinjau oleh ${calendar.reviewedBy}`;
        } else {
          reviewedInfo.textContent = 'Status telaah agronomi: Belum ditinjau [Draf — validasi OQ-11b]';
        }
      }
    }

    // Event listener for Commodity Buttons
    commodityBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.commodity;
        if (id && selectedCommodityId !== id) {
          selectedCommodityId = id;
          updateUrlAndStorage();
          syncUI();
        }
      });
    });

    // Event listener for Commodity Dropdown (Synchronized with Buttons)
    selectCropCommodity?.addEventListener('change', () => {
      const val = selectCropCommodity.value;
      if (val && selectedCommodityId !== val) {
        selectedCommodityId = val;
        updateUrlAndStorage();
        syncUI();
      }
    });

    // Event listener for Date Input (change & input)
    const handleDateChange = () => {
      if (!plantDateInput) return;
      const val = plantDateInput.value;
      if (val && selectedPlantDate !== val) {
        selectedPlantDate = val;
        updateUrlAndStorage();
        syncUI();
      }
    };
    plantDateInput?.addEventListener('change', handleDateChange);
    plantDateInput?.addEventListener('input', handleDateChange);

    // Event listener for Set Hari Ini button
    btnSetToday?.addEventListener('click', () => {
      selectedPlantDate = getTodayIso();
      if (plantDateInput) plantDateInput.value = selectedPlantDate;
      updateUrlAndStorage();
      syncUI();
    });

    // Event listener for Quick Date Presets
    datePresetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const days = parseInt(btn.dataset.days || '0', 10);
        const target = new Date();
        target.setDate(target.getDate() + days);
        const y = target.getFullYear();
        const m = String(target.getMonth() + 1).padStart(2, '0');
        const d = String(target.getDate()).padStart(2, '0');
        selectedPlantDate = `${y}-${m}-${d}`;
        if (plantDateInput) plantDateInput.value = selectedPlantDate;
        updateUrlAndStorage();
        syncUI();
      });
    });

    // Action: Save to .ics
    btnSaveIcs?.addEventListener('click', () => {
      if (!currentPlan) return;
      const commBtn = commodityBtns.find((b) => b.dataset.commodity === currentPlan?.commodityId);
      const commName = commBtn?.textContent?.trim() || currentPlan.commodityId;

      const icsString = generateCropCalendarIcs(currentPlan, commName);
      const blob = new Blob([icsString], { type: 'text/calendar;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `jadwal-tanam-${currentPlan.commodityId}.ics`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });

    // Action: Print Schedule
    btnPrintSchedule?.addEventListener('click', () => {
      window.print();
    });

    // Action: Share Schedule
    btnShareSchedule?.addEventListener('click', async () => {
      const commBtn = commodityBtns.find((b) => b.dataset.commodity === currentPlan?.commodityId);
      const commName = commBtn?.textContent?.trim() || 'Tanaman';
      const shareUrl = window.location.href;
      const shareTitle = `Jadwal Tanam ${commName} - Agritani`;

      if (navigator.share) {
        try {
          await navigator.share({
            title: shareTitle,
            text: `Rencana kalender budidaya ${commName} dari Agritani.`,
            url: shareUrl,
          });
          return;
        } catch {
          // User dismissed or share failed, fallback to copy
        }
      }

      // Fallback: Copy URL to clipboard
      try {
        await navigator.clipboard.writeText(shareUrl);
        if (shareFeedback) {
          shareFeedback.textContent = '✓ Tautan jadwal tanam berhasil disalin ke papan klip!';
          shareFeedback.classList.remove('hidden');
          setTimeout(() => shareFeedback.classList.add('hidden'), 3500);
        }
      } catch {
        // Clipboard blocked
      }
    });

    // Browser back/forward navigation
    window.addEventListener('popstate', () => {
      readInitialState();
    });

    // Initial state setup
    readInitialState();
  }

  initCropCalendar();
  document.addEventListener('astro:page-load', initCropCalendar);
</script>
