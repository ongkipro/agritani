---
/**
 * Jawaban Singkat (DESIGN §4.3.1 blok 7): tint block, sentence-case heading,
 * no side stripe and no kicker (DESIGN §3.3, craft floor).
 */
interface Props {
  answer?: string;
}

const { answer } = Astro.props;
---

{answer && (
  <section
    class="my-8 px-5 py-5 sm:px-6 bg-[var(--color-tint)] rounded-[2px]"
    aria-labelledby="jawaban-singkat-heading"
  >
    <h2
      id="jawaban-singkat-heading"
      class="font-serif text-lg font-semibold text-[var(--color-brand-strong)] mb-2"
    >
      Jawaban singkat
    </h2>
    <p class="text-[1.0625rem] sm:text-[1.125rem] leading-[1.75] text-[var(--color-text)] font-sans text-pretty">
      {answer}
    </p>
  </section>
)}
