---
interface Props {
  answer?: string;
}

const { answer } = Astro.props;
---

{answer && (
  <section
    class="my-8 px-5 py-5 sm:px-6 bg-[var(--color-tint)] rounded-[2px]"
    aria-labelledby="jawaban-singkat-heading"
  >
    <h2
      id="jawaban-singkat-heading"
      class="text-sm font-bold mb-2 text-[var(--color-brand-strong)]"
    >
      Jawaban Singkat
    </h2>
    <p class="text-base sm:text-lg leading-relaxed text-[var(--color-text)] font-serif">
      {answer}
    </p>
  </section>
)}
