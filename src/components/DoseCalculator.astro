---
/**
 * src/components/DoseCalculator.astro
 * Interactive & accessible spray dose calculator component (REQ-11, DESIGN §2.6.3)
 * Styled with shadcn-ui inspired precision, custom unit selectors, preset chips, and metric cards.
 * No prefilled product dosage (PRD REQ-11 & DESIGN §2.6.3 strict rule).
 */
import ConsultPrompt from './ConsultPrompt.astro';
---

<div class="space-y-12" id="dose-calculator-root">
  <!-- Input Form Card -->
  <form id="dose-form" class="space-y-6">
    <div class="max-w-[60ch]">
      <h2 class="section-title !mb-2">Masukkan data label dan ukuran lahan</h2>
      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
        Masukkan angka anjuran dari kemasan resmi produk dan ukuran tangki Anda untuk menghitung takaran bersih di lapangan.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Field 1: Dosis Label -->
      <div class="space-y-1.5">
        <label for="input-dose" class="block text-xs font-bold text-[var(--color-text)]">
          1. Dosis dari Label Kemasan <span class="text-[var(--color-danger)]" aria-hidden="true">*</span>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <input
            type="number"
            id="input-dose"
            name="dose"
            value=""
            placeholder="Misal: 2 atau 1.5"
            step="any"
            min="0.001"
            required
            class="w-full px-3.5 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] focus:border-transparent text-xs sm:text-sm tabular-nums"
            aria-describedby="dose-unit-desc"
          />

          <!-- Custom Select for Dose Unit (shadcn Select pattern) -->
          <div class="relative" id="wrapper-dose-unit-select">
            <select id="input-dose-unit" name="doseUnit" class="sr-only" tabindex="-1" aria-hidden="true">
              <option value="ml/L" selected>ml / Liter (Cair)</option>
              <option value="g/L">g / Liter (Bubuk / WP)</option>
              <option value="ml/tangki">ml / tangki</option>
              <option value="g/tangki">g / tangki</option>
            </select>

            <button
              type="button"
              id="trigger-dose-unit"
              role="combobox"
              aria-expanded="false"
              aria-haspopup="listbox"
              aria-controls="popover-dose-unit"
              aria-label="Pilih satuan dosis"
              class="w-full pl-3.5 pr-9 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] focus:border-transparent text-xs sm:text-sm cursor-pointer transition-colors flex items-center justify-between text-left"
            >
              <span id="label-dose-unit" class="truncate font-medium">ml / Liter (Cair)</span>
              <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-[var(--color-soil)] transition-transform duration-200" aria-hidden="true">
                <svg class="w-4 h-4 chevron-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 8 4 4 4-4"/>
                </svg>
              </span>
            </button>

            <div
              id="popover-dose-unit"
              role="listbox"
              class="hidden absolute top-full left-0 right-0 z-50 mt-1 bg-[var(--color-surface)] border border-[var(--color-border-control)] rounded-[2px] overflow-hidden p-1 space-y-0.5"
            >
              <div role="option" data-value="ml/L" data-label="ml / Liter (Cair)" aria-selected="true" class="dose-unit-opt px-3 py-2 text-xs sm:text-sm rounded-[2px] cursor-pointer flex items-center justify-between bg-[var(--color-tint)] font-semibold text-[var(--color-brand-strong)] hover:bg-[var(--color-tint)] transition-colors min-h-[44px]">
                <span>ml / Liter (Cair)</span>
                <svg class="w-4 h-4 text-[var(--color-brand)] shrink-0 check-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>
              </div>
              <div role="option" data-value="g/L" data-label="g / Liter (Bubuk / WP)" aria-selected="false" class="dose-unit-opt px-3 py-2 text-xs sm:text-sm text-[var(--color-text)] rounded-[2px] cursor-pointer flex items-center justify-between hover:bg-[var(--color-tint)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]">
                <span>g / Liter (Bubuk / WP)</span>
                <svg class="w-4 h-4 text-[var(--color-brand)] shrink-0 hidden check-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>
              </div>
              <div role="option" data-value="ml/tangki" data-label="ml / tangki" aria-selected="false" class="dose-unit-opt px-3 py-2 text-xs sm:text-sm text-[var(--color-text)] rounded-[2px] cursor-pointer flex items-center justify-between hover:bg-[var(--color-tint)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]">
                <span>ml / tangki</span>
                <svg class="w-4 h-4 text-[var(--color-brand)] shrink-0 hidden check-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>
              </div>
              <div role="option" data-value="g/tangki" data-label="g / tangki" aria-selected="false" class="dose-unit-opt px-3 py-2 text-xs sm:text-sm text-[var(--color-text)] rounded-[2px] cursor-pointer flex items-center justify-between hover:bg-[var(--color-tint)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]">
                <span>g / tangki</span>
                <svg class="w-4 h-4 text-[var(--color-brand)] shrink-0 hidden check-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>
              </div>
            </div>
          </div>
        </div>
        <p id="dose-unit-desc" class="text-xs text-[var(--color-text-muted)]">
          Sesuai angka petunjuk anjuran di botol / kemasan produk resmi.
        </p>
        <p id="err-dose" class="text-xs text-[var(--color-danger)] hidden"></p>
      </div>

      <!-- Field 1b: Volume Tangki pada Label (khusus per tangki) -->
      <div id="wrapper-label-tank" class="space-y-1.5 hidden">
        <label for="input-label-tank-vol" class="block text-xs font-bold text-[var(--color-text)]">
          Volume Tangki pada Label (Liter) <span class="text-[var(--color-danger)]" aria-hidden="true">*</span>
        </label>
        <input
          type="number"
          id="input-label-tank-vol"
          name="labelTankVolume"
          value="16"
          step="any"
          min="1"
          max="1000"
          class="w-full px-3.5 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] focus:border-transparent text-xs sm:text-sm tabular-nums"
          aria-describedby="label-tank-desc"
        />
        <p id="label-tank-desc" class="text-xs text-[var(--color-text-muted)]">
          Ukuran tangki yang diasumsikan label produk (umumnya 16 Liter).
        </p>
        <p id="err-label-tank-vol" class="text-xs text-[var(--color-danger)] hidden"></p>
      </div>

      <!-- Field 2: Volume Tangki Pengguna -->
      <div class="space-y-1.5">
        <label for="input-tank-vol" class="block text-xs font-bold text-[var(--color-text)]">
          2. Kapasitas Tangki Semprot Anda (Liter) <span class="text-[var(--color-danger)]" aria-hidden="true">*</span>
        </label>
        <input
          type="number"
          id="input-tank-vol"
          name="tankVolume"
          value="16"
          step="any"
          min="1"
          max="1000"
          required
          class="w-full px-3.5 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] focus:border-transparent text-xs sm:text-sm tabular-nums"
          aria-describedby="tank-vol-desc"
        />
        <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
          <span class="text-[11px] font-semibold text-[var(--color-soil)] mr-1">Pintasan:</span>
          <button type="button" data-tank-preset="14" class="tank-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">14 L (Solo)</button>
          <button type="button" data-tank-preset="16" class="tank-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-bold border border-[var(--color-brand)] bg-[var(--color-tint)] text-[var(--color-brand-strong)] rounded-[2px] transition-colors cursor-pointer">16 L (Standar)</button>
          <button type="button" data-tank-preset="20" class="tank-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">20 L (Elektrik)</button>
          <button type="button" data-tank-preset="200" class="tank-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">200 L (Drum)</button>
        </div>
        <p id="tank-vol-desc" class="text-xs text-[var(--color-text-muted)]">
          Kapasitas tangki semprot punggung Anda (bawaan 16 Liter).
        </p>
        <p id="err-tank-vol" class="text-xs text-[var(--color-danger)] hidden"></p>
      </div>

      <!-- Field 3: Luas Lahan -->
      <div class="space-y-1.5">
        <label for="input-area" class="block text-xs font-bold text-[var(--color-text)]">
          3. Luas Lahan Semprot <span class="text-[var(--color-danger)]" aria-hidden="true">*</span>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <input
            type="number"
            id="input-area"
            name="area"
            value=""
            placeholder="Misal: 1 atau 2500"
            step="any"
            min="0.001"
            required
            class="w-full px-3.5 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] focus:border-transparent text-xs sm:text-sm tabular-nums"
            aria-describedby="area-desc"
          />

          <!-- Custom Select for Area Unit (shadcn Select pattern) -->
          <div class="relative" id="wrapper-area-unit-select">
            <select id="input-area-unit" name="areaUnit" class="sr-only" tabindex="-1" aria-hidden="true">
              <option value="ha" selected>Hektar (ha)</option>
              <option value="m2">Meter persegi (m²)</option>
            </select>

            <button
              type="button"
              id="trigger-area-unit"
              role="combobox"
              aria-expanded="false"
              aria-haspopup="listbox"
              aria-controls="popover-area-unit"
              aria-label="Pilih satuan luas lahan"
              class="w-full pl-3.5 pr-9 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] focus:border-transparent text-xs sm:text-sm cursor-pointer transition-colors flex items-center justify-between text-left"
            >
              <span id="label-area-unit" class="truncate font-medium">Hektar (ha)</span>
              <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-[var(--color-soil)] transition-transform duration-200" aria-hidden="true">
                <svg class="w-4 h-4 chevron-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 8 4 4 4-4"/>
                </svg>
              </span>
            </button>

            <div
              id="popover-area-unit"
              role="listbox"
              class="hidden absolute top-full left-0 right-0 z-50 mt-1 bg-[var(--color-surface)] border border-[var(--color-border-control)] rounded-[2px] overflow-hidden p-1 space-y-0.5"
            >
              <div role="option" data-value="ha" data-label="Hektar (ha)" aria-selected="true" class="area-unit-opt px-3 py-2 text-xs sm:text-sm rounded-[2px] cursor-pointer flex items-center justify-between bg-[var(--color-tint)] font-semibold text-[var(--color-brand-strong)] hover:bg-[var(--color-tint)] transition-colors min-h-[44px]">
                <span>Hektar (ha)</span>
                <svg class="w-4 h-4 text-[var(--color-brand)] shrink-0 check-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>
              </div>
              <div role="option" data-value="m2" data-label="Meter persegi (m²)" aria-selected="false" class="area-unit-opt px-3 py-2 text-xs sm:text-sm text-[var(--color-text)] rounded-[2px] cursor-pointer flex items-center justify-between hover:bg-[var(--color-tint)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px]">
                <span>Meter persegi (m²)</span>
                <svg class="w-4 h-4 text-[var(--color-brand)] shrink-0 hidden check-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10 4 4 8-8"/></svg>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
          <span class="text-[11px] font-semibold text-[var(--color-soil)] mr-1">Pintasan:</span>
          <button type="button" data-area-val="1000" data-area-unit="m2" class="area-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">1.000 m²</button>
          <button type="button" data-area-val="2500" data-area-unit="m2" class="area-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">2.500 m² (1/4 ha)</button>
          <button type="button" data-area-val="0.5" data-area-unit="ha" class="area-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">0.5 ha</button>
          <button type="button" data-area-val="1" data-area-unit="ha" class="area-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">1 ha</button>
        </div>
        <p id="area-desc" class="text-xs text-[var(--color-text-muted)]">
          Gunakan satuan baku m² atau ha. Satuan lokal tidak seragam antar daerah.
        </p>
        <p id="err-area" class="text-xs text-[var(--color-danger)] hidden"></p>
      </div>

      <!-- Field 4: Volume Semprot per Ha -->
      <div class="space-y-1.5">
        <label for="input-spray-vol" class="block text-xs font-bold text-[var(--color-text)]">
          4. Volume Semprot Larutan (L/ha) <span class="text-[var(--color-danger)]" aria-hidden="true">*</span>
        </label>
        <input
          type="number"
          id="input-spray-vol"
          name="sprayVolumePerHa"
          value=""
          placeholder="Misal: 200 atau 400"
          step="any"
          min="50"
          max="1000"
          required
          class="w-full px-3.5 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] hover:border-[var(--color-brand)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-strong)] focus:border-transparent text-xs sm:text-sm tabular-nums"
          aria-describedby="spray-vol-desc"
        />
        <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
          <span class="text-[11px] font-semibold text-[var(--color-soil)] mr-1">Pintasan:</span>
          <button type="button" data-spray-preset="200" class="spray-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">200 L/ha (Rendah)</button>
          <button type="button" data-spray-preset="300" class="spray-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">300 L/ha (Standar)</button>
          <button type="button" data-spray-preset="400" class="spray-preset-btn px-2.5 py-1 min-h-[44px] text-xs font-medium border border-[var(--color-border-control)] rounded-[2px] bg-[var(--color-surface)] hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] transition-colors cursor-pointer">400 L/ha (Lebat)</button>
        </div>
        <p id="spray-vol-desc" class="text-xs text-[var(--color-text-muted)]">
          Volume semprot air per hektar sesuai anjuran label produk atau tanyakan agronom lapangan.
        </p>
        <p id="err-spray-vol" class="text-xs text-[var(--color-danger)] hidden"></p>
      </div>

    </div>
  </form>

  <noscript>
    <div class="px-5 py-4 bg-[var(--color-tint)] rounded-[2px] text-sm text-[var(--color-text)] space-y-3">
      <p class="font-semibold text-[var(--color-brand-strong)]">Panduan rumus kalkulasi mandiri (tanpa JavaScript):</p>
      <p>Kalkulator interaktif membutuhkan JavaScript aktif. Anda tetap dapat menghitung kebutuhan di lapangan menggunakan rumus baku berikut:</p>
      <ul class="list-disc pl-5 space-y-1">
        <li><strong>Takaran per tangki:</strong> Dosis konsentrasi (ml/L atau g/L) × Kapasitas tangki (L).</li>
        <li><strong>Total kebutuhan air semprot:</strong> Luas lahan (ha) × Volume semprot anjuran (L/ha).</li>
        <li><strong>Jumlah tangki semprot:</strong> Total kebutuhan air (L) ÷ Kapasitas tangki (L).</li>
        <li><strong>Kebutuhan tepat produk:</strong> Total kebutuhan air (L) × Dosis konsentrasi per Liter.</li>
      </ul>
    </div>
  </noscript>

  <!-- Empty State Panel (Initial state before valid input) -->
  <div id="calc-empty-state" class="max-w-[60ch] space-y-2">
    <h2 class="font-serif text-xl font-semibold text-[var(--color-brand-strong)]">
      Isi dosis dari label untuk melihat hasil
    </h2>
    <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
      Masukkan angka dosis dari label kemasan resmi, luas lahan, dan volume semprot anjuran untuk menghitung takaran per tangki serta kebutuhan produk.
    </p>
  </div>

  <!-- Output Results Panel (Hidden until all inputs are valid) -->
  <section id="calc-result-container" aria-labelledby="calc-result-heading" aria-live="polite" class="space-y-8 hidden">
    <h2 id="calc-result-heading" class="section-title !mb-0">
      Hasil perhitungan dosis
    </h2>

    <!-- The single results panel: three figures as open columns -->
    <div class="p-5 sm:p-7 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">

        <!-- 1. Per Tangki -->
        <div class="space-y-1">
          <p class="text-sm font-semibold text-[var(--color-soil)]">Takaran per tangki Anda</p>
          <p class="text-3xl sm:text-4xl font-extrabold text-[var(--color-brand)] tabular-nums">
            <span id="res-per-tank">0</span>
            <span id="res-per-tank-unit" class="text-lg font-normal text-[var(--color-text-muted)]">ml</span>
          </p>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed" id="res-per-tank-desc">
            Campurkan ke dalam satu tangki air penuh.
          </p>
        </div>

        <!-- 2. Jumlah Tangki -->
        <div class="space-y-1">
          <p class="text-sm font-semibold text-[var(--color-soil)]">Jumlah tangki semprot</p>
          <p class="text-3xl sm:text-4xl font-extrabold text-[var(--color-brand)] tabular-nums">
            <span id="res-total-tanks">0</span>
            <span class="text-lg font-normal text-[var(--color-text-muted)]">tangki</span>
          </p>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Dibulatkan ke atas dari <span id="res-exact-tanks" class="tabular-nums font-semibold">0</span> tangki (<span id="res-total-water" class="tabular-nums font-semibold">0</span> L air).
          </p>
        </div>

        <!-- 3. Total Kebutuhan Produk -->
        <div class="space-y-1">
          <p class="text-sm font-semibold text-[var(--color-soil)]">Kebutuhan tepat bersih</p>
          <p class="text-3xl sm:text-4xl font-extrabold text-[var(--color-brand)] tabular-nums">
            <span id="res-exact-product-large">0</span>
            <span id="res-exact-product-large-unit" class="text-lg font-normal text-[var(--color-text-muted)]">L</span>
          </p>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Setara <span id="res-exact-product-small" class="tabular-nums font-semibold">0</span> <span id="res-exact-product-small-unit">ml</span> bersih seluruh lahan.
          </p>
          <p class="text-sm text-[var(--color-text)] leading-relaxed pt-2">
            <span class="font-semibold">Jika menyiapkan tangki penuh:</span>
            <span id="res-batch-product-large" class="font-bold tabular-nums">0</span> <span id="res-batch-product-large-unit">L</span>
            (<span id="res-batch-product-small" class="tabular-nums font-semibold">0</span> <span id="res-batch-product-small-unit">ml</span> untuk <span id="res-batch-tanks-count" class="font-bold">0</span> tangki penuh).
          </p>
        </div>

      </div>

      <!-- Rekomendasi Pengisian Tangki Terakhir -->
      <div class="text-sm text-[var(--color-text)] leading-relaxed max-w-[68ch]">
        <p class="font-semibold text-[var(--color-brand-strong)]">Panduan pengisian tangki terakhir:</p>
        <p id="res-partial-tank"></p>
      </div>
    </div>

    <!-- Rincian Cara Hitung (Collapsible) -->
    <details class="group max-w-[68ch]" id="calc-steps-details">
      <summary class="inline-flex items-center gap-2 min-h-[44px] font-semibold text-sm cursor-pointer select-none text-[var(--color-brand-strong)] hover:underline">
        <span>Lihat rincian langkah perhitungan & rumus</span>
        <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 8 4 4 4-4"/>
        </svg>
      </summary>
      <ul id="res-steps" class="mt-2 space-y-2 text-sm text-[var(--color-text)] list-disc pl-5">
      </ul>
    </details>

    <!-- Peringatan Keamanan Label -->
    <div class="px-5 py-4 bg-[var(--color-harvest-tint)] rounded-[2px] text-sm text-[var(--color-text)] leading-relaxed space-y-1 max-w-[68ch]">
      <p class="font-semibold text-[var(--color-soil)]">Peringatan penting label kemasan:</p>
      <p>
        Selalu ikuti takaran dosis dan petunjuk keselamatan pada label kemasan resmi produk yang terdaftar di Kementerian Pertanian. Kalkulator ini hanya instrumen bantu hitungan matematis volume semprot di lahan.
      </p>
    </div>

    <!-- Tautan Kontekstual Cuaca Tani -->
    <div class="max-w-[68ch] space-y-1">
      <h3 class="font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Sebelum mulai menyemprot</h3>
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        Periksa prakiraan curah hujan dan kecepatan angin di desa Anda agar larutan tidak tercuci atau terbawa angin.
      </p>
      <a href="/alat/cuaca-tani/" class="link-more min-h-[44px]">Buka Cuaca Tani &rarr;</a>
    </div>

    <!-- One WhatsApp Consult CTA (DESIGN §2.8) -->
    <div id="dose-consult-wrapper">
      <ConsultPrompt
        source="[Web·Kalkulator]"
        title="Butuh konsultasi kalibrasi semprot atau pencampuran produk?"
        description="Hubungi tim agronomi Agritani bila Anda ragu mengenai pencampuran bahan aktif (kompatibilitas tangki) atau penyesuaian nozzle."
        label="Tanya Tim Agronomi"
        variant="secondary"
      />
    </div>

  </section>
</div>

<script>
  import { calculateDose, formatNumber, type DoseInput, type DoseUnit, type AreaUnit } from '../lib/dose';

  function initDoseCalculator() {
    const doseForm = document.getElementById('dose-form') as HTMLFormElement | null;
    if (doseForm) {
      doseForm.addEventListener('submit', (e) => e.preventDefault());
    }

    const inputDose = document.getElementById('input-dose') as HTMLInputElement | null;
    const inputDoseUnit = document.getElementById('input-dose-unit') as HTMLSelectElement | null;
    const triggerDoseUnit = document.getElementById('trigger-dose-unit');
    const labelDoseUnit = document.getElementById('label-dose-unit');
    const popoverDoseUnit = document.getElementById('popover-dose-unit');

    const wrapperLabelTank = document.getElementById('wrapper-label-tank') as HTMLElement | null;
    const inputLabelTankVol = document.getElementById('input-label-tank-vol') as HTMLInputElement | null;
    const inputTankVol = document.getElementById('input-tank-vol') as HTMLInputElement | null;

    const inputArea = document.getElementById('input-area') as HTMLInputElement | null;
    const inputAreaUnit = document.getElementById('input-area-unit') as HTMLSelectElement | null;
    const triggerAreaUnit = document.getElementById('trigger-area-unit');
    const labelAreaUnit = document.getElementById('label-area-unit');
    const popoverAreaUnit = document.getElementById('popover-area-unit');

    const inputSprayVol = document.getElementById('input-spray-vol') as HTMLInputElement | null;

    // Containers
    const emptyState = document.getElementById('calc-empty-state');
    const resultContainer = document.getElementById('calc-result-container');

    // Result elements
    const resPerTank = document.getElementById('res-per-tank');
    const resPerTankUnit = document.getElementById('res-per-tank-unit');
    const resPerTankDesc = document.getElementById('res-per-tank-desc');
    const resTotalTanks = document.getElementById('res-total-tanks');
    const resExactTanks = document.getElementById('res-exact-tanks');
    const resTotalWater = document.getElementById('res-total-water');
    const resExactProductLarge = document.getElementById('res-exact-product-large');
    const resExactProductLargeUnit = document.getElementById('res-exact-product-large-unit');
    const resExactProductSmall = document.getElementById('res-exact-product-small');
    const resExactProductSmallUnit = document.getElementById('res-exact-product-small-unit');
    const resBatchProductLarge = document.getElementById('res-batch-product-large');
    const resBatchProductLargeUnit = document.getElementById('res-batch-product-large-unit');
    const resBatchProductSmall = document.getElementById('res-batch-product-small');
    const resBatchProductSmallUnit = document.getElementById('res-batch-product-small-unit');
    const resBatchTanksCount = document.getElementById('res-batch-tanks-count');
    const resPartialTank = document.getElementById('res-partial-tank');
    const resSteps = document.getElementById('res-steps');

    // Error elements
    const errDose = document.getElementById('err-dose');
    const errLabelTankVol = document.getElementById('err-label-tank-vol');
    const errTankVol = document.getElementById('err-tank-vol');
    const errArea = document.getElementById('err-area');
    const errSprayVol = document.getElementById('err-spray-vol');

    if (!inputDose || !inputDoseUnit || !inputTankVol || !inputArea || !inputAreaUnit || !inputSprayVol) {
      return;
    }

    // Custom Select handlers for Dose Unit
    function closeDosePopover() {
      if (popoverDoseUnit) popoverDoseUnit.classList.add('hidden');
      if (triggerDoseUnit) {
        triggerDoseUnit.setAttribute('aria-expanded', 'false');
        const chevron = triggerDoseUnit.querySelector('.chevron-icon');
        if (chevron) chevron.classList.remove('rotate-180');
      }
    }

    function openDosePopover() {
      closeAreaPopover();
      if (popoverDoseUnit) popoverDoseUnit.classList.remove('hidden');
      if (triggerDoseUnit) {
        triggerDoseUnit.setAttribute('aria-expanded', 'true');
        const chevron = triggerDoseUnit.querySelector('.chevron-icon');
        if (chevron) chevron.classList.add('rotate-180');
      }
    }

    if (triggerDoseUnit && popoverDoseUnit) {
      triggerDoseUnit.addEventListener('click', (e) => {
        e.stopPropagation();
        if (popoverDoseUnit.classList.contains('hidden')) {
          openDosePopover();
        } else {
          closeDosePopover();
        }
      });

      const doseOpts = popoverDoseUnit.querySelectorAll<HTMLElement>('.dose-unit-opt');
      doseOpts.forEach((opt) => {
        opt.addEventListener('click', () => {
          const val = opt.dataset.value || 'ml/L';
          const lbl = opt.dataset.label || val;
          if (inputDoseUnit) inputDoseUnit.value = val;
          if (labelDoseUnit) labelDoseUnit.textContent = lbl;

          doseOpts.forEach((o) => {
            const isMatch = o.dataset.value === val;
            o.setAttribute('aria-selected', isMatch ? 'true' : 'false');
            const chk = o.querySelector('.check-icon');
            if (isMatch) {
              o.classList.add('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
              if (chk) chk.classList.remove('hidden');
            } else {
              o.classList.remove('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
              if (chk) chk.classList.add('hidden');
            }
          });

          closeDosePopover();
          inputDoseUnit?.dispatchEvent(new Event('change'));
        });
      });
    }

    // Custom Select handlers for Area Unit
    function closeAreaPopover() {
      if (popoverAreaUnit) popoverAreaUnit.classList.add('hidden');
      if (triggerAreaUnit) {
        triggerAreaUnit.setAttribute('aria-expanded', 'false');
        const chevron = triggerAreaUnit.querySelector('.chevron-icon');
        if (chevron) chevron.classList.remove('rotate-180');
      }
    }

    function openAreaPopover() {
      closeDosePopover();
      if (popoverAreaUnit) popoverAreaUnit.classList.remove('hidden');
      if (triggerAreaUnit) {
        triggerAreaUnit.setAttribute('aria-expanded', 'true');
        const chevron = triggerAreaUnit.querySelector('.chevron-icon');
        if (chevron) chevron.classList.add('rotate-180');
      }
    }

    if (triggerAreaUnit && popoverAreaUnit) {
      triggerAreaUnit.addEventListener('click', (e) => {
        e.stopPropagation();
        if (popoverAreaUnit.classList.contains('hidden')) {
          openAreaPopover();
        } else {
          closeAreaPopover();
        }
      });

      const areaOpts = popoverAreaUnit.querySelectorAll<HTMLElement>('.area-unit-opt');
      areaOpts.forEach((opt) => {
        opt.addEventListener('click', () => {
          const val = opt.dataset.value || 'ha';
          const lbl = opt.dataset.label || val;
          if (inputAreaUnit) inputAreaUnit.value = val;
          if (labelAreaUnit) labelAreaUnit.textContent = lbl;

          areaOpts.forEach((o) => {
            const isMatch = o.dataset.value === val;
            o.setAttribute('aria-selected', isMatch ? 'true' : 'false');
            const chk = o.querySelector('.check-icon');
            if (isMatch) {
              o.classList.add('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
              if (chk) chk.classList.remove('hidden');
            } else {
              o.classList.remove('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
              if (chk) chk.classList.add('hidden');
            }
          });

          closeAreaPopover();
          inputAreaUnit?.dispatchEvent(new Event('change'));
        });
      });
    }

    // Close select popovers on outside click
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node | null;
      if (!target) return;
      if (popoverDoseUnit && !popoverDoseUnit.classList.contains('hidden')) {
        if (!popoverDoseUnit.contains(target) && !triggerDoseUnit?.contains(target)) {
          closeDosePopover();
        }
      }
      if (popoverAreaUnit && !popoverAreaUnit.classList.contains('hidden')) {
        if (!popoverAreaUnit.contains(target) && !triggerAreaUnit?.contains(target)) {
          closeAreaPopover();
        }
      }
    });

    // Preset Buttons
    const tankPresets = document.querySelectorAll<HTMLButtonElement>('.tank-preset-btn');
    tankPresets.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.tankPreset || '16';
        if (inputTankVol) {
          inputTankVol.value = val;
          tankPresets.forEach((b) => {
            if (b === btn) {
              b.classList.add('border-[var(--color-brand)]', 'bg-[var(--color-tint)]', 'text-[var(--color-brand-strong)]', 'font-bold');
              b.classList.remove('font-medium');
            } else {
              b.classList.remove('border-[var(--color-brand)]', 'bg-[var(--color-tint)]', 'text-[var(--color-brand-strong)]', 'font-bold');
              b.classList.add('font-medium');
            }
          });
          recompute();
        }
      });
    });

    const areaPresets = document.querySelectorAll<HTMLButtonElement>('.area-preset-btn');
    areaPresets.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.areaVal || '1';
        const unit = btn.dataset.areaUnit || 'ha';
        if (inputArea && inputAreaUnit) {
          inputArea.value = val;
          inputAreaUnit.value = unit;
          if (labelAreaUnit) {
            labelAreaUnit.textContent = unit === 'ha' ? 'Hektar (ha)' : 'Meter persegi (m²)';
          }
          if (popoverAreaUnit) {
            const areaOpts = popoverAreaUnit.querySelectorAll<HTMLElement>('.area-unit-opt');
            areaOpts.forEach((o) => {
              const isMatch = o.dataset.value === unit;
              o.setAttribute('aria-selected', isMatch ? 'true' : 'false');
              const chk = o.querySelector('.check-icon');
              if (isMatch) {
                o.classList.add('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
                if (chk) chk.classList.remove('hidden');
              } else {
                o.classList.remove('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
                if (chk) chk.classList.add('hidden');
              }
            });
          }
          recompute();
        }
      });
    });

    const sprayPresets = document.querySelectorAll<HTMLButtonElement>('.spray-preset-btn');
    sprayPresets.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.dataset.sprayPreset || '300';
        if (inputSprayVol) {
          inputSprayVol.value = val;
          sprayPresets.forEach((b) => {
            if (b === btn) {
              b.classList.add('border-[var(--color-brand)]', 'bg-[var(--color-tint)]', 'text-[var(--color-brand-strong)]', 'font-bold');
              b.classList.remove('font-medium');
            } else {
              b.classList.remove('border-[var(--color-brand)]', 'bg-[var(--color-tint)]', 'text-[var(--color-brand-strong)]', 'font-bold');
              b.classList.add('font-medium');
            }
          });
          recompute();
        }
      });
    });

    function toggleLabelTankVisibility() {
      const unit = inputDoseUnit?.value || '';
      if (unit === 'ml/tangki' || unit === 'g/tangki') {
        wrapperLabelTank?.classList.remove('hidden');
      } else {
        wrapperLabelTank?.classList.add('hidden');
      }
    }

    function recompute() {
      toggleLabelTankVisibility();

      const doseStr = inputDose?.value.trim() || '';
      const areaStr = inputArea?.value.trim() || '';
      const sprayVolStr = inputSprayVol?.value.trim() || '';

      // If user hasn't started filling required fields, stay in empty state
      if (!doseStr || !areaStr || !sprayVolStr) {
        emptyState?.classList.remove('hidden');
        resultContainer?.classList.add('hidden');
        return;
      }

      const dose = parseFloat(doseStr);
      const doseUnit = (inputDoseUnit?.value || 'ml/L') as DoseUnit;
      const tankVolume = parseFloat(inputTankVol?.value || '0');
      const labelTankVolume = inputLabelTankVol ? parseFloat(inputLabelTankVol.value || '16') : 16;
      const area = parseFloat(areaStr);
      const areaUnit = (inputAreaUnit?.value || 'ha') as AreaUnit;
      const sprayVolumePerHa = parseFloat(sprayVolStr);

      const input: DoseInput = {
        dose,
        doseUnit,
        tankVolume,
        labelTankVolume,
        area,
        areaUnit,
        sprayVolumePerHa,
      };

      const result = calculateDose(input);

      // Handle validation error messages
      if (errDose) {
        if (result.errors.dose) {
          errDose.textContent = result.errors.dose;
          errDose.classList.remove('hidden');
        } else {
          errDose.classList.add('hidden');
        }
      }

      if (errLabelTankVol) {
        if (result.errors.labelTankVolume) {
          errLabelTankVol.textContent = result.errors.labelTankVolume;
          errLabelTankVol.classList.remove('hidden');
        } else {
          errLabelTankVol.classList.add('hidden');
        }
      }

      if (errTankVol) {
        if (result.errors.tankVolume) {
          errTankVol.textContent = result.errors.tankVolume;
          errTankVol.classList.remove('hidden');
        } else {
          errTankVol.classList.add('hidden');
        }
      }

      if (errArea) {
        if (result.errors.area) {
          errArea.textContent = result.errors.area;
          errArea.classList.remove('hidden');
        } else {
          errArea.classList.add('hidden');
        }
      }

      if (errSprayVol) {
        if (result.errors.sprayVolumePerHa) {
          errSprayVol.textContent = result.errors.sprayVolumePerHa;
          errSprayVol.classList.remove('hidden');
        } else {
          errSprayVol.classList.add('hidden');
        }
      }

      if (!result.isValid) {
        emptyState?.classList.remove('hidden');
        resultContainer?.classList.add('hidden');
        return;
      }

      // Show result container, hide empty state
      emptyState?.classList.add('hidden');
      resultContainer?.classList.remove('hidden');

      // Update numbers
      if (resPerTank) resPerTank.textContent = formatNumber(result.perTank);
      if (resPerTankUnit) resPerTankUnit.textContent = result.perTankUnit;
      if (resPerTankDesc) {
        resPerTankDesc.textContent = `Campurkan ke dalam satu tangki air Anda (${formatNumber(tankVolume)} Liter).`;
      }

      if (resTotalTanks) resTotalTanks.textContent = String(result.totalTanks);
      if (resExactTanks) resExactTanks.textContent = formatNumber(result.exactTanks, 2);
      if (resTotalWater) resTotalWater.textContent = formatNumber(result.totalWaterLiters, 1);

      if (resExactProductLarge) resExactProductLarge.textContent = formatNumber(result.exactProductLarge, 3);
      if (resExactProductLargeUnit) resExactProductLargeUnit.textContent = result.exactProductLargeUnit;
      if (resExactProductSmall) resExactProductSmall.textContent = formatNumber(result.exactProductSmall, 1);
      if (resExactProductSmallUnit) resExactProductSmallUnit.textContent = result.exactProductSmallUnit;

      if (resBatchProductLarge) resBatchProductLarge.textContent = formatNumber(result.batchProductLarge, 2);
      if (resBatchProductLargeUnit) resBatchProductLargeUnit.textContent = result.batchProductLargeUnit;
      if (resBatchProductSmall) resBatchProductSmall.textContent = formatNumber(result.batchProductSmall);
      if (resBatchProductSmallUnit) resBatchProductSmallUnit.textContent = result.batchProductSmallUnit;
      if (resBatchTanksCount) resBatchTanksCount.textContent = String(result.totalTanks);

      if (resPartialTank) resPartialTank.textContent = result.partialTankExplanation;

      // Update calculation steps
      if (resSteps) {
        resSteps.innerHTML = '';
        result.calculationSteps.forEach((step) => {
          const li = document.createElement('li');
          li.textContent = step;
          resSteps.appendChild(li);
        });
      }
    }

    const listeners: [HTMLElement | null, string][] = [
      [inputDose, 'input'],
      [inputDoseUnit, 'change'],
      [inputLabelTankVol, 'input'],
      [inputTankVol, 'input'],
      [inputArea, 'input'],
      [inputAreaUnit, 'change'],
      [inputSprayVol, 'input'],
    ];

    listeners.forEach(([elem, evt]) => {
      elem?.addEventListener(evt, recompute);
    });

    toggleLabelTankVisibility();
  }

  // Support direct and view transitions
  initDoseCalculator();
  document.addEventListener('astro:page-load', initDoseCalculator);
</script>
