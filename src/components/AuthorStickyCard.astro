---
/**
 * src/components/AuthorStickyCard.astro
 * Desktop Sticky Sidebar Card showcasing Arif Prabowo's agronomic profile & editorial credibility.
 * Adheres to DEC-016 (author identity), DESIGN §3 (tokens & 2px radius), and AGENTS.md.
 */
import AuthorAvatar from './AuthorAvatar.astro';

interface Props {
  author?: string;
  role?: string;
}

const {
  author = 'Arif Prabowo',
  role = 'Konsultan Pertanian Senior',
} = Astro.props;
---

<div class="sticky top-8 p-5 bg-white border border-[var(--color-border)] rounded-[2px] shadow-2xs space-y-4">
  <!-- Author Header with Portrait -->
  <div class="flex items-center gap-3.5">
    <AuthorAvatar size={52} class="w-13 h-13" />
    <div class="min-w-0 flex-1">
      <span class="block text-[10px] uppercase tracking-wider font-extrabold text-[var(--color-soil)]">
        Penulis & Agronomis
      </span>
      <h3 class="font-bold text-base text-[var(--color-text)] leading-tight truncate">
        {author}
      </h3>
      <p class="text-xs text-[var(--color-text-muted)] leading-snug mt-0.5">
        {role}
      </p>
    </div>
  </div>

  <!-- Trust / Role Badge -->
  <div class="flex items-center gap-2 px-2.5 py-1.5 bg-[var(--color-tint)] rounded-[2px] text-xs font-semibold text-[var(--color-brand-strong)]">
    <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
    <span>Pengelola Resmi Jurnal Tani</span>
  </div>

  <!-- Concise Agronomic Credentials (DEC-016) -->
  <p class="text-xs text-[var(--color-text-muted)] leading-relaxed font-sans">
    Praktisi agronomi berpengalaman >8 tahun di berbagai wilayah sentra tani Indonesia. Berfokus pada patologi tanaman, pemulihan kesuburan tanah masam, dan formulasi nutrisi presisi.
  </p>

  <!-- Editorial & Institutional Anchor -->
  <div class="pt-3 border-t border-[var(--color-border)]/70 text-[11px] text-[var(--color-text-muted)] space-y-0.5">
    <span class="font-bold text-[var(--color-soil)] block uppercase tracking-wider text-[10px]">
      PT Agritani Internasional
    </span>
    <p class="leading-normal">
      Portal pertanian sains & pendampingan lapangan petani Indonesia.
    </p>
  </div>

  <!-- Link to Full Author Dossier -->
  <div class="pt-1">
    <a
      href="/penulis/arif-prabowo/"
      class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-brand-strong)] hover:text-[var(--color-brand-hover)] hover:underline min-h-[32px]"
    >
      <span>Profil Lengkap & Arsip Panduan</span>
      <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</div>
