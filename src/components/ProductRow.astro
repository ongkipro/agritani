---
/**
 * src/components/ProductRow.astro
 * Open product row for the catalog index (T-11, DESIGN §2.5, §4.2.3)
 * Invariants: no cards/pills/kickers, touch target >= 44px, 2px radius, tabular numbers.
 */
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { getProductImage } from '../lib/product-images';

interface Props {
  product: CollectionEntry<'products'>;
  commoditiesMap: Map<string, string>;
}

const { product, commoditiesMap } = Astro.props;
const p = product.data;

const formatRupiah = (val: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
---

<article id={product.id} class="scroll-mt-24 py-10 first:pt-0">
  <div class="grid grid-cols-[6rem_1fr] sm:grid-cols-[10rem_1fr] lg:grid-cols-[12rem_1fr_14rem] gap-x-5 sm:gap-x-8 gap-y-5 items-start">
    <a
      href={`/produk/${product.id}/`}
      class="block aspect-square rounded-[2px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
      tabindex="-1"
      aria-hidden="true"
    >
      <Picture
        src={getProductImage(product.id)}
        formats={['webp']}
        widths={[200, 400]}
        sizes="(min-width: 1024px) 12rem, (min-width: 640px) 10rem, 6rem"
        quality={85}
        alt={`Kemasan ${p.name}`}
        class="w-full h-full object-contain"
        loading="lazy"
      />
    </a>

    <div class="space-y-3 min-w-0">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-[var(--color-text)] leading-tight">
        <a
          href={`/produk/${product.id}/`}
          class="hover:text-[var(--color-brand-strong)] rounded-[2px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          {p.name}
        </a>
      </h2>
      {p.tagline && <p class="text-sm font-semibold text-[var(--color-soil)]">{p.tagline}</p>}
      <p class="text-base text-[var(--color-text)] leading-relaxed">{p.role}</p>
      <p class="hidden sm:block text-sm text-[var(--color-text-muted)] leading-relaxed">{p.summary}</p>

      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm pt-1">
        <div>
          <dt class="text-[var(--color-text-muted)]">Komoditas sasaran</dt>
          <dd class="mt-0.5 text-[var(--color-text)]">
            {p.commodities.slice(0, 5).map((c) => commoditiesMap.get(typeof c === 'string' ? c : c.id) || c).join(', ')}
            {p.commodities.length > 5 && ` (+${p.commodities.length - 5} lainnya)`}
          </dd>
        </div>
        <div>
          <dt class="text-[var(--color-text-muted)]">Cara aplikasi</dt>
          <dd class="mt-0.5 text-[var(--color-text)]">{p.applicationMethods.join(' & ')}</dd>
        </div>
      </dl>
    </div>

    <div class="col-span-2 lg:col-span-1 space-y-3">
      {p.variants && p.variants.length > 0 && (
        <dl class="text-sm tabular-nums divide-y divide-[var(--color-border)]">
          {p.variants.map((v) => (
            <div class="flex items-baseline justify-between gap-4 py-2 first:pt-0">
              <dt class="text-[var(--color-text-muted)]">Kemasan {v.size}</dt>
              <dd class="font-semibold text-[var(--color-text)]">{formatRupiah(v.price)}</dd>
            </div>
          ))}
        </dl>
      )}
      <a href={`/produk/${product.id}/`} class="link-more text-sm">
        Dosis & rincian<span class="sr-only"> {p.name}</span> &rarr;
      </a>
    </div>
  </div>
</article>
