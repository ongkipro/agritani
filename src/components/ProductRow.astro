---
/**
 * src/components/ProductRow.astro
 * Comparison row / card for product index (T-11, DESIGN §2.5, §4.2.3)
 * Invariants: Touch target >= 44px, 2px radius, text contrast >= 7:1, no divider lines.
 */
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { getProductImage } from '../lib/product-images';

interface Props {
  product: CollectionEntry<'products'>;
  commoditiesMap: Map<string, string>;
}

const { product, commoditiesMap } = Astro.props;
const p = product.data;

const categoryBadges: Record<string, string> = {
  aussie: 'Perkebunan & Tanaman Keras',
  kojien: 'Teknologi Thailand · Spesialis Padi',
  bensu: 'Teknologi Thailand · Pangan & Hortikultura',
  saratoga: 'Japanese Pro-Plant Complex · Asam Amino',
};
const categoryBadge = categoryBadges[product.id] || 'Nutrisi & Biostimulan';
---

<article
  id={product.id}
  class="scroll-mt-24 py-10 sm:py-12 border-b border-[var(--color-border)] last:border-b-0"
>
  <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 lg:gap-8">
    <!-- Product Packshot Visual -->
    <a
      href={`/produk/${product.id}/`}
      class="w-36 h-36 sm:w-44 sm:h-44 aspect-square shrink-0 flex items-center justify-center p-3 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] group self-center sm:self-start overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)] focus-visible:ring-offset-2"
      aria-label={`Lihat detail produk ${p.name}`}
    >
      <Picture
        src={getProductImage(product.id)}
        formats={['webp']}
        widths={[180, 360]}
        sizes="11rem"
        quality={85}
        alt={`Kemasan ${p.name}`}
        class="w-full h-full object-contain transition-transform duration-300 ease-out group-hover:scale-105"
        loading="lazy"
      />
    </a>

    <!-- Main Info -->
    <div class="space-y-4 flex-1">
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="inline-flex items-center px-2 py-0.5 text-xs font-semibold text-[var(--color-brand-strong)] bg-[var(--color-tint)] border border-[var(--color-brand-strong)]/20 rounded-[2px]">
            {categoryBadge}
          </span>
          {p.tagline && (
            <span class="text-xs sm:text-sm font-semibold text-[var(--color-soil)]">
              {p.tagline}
            </span>
          )}
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-[var(--color-brand)] tracking-tight">
          <a
            href={`/produk/${product.id}/`}
            class="hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
          >
            {p.name}
          </a>
        </h2>
        <p class="mt-1 text-base sm:text-lg font-medium text-[var(--color-text)]">
          {p.role}
        </p>
      </div>

      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
        {p.summary}
      </p>

      <!-- Specifications Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-sm">
        <div>
          <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1">
            Komoditas Sasaran
          </span>
          <p class="text-[var(--color-text)] font-medium text-sm leading-snug">
            {p.commodities.map((c) => commoditiesMap.get(typeof c === 'string' ? c : c.id) || (typeof c === 'string' ? c : c.id)).join(', ')}
          </p>
        </div>

        <div>
          <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1">
            Bentuk & Cara Aplikasi
          </span>
          <p class="text-[var(--color-text)] font-medium mb-1 text-sm">
            {p.form || 'Cairan konsentrat'}
          </p>
          <ul class="text-xs sm:text-sm text-[var(--color-text-muted)] list-disc pl-4 space-y-0.5">
            {p.applicationMethods.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Action Link -->
    <div class="w-full sm:w-auto lg:self-center shrink-0 pt-2 lg:pt-0">
      <a
        href={`/produk/${product.id}/`}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3 min-h-[44px] text-sm font-semibold bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white rounded-[2px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-strong)] focus-visible:ring-offset-2 shadow-2xs"
      >
        <span>Lihat Spesifikasi & Dosis</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
