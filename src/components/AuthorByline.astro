---
import AuthorAvatar from './AuthorAvatar.astro';

interface Props {
  author?: string;
  role?: string;
}

const { author = 'Arif Prabowo', role = 'Konsultan Pertanian Senior · Pengelola Jurnal Tani' } = Astro.props;
---

<div class="flex items-center gap-3.5 my-4">
  <AuthorAvatar size={40} class="w-10 h-10" />
  <address class="not-italic text-sm leading-snug">
    <div>
      <span class="text-[var(--color-text-muted)]">Oleh</span>
      <a
        href="/penulis/arif-prabowo/"
        class="font-semibold text-[var(--color-text)] hover:underline ml-1"
      >
        {author}
      </a>
    </div>
    <div class="text-[var(--color-text-muted)] text-xs mt-0.5">
      {role}
    </div>
  </address>
</div>
