---
/**
 * src/components/RegionPicker.astro
 * 4-level cascading region picker for Cuaca Tani (REQ-10, ARCHITECTURE §5b).
 * Styled with shadcn-ui inspired Combobox pattern & max-h-52 (~5 items) scrollable list.
 * Loads tiered Kemendagri JSON files: Provinsi -> Kabupaten -> Kecamatan -> Desa.
 */
import fs from 'node:fs';
import path from 'node:path';

// Load provinces at build time for instant SSR rendering
let provinces: Array<{ kode: string; nama: string }> = [];
try {
  const provPath = path.resolve('public/wilayah/provinsi.json');
  if (fs.existsSync(provPath)) {
    provinces = JSON.parse(fs.readFileSync(provPath, 'utf-8'));
  }
} catch {
  provinces = [];
}
---

<div id="region-picker-root" class="bg-[var(--color-surface)] p-5 sm:p-7 border border-[var(--color-border)] rounded-[2px] space-y-6">
  <div class="border-b border-[var(--color-border)] pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <span class="block text-xs font-bold text-[var(--color-soil)] mb-0.5">
        Langkah 1: Tentukan Lokasi Lahan
      </span>
      <p class="text-xs text-[var(--color-text-muted)]">
        Pilih wilayah administrasi desa atau kelurahan untuk mengambil prakiraan cuaca resmi BMKG tingkat tapak.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Level 1: Provinsi -->
    <div class="space-y-1.5 relative region-level-container" data-level="provinsi">
      <div class="flex items-center justify-between">
        <label id="label-provinsi" for="combobox-trigger-provinsi" class="block text-xs font-bold text-[var(--color-text)]">
          1. Provinsi
        </label>
        <span id="badge-provinsi" class="text-[11px] font-semibold text-[var(--color-brand-strong)] hidden">✓ Terpilih</span>
      </div>
      <div class="relative">
        <!-- Native select preserved sr-only for form & automated checks compatibility -->
        <select id="select-provinsi" class="sr-only" tabindex="-1" aria-hidden="true">
          <option value="">-- Pilih Provinsi --</option>
          {provinces.map((p) => (
            <option value={p.kode}>{p.nama}</option>
          ))}
        </select>

        <!-- Trigger Button (shadcn SelectTrigger style) -->
        <button
          type="button"
          id="combobox-trigger-provinsi"
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="combobox-popover-provinsi"
          aria-labelledby="label-provinsi combobox-label-provinsi"
          class="w-full pl-3.5 pr-9 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] shadow-2xs hover:border-[var(--color-brand)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-strong)] focus-visible:ring-offset-1 text-sm font-medium cursor-pointer transition-colors flex items-center justify-between text-left disabled:opacity-45 disabled:bg-[var(--color-canvas)] disabled:hover:border-[var(--color-border-control)] disabled:cursor-not-allowed"
        >
          <span id="combobox-label-provinsi" class="truncate text-[var(--color-text-muted)]">
            -- Pilih Provinsi --
          </span>
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-[var(--color-soil)] transition-transform duration-200" aria-hidden="true">
            <svg class="w-4 h-4 chevron-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 8 4 4 4-4"/>
            </svg>
          </span>
        </button>

        <!-- Dropdown Popover (shadcn SelectContent / Command style) -->
        <div
          id="combobox-popover-provinsi"
          role="listbox"
          aria-labelledby="label-provinsi"
          class="hidden absolute top-full left-0 right-0 z-50 mt-1.5 bg-[var(--color-surface)] border border-[var(--color-border-control)] rounded-[2px] shadow-lg overflow-hidden"
        >
          <!-- Search Box (CommandInput style) -->
          <div class="p-2.5 border-b border-[var(--color-border)] bg-[var(--color-surface)] flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--color-soil)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="text"
              id="combobox-search-provinsi"
              placeholder="Cari provinsi..."
              autocomplete="off"
              aria-label="Cari provinsi"
              class="w-full bg-transparent text-base sm:text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] outline-none border-none p-0 focus:ring-0 font-medium"
            />
            <button
              type="button"
              id="combobox-clear-provinsi"
              class="hidden p-1 text-[var(--color-text-muted)] hover:text-[var(--color-text)] rounded-[2px] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)] cursor-pointer"
              aria-label="Hapus pencarian provinsi"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <!-- Scrolling List (CommandList style, max-h-60 sm:max-h-52 = shows ~5-6 items) -->
          <div
            id="combobox-list-provinsi"
            class="combobox-scroll-list max-h-60 sm:max-h-52 overflow-y-auto overscroll-contain p-1 space-y-0.5"
          >
            {provinces.map((p) => (
              <div
                role="option"
                data-value={p.kode}
                data-label={p.nama}
                aria-selected="false"
                tabindex="-1"
                class="combobox-item px-3.5 py-2.5 text-sm text-[var(--color-text)] rounded-[2px] cursor-pointer flex items-center justify-between hover:bg-[var(--color-tint)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px] select-none"
              >
                <span class="truncate">{p.nama}</span>
                <svg class="w-4 h-4 text-[var(--color-brand)] shrink-0 hidden check-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m4 10 4 4 8-8"/>
                </svg>
              </div>
            ))}
          </div>

          <!-- Empty state -->
          <div
            id="combobox-empty-provinsi"
            class="hidden py-6 px-3 text-center text-xs sm:text-sm text-[var(--color-text-muted)]"
          >
            Tidak ada provinsi ditemukan
          </div>
        </div>
      </div>
    </div>

    <!-- Level 2: Kabupaten / Kota -->
    <div class="space-y-1.5 relative region-level-container" data-level="kabupaten">
      <div class="flex items-center justify-between">
        <label id="label-kabupaten" for="combobox-trigger-kabupaten" class="block text-xs font-bold text-[var(--color-text)]">
          2. Kabupaten / Kota
        </label>
        <span id="badge-kabupaten" class="text-[11px] font-semibold text-[var(--color-brand-strong)] hidden">✓ Terpilih</span>
      </div>
      <div class="relative">
        <select id="select-kabupaten" disabled class="sr-only" tabindex="-1" aria-hidden="true">
          <option value="">-- Pilih Kabupaten --</option>
        </select>

        <button
          type="button"
          id="combobox-trigger-kabupaten"
          disabled
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="combobox-popover-kabupaten"
          aria-labelledby="label-kabupaten combobox-label-kabupaten"
          class="w-full pl-3.5 pr-9 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] shadow-2xs hover:border-[var(--color-brand)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-strong)] focus-visible:ring-offset-1 text-sm font-medium cursor-pointer transition-colors flex items-center justify-between text-left disabled:opacity-45 disabled:bg-[var(--color-canvas)] disabled:hover:border-[var(--color-border-control)] disabled:cursor-not-allowed"
        >
          <span id="combobox-label-kabupaten" class="truncate text-[var(--color-text-muted)]">
            -- Pilih Kabupaten --
          </span>
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-[var(--color-soil)] opacity-50 transition-transform duration-200" aria-hidden="true">
            <svg class="w-4 h-4 chevron-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 8 4 4 4-4"/>
            </svg>
          </span>
        </button>

        <div
          id="combobox-popover-kabupaten"
          role="listbox"
          aria-labelledby="label-kabupaten"
          class="hidden absolute top-full left-0 right-0 z-50 mt-1.5 bg-[var(--color-surface)] border border-[var(--color-border-control)] rounded-[2px] shadow-lg overflow-hidden"
        >
          <div class="p-2.5 border-b border-[var(--color-border)] bg-[var(--color-surface)] flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--color-soil)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="text"
              id="combobox-search-kabupaten"
              placeholder="Cari kabupaten/kota..."
              autocomplete="off"
              aria-label="Cari kabupaten atau kota"
              class="w-full bg-transparent text-base sm:text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] outline-none border-none p-0 focus:ring-0 font-medium"
            />
            <button
              type="button"
              id="combobox-clear-kabupaten"
              class="hidden p-1 text-[var(--color-text-muted)] hover:text-[var(--color-text)] rounded-[2px] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)] cursor-pointer"
              aria-label="Hapus pencarian kabupaten"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <div
            id="combobox-list-kabupaten"
            class="combobox-scroll-list max-h-60 sm:max-h-52 overflow-y-auto overscroll-contain p-1 space-y-0.5"
          >
          </div>

          <div
            id="combobox-empty-kabupaten"
            class="hidden py-6 px-3 text-center text-xs sm:text-sm text-[var(--color-text-muted)]"
          >
            Tidak ada kabupaten/kota ditemukan
          </div>
        </div>
      </div>
    </div>

    <!-- Level 3: Kecamatan -->
    <div class="space-y-1.5 relative region-level-container" data-level="kecamatan">
      <div class="flex items-center justify-between">
        <label id="label-kecamatan" for="combobox-trigger-kecamatan" class="block text-xs font-bold text-[var(--color-text)]">
          3. Kecamatan
        </label>
        <span id="badge-kecamatan" class="text-[11px] font-semibold text-[var(--color-brand-strong)] hidden">✓ Terpilih</span>
      </div>
      <div class="relative">
        <select id="select-kecamatan" disabled class="sr-only" tabindex="-1" aria-hidden="true">
          <option value="">-- Pilih Kecamatan --</option>
        </select>

        <button
          type="button"
          id="combobox-trigger-kecamatan"
          disabled
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="combobox-popover-kecamatan"
          aria-labelledby="label-kecamatan combobox-label-kecamatan"
          class="w-full pl-3.5 pr-9 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] shadow-2xs hover:border-[var(--color-brand)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-strong)] focus-visible:ring-offset-1 text-sm font-medium cursor-pointer transition-colors flex items-center justify-between text-left disabled:opacity-45 disabled:bg-[var(--color-canvas)] disabled:hover:border-[var(--color-border-control)] disabled:cursor-not-allowed"
        >
          <span id="combobox-label-kecamatan" class="truncate text-[var(--color-text-muted)]">
            -- Pilih Kecamatan --
          </span>
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-[var(--color-soil)] opacity-50 transition-transform duration-200" aria-hidden="true">
            <svg class="w-4 h-4 chevron-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 8 4 4 4-4"/>
            </svg>
          </span>
        </button>

        <div
          id="combobox-popover-kecamatan"
          role="listbox"
          aria-labelledby="label-kecamatan"
          class="hidden absolute top-full left-0 right-0 z-50 mt-1.5 bg-[var(--color-surface)] border border-[var(--color-border-control)] rounded-[2px] shadow-lg overflow-hidden"
        >
          <div class="p-2.5 border-b border-[var(--color-border)] bg-[var(--color-surface)] flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--color-soil)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="text"
              id="combobox-search-kecamatan"
              placeholder="Cari kecamatan..."
              autocomplete="off"
              aria-label="Cari kecamatan"
              class="w-full bg-transparent text-base sm:text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] outline-none border-none p-0 focus:ring-0 font-medium"
            />
            <button
              type="button"
              id="combobox-clear-kecamatan"
              class="hidden p-1 text-[var(--color-text-muted)] hover:text-[var(--color-text)] rounded-[2px] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)] cursor-pointer"
              aria-label="Hapus pencarian kecamatan"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <div
            id="combobox-list-kecamatan"
            class="combobox-scroll-list max-h-60 sm:max-h-52 overflow-y-auto overscroll-contain p-1 space-y-0.5"
          >
          </div>

          <div
            id="combobox-empty-kecamatan"
            class="hidden py-6 px-3 text-center text-xs sm:text-sm text-[var(--color-text-muted)]"
          >
            Tidak ada kecamatan ditemukan
          </div>
        </div>
      </div>
    </div>

    <!-- Level 4: Desa / Kelurahan -->
    <div class="space-y-1.5 relative region-level-container" data-level="desa">
      <div class="flex items-center justify-between">
        <label id="label-desa" for="combobox-trigger-desa" class="block text-xs font-bold text-[var(--color-text)]">
          4. Desa / Kelurahan
        </label>
        <span id="badge-desa" class="text-[11px] font-semibold text-[var(--color-brand-strong)] hidden">✓ Terpilih</span>
      </div>
      <div class="relative">
        <select id="select-desa" disabled class="sr-only" tabindex="-1" aria-hidden="true">
          <option value="">-- Pilih Desa --</option>
        </select>

        <button
          type="button"
          id="combobox-trigger-desa"
          disabled
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="combobox-popover-desa"
          aria-labelledby="label-desa combobox-label-desa"
          class="w-full pl-3.5 pr-9 py-2.5 min-h-[44px] bg-[var(--color-surface)] text-[var(--color-text)] border border-[var(--color-border-control)] rounded-[2px] shadow-2xs hover:border-[var(--color-brand)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-strong)] focus-visible:ring-offset-1 text-sm font-medium cursor-pointer transition-colors flex items-center justify-between text-left disabled:opacity-45 disabled:bg-[var(--color-canvas)] disabled:hover:border-[var(--color-border-control)] disabled:cursor-not-allowed"
        >
          <span id="combobox-label-desa" class="truncate text-[var(--color-text-muted)]">
            -- Pilih Desa --
          </span>
          <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-[var(--color-soil)] opacity-50 transition-transform duration-200" aria-hidden="true">
            <svg class="w-4 h-4 chevron-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 8 4 4 4-4"/>
            </svg>
          </span>
        </button>

        <div
          id="combobox-popover-desa"
          role="listbox"
          aria-labelledby="label-desa"
          class="hidden absolute top-full left-0 right-0 z-50 mt-1.5 bg-[var(--color-surface)] border border-[var(--color-border-control)] rounded-[2px] shadow-lg overflow-hidden"
        >
          <div class="p-2.5 border-b border-[var(--color-border)] bg-[var(--color-surface)] flex items-center gap-2">
            <svg class="w-4 h-4 text-[var(--color-soil)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="text"
              id="combobox-search-desa"
              placeholder="Cari desa/kelurahan..."
              autocomplete="off"
              aria-label="Cari desa atau kelurahan"
              class="w-full bg-transparent text-base sm:text-sm text-[var(--color-text)] placeholder:text-[var(--color-text-muted)] outline-none border-none p-0 focus:ring-0 font-medium"
            />
            <button
              type="button"
              id="combobox-clear-desa"
              class="hidden p-1 text-[var(--color-text-muted)] hover:text-[var(--color-text)] rounded-[2px] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)] cursor-pointer"
              aria-label="Hapus pencarian desa"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <div
            id="combobox-list-desa"
            class="combobox-scroll-list max-h-60 sm:max-h-52 overflow-y-auto overscroll-contain p-1 space-y-0.5"
          >
          </div>

          <div
            id="combobox-empty-desa"
            class="hidden py-6 px-3 text-center text-xs sm:text-sm text-[var(--color-text-muted)]"
          >
            Tidak ada desa/kelurahan ditemukan
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Active Selection Summary Card (Appears when location is fully selected) -->
  <div id="region-active-summary" class="hidden p-4 bg-[var(--color-tint)] border border-[var(--color-brand)]/20 rounded-[2px] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs sm:text-sm">
    <div class="flex items-start sm:items-center gap-2.5">
      <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[var(--color-brand)] text-white text-xs shrink-0 mt-0.5 sm:mt-0 font-bold" aria-hidden="true">✓</span>
      <div>
        <span class="font-bold text-[var(--color-brand-strong)]">Lokasi Terpilih:</span>
        <span id="region-active-text" class="font-medium text-[var(--color-text)] ml-1"></span>
      </div>
    </div>
    <div class="flex items-center gap-3 shrink-0 self-end sm:self-auto">
      <button
        type="button"
        id="region-reset-btn"
        class="inline-flex items-center gap-1 text-xs font-bold text-[var(--color-brand-strong)] hover:text-[var(--color-brand-hover)] hover:underline min-h-[36px] cursor-pointer"
      >
        <span>Ganti Wilayah</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </div>

  <!-- Status / Loading Indicator for Region Picker -->
  <div class="flex items-center justify-between text-xs text-[var(--color-text-muted)] pt-1">
    <span id="region-status-text" class="font-medium">Pilih provinsi untuk memulai.</span>
    <span id="region-remember-badge" class="hidden tabular-nums text-xs text-[var(--color-soil)] font-medium">
      ✓ Lokasi tersimpan di perangkat
    </span>
  </div>
</div>

<style>
  /* Subtle scrollbar matching shadcn ScrollArea */
  .combobox-scroll-list::-webkit-scrollbar {
    width: 6px;
  }
  .combobox-scroll-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .combobox-scroll-list::-webkit-scrollbar-thumb {
    background-color: var(--color-border-control);
    border-radius: 2px;
  }
  .combobox-scroll-list {
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-control) transparent;
  }
</style>

<script>
  interface RegencyItem {
    kode: string;
    nama: string;
  }

  interface VillageItem {
    kode: string;
    nama: string;
  }

  interface DistrictItem {
    kode: string;
    nama: string;
    desa: VillageItem[];
  }

  interface RegencyDetail {
    kode: string;
    nama: string;
    kecamatan: DistrictItem[];
  }

  type RegionLevel = 'provinsi' | 'kabupaten' | 'kecamatan' | 'desa';

  const STORAGE_KEY = 'agritani_last_region';

  const PLACEHOLDERS: Record<RegionLevel, string> = {
    provinsi: '-- Pilih Provinsi --',
    kabupaten: '-- Pilih Kabupaten --',
    kecamatan: '-- Pilih Kecamatan --',
    desa: '-- Pilih Desa --',
  };

  function initRegionPicker() {
    const root = document.getElementById('region-picker-root');
    if (!root) return;

    // Elements
    const selectProv = document.getElementById('select-provinsi') as HTMLSelectElement | null;
    const selectKab = document.getElementById('select-kabupaten') as HTMLSelectElement | null;
    const selectKec = document.getElementById('select-kecamatan') as HTMLSelectElement | null;
    const selectDesa = document.getElementById('select-desa') as HTMLSelectElement | null;

    const triggerProv = document.getElementById('combobox-trigger-provinsi') as HTMLButtonElement | null;
    const triggerKab = document.getElementById('combobox-trigger-kabupaten') as HTMLButtonElement | null;
    const triggerKec = document.getElementById('combobox-trigger-kecamatan') as HTMLButtonElement | null;
    const triggerDesa = document.getElementById('combobox-trigger-desa') as HTMLButtonElement | null;

    const labelProv = document.getElementById('combobox-label-provinsi');
    const labelKab = document.getElementById('combobox-label-kabupaten');
    const labelKec = document.getElementById('combobox-label-kecamatan');
    const labelDesa = document.getElementById('combobox-label-desa');

    const popoverProv = document.getElementById('combobox-popover-provinsi');
    const popoverKab = document.getElementById('combobox-popover-kabupaten');
    const popoverKec = document.getElementById('combobox-popover-kecamatan');
    const popoverDesa = document.getElementById('combobox-popover-desa');

    const listProv = document.getElementById('combobox-list-provinsi');
    const listKab = document.getElementById('combobox-list-kabupaten');
    const listKec = document.getElementById('combobox-list-kecamatan');
    const listDesa = document.getElementById('combobox-list-desa');

    const searchProv = document.getElementById('combobox-search-provinsi') as HTMLInputElement | null;
    const searchKab = document.getElementById('combobox-search-kabupaten') as HTMLInputElement | null;
    const searchKec = document.getElementById('combobox-search-kecamatan') as HTMLInputElement | null;
    const searchDesa = document.getElementById('combobox-search-desa') as HTMLInputElement | null;

    const clearProv = document.getElementById('combobox-clear-provinsi') as HTMLButtonElement | null;
    const clearKab = document.getElementById('combobox-clear-kabupaten') as HTMLButtonElement | null;
    const clearKec = document.getElementById('combobox-clear-kecamatan') as HTMLButtonElement | null;
    const clearDesa = document.getElementById('combobox-clear-desa') as HTMLButtonElement | null;

    const badgeProv = document.getElementById('badge-provinsi');
    const badgeKab = document.getElementById('badge-kabupaten');
    const badgeKec = document.getElementById('badge-kecamatan');
    const badgeDesa = document.getElementById('badge-desa');

    const emptyProv = document.getElementById('combobox-empty-provinsi');
    const emptyKab = document.getElementById('combobox-empty-kabupaten');
    const emptyKec = document.getElementById('combobox-empty-kecamatan');
    const emptyDesa = document.getElementById('combobox-empty-desa');

    const statusText = document.getElementById('region-status-text');
    const rememberBadge = document.getElementById('region-remember-badge');
    const activeSummary = document.getElementById('region-active-summary');
    const activeText = document.getElementById('region-active-text');
    const resetBtn = document.getElementById('region-reset-btn');

    if (!selectProv || !selectKab || !selectKec || !selectDesa) return;
    if (!triggerProv || !triggerKab || !triggerKec || !triggerDesa) return;

    const triggers: Record<RegionLevel, HTMLButtonElement> = {
      provinsi: triggerProv,
      kabupaten: triggerKab,
      kecamatan: triggerKec,
      desa: triggerDesa,
    };

    const labels: Record<RegionLevel, HTMLElement | null> = {
      provinsi: labelProv,
      kabupaten: labelKab,
      kecamatan: labelKec,
      desa: labelDesa,
    };

    const badges: Record<RegionLevel, HTMLElement | null> = {
      provinsi: badgeProv,
      kabupaten: badgeKab,
      kecamatan: badgeKec,
      desa: badgeDesa,
    };

    const popovers: Record<RegionLevel, HTMLElement | null> = {
      provinsi: popoverProv,
      kabupaten: popoverKab,
      kecamatan: popoverKec,
      desa: popoverDesa,
    };

    const lists: Record<RegionLevel, HTMLElement | null> = {
      provinsi: listProv,
      kabupaten: listKab,
      kecamatan: listKec,
      desa: listDesa,
    };

    const searches: Record<RegionLevel, HTMLInputElement | null> = {
      provinsi: searchProv,
      kabupaten: searchKab,
      kecamatan: searchKec,
      desa: searchDesa,
    };

    const clears: Record<RegionLevel, HTMLButtonElement | null> = {
      provinsi: clearProv,
      kabupaten: clearKab,
      kecamatan: clearKec,
      desa: clearDesa,
    };

    const empties: Record<RegionLevel, HTMLElement | null> = {
      provinsi: emptyProv,
      kabupaten: emptyKab,
      kecamatan: emptyKec,
      desa: emptyDesa,
    };

    const selects: Record<RegionLevel, HTMLSelectElement> = {
      provinsi: selectProv,
      kabupaten: selectKab,
      kecamatan: selectKec,
      desa: selectDesa,
    };

    let activeRegencyData: RegencyDetail | null = null;

    // Check URL search params first (e.g. ?adm4=32.04.10.2001)
    const urlParams = new URLSearchParams(window.location.search);
    const initialAdm4 = urlParams.get('adm4');

    async function loadRegenciesForProvince(provKode: string): Promise<RegencyItem[]> {
      if (!provKode) return [];
      const res = await fetch(`/wilayah/${provKode}.json`);
      if (!res.ok) throw new Error(`Gagal memuat kabupaten untuk provinsi ${provKode}`);
      return res.json();
    }

    async function loadRegencyDetail(kabKode: string): Promise<RegencyDetail> {
      if (!kabKode) throw new Error('Kode kabupaten kosong');
      const res = await fetch(`/wilayah/${kabKode}.json`);
      if (!res.ok) throw new Error(`Gagal memuat data kecamatan untuk kabupaten ${kabKode}`);
      return res.json();
    }

    function saveLastLocation(loc: { prov: string; kab: string; kec: string; desa: string }) {
      try {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify(loc));
        if (rememberBadge) rememberBadge.classList.remove('hidden');
      } catch {
        // localStorage might be disabled; ignore gracefully
      }
    }

    function dispatchSelectedAdm4(adm4: string, label: string) {
      // Dispatch custom event for ForecastTable component
      window.dispatchEvent(
        new CustomEvent('agritani:region-selected', {
          detail: { adm4, label },
        })
      );

      // Update URL query string without reloading
      const url = new URL(window.location.href);
      url.searchParams.set('adm4', adm4);
      window.history.replaceState({ adm4 }, '', url.toString());
    }

    // Popover Open / Close Controls
    function closePopover(lvl: RegionLevel) {
      const popover = popovers[lvl];
      const trigger = triggers[lvl];
      const search = searches[lvl];
      const container = root ? root.querySelector(`.region-level-container[data-level="${lvl}"]`) : null;

      if (popover) popover.classList.add('hidden');
      if (search && document.activeElement === search) {
        search.blur();
      }
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
        const chevron = trigger.querySelector('.chevron-icon');
        if (chevron) chevron.classList.remove('rotate-180');
      }
      if (container) {
        container.classList.remove('z-30');
      }
    }

    function closeAllPopovers() {
      const levels: RegionLevel[] = ['provinsi', 'kabupaten', 'kecamatan', 'desa'];
      levels.forEach(closePopover);
    }

    function openPopover(lvl: RegionLevel) {
      const popover = popovers[lvl];
      const trigger = triggers[lvl];
      const search = searches[lvl];
      const list = lists[lvl];
      const empty = empties[lvl];
      const clearBtn = clears[lvl];
      const container = root ? root.querySelector(`.region-level-container[data-level="${lvl}"]`) : null;

      if (!popover || !trigger || trigger.disabled) return;

      closeAllPopovers();

      popover.classList.remove('hidden');
      trigger.setAttribute('aria-expanded', 'true');
      const chevron = trigger.querySelector('.chevron-icon');
      if (chevron) chevron.classList.add('rotate-180');
      if (container) container.classList.add('z-30');

      // Reset search filter
      if (search) {
        search.value = '';
        if (clearBtn) clearBtn.classList.add('hidden');

        // Only autofocus on non-touch / desktop screens to prevent mobile virtual keyboard popup and viewport shifting
        const isTouch = window.matchMedia('(max-width: 640px)').matches || window.matchMedia('(pointer: coarse)').matches;
        if (!isTouch) {
          search.focus();
        }
      }
      if (list) {
        const items = list.querySelectorAll<HTMLElement>('.combobox-item');
        items.forEach((it) => it.classList.remove('hidden'));
        const selected = list.querySelector<HTMLElement>('[aria-selected="true"]');
        if (selected) {
          selected.scrollIntoView({ block: 'nearest' });
        }
      }
      if (empty) empty.classList.add('hidden');
    }

    function togglePopover(lvl: RegionLevel) {
      const popover = popovers[lvl];
      if (popover && !popover.classList.contains('hidden')) {
        closePopover(lvl);
      } else {
        openPopover(lvl);
      }
    }

    // Set Selection
    function setTriggerSelected(lvl: RegionLevel, kode: string, nama: string) {
      const select = selects[lvl];
      const label = labels[lvl];
      const list = lists[lvl];
      const badge = badges[lvl];

      if (select) select.value = kode;
      if (label) {
        label.textContent = nama || PLACEHOLDERS[lvl];
        if (kode) {
          label.classList.remove('text-[var(--color-text-muted)]');
          label.classList.add('text-[var(--color-text)]', 'font-semibold');
          if (badge) badge.classList.remove('hidden');
        } else {
          label.classList.add('text-[var(--color-text-muted)]');
          label.classList.remove('text-[var(--color-text)]', 'font-semibold');
          if (badge) badge.classList.add('hidden');
        }
      }

      if (list) {
        const items = list.querySelectorAll<HTMLElement>('.combobox-item');
        items.forEach((it) => {
          const isSelected = it.dataset.value === kode;
          it.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          const checkIcon = it.querySelector('.check-icon');
          if (isSelected) {
            it.classList.add('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
            if (checkIcon) checkIcon.classList.remove('hidden');
          } else {
            it.classList.remove('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
            if (checkIcon) checkIcon.classList.add('hidden');
          }
        });
      }
    }

    function enableLevel(lvl: RegionLevel) {
      const trigger = triggers[lvl];
      const select = selects[lvl];
      if (trigger) {
        trigger.disabled = false;
        const iconWrapper = trigger.querySelector('.opacity-50');
        if (iconWrapper) iconWrapper.classList.remove('opacity-50');
      }
      if (select) select.disabled = false;
    }

    function disableLevel(lvl: RegionLevel) {
      closePopover(lvl);
      const trigger = triggers[lvl];
      const select = selects[lvl];
      const label = labels[lvl];
      const list = lists[lvl];
      const badge = badges[lvl];

      if (badge) badge.classList.add('hidden');
      if (trigger) {
        trigger.disabled = true;
        const chevronWrapper = trigger.querySelector('span.pointer-events-none');
        if (chevronWrapper) chevronWrapper.classList.add('opacity-50');
      }
      if (select) {
        select.disabled = true;
        select.value = '';
        select.innerHTML = `<option value="">${PLACEHOLDERS[lvl]}</option>`;
      }
      if (label) {
        label.textContent = PLACEHOLDERS[lvl];
        label.classList.add('text-[var(--color-text-muted)]');
        label.classList.remove('text-[var(--color-text)]', 'font-semibold');
      }
      if (list) {
        list.innerHTML = '';
      }
    }

    function renderList(
      lvl: RegionLevel,
      items: Array<{ kode: string; nama: string }>,
      selectedKode = ''
    ) {
      const list = lists[lvl];
      const select = selects[lvl];
      if (!list || !select) return;

      list.innerHTML = '';
      select.innerHTML = `<option value="">${PLACEHOLDERS[lvl]}</option>`;

      items.forEach((item) => {
        // Native option
        const opt = document.createElement('option');
        opt.value = item.kode;
        opt.textContent = item.nama;
        if (item.kode === selectedKode) opt.selected = true;
        select.appendChild(opt);

        // Combobox item
        const itemEl = document.createElement('div');
        itemEl.role = 'option';
        itemEl.dataset.value = item.kode;
        itemEl.dataset.label = item.nama;
        itemEl.tabIndex = -1;
        itemEl.className =
          'combobox-item px-3.5 py-2.5 text-sm text-[var(--color-text)] rounded-[2px] cursor-pointer flex items-center justify-between hover:bg-[var(--color-tint)] hover:text-[var(--color-brand-strong)] transition-colors min-h-[44px] select-none';

        const isSelected = item.kode === selectedKode;
        itemEl.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        if (isSelected) {
          itemEl.classList.add('bg-[var(--color-tint)]', 'font-semibold', 'text-[var(--color-brand-strong)]');
        }

        const textSpan = document.createElement('span');
        textSpan.className = 'truncate';
        textSpan.textContent = item.nama;
        itemEl.appendChild(textSpan);

        const checkSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        checkSvg.setAttribute(
          'class',
          `w-4 h-4 text-[var(--color-brand)] shrink-0 check-icon ${isSelected ? '' : 'hidden'}`
        );
        checkSvg.setAttribute('viewBox', '0 0 20 20');
        checkSvg.setAttribute('fill', 'none');
        checkSvg.setAttribute('stroke', 'currentColor');
        checkSvg.setAttribute('stroke-width', '2.5');
        checkSvg.setAttribute('stroke-linecap', 'round');
        checkSvg.setAttribute('stroke-linejoin', 'round');
        checkSvg.setAttribute('aria-hidden', 'true');

        const pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        pathEl.setAttribute('d', 'm4 10 4 4 8-8');
        checkSvg.appendChild(pathEl);
        itemEl.appendChild(checkSvg);

        itemEl.addEventListener('click', () => {
          handleSelectOption(lvl, item.kode, item.nama);
        });

        list.appendChild(itemEl);
      });
    }

    // Attach click listeners to SSR-rendered Provinsi items
    if (listProv) {
      const provItems = listProv.querySelectorAll<HTMLElement>('.combobox-item');
      provItems.forEach((it) => {
        it.addEventListener('click', () => {
          const kode = it.dataset.value || '';
          const nama = it.dataset.label || '';
          handleSelectOption('provinsi', kode, nama);
        });
      });
    }

    // Handle Option Selection
    async function handleSelectOption(lvl: RegionLevel, kode: string, nama: string) {
      setTriggerSelected(lvl, kode, nama);
      closePopover(lvl);

      if (lvl === 'provinsi') {
        disableLevel('kabupaten');
        disableLevel('kecamatan');
        disableLevel('desa');
        activeRegencyData = null;
        if (activeSummary) activeSummary.classList.add('hidden');

        if (!kode) {
          if (statusText) statusText.textContent = 'Pilih provinsi untuk memulai.';
          return;
        }

        if (statusText) statusText.textContent = `Provinsi dipilih: ${nama}. Memuat daftar kabupaten/kota...`;
        if (labels.kabupaten) labels.kabupaten.textContent = 'Memuat...';

        try {
          const regencies = await loadRegenciesForProvince(kode);
          renderList('kabupaten', regencies);
          enableLevel('kabupaten');
          if (labels.kabupaten) labels.kabupaten.textContent = PLACEHOLDERS.kabupaten;
          if (statusText) statusText.textContent = `Provinsi ${nama}. Silakan pilih kabupaten/kota.`;
        } catch (err: any) {
          if (statusText) statusText.textContent = err.message || 'Gagal memuat kabupaten.';
          disableLevel('kabupaten');
        }
      } else if (lvl === 'kabupaten') {
        disableLevel('kecamatan');
        disableLevel('desa');
        activeRegencyData = null;
        if (activeSummary) activeSummary.classList.add('hidden');

        if (!kode) {
          if (statusText) statusText.textContent = 'Pilih kabupaten/kota.';
          return;
        }

        if (statusText) statusText.textContent = `Kabupaten dipilih: ${nama}. Memuat daftar kecamatan...`;
        if (labels.kecamatan) labels.kecamatan.textContent = 'Memuat...';

        try {
          activeRegencyData = await loadRegencyDetail(kode);
          const districts = activeRegencyData.kecamatan.map((k) => ({ kode: k.kode, nama: k.nama }));
          renderList('kecamatan', districts);
          enableLevel('kecamatan');
          if (labels.kecamatan) labels.kecamatan.textContent = PLACEHOLDERS.kecamatan;
          if (statusText) statusText.textContent = `Kabupaten ${nama}. Silakan pilih kecamatan.`;
        } catch (err: any) {
          if (statusText) statusText.textContent = err.message || 'Gagal memuat kecamatan.';
          disableLevel('kecamatan');
        }
      } else if (lvl === 'kecamatan') {
        disableLevel('desa');
        if (activeSummary) activeSummary.classList.add('hidden');

        if (!kode || !activeRegencyData) {
          if (statusText) statusText.textContent = 'Pilih kecamatan.';
          return;
        }

        const dist = activeRegencyData.kecamatan.find((k) => k.kode === kode);
        if (!dist || dist.desa.length === 0) {
          if (statusText) statusText.textContent = 'Tidak ada desa terdaftar pada kecamatan ini.';
          return;
        }

        renderList('desa', dist.desa);
        enableLevel('desa');
        if (statusText) statusText.textContent = `Kecamatan ${nama}. Silakan pilih desa/kelurahan.`;
      } else if (lvl === 'desa') {
        const adm4 = kode;
        if (!adm4) return;

        const provText = labels.provinsi?.textContent || '';
        const kabText = labels.kabupaten?.textContent || '';
        const kecText = labels.kecamatan?.textContent || '';
        const desaText = nama;

        const fullLabel = `${desaText}, Kec. ${kecText}, ${kabText}, ${provText}`;
        if (statusText) statusText.textContent = `Prakiraan cuaca siap: ${desaText}, ${kecText}`;

        if (activeSummary && activeText) {
          activeText.textContent = fullLabel;
          activeSummary.classList.remove('hidden');
        }

        saveLastLocation({
          prov: selects.provinsi.value,
          kab: selects.kabupaten.value,
          kec: selects.kecamatan.value,
          desa: adm4,
        });

        dispatchSelectedAdm4(adm4, fullLabel);
      }
    }

    // Reset button to clear selection and start anew
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        disableLevel('desa');
        disableLevel('kecamatan');
        disableLevel('kabupaten');
        setTriggerSelected('provinsi', '', '');
        activeRegencyData = null;
        if (activeSummary) activeSummary.classList.add('hidden');
        if (statusText) statusText.textContent = 'Pilih provinsi untuk memulai.';
        triggerProv.focus();
        openPopover('provinsi');
      });
    }

    // Attach trigger buttons and search inputs listeners
    const levels: RegionLevel[] = ['provinsi', 'kabupaten', 'kecamatan', 'desa'];
    levels.forEach((lvl) => {
      const trigger = triggers[lvl];
      const search = searches[lvl];
      const list = lists[lvl];
      const empty = empties[lvl];
      const clearBtn = clears[lvl];

      if (trigger) {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          togglePopover(lvl);
        });

        trigger.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openPopover(lvl);
          } else if (e.key === 'Escape') {
            closePopover(lvl);
          }
        });
      }

      if (search && list && empty) {
        search.addEventListener('input', () => {
          const q = search.value.trim().toLowerCase();
          if (clearBtn) {
            if (search.value.length > 0) {
              clearBtn.classList.remove('hidden');
            } else {
              clearBtn.classList.add('hidden');
            }
          }

          const items = list.querySelectorAll<HTMLElement>('.combobox-item');
          let visibleCount = 0;
          items.forEach((it) => {
            const labelText = (it.dataset.label || '').toLowerCase();
            if (!q || labelText.includes(q)) {
              it.classList.remove('hidden');
              visibleCount++;
            } else {
              it.classList.add('hidden');
            }
          });

          if (visibleCount === 0) {
            empty.classList.remove('hidden');
          } else {
            empty.classList.add('hidden');
          }
        });

        if (clearBtn) {
          clearBtn.addEventListener('click', () => {
            search.value = '';
            clearBtn.classList.add('hidden');
            search.dispatchEvent(new Event('input'));
            search.focus();
          });
        }

        search.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closePopover(lvl);
            trigger?.focus();
            return;
          }

          const visibleItems = Array.from(
            list.querySelectorAll<HTMLElement>('.combobox-item:not(.hidden)')
          );
          if (visibleItems.length === 0) return;

          let highlightedIndex = visibleItems.findIndex((it) =>
            it.classList.contains('ring-1')
          );

          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (highlightedIndex >= 0) {
              visibleItems[highlightedIndex].classList.remove(
                'ring-1',
                'ring-inset',
                'ring-[var(--color-brand)]'
              );
            }
            highlightedIndex = (highlightedIndex + 1) % visibleItems.length;
            const target = visibleItems[highlightedIndex];
            target.classList.add('ring-1', 'ring-inset', 'ring-[var(--color-brand)]');
            target.scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (highlightedIndex >= 0) {
              visibleItems[highlightedIndex].classList.remove(
                'ring-1',
                'ring-inset',
                'ring-[var(--color-brand)]'
              );
            }
            highlightedIndex =
              highlightedIndex <= 0 ? visibleItems.length - 1 : highlightedIndex - 1;
            const target = visibleItems[highlightedIndex];
            target.classList.add('ring-1', 'ring-inset', 'ring-[var(--color-brand)]');
            target.scrollIntoView({ block: 'nearest' });
          } else if (e.key === 'Enter') {
            e.preventDefault();
            if (highlightedIndex >= 0) {
              visibleItems[highlightedIndex].click();
            } else if (visibleItems.length === 1) {
              visibleItems[0].click();
            }
          }
        });
      }
    });

    // Close on outside click
    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node | null;
      if (!target) return;
      levels.forEach((lvl) => {
        const popover = popovers[lvl];
        const trigger = triggers[lvl];
        if (popover && !popover.classList.contains('hidden')) {
          if (!popover.contains(target) && !trigger?.contains(target)) {
            closePopover(lvl);
          }
        }
      });
    });

    // Restore either from URL or last location in localStorage
    async function restoreLocation() {
      let targetAdm4 = initialAdm4;
      let targetProv = '';
      let targetKab = '';
      let targetKec = '';
      let targetDesa = '';

      if (targetAdm4) {
        const parts = targetAdm4.split('.');
        if (parts.length === 4) {
          targetProv = parts[0];
          targetKab = `${parts[0]}.${parts[1]}`;
          targetKec = `${parts[0]}.${parts[1]}.${parts[2]}`;
          targetDesa = targetAdm4;
        }
      } else {
        try {
          const savedStr = window.localStorage.getItem(STORAGE_KEY);
          if (savedStr) {
            const saved = JSON.parse(savedStr);
            if (saved && saved.prov && saved.kab && saved.kec && saved.desa) {
              targetProv = saved.prov;
              targetKab = saved.kab;
              targetKec = saved.kec;
              targetDesa = saved.desa;
              targetAdm4 = saved.desa;
            }
          }
        } catch {
          // ignore
        }
      }

      if (targetProv && targetKab && targetKec && targetDesa) {
        try {
          // 1. Set Province
          const provItem = listProv?.querySelector<HTMLElement>(
            `.combobox-item[data-value="${targetProv}"]`
          );
          const provName = provItem?.dataset.label || targetProv;
          setTriggerSelected('provinsi', targetProv, provName);

          // 2. Load and set Regencies
          const regencies = await loadRegenciesForProvince(targetProv);
          renderList('kabupaten', regencies, targetKab);
          const kabItem = regencies.find((r) => r.kode === targetKab);
          const kabName = kabItem ? kabItem.nama : targetKab;
          setTriggerSelected('kabupaten', targetKab, kabName);
          enableLevel('kabupaten');

          // 3. Load and set Districts
          activeRegencyData = await loadRegencyDetail(targetKab);
          const districts = activeRegencyData.kecamatan.map((k) => ({ kode: k.kode, nama: k.nama }));
          renderList('kecamatan', districts, targetKec);
          const kecItem = districts.find((k) => k.kode === targetKec);
          const kecName = kecItem ? kecItem.nama : targetKec;
          setTriggerSelected('kecamatan', targetKec, kecName);
          enableLevel('kecamatan');

          // 4. Load and set Villages
          const activeDist = activeRegencyData.kecamatan.find((k) => k.kode === targetKec);
          if (activeDist && activeDist.desa.length > 0) {
            renderList('desa', activeDist.desa, targetDesa);
            const desaItem = activeDist.desa.find((d) => d.kode === targetDesa);
            const desaName = desaItem ? desaItem.nama : targetDesa;
            setTriggerSelected('desa', targetDesa, desaName);
            enableLevel('desa');

            const fullLabel = `${desaName}, Kec. ${kecName}, ${kabName}, ${provName}`;
            if (statusText) statusText.textContent = `Prakiraan cuaca siap: ${desaName}, ${kecName}`;
            if (rememberBadge) rememberBadge.classList.remove('hidden');
            if (activeSummary && activeText) {
              activeText.textContent = fullLabel;
              activeSummary.classList.remove('hidden');
            }

            dispatchSelectedAdm4(targetDesa, fullLabel);
          }
        } catch {
          // Fall back gracefully to clean picker
        }
      }
    }

    restoreLocation();
  }

  initRegionPicker();
  document.addEventListener('astro:page-load', initRegionPicker);
</script>
