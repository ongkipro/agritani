---
/**
 * src/components/CommodityPicker.astro
 * Tap-first commodity grid (DESIGN §4.1 C3, §4.2.3). Without `commodities` it lists every built commodity hub with
 * its article count (src/lib/journal.ts); Jurnal pages render it below 1024px in place of TopicSidebar (T-58A).
 * The first `visible` items show; the rest sit behind a native <details> (open when the current commodity is inside).
 */
import { getCommodityCounts } from '../lib/journal';

export interface CommodityItem {
  slug: string;
  name: string;
  href?: string;
  count?: number;
}

interface Props {
  commodities?: CommodityItem[];
  label?: string;
  /** Slug of the commodity hub being viewed: aria-current="page". */
  current?: string;
  /** How many items show before the "Semua n komoditas" disclosure; all when omitted. */
  visible?: number;
  class?: string;
}

const { label = 'Panduan per komoditas', current, visible, class: className } = Astro.props;

const commodities: CommodityItem[] =
  Astro.props.commodities ?? (await getCommodityCounts()).map((c) => ({ slug: c.id, name: c.name, count: c.count }));

const shown = visible ? commodities.slice(0, visible) : commodities;
const rest = commodities.slice(shown.length);
const restOpen = rest.some((c) => c.slug === current);
const headingId = 'komoditas-picker-heading'; // one picker per page
const tile =
  'flex items-center justify-between gap-2 px-3 py-2 min-h-[48px] rounded-[2px] border text-sm sm:text-base transition-colors';
---

{commodities.length > 0 && (
  <nav aria-labelledby={headingId} class={className}>
    <h2 id={headingId} class="font-serif text-base font-semibold text-[var(--color-text)] mb-3">{label}</h2>

    {[shown, rest].map((group, gi) => {
      const grid = (
        <ul class="grid grid-cols-2 sm:grid-cols-3 gap-2" role="list">
          {group.map((c) => {
            const active = c.slug === current;
            return (
              <li class="min-w-0">
                <a
                  href={c.href || `/jurnal/komoditas/${c.slug}/`}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    tile,
                    active
                      ? 'border-[var(--color-brand-strong)] bg-[var(--color-tint)] text-[var(--color-brand-strong)] font-bold'
                      : 'border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] font-semibold hover:border-[var(--color-brand)] hover:text-[var(--color-brand-strong)] active:bg-[var(--color-tint)]',
                  ]}
                >
                  <span class="min-w-0 break-words">{c.name}</span>
                  {c.count !== undefined && (
                    <span class="shrink-0 tabular-nums text-sm font-normal text-[var(--color-text-muted)]">
                      <span class="sr-only">, </span>{c.count}<span class="sr-only"> artikel</span>
                    </span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      );
      if (gi === 0) return grid;
      if (group.length === 0) return null;
      return (
        <details class="group mt-2" open={restOpen}>
          <summary class="flex items-center justify-center min-h-[48px] px-3 rounded-[2px] border border-[var(--color-border-control)] bg-[var(--color-surface)] text-sm font-semibold text-[var(--color-brand-strong)] cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-[var(--color-tint)] group-open:mb-2">
            <span class="group-open:hidden">Semua {commodities.length} komoditas</span>
            <span class="hidden group-open:inline">Tampilkan lebih sedikit</span>
          </summary>
          {grid}
        </details>
      );
    })}
  </nav>
)}
