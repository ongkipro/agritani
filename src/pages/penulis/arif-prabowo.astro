---
/**
 * src/pages/penulis/arif-prabowo.astro
 * Author profile page for Arif Prabowo (DEC-016, DESIGN §4.2.3, §4.4.3, §4.4.5)
 * Bio strictly constrained per DEC-016.
 * Invariants: Single WhatsApp CTA, 0/0/0 CSP, 2px radius, no divider lines, text contrast >= 7:1.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleList from '../../components/ArticleList.astro';
import ConsultPrompt from '../../components/ConsultPrompt.astro';
import AuthorAvatar from '../../components/AuthorAvatar.astro';
import type { SeoInput } from '../../lib/seo';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Jurnal Tani', url: '/jurnal/' },
  { name: 'Arif Prabowo', url: '/penulis/arif-prabowo/' },
];

const seo: SeoInput = {
  title: 'Arif Prabowo, Konsultan Pertanian Senior',
  description:
    'Profil Arif Prabowo, Konsultan Pertanian Senior dan Pengelola Jurnal Tani Agritani. Pengalaman lebih dari 8 tahun riset lapangan dan budidaya tanaman.',
  canonicalPath: '/penulis/arif-prabowo/',
  breadcrumbs,
  pageType: 'profile',
  ogType: 'profile',
};

const includeDrafts =
  import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;

const allArticles = await getCollection('articles');

// Filter articles authored or moderated by Arif Prabowo
const authorArticles = allArticles.filter(
  (a) => !a.data.author || a.data.author === 'Arif Prabowo' || a.data.author.includes('Arif')
);

const visibleArticles = includeDrafts
  ? authorArticles
  : authorArticles.filter((a) => !a.data.draft);

const sortedArticles = visibleArticles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout seo={seo} currentPath="/penulis/arif-prabowo/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <!-- Profile Header (Sains Editorial Canvas) -->
    <header class="max-w-[68ch] mx-auto my-8 sm:my-12">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-6">
        <AuthorAvatar size={96} class="w-20 h-20 sm:w-24 sm:h-24" decorative={false} />

        <div class="space-y-1">
          <h1 class="text-3xl sm:text-4xl font-serif font-semibold text-[var(--color-text)] leading-tight tracking-[-0.015em] text-balance">
            Arif Prabowo
          </h1>
          <p class="text-base sm:text-lg text-[var(--color-soil)]">
            Konsultan Pertanian Senior · Pengelola Jurnal Tani
          </p>
        </div>
      </div>

      <!-- Bio Prose: Strictly limited to authorized fact (DEC-016) -->
      <div class="space-y-4 text-base sm:text-lg text-[var(--color-text)] leading-relaxed font-sans mb-8">
        <p>
          Arif Prabowo memiliki pengalaman lebih dari 8 tahun di bidang pertanian dan riset, mempelajari beragam komoditas serta praktik budidaya di berbagai wilayah Indonesia. Saat ini beliau bertindak sebagai sales dan konsultan produk unggulan Agritani (Aussie, BENSU, Saratoga, dan Kojien), serta mengelola resmi portal pertanian Agritani yang bekerja sama dengan beberapa brand pupuk dan perusahaan pertanian.
        </p>
      </div>

      <!-- Kontak: satu-satunya CTA WhatsApp di halaman ini (DESIGN §2.8; dipindah dari artikel atas keputusan pemilik 2026-09-30) -->
      <ConsultPrompt
        source="Web·Penulis"
        title="Konsultasi dengan Arif Prabowo"
        description="Tanyakan budidaya, gejala tanaman, atau penggunaan produk Agritani. Siapkan foto tanaman, umur tanaman, dan lokasi kebun. Pesan dikirim ke WhatsApp resmi Agritani."
        label="Chat via WhatsApp"
        variant="secondary"
      />

      <!-- Pengungkapan (DESIGN §4.3.1 blok 16, DEC-016) -->
      <div class="mt-8 text-xs sm:text-sm text-[var(--color-text-muted)] space-y-1">
        <p class="font-semibold text-[var(--color-text)]">Pengungkapan</p>
        <p>
          Arif Prabowo juga bekerja sebagai sales dan konsultan produk Agritani (Aussie, BENSU, Kojien, Saratoga). Hubungan ini juga dicantumkan di bio penulis pada setiap artikel Jurnal Tani. Ikuti selalu petunjuk pada label kemasan.
        </p>
      </div>
    </header>

    <!-- Articles Section -->
    <main class="max-w-[68ch] mx-auto mb-12 sm:mb-16">
      <div class="flex items-baseline justify-between gap-4 mb-6">
        <h2 class="section-title !mb-0">
          Panduan dan karya tulis
        </h2>
        <span class="text-xs sm:text-sm text-[var(--color-text-muted)] tabular-nums">
          {sortedArticles.length} artikel {includeDrafts ? '(termasuk draf)' : 'terbit'}
        </span>
      </div>

      <ArticleList
        articles={sortedArticles}
        initialCount={6}
        batchSize={6}
        listId="penulis-arif"
        emptyMessage="Belum ada artikel yang diterbitkan untuk saat ini."
      />

      <!-- Bottom navigation -->
      <div class="mt-12 space-y-1">
        <h3 class="font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Jelajahi berdasarkan topik</h3>
        <p class="text-sm sm:text-base text-[var(--color-text-muted)]">
          Kunjungi indeks lengkap Jurnal Tani untuk menyaring artikel per komoditas dan bidang keilmuan.
        </p>
        <a href="/jurnal/" class="link-more text-sm">Buka indeks Jurnal Tani &rarr;</a>
      </div>
    </main>
  </div>
</BaseLayout>
