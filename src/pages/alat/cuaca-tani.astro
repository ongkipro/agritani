---
/**
 * src/pages/alat/cuaca-tani.astro
 * Dedicated tool page for Cuaca Tani (REQ-10, DESIGN §2.6.2, ARCHITECTURE §5b).
 * Connects directly to BMKG open API for 3-day hyperlocal weather forecasts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RegionPicker from '../../components/RegionPicker.astro';
import ForecastTable from '../../components/ForecastTable.astro';
import ExternalLinkIcon from '../../components/ExternalLinkIcon.astro';
import { externalLink } from '../../lib/links';
import type { SeoInput } from '../../lib/seo';

const refLink = externalLink('reference');

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Alat Tani', url: '/alat/' },
  { name: 'Cuaca Tani', url: '/alat/cuaca-tani/' },
];

const seo: SeoInput = {
  title: 'Cuaca Tani & Prakiraan Semprot Lapangan',
  description:
    'Prakiraan cuaca 3 harian BMKG per 3 jam untuk desa Anda. Pantau suhu, kelembapan, arah angin, dan risiko hujan sebelum menyemprot di lahan.',
  canonicalPath: '/alat/cuaca-tani/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/alat/cuaca-tani/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (Lapangan Layout) -->
    <header class="my-6 sm:my-8 max-w-[68ch]">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-[var(--color-text)] mb-3 leading-tight">
        Cuaca Tani
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        Prakiraan cuaca 3 harian per interval 3 jam langsung dari Badan Meteorologi, Klimatologi, dan Geofisika (BMKG) untuk desa Anda. Pantau risiko hujan, laju penguapan, serta kecepatan angin sebelum melakukan penyemprotan atau pemupukan.
      </p>
    </header>

    <!-- Main Tool Workspace -->
    <div class="space-y-14 max-w-[64rem]">
      
      <!-- No-JS Fallback Banner (DESIGN §2.6.2) -->
      <noscript>
        <div class="max-w-[60ch] space-y-3">
          <h2 class="section-title !mb-0">
            Mode statis (tanpa JavaScript)
          </h2>
          <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
            Pengambilan data cuaca real-time langsung dari API BMKG membutuhkan peramban dengan JavaScript aktif. Anda tetap dapat memantau prakiraan cuaca daerah Anda secara langsung melalui tautan portal resmi BMKG di bawah ini:
          </p>
          <div>
            <a
              href="https://www.bmkg.go.id/cuaca/prakiraan-cuaca.bmkg"
              target={refLink.target}
              rel={refLink.rel}
              class="inline-flex items-center gap-2 px-5 py-2 min-h-[44px] text-sm font-semibold rounded-[2px] bg-[var(--color-brand)] !text-white hover:bg-[var(--color-brand-hover)] transition-colors"
            >
              <span>Buka Portal Cuaca Resmi BMKG</span>
              <ExternalLinkIcon size={14} />
              <span class="sr-only"> {refLink.tabNotice}</span>
            </a>
          </div>
        </div>
      </noscript>

      <!-- Step 1: 4-Level Cascading Region Picker -->
      <RegionPicker />

      <!-- Step 2: 3-Day Forecast Table with BMKG live attribution -->
      <ForecastTable />

    </div>
  </div>
</BaseLayout>
