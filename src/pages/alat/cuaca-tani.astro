---
/**
 * src/pages/alat/cuaca-tani.astro
 * Dedicated tool page for Cuaca Tani (REQ-10, DESIGN §2.6.2, ARCHITECTURE §5b).
 * Connects directly to BMKG open API for 3-day hyperlocal weather forecasts.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RegionPicker from '../../components/RegionPicker.astro';
import ForecastTable from '../../components/ForecastTable.astro';
import ExternalLinkIcon from '../../components/ExternalLinkIcon.astro';
import { externalLink } from '../../lib/links';
import type { SeoInput } from '../../lib/seo';

const refLink = externalLink('reference');

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Alat Tani', url: '/alat/' },
  { name: 'Cuaca Tani', url: '/alat/cuaca-tani/' },
];

const seo: SeoInput = {
  title: 'Cuaca Tani BMKG: Prakiraan Hujan & Waktu Semprot per Desa',
  description:
    'Prakiraan cuaca 3 harian BMKG per 3 jam untuk desa Anda. Pantau suhu, kelembapan, arah angin, dan risiko hujan sebelum menyemprot di lahan.',
  canonicalPath: '/alat/cuaca-tani/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/alat/cuaca-tani/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-16 lg:pb-24">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (Lapangan Layout) -->
    <header class="mt-6 mb-8 sm:mt-8 sm:mb-10 max-w-[60ch]">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[var(--color-text)] leading-tight tracking-[-0.015em] text-balance mb-3">
        Cuaca Tani
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        Prakiraan cuaca 3 hari per 3 jam dari BMKG untuk desa Anda, untuk memilih waktu semprot dan pemupukan yang aman.
      </p>
    </header>

    <!-- Main Tool Workspace -->
    <div class="space-y-10 lg:space-y-12">
      
      <!-- No-JS Fallback Banner (DESIGN §2.6.2) -->
      <noscript>
        <div class="card p-4 sm:p-6 max-w-[60ch] space-y-3">
          <h2 class="font-serif text-xl font-semibold text-[var(--color-brand-strong)]">
            Mode statis (tanpa JavaScript)
          </h2>
          <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
            Pengambilan data cuaca real-time langsung dari API BMKG membutuhkan peramban dengan JavaScript aktif. Anda tetap dapat memantau prakiraan cuaca daerah Anda secara langsung melalui tautan portal resmi BMKG di bawah ini:
          </p>
          <div>
            <a
              href="https://www.bmkg.go.id/cuaca/prakiraan-cuaca.bmkg"
              target={refLink.target}
              rel={refLink.rel}
              class="inline-flex items-center gap-2 px-5 py-2 min-h-[44px] text-sm font-semibold rounded-[2px] bg-[var(--color-brand)] !text-white hover:bg-[var(--color-brand-hover)] transition-colors"
            >
              <span>Buka Portal Cuaca Resmi BMKG</span>
              <ExternalLinkIcon size={14} />
              <span class="sr-only"> {refLink.tabNotice}</span>
            </a>
          </div>
        </div>
      </noscript>

      <!-- Step 1: 4-Level Cascading Region Picker -->
      <RegionPicker />

      <!-- Step 2: 3-Day Forecast Table with BMKG live attribution -->
      <ForecastTable />

    </div>

    <!-- Related tools and references -->
    <section aria-labelledby="cuaca-related-heading" class="mt-12 lg:mt-16">
      <h2 id="cuaca-related-heading" class="font-serif text-xl font-semibold text-[var(--color-brand-strong)] mb-4">Sebelum dan sesudah menyemprot</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <li>
          <a href="/alat/kalkulator-dosis/" class="card card-link block h-full p-5">
            <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Kalkulator Dosis</span>
            <span class="mt-1 block text-sm text-[var(--color-text-muted)] leading-snug">Takaran per tangki sesuai label kemasan.</span>
          </a>
        </li>
        <li>
          <a href="/produk/" class="card card-link block h-full p-5">
            <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Produk Agritani</span>
            <span class="mt-1 block text-sm text-[var(--color-text-muted)] leading-snug">Dosis anjuran tiap produk sesuai label kemasan.</span>
          </a>
        </li>
        <li>
          <a href="/jurnal/" class="card card-link block h-full p-5">
            <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Jurnal Tani</span>
            <span class="mt-1 block text-sm text-[var(--color-text-muted)] leading-snug">Panduan penanganan hama dan penyakit per komoditas.</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
