---
/**
 * src/pages/alat/kalender-tanam.astro
 * Dedicated tool page for Kalender Tanam (REQ-09, DESIGN §2.6.1, §4.2.3)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CropTimeline from '../../components/CropTimeline.astro';
import type { SeoInput } from '../../lib/seo';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Alat Tani', url: '/alat/' },
  { name: 'Kalender Tanam', url: '/alat/kalender-tanam/' },
];

const seo: SeoInput = {
  title: 'Kalender Tanam: Rencana Fase HST, Pemupukan & Panen',
  description:
    'Rencanakan fase tanam, pemupukan, pemantauan hama, dan perkiraan panen dari tanggal tanam komoditas Anda. Simpan jadwal ke kalender HP tanpa akun.',
  canonicalPath: '/alat/kalender-tanam/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/alat/kalender-tanam/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-16 lg:pb-24">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (Lapangan Layout) -->
    <header class="mt-6 mb-8 sm:mt-8 sm:mb-10 max-w-[60ch]">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[var(--color-text)] leading-tight tracking-[-0.015em] text-balance mb-3">
        Kalender Tanam
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        Buat jadwal dari tanggal tanam Anda: umur HST hari ini, fase aktif, kegiatan kunci, dan perkiraan panen.
      </p>
    </header>

    <!-- Main Tool Workspace -->
    <CropTimeline />
    <!-- Related tools and references -->
    <section aria-labelledby="kalender-related-heading" class="mt-12 lg:mt-16">
      <h2 id="kalender-related-heading" class="font-serif text-xl font-semibold text-[var(--color-brand-strong)] mb-4">Alat lain untuk jadwal lapangan</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <li>
          <a href="/alat/cuaca-tani/" class="card card-link block h-full p-5">
            <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Cuaca Tani</span>
            <span class="mt-1 block text-sm text-[var(--color-text-muted)] leading-snug">Prakiraan BMKG per 3 jam untuk memilih waktu semprot.</span>
          </a>
        </li>
        <li>
          <a href="/alat/kalkulator-dosis/" class="card card-link block h-full p-5">
            <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Kalkulator Dosis</span>
            <span class="mt-1 block text-sm text-[var(--color-text-muted)] leading-snug">Takaran per tangki sesuai label kemasan.</span>
          </a>
        </li>
        <li>
          <a href="/jurnal/" class="card card-link block h-full p-5">
            <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Jurnal Tani</span>
            <span class="mt-1 block text-sm text-[var(--color-text-muted)] leading-snug">Panduan penanganan hama dan penyakit per komoditas.</span>
          </a>
        </li>
      </ul>
    </section>

  </div>
</BaseLayout>
