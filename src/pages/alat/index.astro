---
/**
 * src/pages/alat/index.astro
 * Hub / Index page for Alat Tani (REQ-06, DESIGN §2.6.4, §4.2.3)
 * Lists 4 tools with zero WhatsApp CTAs (DESIGN §2.8).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import type { SeoInput } from '../../lib/seo';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Alat Tani', url: '/alat/' },
];

const seo: SeoInput = {
  title: 'Alat Tani',
  description:
    'Instrumen bantu praktis petani: diagnosa gejala hama penyakit, kalender tanam HST, cuaca semprot BMKG tingkat desa, dan kalkulator dosis tangki.',
  canonicalPath: '/alat/',
  breadcrumbs,
  pageType: 'website',
};

const isDraftPreview = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true';

const tools = [
  {
    title: 'Diagnosa Gejala',
    href: '/alat/diagnosa-gejala/',
    badge: isDraftPreview ? 'Identifikasi Masalah' : 'Segera hadir',
    isUpcoming: !isDraftPreview,
    description:
      'Temukan kemungkinan hama, penyakit, atau defisiensi hara berdasarkan bagian tanaman dan tanda visual di kebun.',
  },
  {
    title: 'Kalender Tanam',
    href: '/alat/kalender-tanam/',
    badge: isDraftPreview ? 'Fase & Jadwal' : 'Segera hadir',
    isUpcoming: !isDraftPreview,
    description:
      'Pantau fase pertumbuhan tanaman (HST), jadwal pemupukan berkala, dan perkiraan waktu panen komoditas Anda.',
  },
  {
    title: 'Cuaca Tani',
    href: '/alat/cuaca-tani/',
    badge: 'Prakiraan BMKG',
    isUpcoming: false,
    description:
      'Prakiraan cuaca 3 hari per 3 jam langsung dari data BMKG tingkat desa untuk menentukan waktu aplikasi semprot yang aman.',
  },
  {
    title: 'Kalkulator Dosis',
    href: '/alat/kalkulator-dosis/',
    badge: 'Kalkulasi Tangki',
    isUpcoming: false,
    description:
      'Hitung takaran pestisida atau pupuk daun per tangki semprot dan total kebutuhan larutan sesuai luas lahan Anda.',
  },
];
---

<BaseLayout seo={seo} currentPath="/alat/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (Lapangan Layout) -->
    <header class="my-6 sm:my-8 max-w-[68ch]">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] mb-3 leading-tight tracking-tight">
        Alat Tani
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        Empat instrumen bantu praktis untuk diagnosa masalah lapangan, penjadwalan fase tanam, prakiraan cuaca semprot, dan kalkulasi dosis.
      </p>
    </header>

    <p class="mb-8 max-w-[68ch] text-sm text-[var(--color-text-muted)]">
      Semua alat gratis, tanpa registrasi atau akun, dan dirancang untuk layar ponsel di lahan.
    </p>

    <!-- Tools index: open rows, live tools first (DESIGN §4.2.3) -->
    <ul class="mb-16 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
      {[...tools].sort((a, b) => Number(a.isUpcoming) - Number(b.isUpcoming)).map((tool) => (
        <li>
          <a
            href={tool.href}
            class="group grid grid-cols-1 sm:grid-cols-[14rem_1fr_auto] gap-x-8 gap-y-1.5 py-6 sm:py-7 sm:items-baseline"
          >
            <h2 class="text-xl sm:text-2xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
              {tool.title}
            </h2>
            <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-[60ch]">
              {tool.description}
              <span class="block mt-1 text-xs font-semibold text-[var(--color-soil)]">{tool.badge}</span>
            </p>
            <span class="link-more text-sm mt-2 sm:mt-0 whitespace-nowrap">
              {tool.isUpcoming ? 'Lihat status' : 'Buka instrumen'} &rarr;
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
