---
/**
 * src/pages/alat/kalkulator-dosis.astro
 * Dedicated page for the spray dose and tank calculator tool (REQ-11, DESIGN §2.6.3, §4.2.3)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DoseCalculator from '../../components/DoseCalculator.astro';
import type { SeoInput } from '../../lib/seo';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Alat Tani', url: '/alat/' },
  { name: 'Kalkulator Dosis', url: '/alat/kalkulator-dosis/' },
];

const seo: SeoInput = {
  title: 'Kalkulator Dosis Semprot',
  description:
    'Hitung takaran pestisida atau pupuk daun per tangki semprot dan total kebutuhan larutan untuk luas lahan Anda secara cepat dan akurat di lapangan.',
  canonicalPath: '/alat/kalkulator-dosis/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/alat/kalkulator-dosis/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 pb-16 lg:pb-24">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (Lapangan Layout) -->
    <header class="mt-6 mb-8 sm:mt-8 sm:mb-10 max-w-[60ch]">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[var(--color-text)] leading-tight tracking-[-0.015em] text-balance mb-3">
        Kalkulator Dosis Semprot
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        Hitung takaran produk per tangki semprot dan total kebutuhan larutan untuk luas lahan Anda.
      </p>
    </header>

    <!-- Main Tool Workspace -->
    <DoseCalculator />
  </div>
</BaseLayout>
