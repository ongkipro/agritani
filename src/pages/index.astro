  <!-- Client Script for Hero Auto Slider -->
  <script>
    function initHeroSlider() {
      const slider = document.getElementById('hero-masthead-slider');
      if (!slider) return;

      const slides = Array.from(slider.querySelectorAll<HTMLElement>('.hero-slide'));
      const btnPrev = document.getElementById('hero-slider-prev');
      const btnNext = document.getElementById('hero-slider-next');

      if (slides.length <= 1) return;

      let currentIndex = 0;
      let timer: ReturnType<typeof setInterval> | null = null;
      let isPaused = false;
      const intervalMs = 5000;

      function goToSlide(targetIndex: number) {
        if (targetIndex === currentIndex) return;

        const prevSlide = slides[currentIndex];
        const nextSlide = slides[targetIndex];

        // Crossfade slides
        prevSlide.classList.remove('opacity-100', 'z-1');
        prevSlide.classList.add('opacity-0', 'z-0');
        prevSlide.setAttribute('aria-hidden', 'true');

        nextSlide.classList.remove('opacity-0', 'z-0');
        nextSlide.classList.add('opacity-100', 'z-1');
        nextSlide.setAttribute('aria-hidden', 'false');

        currentIndex = targetIndex;
      }

      function nextSlide() {
        const next = (currentIndex + 1) % slides.length;
        goToSlide(next);
      }

      function prevSlide() {
        const prev = (currentIndex - 1 + slides.length) % slides.length;
        goToSlide(prev);
      }

      function startTimer() {
        stopTimer();
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (isPaused) return;
        timer = setInterval(nextSlide, intervalMs);
      }

      function stopTimer() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      btnPrev?.addEventListener('click', () => {
        prevSlide();
        startTimer();
      });

      btnNext?.addEventListener('click', () => {
        nextSlide();
        startTimer();
      });

      slider.addEventListener('mouseenter', () => {
        isPaused = true;
        stopTimer();
      });

      slider.addEventListener('mouseleave', () => {
        isPaused = false;
        startTimer();
      });

      slider.addEventListener('focusin', () => {
        isPaused = true;
        stopTimer();
      });

      slider.addEventListener('focusout', () => {
        isPaused = false;
        startTimer();
      });

      // Touch swipe support for mobile
      let touchStartX = 0;
      slider.addEventListener(
        'touchstart',
        (e) => {
          touchStartX = e.changedTouches[0].screenX;
        },
        { passive: true }
      );

      slider.addEventListener(
        'touchend',
        (e) => {
          const touchEndX = e.changedTouches[0].screenX;
          const diffX = touchEndX - touchStartX;
          if (Math.abs(diffX) > 40) {
            if (diffX < 0) {
              nextSlide();
            } else {
              prevSlide();
            }
            startTimer();
          }
        },
        { passive: true }
      );

      startTimer();
    }

    initHeroSlider();
    document.addEventListener('astro:page-load', initHeroSlider);
  </script>
