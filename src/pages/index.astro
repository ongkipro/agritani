---
/**
 * src/pages/index.astro
 * Homepage hibrida Agritani (REQ-01, DESIGN §4.1 C1-C8, §4.2.3).
 * Tap-first hero, latest journal columns + topic index, image pillars (Alat Tani, Konsultasi),
 * moderator bio, official product references from collection, and partnership pathway.
 */

import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CommodityPicker from '../components/CommodityPicker.astro';
import { resolveCommodityHeroTarget } from '../components/CommodityPicker.test';
import TopicSidebar from '../components/TopicSidebar.astro';
import { topicName } from '../lib/topics';
import alatImage from '../assets/images/dummy/alat-tani.webp';
import konsultasiImage from '../assets/images/dummy/konsultasi.webp';
import kemitraanImage from '../assets/images/dummy/kemitraan.webp';
import heroImage from '../assets/images/dummy/hero-beranda.webp';
import { getReadingTime } from '../lib/reading-time';

// 1. Fetch articles (respecting draft preview environment)
const isDraftPreview = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true';
const allArticles = await getCollection('articles', ({ data }) => {
  return isDraftPreview || !data.draft;
});

// Sort articles by publication date descending
const sortedArticles = [...allArticles].sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const latestArticles = sortedArticles.slice(0, 3);
const dateFmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

// 2. Fetch products collection (verified data only, DESIGN §2.5)
const allProducts = await getCollection('products');

// 3. Fetch symptoms and commodities for dynamic hero target resolution
const allSymptoms = await getCollection('symptoms');
const hasReviewedSymptoms = allSymptoms.some((s) => Boolean(s.data.reviewedBy?.trim()));

const commodities = await getCollection('commodities');

// Derive dynamic commodity article counts
const commodityCounts: Record<string, number> = {};
allArticles.forEach((art) => {
  if (Array.isArray(art.data.commodities)) {
    art.data.commodities.forEach((c) => {
      const slug = typeof c === 'string' ? c : c?.id;
      if (slug) {
        commodityCounts[slug] = (commodityCounts[slug] || 0) + 1;
      }
    });
  }
});

// Hubs are valid when having >= 3 visible articles (DESIGN §4.4.3)
const activeHubSlugs = new Set(
  commodities
    .filter((c) => (commodityCounts[c.id] || 0) >= 3)
    .map((c) => c.id)
);

const RAW_HERO_COMMODITIES = [
  { slug: 'cabai', name: 'Cabai' },
  { slug: 'padi', name: 'Padi' },
  { slug: 'kelapa-sawit', name: 'Kelapa Sawit' },
  { slug: 'tomat', name: 'Tomat' },
  { slug: 'bawang-merah', name: 'Bawang Merah' },
  { slug: 'jagung', name: 'Jagung' },
];

const heroCommodities = RAW_HERO_COMMODITIES.map((c) => {
  const target = resolveCommodityHeroTarget({
    slug: c.slug,
    hasReviewedSymptoms,
    activeHubSlugs,
  });
  return {
    ...c,
    href: target.href,
  };
});

const heroQuestionLabel = hasReviewedSymptoms
  ? 'Pilih Tanaman Anda:'
  : 'Pilih tanaman Anda untuk panduan penanganannya:';

const toolsUpcoming = import.meta.env.PUBLIC_INCLUDE_DRAFTS !== 'true';
const tools = [
  { title: 'Cuaca Tani & Jendela Semprot', href: '/alat/cuaca-tani/', desc: 'Prakiraan BMKG per 3 jam tingkat desa untuk memilih waktu aplikasi.', upcoming: false },
  { title: 'Kalkulator Dosis Semprot', href: '/alat/kalkulator-dosis/', desc: 'Takaran per tangki dan total larutan sesuai luas lahan.', upcoming: false },
  { title: 'Diagnosa Gejala Tanaman', href: '/alat/diagnosa-gejala/', desc: 'Kenali hama, penyakit, dan defisiensi hara dari tanda visual.', upcoming: toolsUpcoming },
  { title: 'Kalender Tanam & Rencana Musim', href: '/alat/kalender-tanam/', desc: 'Fase HST, jadwal tindakan lapangan, dan unduhan kalender.', upcoming: toolsUpcoming },
].sort((a, b) => Number(a.upcoming) - Number(b.upcoming));

const seoProps = {
  title: 'Distributor Resmi Sarana Pertanian Modern',
  description: 'Distributor resmi saprotan dan biostimulan aktivator sel tanaman. Dilengkapi Jurnal Tani karya Prof. Arif Prabowo dan alat diagnosis hama, kalender tanam, serta cuaca BMKG.',
  canonical: '/',
  ogType: 'website' as const,
  ogImage: '/og/default.png',
};
---

<BaseLayout seo={seoProps}>

  <!-- 1. Hero Lapangan (DESIGN §4.1 C1-C3, §4.2.3) -->
  <section class="py-10 sm:py-16 bg-[var(--color-canvas)]">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column (7/12 desktop): Problem Framing & Tap-First Selector -->
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-3">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--color-text)] tracking-tight leading-[1.15] max-w-[16ch]">
              Tanaman Anda bermasalah? Kenali dari gejalanya.
            </h1>
            <p class="text-base sm:text-lg text-[var(--color-text-muted)] max-w-[52ch] leading-relaxed">
              Identifikasi cepat hama, penyakit, dan kekurangan hara berdasarkan ciri visual di lapangan, didukung telaah agronomi ilmiah.
            </p>
          </div>

          <!-- Commodity Picker (Dynamic destination based on reviewed symptoms vs published hubs) -->
          <div class="pt-2">
            <CommodityPicker
              commodities={heroCommodities}
              label={heroQuestionLabel}
            />
          </div>

          <!-- Secondary Navigation Links -->
          <div class="pt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
            <a
              href="/cari/"
              class="inline-flex items-center gap-1.5 font-bold text-[var(--color-brand-strong)] hover:text-[var(--color-brand)] underline transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/>
                <path d="m21 21-4.3-4.3"/>
              </svg>
              <span>atau cari gejala dengan kata kunci</span>
            </a>
            <span class="text-[var(--color-border-control)]" aria-hidden="true">·</span>
            <a
              href="/jurnal/"
              class="font-semibold text-[var(--color-soil)] hover:text-[var(--color-brand-strong)] underline transition-colors"
            >
              Jelajahi Jurnal Tani
            </a>
          </div>
        </div>

        <!-- Right Column (5/12 desktop): Hero Media (DESIGN §4.1 C3, no deceptive caption/kicker) -->
        <div class="lg:col-span-5">
          <Picture
            src={heroImage}
            formats={['webp']}
            widths={[400, 640, 800, 1200]}
            sizes="(min-width: 1024px) 28rem, calc(100vw - 2rem)"
            quality={52}
            alt="Hamparan sawah terasering tropis di Bali dengan pohon kelapa dan saluran air alami"
            class="w-full aspect-[5/4] object-cover rounded-[2px]"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Jurnal Tani terbaru: 3 text columns + topic index (DESIGN §4.2.3 #2, teagasc.ie News & Publications) -->
  <section class="py-12 sm:py-16">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-10">
      {latestArticles.length > 0 && (
      <div class="lg:col-span-8">
        <h2 id="jurnal-terbaru" class="section-title">Jurnal Tani terbaru</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 md:divide-x divide-y md:divide-y-0 divide-[var(--color-border)]">
          {latestArticles.map((art) => (
            <article class="py-5 md:py-1 md:px-5 first:md:pl-0 last:md:pr-0">
              <a href={`/jurnal/topik/${art.data.topic}/`} class={`topic-${art.data.topic} inline-flex items-center gap-1.5 text-xs font-medium text-[var(--color-soil)] hover:underline min-h-[44px]`}>
                <span class="w-2 h-2 bg-[var(--topic)]" aria-hidden="true"></span>
                {topicName(art.data.topic)}
              </a>
              <h3 class="mt-2 font-serif text-lg font-semibold leading-snug text-balance">
                <a href={`/jurnal/${art.data.slug}/`} class="text-[var(--color-text)] hover:text-[var(--color-brand-strong)] hover:underline underline-offset-4">
                  {art.data.title}
                </a>
              </h3>
              <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed line-clamp-3">{art.data.description}</p>
              <p class="mt-3 text-xs text-[var(--color-text-muted)] tabular-nums">
                <time datetime={art.data.pubDate.toISOString()}>{dateFmt.format(art.data.pubDate)}</time> · {getReadingTime(art.body || '').text}
              </p>
            </article>
          ))}
        </div>
        <a href="/jurnal/" class="link-more mt-8">Semua artikel Jurnal Tani</a>
      </div>
      )}
      <div class="lg:col-span-4">
        <h2 class="section-title">Telusuri Jurnal</h2>
        <TopicSidebar />
      </div>
    </div>
  </section>

  <!-- 3a. Pillar: Alat Tani (image left) -->
  <section class="py-12 sm:py-16" aria-labelledby="pilar-alat">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <Picture
        src={alatImage}
        formats={['webp']}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 28rem, calc(100vw - 2rem)"
        quality={60}
        alt=""
        class="w-full aspect-[5/4] object-cover rounded-[2px]"
        pictureAttributes={{ class: "lg:col-span-5" }}
      />
      <div class="lg:col-span-7 pillar">
        <h2 id="pilar-alat" class="pillar-title">Alat Tani Lapangan</h2>
        <p class="pillar-lede">Alat bantu gratis tanpa akun untuk keputusan harian di lahan: kapan menyemprot, berapa takarannya, dan apa penyebab gejala di tanaman.</p>
        <ul class="mt-6 divide-y divide-[var(--color-border)] border-b border-[var(--color-border)]">
          {tools.map((t) => (
            <li>
              <a href={t.href} class="group flex items-baseline justify-between gap-4 py-4 min-h-[44px]">
                <span>
                  <span class="block font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] group-hover:underline underline-offset-4">{t.title}</span>
                  <span class="block text-sm text-[var(--color-text-muted)]">{t.desc}</span>
                </span>
                <span class="shrink-0 text-xs font-semibold text-[var(--color-soil)]">{t.upcoming ? 'Segera hadir' : 'Buka'}</span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/alat/" class="link-more mt-8">Semua Alat Tani</a>
      </div>
    </div>
  </section>

  <!-- 3b. Pillar: Konsultasi (image right). No WhatsApp button on the homepage (DESIGN §2.8) -->
  <section class="py-12 sm:py-16 bg-[var(--color-tint)]" aria-labelledby="pilar-konsultasi">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <Picture
        src={konsultasiImage}
        formats={['webp']}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 28rem, calc(100vw - 2rem)"
        quality={60}
        alt=""
        class="w-full aspect-[5/4] object-cover rounded-[2px]"
        pictureAttributes={{ class: "lg:col-span-5 lg:order-last" }}
      />
      <div class="lg:col-span-7 pillar">
        <h2 id="pilar-konsultasi" class="pillar-title">Tanya langsung ke tim agronomi</h2>
        <p class="pillar-lede">Gejala yang sulit dikenali? Kirim foto tanaman dan riwayat perlakuan lahan Anda ke tim agronomi PT Agritani Internasional.</p>
        <ul class="mt-6 list-disc pl-5 space-y-1.5 text-sm text-[var(--color-text)] marker:text-[var(--color-soil)]">
          <li>Foto dekat bagian yang sakit dan foto tanaman utuh.</li>
          <li>Komoditas, umur tanaman (HST), dan lokasi kebun.</li>
          <li>Pupuk atau semprotan dua minggu terakhir.</li>
        </ul>
        <a href="/konsultasi/" class="link-more mt-8">Cara konsultasi</a>
      </div>
    </div>
  </section>

  <!-- 4. Produk: heading left, rows right (DESIGN §4.2.3 #4) -->
  <section class="py-12 sm:py-16" aria-labelledby="produk-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-6">
      <div class="lg:col-span-4 pillar">
        <h2 id="produk-heading" class="pillar-title">Produk untuk lahan Anda</h2>
        <p class="pillar-lede">Empat biostimulan dan aktivator sel resmi yang didistribusikan PT Agritani Internasional, sebagai rujukan sesuai komoditas.</p>
        <a href="/produk/" class="link-more mt-6">Bandingkan produk</a>
      </div>
      <ul class="lg:col-span-8 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
        {allProducts.map((product) => (
          <li>
            <a href={`/produk/${product.data.id}/`} class="group grid grid-cols-1 sm:grid-cols-[9rem_1fr] gap-x-6 gap-y-1 py-5">
              <span class="font-serif text-xl font-semibold text-[var(--color-brand-strong)] group-hover:underline underline-offset-4">{product.data.name}</span>
              <span>
                <span class="block text-sm font-semibold text-[var(--color-soil)]">{product.data.tagline || product.data.role}</span>
                <span class="block mt-1 text-sm text-[var(--color-text-muted)] leading-relaxed">{product.data.summary}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Moderator (strict facts only; photo pending from owner) -->
  <section class="py-12 sm:py-16" aria-labelledby="moderator-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-x-12 gap-y-6 items-center">
      <div class="lg:col-span-4 flex items-center gap-4">
        <div class="w-16 h-16 rounded-[2px] bg-[var(--color-brand)] !text-white font-serif font-semibold text-2xl flex items-center justify-center shrink-0" aria-hidden="true">AP</div>
        <div>
          <h2 id="moderator-heading" class="font-serif text-2xl font-semibold text-[var(--color-text)]">Prof. Arif Prabowo</h2>
          <p class="text-sm font-semibold text-[var(--color-soil)]">Profesor Pertanian · Moderator Jurnal Tani</p>
        </div>
      </div>
      <div class="lg:col-span-8">
        <p class="font-serif text-xl sm:text-2xl leading-snug text-[var(--color-text)] max-w-[40ch]">
          Artikel Jurnal Tani yang terbit ditulis dan dimoderasi oleh Prof. Arif Prabowo, dan wajib memuat daftar pustaka yang dapat ditelusuri.
        </p>
        <a href="/penulis/arif-prabowo/" class="link-more mt-6">Profil dan publikasi</a>
      </div>
    </div>
  </section>

  <!-- 6. Kemitraan pillar on harvest band (DESIGN §4.2.3 #6) -->
  <section class="py-12 sm:py-16 bg-[var(--color-harvest-tint)]" aria-labelledby="kemitraan-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <Picture
        src={kemitraanImage}
        formats={['webp']}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 28rem, calc(100vw - 2rem)"
        quality={60}
        alt=""
        class="w-full aspect-[5/4] object-cover rounded-[2px]"
        pictureAttributes={{ class: "lg:col-span-5" }}
      />
      <div class="lg:col-span-7 pillar pillar-harvest">
        <h2 id="kemitraan-heading" class="pillar-title">Menjadi mitra distributor resmi</h2>
        <p class="pillar-lede">Kerja sama distribusi resmi untuk kios saprotan, kelompok tani, dan perkebunan daerah di seluruh Indonesia.</p>
        <ol class="mt-6 divide-y divide-[color-mix(in_srgb,var(--color-soil)_20%,transparent)]">
          <li class="grid grid-cols-[2rem_1fr] gap-x-3 py-3"><span class="font-serif text-xl font-semibold text-[var(--color-soil)] tabular-nums leading-none pt-0.5" aria-hidden="true">1</span><span><strong class="block text-[var(--color-text)]">Pelajari wilayah distribusi</strong><span class="text-sm text-[var(--color-text-muted)]">Kebutuhan petani dan sentra komoditas di wilayah Anda.</span></span></li>
          <li class="grid grid-cols-[2rem_1fr] gap-x-3 py-3"><span class="font-serif text-xl font-semibold text-[var(--color-soil)] tabular-nums leading-none pt-0.5" aria-hidden="true">2</span><span><strong class="block text-[var(--color-text)]">Ajukan profil kios atau usaha</strong><span class="text-sm text-[var(--color-text-muted)]">Formulir kemitraan untuk verifikasi kesiapan rantai pasok.</span></span></li>
          <li class="grid grid-cols-[2rem_1fr] gap-x-3 py-3"><span class="font-serif text-xl font-semibold text-[var(--color-soil)] tabular-nums leading-none pt-0.5" aria-hidden="true">3</span><span><strong class="block text-[var(--color-text)]">Mulai penyaluran resmi</strong><span class="text-sm text-[var(--color-text-muted)]">Produk asli dan pendampingan materi agronomi lapangan.</span></span></li>
        </ol>
        <a
          href="/kemitraan-distributor/"
          class="mt-8 inline-flex items-center justify-center px-6 py-3.5 min-h-[48px] text-sm font-extrabold rounded-[2px] bg-[var(--color-harvest)] !text-[var(--color-text)] hover:bg-[var(--color-harvest-hover)] transition-colors"
        >
          Ajukan Kemitraan Distributor <span aria-hidden="true" class="ml-1.5">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
