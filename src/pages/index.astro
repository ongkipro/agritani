---
/**
 * src/pages/index.astro
 * Modern Farming UI/UX — Hybrid Corporate Profile, Scientific Journal,
 * Field Precision Tools, and Agronomy Consultation.
 *
 * Designed with organic breathing room, high typographic contrast (Newsreader
 * display serif + Plus Jakarta Sans functional data), zero card-soup borders,
 * and strict adherence to CSP and WCAG AAA accessibility.
 */

import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { topicName } from '../lib/topics';
import { getReadingTime } from '../lib/reading-time';
import { getTopicImage } from '../lib/topic-images';
import { getProductImage } from '../lib/product-images';
import type { SeoInput } from '../lib/seo';

// Media assets
import heroImage from '../assets/images/dummy/hero-beranda.webp';
import konsultasiImage from '../assets/images/dummy/konsultasi.webp';
import AuthorAvatar from '../components/AuthorAvatar.astro';

// 1. Fetch articles (respecting draft preview environment)
const isDraftPreview = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true';
const allArticles = await getCollection('articles', ({ data }) => {
  return isDraftPreview || !data.draft;
});

// Helper for dynamic published count per commodity
const getCommodityArticleCount = (commId: string) => {
  return allArticles.filter((a) => {
    return a.data.commodities?.some((c) => (typeof c === 'string' ? c : c.id) === commId);
  }).length;
};

// Sort articles by publication date descending
const sortedArticles = [...allArticles].sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const featuredArticle = sortedArticles[0];
const recentDispatches = sortedArticles.slice(1, 4);
const dateFmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

// 2. Fetch products collection (verified data only, DEC-010)
const allProducts = await getCollection('products');
const order = ['aussie', 'kojien', 'bensu', 'saratoga'];
const sortedProducts = [...allProducts].sort((a, b) => {
  const indexA = order.indexOf(a.id);
  const indexB = order.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

// SEO configuration
const seoProps: SeoInput = {
  title: 'Agritani: Portal Pertanian & Produk Unggulan Presisi',
  metaTitle: 'Agritani: Portal Pertanian & Produk Unggulan Presisi',
  description:
    'Portal pertanian resmi yang dikelola Arif Prabowo untuk PT Agritani Internasional. Menyajikan panduan Jurnal Tani teruji, instrumen lapangan, dan empat produk unggulan.',
  canonicalPath: '/',
  pageType: 'website',
  ogType: 'website',
  ogImage: '/og/default.png',
};
---

<BaseLayout seo={seoProps}>

  <!-- 1. Hero Photographic Masthead & Precision Tools Deck (Fokus Image, Proporsional) -->
  <section class="relative bg-[var(--color-canvas)] pt-6 pb-12 sm:pt-10 sm:pb-20">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Asymmetric Editorial Grid (7/12 Landscape Visual + 5/12 Field Utility Deck) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
        
        <!-- Left Column: Photographic Editorial Masthead (Fokus Image, Vignette Halus Bawah) -->
        <div class="lg:col-span-7 relative min-h-[440px] sm:min-h-[520px] flex flex-col justify-end p-6 sm:p-8 lg:p-10 rounded-[2px] overflow-hidden group">
          <Picture
            src={heroImage}
            formats={['webp']}
            widths={[640, 960, 1200, 1600]}
            sizes="(min-width: 1024px) 46rem, 100vw"
            quality={75}
            alt="Hamparan sawah terasering tropis di Indonesia dengan saluran irigasi alami dan tanaman subur"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            loading="eager"
          />
          <!-- Atmospheric Bottom-Weighted Vignette: Bagian Atas Gambar Jernih, Bawah Bergradasi Halus -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-[var(--color-brand-strong)]/95 via-[var(--color-brand-strong)]/50 to-transparent"
            aria-hidden="true"
          ></div>

          <!-- Hero Content: Headline Proporsional & Elegan (Tidak Terlalu Besar) -->
          <div class="relative z-10 max-w-[42ch]">
            <h1 class="font-serif text-2xl sm:text-3xl lg:text-[2.25rem] font-bold text-white leading-tight tracking-tight">
              Standar Agronomi Presisi & Sains Lapangan Tropis
            </h1>
            <p class="mt-3 text-sm sm:text-base text-white/95 leading-relaxed max-w-[38ch]">
              Portal pertanian resmi PT Agritani Internasional yang dikelola Arif Prabowo bersama tim agronomi lapangan.
            </p>
            <div class="mt-6 sm:mt-7 flex flex-wrap items-center gap-3 sm:gap-4">
              <a
                href="/alat/"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-[2px] bg-[var(--color-harvest)] text-[var(--color-text)] font-extrabold text-xs sm:text-sm hover:bg-[var(--color-harvest-hover)] transition-colors focus:outline-none focus:ring-2 focus:ring-white"
              >
                <span>Buka Instrumen Tani</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a
                href="/jurnal/"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-[2px] bg-white/15 hover:bg-white/25 text-white text-xs sm:text-sm font-bold transition-colors backdrop-blur-xs focus:outline-none focus:ring-2 focus:ring-white"
              >
                <span>Jelajahi Jurnal Ilmiah</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Modern Field Precision Deck (Clean, No Card-Soup) -->
        <div class="lg:col-span-5 flex flex-col justify-between py-2 sm:py-4">
          <div>
            <div class="flex items-baseline justify-between mb-4">
              <h2 class="text-sm font-bold text-[var(--color-brand-strong)]">
                Instrumen Cepat Lapangan
              </h2>
              <span class="text-xs font-semibold text-[var(--color-text-muted)]">
                Musim Tanam 2026
              </span>
            </div>

            <!-- Modern Farming Utility List (Free of Card-Borders) -->
            <div class="space-y-4">
              
              <!-- Tool 1: Cuaca Tani BMKG -->
              <a
                href="/alat/cuaca-tani/"
                class="group block p-3.5 rounded-[2px] hover:bg-[var(--color-tint)] transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                      Prakiraan Cuaca Tani BMKG
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                      Prakiraan 3 hari per 3 jam tingkat desa untuk menentukan jendela semprot aman tanpa risiko tercuci hujan.
                    </p>
                  </div>
                  <span class="text-sm font-bold text-[var(--color-brand)] group-hover:translate-x-1 transition-transform shrink-0 mt-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>

              <!-- Tool 2: Kalkulator Dosis 16L -->
              <a
                href="/alat/kalkulator-dosis/"
                class="group block p-3.5 rounded-[2px] hover:bg-[var(--color-tint)] transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                      Kalkulator Dosis Tangki 16L
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                      Hitungan presisi takaran mililiter per tangki knapsack gendong dan drum 200L sesuai anjuran label resmi.
                    </p>
                  </div>
                  <span class="text-sm font-bold text-[var(--color-brand)] group-hover:translate-x-1 transition-transform shrink-0 mt-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>

              <!-- Tool 3: Diagnosa Visual Gejala -->
              <a
                href="/alat/diagnosa-gejala/"
                class="group block p-3.5 rounded-[2px] hover:bg-[var(--color-tint)] transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                      Diagnosa Visual Gejala Tanaman
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                      Identifikasi cepat hama, patogen, dan defisiensi hara di kebun secara tap-first tanpa mengetik.
                    </p>
                  </div>
                  <span class="text-sm font-bold text-[var(--color-brand)] group-hover:translate-x-1 transition-transform shrink-0 mt-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>

              <!-- Tool 4: Kalender Tanam & Fase HST -->
              <a
                href="/alat/kalender-tanam/"
                class="group block p-3.5 rounded-[2px] hover:bg-[var(--color-tint)] transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                      Kalender Tanam & Fase HST
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                      Panduan umur Hari Setelah Tanam, jadwal perlakuan berkala, dan sinkronisasi ke kalender ponsel (.ics).
                    </p>
                  </div>
                  <span class="text-sm font-bold text-[var(--color-brand)] group-hover:translate-x-1 transition-transform shrink-0 mt-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>

            </div>
          </div>

          <!-- Quick Consultation Entry (Text link without WhatsApp mention, DESIGN §2.8) -->
          <div class="mt-4 pt-2">
            <a
              href="/konsultasi/"
              class="inline-flex items-center gap-2 text-xs font-bold text-[var(--color-brand-strong)] hover:underline py-1.5"
            >
              <span>Butuh telaah kebun langsung? Pelajari alur konsultasi agronomi</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Profil Pengelola: Arif Prabowo & PT Agritani Internasional -->
  <section class="py-16 sm:py-24 bg-[var(--color-surface)]" aria-labelledby="authority-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        
        <!-- Left: Profile Identity -->
        <div class="lg:col-span-4 flex flex-col items-start">
          <div class="flex items-center gap-4 sm:gap-5 mb-4">
            <AuthorAvatar size={112} class="w-20 h-20 sm:w-24 sm:h-24" decorative={false} />
            <div>
              <h2 id="authority-heading" class="font-serif text-2xl sm:text-3xl font-bold text-[var(--color-text)] tracking-tight leading-tight">
                Arif Prabowo
              </h2>
              <span class="text-xs text-[var(--color-soil)] font-semibold mt-0.5 block">
                Konsultan Pertanian Senior · Pengelola Jurnal Tani
              </span>
            </div>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed mt-1">
            Pengalaman lebih dari 8 tahun riset pertanian dan budidaya lapangan; sales dan konsultan produk unggulan Agritani.
          </p>
          <div class="mt-4">
            <a href="/penulis/arif-prabowo/" class="link-more text-sm">
              Profil lengkap & panduan agronomi &rarr;
            </a>
          </div>
        </div>

        <!-- Right: Integritas Artikel Jurnal Tani (Kalimat Biasa, Tanpa Kutipan) -->
        <div class="lg:col-span-8 flex flex-col justify-center space-y-6 pt-2">
          <p class="font-serif text-xl sm:text-2xl text-[var(--color-text)] leading-relaxed">
            Artikel Jurnal Tani yang terbit ditulis dan dimoderasi oleh Arif Prabowo, dan wajib memuat daftar pustaka yang dapat ditelusuri.
          </p>
          <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
            Setiap pembahasan disusun berdasarkan observasi riil di lapangan tropis Indonesia, telaah fisiologi tanaman teruji, dan kalibrasi rekomendasi dosis yang bertanggung jawab untuk melindungi tanaman petani dari risiko kerusakan.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. Portal Artikel: Jurnal Tani & Riset Lapangan -->
  <section class="py-16 sm:py-24 bg-[var(--color-canvas)]" aria-labelledby="journal-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <h2 id="journal-heading" class="section-headline">
            Jurnal Tani & Riset Lapangan
          </h2>
          <p class="section-subheading">
            Panduan teknis budidaya, mitigasi patogen, dan manajemen hara berbasis pembuktian ilmiah terbuka.
          </p>
        </div>
        <div class="shrink-0">
          <a href="/jurnal/" class="link-more text-sm">
            Lihat seluruh arsip jurnal &rarr;
          </a>
        </div>
      </div>

      <!-- Editorial Magazine Layout: Lead Story (7/12) + Recent Dispatches (5/12) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        
        <!-- Lead Feature Story with Rich Topic Image -->
        {featuredArticle && (
          <article class="lg:col-span-7 flex flex-col justify-between group">
            <div>
              <a
                href={`/jurnal/${featuredArticle.data.slug}/`}
                class="block mb-5 rounded-[2px] overflow-hidden aspect-[16/9] relative bg-[var(--color-surface)]"
                tabindex="-1"
                aria-hidden="true"
              >
                <Picture
                  src={getTopicImage(featuredArticle.data.topic)}
                  formats={['webp']}
                  widths={[480, 800, 1100]}
                  sizes="(min-width: 1024px) 42rem, 100vw"
                  quality={75}
                  alt={`Ilustrasi agronomi panduan ${featuredArticle.data.title}`}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </a>
              <a
                href={`/jurnal/topik/${featuredArticle.data.topic}/`}
                class={`topic-${featuredArticle.data.topic} inline-flex items-center gap-2 text-xs font-bold text-[var(--color-soil)] hover:underline mb-2.5`}
              >
                <span class="w-2 h-2 rounded-full bg-[var(--topic)]" aria-hidden="true"></span>
                <span>{topicName(featuredArticle.data.topic)}</span>
              </a>
              <h3 class="font-serif text-2xl sm:text-3xl lg:text-[28px] xl:text-[32px] font-bold text-[var(--color-text)] tracking-tight leading-[1.25]">
                <a
                  href={`/jurnal/${featuredArticle.data.slug}/`}
                  class="group-hover:text-[var(--color-brand-strong)] transition-colors"
                >
                  {featuredArticle.data.title}
                </a>
              </h3>
              <p class="mt-3 text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed line-clamp-3">
                {featuredArticle.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-[var(--color-border)] flex items-center gap-3 text-xs text-[var(--color-text-muted)] tabular-nums font-medium">
              <span>Arif Prabowo</span>
              <span aria-hidden="true">&middot;</span>
              <time datetime={featuredArticle.data.pubDate.toISOString()}>{dateFmt.format(featuredArticle.data.pubDate)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{getReadingTime(featuredArticle.body || '').text}</span>
            </div>
          </article>
        )}

        <!-- Stream of Recent Dispatches (Rich Rows with Thumbnails) -->
        <div class="lg:col-span-5 flex flex-col divide-y divide-[var(--color-border)] lg:border-l lg:border-[var(--color-border)] lg:pl-8 xl:pl-10">
          {recentDispatches.map((article) => (
            <article class="group flex gap-4 sm:gap-5 items-start py-5 first:pt-0 last:pb-0">
              <a
                href={`/jurnal/${article.data.slug}/`}
                class="w-28 sm:w-32 aspect-[16/9] rounded-[2px] overflow-hidden shrink-0 bg-[var(--color-surface)] block"
                tabindex="-1"
                aria-hidden="true"
              >
                <Picture
                  src={getTopicImage(article.data.topic)}
                  formats={['webp']}
                  widths={[160, 240]}
                  sizes="(min-width: 640px) 8rem, 7rem"
                  quality={70}
                  alt={`Ilustrasi ${article.data.title}`}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                />
              </a>
              <div class="flex-1 min-w-0">
                <a
                  href={`/jurnal/topik/${article.data.topic}/`}
                  class={`topic-${article.data.topic} inline-flex items-center gap-1.5 text-[11px] font-bold text-[var(--color-soil)] hover:underline mb-1`}
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--topic)]" aria-hidden="true"></span>
                  <span>{topicName(article.data.topic)}</span>
                </a>
                <h3 class="font-serif text-base sm:text-[17px] font-bold text-[var(--color-text)] leading-snug">
                  <a
                    href={`/jurnal/${article.data.slug}/`}
                    class="group-hover:text-[var(--color-brand-strong)] transition-colors line-clamp-2"
                  >
                    {article.data.title}
                  </a>
                </h3>
                <p class="mt-2 text-xs text-[var(--color-text-muted)] tabular-nums font-medium">
                  <time datetime={article.data.pubDate.toISOString()}>{dateFmt.format(article.data.pubDate)}</time> &middot; {getReadingTime(article.body || '').text}
                </p>
              </div>
            </article>
          ))}
        </div>

      </div>

      <!-- Curated Commodity Tracks (Clean Editorial Typography, No Bulky Card-Soup) -->
      <div class="mt-16">
        <div class="flex items-baseline justify-between mb-4">
          <h3 class="text-sm font-bold text-[var(--color-text)]">
            Panduan Berdasarkan Komoditas Unggulan
          </h3>
          <a href="/jurnal/" class="text-xs font-bold text-[var(--color-brand-strong)] hover:underline">
            Semua Komoditas &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
          <a
            href="/jurnal/komoditas/padi/"
            class="group block"
          >
            <div class="flex items-baseline justify-between mb-1">
              <span class="font-serif text-lg font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                Padi Sawah
              </span>
              <span class="text-xs font-bold text-[var(--color-brand-strong)] tabular-nums">{getCommodityArticleCount('padi')} Panduan &rarr;</span>
            </div>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
              Mitigasi hawar daun bakteri, blas, dan pengendalian wereng batang coklat.
            </p>
          </a>
          <a
            href="/jurnal/komoditas/cabai/"
            class="group block"
          >
            <div class="flex items-baseline justify-between mb-1">
              <span class="font-serif text-lg font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                Cabai
              </span>
              <span class="text-xs font-bold text-[var(--color-brand-strong)] tabular-nums">{getCommodityArticleCount('cabai')} Panduan &rarr;</span>
            </div>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
              Protokol patek antraknosa, pencegahan layu fusarium, dan thrips keriting.
            </p>
          </a>
          <a
            href="/jurnal/membasmi-ulat-grayak-jagung-faw-spodoptera/"
            class="group block"
          >
            <div class="flex items-baseline justify-between mb-1">
              <span class="font-serif text-lg font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                Jagung
              </span>
              <span class="text-xs font-bold text-[var(--color-soil)] tabular-nums">{getCommodityArticleCount('jagung')} Panduan &rarr;</span>
            </div>
            <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
              Perlindungan titik tumbuh dari ulat grayak jagung (FAW) dan penyakit bulai.
            </p>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- 4. Alat Tani & Instrumen Lapangan (Baris Indeks, DESIGN §4.2.3) -->
  <section class="py-16 sm:py-24 bg-[var(--color-surface)]" aria-labelledby="tools-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div class="max-w-[54ch]">
          <h2 id="tools-heading" class="section-headline">
            Alat Tani & Instrumen Lapangan
          </h2>
          <p class="section-subheading">
            Empat perangkat bantu gratis tanpa akun, tanpa registrasi, dan tanpa pemrosesan data pribadi untuk penggunaan sigap di kebun.
          </p>
        </div>
        <div class="shrink-0">
          <a href="/alat/" class="link-more text-sm">
            Lihat semua instrumen &rarr;
          </a>
        </div>
      </div>

      <!-- Index Rows of 4 Precision Tools (Free of Cards, Open Rows) -->
      <div class="divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
        
        <!-- Row 1: Cuaca Tani -->
        <div class="py-6 sm:py-7 flex flex-col md:flex-row md:items-baseline justify-between gap-4 group">
          <div class="md:w-5/12">
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
              <a href="/alat/cuaca-tani/">Cuaca Tani & Jendela Semprot</a>
            </h3>
          </div>
          <div class="md:w-5/12">
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
              Prakiraan 3 hari per 3 jam langsung dari BMKG tingkat desa untuk memilih waktu semprot terbaik sebelum hujan turun.
            </p>
          </div>
          <div class="md:w-2/12 md:text-right shrink-0">
            <a href="/alat/cuaca-tani/" class="link-more text-xs sm:text-sm">
              Buka prakiraan &rarr;
            </a>
          </div>
        </div>

        <!-- Row 2: Kalkulator Dosis -->
        <div class="py-6 sm:py-7 flex flex-col md:flex-row md:items-baseline justify-between gap-4 group">
          <div class="md:w-5/12">
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
              <a href="/alat/kalkulator-dosis/">Kalkulator Dosis Tangki 16L</a>
            </h3>
          </div>
          <div class="md:w-5/12">
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
              Takaran mililiter atau gram per tangki knapsack gendong dan drum 200L sesuai luas lahan dan petunjuk label resmi.
            </p>
          </div>
          <div class="md:w-2/12 md:text-right shrink-0">
            <a href="/alat/kalkulator-dosis/" class="link-more text-xs sm:text-sm">
              Hitung dosis &rarr;
            </a>
          </div>
        </div>

        <!-- Row 3: Diagnosa Visual Gejala -->
        <div class="py-6 sm:py-7 flex flex-col md:flex-row md:items-baseline justify-between gap-4 group">
          <div class="md:w-5/12">
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
              <a href="/alat/diagnosa-gejala/">Diagnosa Visual Gejala</a>
            </h3>
          </div>
          <div class="md:w-5/12">
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
              Identifikasi visual hama, patogen penyakit, dan kahat hara tanaman langsung dari ponsel tanpa mengetik di lahan.
            </p>
          </div>
          <div class="md:w-2/12 md:text-right shrink-0">
            <a href="/alat/diagnosa-gejala/" class="link-more text-xs sm:text-sm">
              Mulai diagnosa &rarr;
            </a>
          </div>
        </div>

        <!-- Row 4: Kalender Tanam & Fase HST -->
        <div class="py-6 sm:py-7 flex flex-col md:flex-row md:items-baseline justify-between gap-4 group">
          <div class="md:w-5/12">
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
              <a href="/alat/kalender-tanam/">Kalender Tanam & Fase HST</a>
            </h3>
          </div>
          <div class="md:w-5/12">
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
              Perhitungan umur Hari Setelah Tanam, panduan tindakan berkala, dan ekspor pengingat kalender HP (.ics).
            </p>
          </div>
          <div class="md:w-2/12 md:text-right shrink-0">
            <a href="/alat/kalender-tanam/" class="link-more text-xs sm:text-sm">
              Buat rencana &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. Pendampingan Lapangan & Konsultasi Kebun -->
  <section class="py-16 sm:py-24 bg-[var(--color-canvas)]" aria-labelledby="consult-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 items-center">
        
        <!-- Left: Field Advisory Photograph -->
        <div class="md:col-span-5">
          <Picture
            src={konsultasiImage}
            formats={['webp']}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 28rem, 100vw"
            quality={70}
            alt="Pendampingan dan konsultasi agronomi langsung di kebun petani"
            class="w-full aspect-[4/3] object-cover rounded-[2px]"
            loading="lazy"
          />
        </div>

        <!-- Right: Dignified Consultation Protocol -->
        <div class="md:col-span-7 space-y-6">
          <h2 id="consult-heading" class="section-headline">
            Pendampingan Agronomi & Konsultasi Kebun
          </h2>
          <p class="text-base text-[var(--color-text-muted)] leading-relaxed">
            Layanan konsultasi agronomi langsung bersama tim agronomis PT Agritani Internasional. Dapatkan telaah penanganan terarah untuk kebun Anda secara gratis dengan protokol data lapangan.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 text-xs font-semibold text-[var(--color-text)]">
            <div class="space-y-1">
              <span class="block text-[var(--color-brand-strong)] font-bold">1. Foto Gejala</span>
              <span class="block text-[var(--color-text-muted)]">Ambil foto dekat daun/buah dan foto tanaman keseluruhan.</span>
            </div>
            <div class="space-y-1">
              <span class="block text-[var(--color-brand-strong)] font-bold">2. Data Tanaman</span>
              <span class="block text-[var(--color-text-muted)]">Sebutkan komoditas, perkiraan umur HST, dan kabupaten kebun.</span>
            </div>
            <div class="space-y-1">
              <span class="block text-[var(--color-brand-strong)] font-bold">3. Telaah Agronom</span>
              <span class="block text-[var(--color-text-muted)]">Rekomendasi tindakan teknis sesuai kaidah agronomi teruji.</span>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/konsultasi/"
              class="link-more text-sm sm:text-base font-bold"
            >
              Cara konsultasi & alur pendampingan kebun &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 6. Produk Unggulan & Integritas Saprotan (4 Produk Unggulan & ShieldedTag™) -->
  <section class="py-16 sm:py-24 bg-[var(--color-surface)]" aria-labelledby="initiatives-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <h2 id="initiatives-heading" class="section-headline">
            Empat Produk Unggulan & Integritas Saprotan
          </h2>
          <p class="section-subheading">
            Sarana produksi terdaftar Kementerian Pertanian RI dengan perlindungan keaslian kemasan ShieldedTag™.
          </p>
        </div>
        <div class="shrink-0">
          <a href="/produk/" class="link-more text-sm">
            Katalog 4 produk unggulan &rarr;
          </a>
        </div>
      </div>

      <!-- 4 Verified Official Products (With Official Packshots) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 mb-16">
        {sortedProducts.map((prod) => (
          <div class="flex flex-col justify-between group pt-4 border-t border-[var(--color-border)]">
            <div>
              <a
                href={`/produk/${prod.id}/`}
                class="block mb-4 aspect-square bg-white border border-[var(--color-border)] rounded-[2px] p-4 overflow-hidden relative group/img"
                tabindex="-1"
                aria-hidden="true"
              >
                <Picture
                  src={getProductImage(prod.id)}
                  formats={['webp']}
                  widths={[200, 400]}
                  sizes="(min-width: 1024px) 16rem, 50vw"
                  quality={80}
                  alt={`Kemasan resmi ${prod.data.name}`}
                  class="w-full h-full object-contain transition-transform duration-500 ease-out group-hover/img:scale-105"
                  loading="lazy"
                />
              </a>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                <a href={`/produk/${prod.id}/`}>{prod.data.name}</a>
              </h3>
              <p class="text-xs font-semibold text-[var(--color-brand-strong)] mt-1.5">
                {prod.data.tagline || prod.data.role}
              </p>
              <p class="text-xs text-[var(--color-text-muted)] mt-2.5 leading-relaxed line-clamp-3">
                {prod.data.role}
              </p>
            </div>
            <div class="mt-5">
              <a href={`/produk/${prod.id}/`} class="link-more text-xs">
                Spesifikasi & izin Kementan &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- ShieldedTag & Kemitraan Callouts (Open Editorial Layout) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mt-16">
        <div>
          <h3 class="font-serif text-xl font-bold text-[var(--color-text)]">
            Keaslian Kemasan ShieldedTag™
          </h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">
            Setiap kemasan resmi yang didistribusikan PT Agritani Internasional dilindungi segel tamper-evident berhologram untuk memastikan petani terlindungi dari pemalsuan saprotan.
          </p>
          <div class="mt-3">
            <a href="/tentang-kami/" class="link-more text-xs">
              Cara memeriksa segel keaslian &rarr;
            </a>
          </div>
        </div>
        <div>
          <h3 class="font-serif text-xl font-bold text-[var(--color-text)]">
            Kemitraan Kios Saprotan & Gapoktan
          </h3>
          <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">
            Penyaluran resmi bagi jaringan kios saprotan dan kelompok tani daerah dengan kepastian kontinuitas pasokan dan pendampingan materi agronomi langsung dari pengelola.
          </p>
          <div class="mt-3">
            <a href="/kemitraan-distributor/" class="link-more text-xs">
              Ketentuan kemitraan distribusi &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

</BaseLayout>
