---
/**
 * src/pages/index.astro
 * Agritani Homepage strictly modelled after the authoritative, clean, minimal
 * UI/UX architecture of Teagasc.ie (https://teagasc.ie/):
 *
 * 1. Hero: 65% / 35% Split (Feature Image with high-contrast text overlay + Vertical Seasonal Priority Agenda Rail)
 * 2. News & Publications (Jurnal Tani & Riset Lapangan): 65% Recent Articles & Commodity Badges + 35% Publications Column
 * 3. Two Horizontal Pillars:
 *    - Pillar 1: Pendampingan Agronomi Lapangan (Farm Advisory)
 *    - Pillar 2: Instrumen Digital & Riset Lapangan (Research & Innovation)
 * 4. 2x2 Priority Initiatives Grid:
 *    - Garansi Keaslian ShieldedTag
 *    - Kemitraan Kios & Gapoktan
 *    - Dewan Pakar Prof. Arif Prabowo
 *    - Katalog 4 Produk Resmi Terdaftar
 * 5. Buletin & Panduan Berkala (Our Newsletters)
 *
 * Strictly adheres to CSP (0 inline styles, 0 inline scripts), WCAG AAA contrast,
 * and authentic Indonesian agricultural domain facts.
 */

import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { topicName } from '../lib/topics';
import { getReadingTime } from '../lib/reading-time';
import type { SeoInput } from '../lib/seo';

// Media assets
import heroImage from '../assets/images/dummy/hero-beranda.webp';
import alatImage from '../assets/images/dummy/alat-tani.webp';
import konsultasiImage from '../assets/images/dummy/konsultasi.webp';
import kemitraanImage from '../assets/images/dummy/kemitraan.webp';
import tentangKamiImage from '../assets/images/dummy/tentang-kami.webp';
import topikBudidayaImage from '../assets/images/dummy/topik-budidaya.webp';

// 1. Fetch articles (respecting draft preview environment)
const isDraftPreview = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true';
const allArticles = await getCollection('articles', ({ data }) => {
  return isDraftPreview || !data.draft;
});

// Sort articles by publication date descending
const sortedArticles = [...allArticles].sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const latestArticles = sortedArticles.slice(0, 3);
const dateFmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

// 2. Fetch products collection (verified data only, DEC-010)
const allProducts = await getCollection('products');
const order = ['aussie', 'kojien', 'bensu', 'saratoga'];
const sortedProducts = [...allProducts].sort((a, b) => {
  const indexA = order.indexOf(a.id);
  const indexB = order.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

// SEO configuration
const seoProps: SeoInput = {
  title: 'Distributor Resmi Sarana Pertanian Modern | Agritani',
  metaTitle: 'Distributor Resmi Sarana Pertanian Modern | Agritani',
  description:
    'Distributor resmi saprotan dan biostimulan aktivator sel tanaman. Dilengkapi Jurnal Tani karya Prof. Arif Prabowo dan alat diagnosis hama, kalender tanam, serta cuaca BMKG.',
  canonicalPath: '/',
  pageType: 'website',
  ogType: 'website',
  ogImage: '/og/default.png',
};
---

<BaseLayout seo={seoProps}>

  <!-- 1. Hero: 65% / 35% Split (Canonical Teagasc.ie Anatomy) -->
  <section class="py-6 sm:py-8 bg-white border-b border-[var(--color-border)]">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
        
        <!-- Left Column (8/12 - 67%): High-Impact Agricultural Feature Banner -->
        <div class="lg:col-span-8 relative min-h-[380px] sm:min-h-[440px] rounded-[4px] overflow-hidden flex flex-col justify-end group shadow-xs">
          <Picture
            src={heroImage}
            formats={['webp']}
            widths={[640, 960, 1200, 1600]}
            sizes="(min-width: 1024px) 50rem, 100vw"
            quality={75}
            alt="Hamparan sawah terasering tropis di Indonesia dengan saluran irigasi alami dan tanaman subur"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
            loading="eager"
            fetchpriority="high"
          />
          <!-- High-Contrast Scrim Gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent pointer-events-none" aria-hidden="true"></div>

          <!-- Hero Content Overlay -->
          <div class="relative z-10 p-6 sm:p-10 text-white">
            <span class="inline-block text-xs font-extrabold uppercase tracking-wider text-[var(--color-harvest)] mb-2">
              Fokus Musim Tanam MT1 2026
            </span>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white leading-tight max-w-[20ch] tracking-tight drop-shadow-sm">
              Pengendalian Hama & Penyakit Tanaman Tropis
            </h1>
            <p class="mt-2 text-sm sm:text-base text-white/90 max-w-[48ch] leading-relaxed">
              Identifikasi cepat hama, patogen penyakit, dan kahat hara berdasarkan gejala visual di lapangan dengan protokol agronomi teruji.
            </p>
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <a
                href="/alat/diagnosa-gejala/"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-[2px] bg-[var(--color-harvest)] text-[var(--color-text)] font-extrabold text-sm hover:bg-[var(--color-harvest-hover)] transition-colors focus:outline-none focus:ring-2 focus:ring-white"
              >
                <span>Buka Diagnosa Lapangan</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a
                href="/jurnal/"
                class="inline-flex items-center gap-2 px-4 py-3 rounded-[2px] bg-white/20 hover:bg-white/30 text-white text-sm font-bold transition-colors backdrop-blur-xs focus:outline-none focus:ring-2 focus:ring-white"
              >
                <span>Jelajahi Jurnal Tani</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column (4/12 - 33%): Vertical Farm Priority & Agenda Rail (Teagasc Signature) -->
        <div class="lg:col-span-4 flex flex-col justify-between bg-white border border-[var(--color-border)] rounded-[4px] p-5 sm:p-6 shadow-xs">
          <div>
            <div class="pb-3 border-b-2 border-[var(--color-brand)] mb-3 flex items-center justify-between">
              <span class="text-xs font-extrabold uppercase tracking-wider text-[var(--color-brand-strong)]">
                Agenda & Prioritas Lapangan
              </span>
              <span class="w-2 h-2 rounded-full bg-[var(--color-brand)]" aria-hidden="true"></span>
            </div>

            <!-- Priority 1 (Active Focus) -->
            <div class="py-3 border-l-4 border-[var(--color-brand)] pl-3 -ml-1 bg-emerald-50/60 rounded-r-[2px] mb-2">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[var(--color-brand-strong)]">
                Fokus Musim Hujan
              </span>
              <h2 class="text-sm font-bold text-[var(--color-brand-strong)] leading-snug mt-0.5">
                Kesiapsiagaan Hama & Penyakit Musim Hujan
              </h2>
              <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                Protokol pencegahan patek cabai, busuk daun, dan serangan wereng akibat kelembapan tinggi.
              </p>
            </div>

            <!-- Priority 2: Cuaca BMKG -->
            <a
              href="/alat/cuaca-tani/"
              class="group block py-3 border-t border-[var(--color-border)] hover:bg-[var(--color-canvas)] -mx-2 px-2 transition-colors rounded-[2px]"
            >
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)]">
                  Cuaca Tani & Jendela Semprot BMKG
                </span>
                <span class="text-xs text-[var(--color-brand)] font-bold transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </div>
              <p class="text-[11px] text-[var(--color-text-muted)] mt-0.5 leading-relaxed">
                Prakiraan BMKG per 3 jam tingkat desa untuk memilih waktu semprot tanpa risiko tercuci hujan.
              </p>
            </a>

            <!-- Priority 3: Kalkulator Dosis -->
            <a
              href="/alat/kalkulator-dosis/"
              class="group block py-3 border-t border-[var(--color-border)] hover:bg-[var(--color-canvas)] -mx-2 px-2 transition-colors rounded-[2px]"
            >
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)]">
                  Kalkulator Dosis Tangki 16L Knapsack
                </span>
                <span class="text-xs text-[var(--color-brand)] font-bold transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </div>
              <p class="text-[11px] text-[var(--color-text-muted)] mt-0.5 leading-relaxed">
                Takaran per tangki gendong dan drum 200L sesuai luas lahan dan anjuran label resmi.
              </p>
            </a>

            <!-- Priority 4: Kalender Tanam -->
            <a
              href="/alat/kalender-tanam/"
              class="group block py-3 border-t border-[var(--color-border)] hover:bg-[var(--color-canvas)] -mx-2 px-2 transition-colors rounded-[2px]"
            >
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)]">
                  Kalender Tanam & Fase HST MT1 2026
                </span>
                <span class="text-xs text-[var(--color-brand)] font-bold transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </div>
              <p class="text-[11px] text-[var(--color-text-muted)] mt-0.5 leading-relaxed">
                Panduan umur Hari Setelah Tanam, jadwal tindakan berkala, dan ekspor kalender HP (.ics).
              </p>
            </a>
          </div>

          <!-- Priority 5: Konsultasi -->
          <div class="pt-3 border-t border-[var(--color-border)] mt-1">
            <a
              href="/konsultasi/"
              class="inline-flex items-center justify-between w-full p-2.5 rounded-[2px] bg-[var(--color-canvas)] hover:bg-[var(--color-tint)] border border-[var(--color-border)] text-xs font-bold text-[var(--color-brand-strong)] transition-colors"
            >
              <span>Konsultasi Langsung via WhatsApp</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. News & Publications (Jurnal Tani & Riset Lapangan) -->
  <section class="py-12 sm:py-16 bg-white border-b border-[var(--color-border)]" aria-labelledby="news-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Signature Teagasc Section Heading -->
      <div>
        <h2 id="news-heading" class="font-serif text-2xl sm:text-3xl font-bold text-[var(--color-brand-strong)]">
          Jurnal Tani & Riset Lapangan
        </h2>
        <div class="w-14 h-0.5 bg-[var(--color-brand)] mt-2 mb-8" aria-hidden="true"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left (8/12 - 67%): Recent Articles & Visual Commodity Badges -->
        <div class="lg:col-span-8">
          
          <!-- 3 Columns of Recent Articles -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:divide-x divide-y md:divide-y-0 divide-[var(--color-border)]">
            {latestArticles.map((art) => (
              <article class="first:md:pl-0 md:px-4 last:md:pr-0 pt-4 md:pt-0">
                <a
                  href={`/jurnal/topik/${art.data.topic}/`}
                  class={`topic-${art.data.topic} inline-flex items-center gap-1.5 text-xs font-bold text-[var(--color-soil)] hover:underline min-h-[32px]`}
                >
                  <span class="w-2 h-2 rounded-full bg-[var(--topic)]" aria-hidden="true"></span>
                  <span>{topicName(art.data.topic)}</span>
                </a>
                <h3 class="mt-2 font-serif text-base font-bold leading-snug text-balance">
                  <a
                    href={`/jurnal/${art.data.slug}/`}
                    class="text-[var(--color-text)] hover:text-[var(--color-brand-strong)] hover:underline underline-offset-4"
                  >
                    {art.data.title}
                  </a>
                </h3>
                <p class="mt-2 text-xs text-[var(--color-text-muted)] leading-relaxed line-clamp-3">
                  {art.data.description}
                </p>
                <p class="mt-3 text-[11px] text-[var(--color-text-muted)] tabular-nums">
                  <time datetime={art.data.pubDate.toISOString()}>{dateFmt.format(art.data.pubDate)}</time> &middot; {getReadingTime(art.body || '').text}
                </p>
              </article>
            ))}
          </div>

          <!-- View all News CTA -->
          <div class="mt-6">
            <a href="/jurnal/" class="link-more">
              Lihat semua artikel Jurnal Tani
            </a>
          </div>

          <!-- Featured Commodity Badges Row (Teagasc Calendar / Date Badges Style) -->
          <div class="mt-10 pt-8 border-t border-[var(--color-border)]">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-[var(--color-text-muted)] mb-4">
              Panduan Komoditas Unggulan Musim Ini
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              
              <!-- Commodity 1: Padi -->
              <a
                href="/jurnal/komoditas/padi/"
                class="group flex items-start gap-3 p-3.5 bg-[var(--color-canvas)] border border-[var(--color-border)] hover:border-[var(--color-brand)] rounded-[2px] transition-colors"
              >
                <div class="flex flex-col items-center justify-center w-12 h-12 bg-emerald-50 text-[var(--color-brand-strong)] border border-emerald-200 rounded-[2px] shrink-0 font-bold">
                  <span class="text-[9px] uppercase tracking-wider">Padi</span>
                  <span class="text-base font-extrabold leading-none">29</span>
                </div>
                <div class="min-w-0">
                  <span class="block text-xs font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] truncate">
                    Mitigasi Hawar & Wereng
                  </span>
                  <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">
                    29 artikel panduan teknis
                  </span>
                </div>
              </a>

              <!-- Commodity 2: Cabai -->
              <a
                href="/jurnal/komoditas/cabai/"
                class="group flex items-start gap-3 p-3.5 bg-[var(--color-canvas)] border border-[var(--color-border)] hover:border-[#B3261E] rounded-[2px] transition-colors"
              >
                <div class="flex flex-col items-center justify-center w-12 h-12 bg-red-50 text-[#B3261E] border border-red-200 rounded-[2px] shrink-0 font-bold">
                  <span class="text-[9px] uppercase tracking-wider">Cabai</span>
                  <span class="text-base font-extrabold leading-none">20</span>
                </div>
                <div class="min-w-0">
                  <span class="block text-xs font-bold text-[var(--color-text)] group-hover:text-[#B3261E] truncate">
                    Protokol Patek Antraknosa
                  </span>
                  <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">
                    20 artikel budidaya & proteksi
                  </span>
                </div>
              </a>

              <!-- Commodity 3: Jagung -->
              <a
                href="/jurnal/membasmi-ulat-grayak-jagung-faw-spodoptera/"
                class="group flex items-start gap-3 p-3.5 bg-[var(--color-canvas)] border border-[var(--color-border)] hover:border-[#7A4A22] rounded-[2px] transition-colors"
              >
                <div class="flex flex-col items-center justify-center w-12 h-12 bg-amber-50 text-[#7A4A22] border border-amber-200 rounded-[2px] shrink-0 font-bold">
                  <span class="text-[9px] uppercase tracking-wider">Jagung</span>
                  <span class="text-base font-extrabold leading-none">FAW</span>
                </div>
                <div class="min-w-0">
                  <span class="block text-xs font-bold text-[var(--color-text)] group-hover:text-[#7A4A22] truncate">
                    Mitigasi Ulat Grayak Jagung
                  </span>
                  <span class="block text-[11px] text-[var(--color-text-muted)] mt-0.5">
                    Protokol titik tumbuh tanaman
                  </span>
                </div>
              </a>

            </div>

            <!-- View all Commodities CTA -->
            <div class="mt-4">
              <a href="/jurnal/" class="link-more">
                Semua panduan komoditas lapangan
              </a>
            </div>
          </div>

        </div>

        <!-- Right (4/12 - 33%): Publications Highlight Column (Teagasc Anatomy) -->
        <div class="lg:col-span-4 lg:border-l lg:border-[var(--color-border)] lg:pl-8">
          <h3 class="font-serif text-xl font-bold text-[var(--color-text)] mb-1">
            Publikasi Teknis Terpilih
          </h3>
          <p class="text-xs text-[var(--color-text-muted)] mb-6">
            Karya Prof. Arif Prabowo & Dewan Pakar Agronomi
          </p>

          <div class="space-y-5">
            <!-- Pub 1 -->
            <div class="pb-4 border-b border-[var(--color-border)]">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[var(--color-soil)]">
                SOP Teknis Proteksi Cabai
              </span>
              <h4 class="font-serif text-sm font-bold text-[var(--color-text)] hover:text-[var(--color-brand-strong)] mt-1 leading-snug">
                <a href="/jurnal/jurus-pengendalian-antraknosa-patek-cabai/">
                  Protokol Terpadu Pengendalian Patek Antraknosa Cabai
                </a>
              </h4>
              <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed line-clamp-2">
                Sanitasi spora, jarak tanam ideal, dan aplikasi kalsium boron untuk mencegah busuk buah melingkar.
              </p>
            </div>

            <!-- Pub 2 -->
            <div class="pb-4 border-b border-[var(--color-border)]">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[var(--color-soil)]">
                Mitigasi Hama Pangan Jagung
              </span>
              <h4 class="font-serif text-sm font-bold text-[var(--color-text)] hover:text-[var(--color-brand-strong)] mt-1 leading-snug">
                <a href="/jurnal/membasmi-ulat-grayak-jagung-faw-spodoptera/">
                  Pengendalian Ulat Grayak Jagung (FAW) Spodoptera
                </a>
              </h4>
              <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed line-clamp-2">
                Perlindungan titik tumbuh tanaman jagung muda dengan bioinsektisida dan abu sekam terarah.
              </p>
            </div>

            <!-- Pub 3 -->
            <div class="pb-4 border-b border-[var(--color-border)]">
              <span class="text-[10px] font-extrabold uppercase tracking-wider text-[var(--color-soil)]">
                Vektor Virus Tanaman Padi
              </span>
              <h4 class="font-serif text-sm font-bold text-[var(--color-text)] hover:text-[var(--color-brand-strong)] mt-1 leading-snug">
                <a href="/jurnal/mencegah-penyakit-tungro-dan-wereng-hijau-padi/">
                  Pemutusan Rantai Vektor Wereng Hijau Virus Tungro Padi
                </a>
              </h4>
              <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed line-clamp-2">
                Identifikasi daun kuning oranye dan strategi pemutusan siklus vektor wereng hijau di persawahan.
              </p>
            </div>
          </div>

          <!-- View all Publications CTA -->
          <div class="mt-6">
            <a href="/penulis/arif-prabowo/" class="link-more">
              Lihat publikasi dewan pakar
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. The Iconic Two Horizontal Pillars (Teagasc Farm Advisory & Research & Innovation) -->
  <section class="py-12 sm:py-16 bg-white border-b border-[var(--color-border)]" aria-labelledby="pillars-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Screen reader heading -->
      <h2 id="pillars-heading" class="sr-only">Pilar Layanan dan Riset Lapangan</h2>

      <!-- Pillar 1: Pendampingan Agronomi Lapangan (Farm Advisory) -->
      <div class="border-t border-b border-[var(--color-border)] py-8 group">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-5">
            <Picture
              src={konsultasiImage}
              formats={['webp']}
              widths={[400, 640, 900]}
              sizes="(min-width: 1024px) 28rem, 100vw"
              quality={70}
              alt="Pendampingan dan konsultasi agronomi langsung di kebun petani"
              class="w-full aspect-[4/3] object-cover rounded-[4px] border border-[var(--color-border)] shadow-xs"
              loading="lazy"
            />
          </div>
          <div class="md:col-span-7">
            <div class="flex items-start justify-between">
              <h3 class="font-serif text-2xl sm:text-3xl font-bold text-[var(--color-brand-strong)] leading-tight">
                Pendampingan Agronomi Lapangan
              </h3>
              <a
                href="/konsultasi/"
                class="text-2xl font-serif text-[var(--color-brand)] group-hover:translate-x-1.5 transition-transform"
                aria-label="Konsultasi agronomi lapangan"
              >
                &rarr;
              </a>
            </div>
            <p class="mt-3 text-base text-[var(--color-text-muted)] leading-relaxed">
              Layanan konsultasi agronomi langsung dan independen bersama tim agronomis PT Agritani Internasional. Kirim foto gejala tanaman dan riwayat perlakuan kebun Anda via WhatsApp untuk telaah penanganan terarah tanpa biaya.
            </p>
            <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-bold text-[var(--color-text)]">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
                <span>Identifikasi Gejala Makro</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
                <span>Rekomendasi Sesuai HST</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
                <span>Bebas Biaya Petani</span>
              </div>
            </div>
            <div class="mt-6">
              <a href="/konsultasi/" class="link-more">
                Protokol konsultasi kebun
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Pillar 2: Instrumen Digital & Riset Lapangan (Research & Innovation) -->
      <div class="border-t border-b border-[var(--color-border)] py-8 group">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div class="md:col-span-5">
            <Picture
              src={alatImage}
              formats={['webp']}
              widths={[400, 640, 900]}
              sizes="(min-width: 1024px) 28rem, 100vw"
              quality={70}
              alt="Hamparan sawah dan instrumen riset pertanian lapangan"
              class="w-full aspect-[4/3] object-cover rounded-[4px] border border-[var(--color-border)] shadow-xs"
              loading="lazy"
            />
          </div>
          <div class="md:col-span-7">
            <div class="flex items-start justify-between">
