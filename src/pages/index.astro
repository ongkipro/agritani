---
/**
 * src/pages/index.astro
 * Modern Farming UI/UX — Hybrid Corporate Profile, Scientific Journal,
 * Field Precision Tools, and Agronomy Consultation.
 *
 * Designed with organic breathing room, high typographic contrast (Newsreader
 * display serif + Plus Jakarta Sans functional data), zero card-soup borders,
 * and strict adherence to CSP and WCAG AAA accessibility.
 */

import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { topicName } from '../lib/topics';
import { getReadingTime } from '../lib/reading-time';
import { getArticleImage } from '../lib/topic-images';
import { articleImageAlt } from '../lib/image-alt';
import { getProductImage } from '../lib/product-images';
import type { SeoInput } from '../lib/seo';

// Media assets
import heroSawah from '../assets/images/hero/hero-sawah-padi.webp';
import heroSawit from '../assets/images/hero/hero-kebun-sawit.webp';
import heroCabai from '../assets/images/hero/hero-hortikultura-cabai.webp';
import heroJagung from '../assets/images/hero/hero-kebun-jagung.webp';
import heroIrigasi from '../assets/images/hero/hero-irigasi-pertanian.webp';
import konsultasiImage from '../assets/images/dummy/konsultasi.webp';
import arifPortrait from '../assets/images/authors/arif-prabowo.webp';

const heroSlides = [
  {
    image: heroSawah,
    alt: 'Hamparan sawah padi bertingkat hijau di Indonesia untuk panduan budidaya Agritani',
    badge: 'Padi & Tanaman Pangan',
  },
  {
    image: heroSawit,
    alt: 'Perkebunan kelapa sawit produktif tropis Indonesia dengan perawatan agronomi Agritani',
    badge: 'Perkebunan Sawit Presisi',
  },
  {
    image: heroCabai,
    alt: 'Pertanian tanaman cabai merah subur di dataran tinggi Indonesia bersama Agritani',
    badge: 'Hortikultura & Sayuran',
  },
  {
    image: heroJagung,
    alt: 'Lahan perkebunan jagung berbulir emas subur di Indonesia dalam riset Agritani',
    badge: 'Palawija & Jagung Hibrida',
  },
  {
    image: heroIrigasi,
    alt: 'Saluran irigasi pertanian presisi mengairi persawahan hijau subur di Agritani',
    badge: 'Irigasi & Manajemen Lahan',
  },
];

// 1. Fetch articles (respecting draft preview environment)
const isDraftPreview = import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true';
const allArticles = await getCollection('articles', ({ data }) => {
  return isDraftPreview || !data.draft;
});

// Helper for dynamic published count per commodity
const getCommodityArticleCount = (commId: string) => {
  return allArticles.filter((a) => {
    return a.data.commodities?.some((c) => (typeof c === 'string' ? c : c.id) === commId);
  }).length;
};

// Sort articles by publication date descending
const sortedArticles = [...allArticles].sort((a, b) => {
  return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});

const featuredArticle = sortedArticles[0];
const recentDispatches = sortedArticles.slice(1, 4);
const dateFmt = new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

// 2. Fetch products collection (verified data only, DEC-010)
const allProducts = await getCollection('products');
const order = ['aussie', 'kojien', 'bensu', 'saratoga'];
const sortedProducts = [...allProducts].sort((a, b) => {
  const indexA = order.indexOf(a.id);
  const indexB = order.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

// SEO configuration
const seoProps: SeoInput = {
  title: 'Agritani: Portal Pertanian, Jurnal Tani & Produk Unggulan Presisi',
  metaTitle: 'Agritani: Portal Pertanian, Jurnal Tani & Produk Unggulan Presisi',
  description:
    'Portal pertanian resmi yang dikelola Arif Prabowo (Agritani Official): panduan Jurnal Tani, alat bantu lapangan, dan empat produk unggulan pertanian.',
  canonicalPath: '/',
  pageType: 'website',
  ogType: 'website',
  ogImage: '/og/default.png',
};
---

<BaseLayout seo={seoProps}>

  <!-- 1. Hero Photographic Masthead & Precision Tools Deck (Fokus Image, Proporsional) -->
  <section class="relative bg-[var(--color-canvas)] pt-6 pb-12 sm:pt-10 sm:pb-20">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Asymmetric Editorial Grid (7/12 Landscape Visual + 5/12 Field Utility Deck) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch">
        
        <!-- Left Column: Photographic Editorial Masthead (Auto Slider Continuously, 5 Lanskap Unggulan) -->
        <div
          id="hero-masthead-slider"
          class="lg:col-span-7 relative min-h-[460px] sm:min-h-[540px] flex flex-col justify-end p-6 sm:p-8 lg:p-10 rounded-[2px] overflow-hidden group select-none"
          role="region"
          aria-roledescription="carousel"
          aria-label="Galeri lanskap pertanian unggulan Agritani"
        >
          <!-- Background Slides Container -->
          <div class="absolute inset-0 overflow-hidden" aria-live="off">
            {heroSlides.map((slide, idx) => (
              <div
                class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${idx === 0 ? 'opacity-100 z-1' : 'opacity-0 z-0'}`}
                data-slide-index={idx}
                aria-hidden={idx === 0 ? 'false' : 'true'}
              >
                <Picture
                  src={slide.image}
                  formats={['webp']}
                  fallbackFormat="webp"
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 1024px) 46rem, 100vw"
                  quality={80}
                  alt={slide.alt}
                  class="w-full h-full object-cover transition-transform duration-7000 ease-out transform scale-100 group-hover:scale-[1.02]"
                  loading={idx === 0 ? 'eager' : 'lazy'}
                  fetchpriority={idx === 0 ? 'high' : 'auto'}
                />
              </div>
            ))}
          </div>

          <!-- Atmospheric Bottom-Weighted Vignette: Bagian Atas Gambar Jernih, Bawah Bergradasi Halus -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-[var(--color-brand-strong)]/95 via-[var(--color-brand-strong)]/85 via-45% to-transparent to-80% z-2 pointer-events-none"
            aria-hidden="true"
          ></div>

          <!-- Bottom Content: Headline, Deskripsi, CTAs & Slider Arrows -->
          <div class="relative z-10 max-w-[44ch] mt-auto">
            <h1 class="font-serif text-2xl sm:text-3xl lg:text-[2.25rem] font-bold text-white leading-tight tracking-tight">
              Standar Agronomi Presisi & Sains Lapangan Tropis
            </h1>
            <p class="mt-3 text-sm sm:text-base text-white/95 leading-relaxed max-w-[38ch]">
              Portal pertanian resmi Agritani yang dikelola Arif Prabowo bersama tim agronomi lapangan.
            </p>

            <!-- CTAs and Navigation Controls -->
            <div class="mt-6 sm:mt-7 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-3 sm:gap-4">
                <a
                  href="/alat/"
                  class="inline-flex items-center gap-2 px-5 py-3 min-h-[44px] rounded-[2px] bg-[var(--color-harvest)] text-[var(--color-text)] font-extrabold text-xs sm:text-sm hover:bg-[var(--color-harvest-hover)] transition-colors focus:outline-none focus:ring-2 focus:ring-white"
                >
                  <span>Buka Instrumen Tani</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
                <a
                  href="/jurnal/"
                  class="inline-flex items-center gap-2 px-5 py-3 min-h-[44px] rounded-[2px] bg-white/15 hover:bg-white/25 text-white text-xs sm:text-sm font-bold transition-colors backdrop-blur-xs focus:outline-none focus:ring-2 focus:ring-white"
                >
                  <span>Jelajahi Jurnal Ilmiah</span>
                </a>
              </div>

              <!-- Compact Nav Controls: Prev / Next Buttons -->
              <div class="hidden sm:flex items-center gap-1.5">
                <button
                  type="button"
                  id="hero-slider-prev"
                  aria-label="Slide sebelumnya"
                  class="w-9 h-9 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-[2px] bg-white/15 hover:bg-white/30 text-white backdrop-blur-xs transition-colors cursor-pointer focus:outline-none focus:ring-1 focus:ring-white"
                >
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m13 16-6-6 6-6"/>
                  </svg>
                </button>
                <button
                  type="button"
                  id="hero-slider-next"
                  aria-label="Slide berikutnya"
                  class="w-9 h-9 min-h-[44px] min-w-[44px] flex items-center justify-center rounded-[2px] bg-white/15 hover:bg-white/30 text-white backdrop-blur-xs transition-colors cursor-pointer focus:outline-none focus:ring-1 focus:ring-white"
                >
                  <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m7 16 6-6-6-6"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Modern Field Precision Deck (Clean, No Card-Soup) -->
        <div class="lg:col-span-5 flex flex-col justify-between py-2 sm:py-4">
          <div>
            <div class="flex items-baseline justify-between mb-4">
              <h2 class="text-sm font-bold text-[var(--color-brand-strong)]">
                Instrumen Cepat Lapangan
              </h2>
              <span class="text-xs font-semibold text-[var(--color-text-muted)]">
                Musim Tanam 2026
              </span>
            </div>

            <!-- Modern Farming Utility List (Free of Card-Borders); -mx cancels row padding so text aligns with the heading -->
            <div class="-mx-3.5 space-y-2">
              
              <!-- Tool 1: Cuaca Tani BMKG -->
              <a
                href="/alat/cuaca-tani/"
                class="group block p-3.5 rounded-[2px] hover:bg-[var(--color-tint)] transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                      Prakiraan Cuaca Tani BMKG
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                      Prakiraan 3 hari per 3 jam tingkat desa untuk menentukan jendela semprot aman tanpa risiko tercuci hujan.
                    </p>
                  </div>
                  <span class="text-sm font-bold text-[var(--color-brand)] group-hover:translate-x-1 transition-transform shrink-0 mt-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>

              <!-- Tool 2: Kalkulator Dosis 16L -->
              <a
                href="/alat/kalkulator-dosis/"
                class="group block p-3.5 rounded-[2px] hover:bg-[var(--color-tint)] transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                      Kalkulator Dosis Tangki 16L
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                      Hitungan presisi takaran mililiter per tangki knapsack gendong dan drum 200L sesuai anjuran label resmi.
                    </p>
                  </div>
                  <span class="text-sm font-bold text-[var(--color-brand)] group-hover:translate-x-1 transition-transform shrink-0 mt-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>

              <!-- Tool 3: Diagnosa Visual Gejala -->
              <a
                href="/alat/diagnosa-gejala/"
                class="group block p-3.5 rounded-[2px] hover:bg-[var(--color-tint)] transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                      Diagnosa Visual Gejala Tanaman
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                      Identifikasi cepat hama, patogen, dan defisiensi hara di kebun secara tap-first tanpa mengetik.
                    </p>
                  </div>
                  <span class="text-sm font-bold text-[var(--color-brand)] group-hover:translate-x-1 transition-transform shrink-0 mt-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>

              <!-- Tool 4: Kalender Tanam & Fase HST -->
              <a
                href="/alat/kalender-tanam/"
                class="group block p-3.5 rounded-[2px] hover:bg-[var(--color-tint)] transition-colors"
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-base font-bold text-[var(--color-text)] group-hover:text-[var(--color-brand-strong)] transition-colors">
                      Kalender Tanam & Fase HST
                    </h3>
                    <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
                      Panduan umur Hari Setelah Tanam, jadwal perlakuan berkala, dan sinkronisasi ke kalender ponsel (.ics).
                    </p>
                  </div>
                  <span class="text-sm font-bold text-[var(--color-brand)] group-hover:translate-x-1 transition-transform shrink-0 mt-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>

            </div>
          </div>

          <!-- Quick Consultation Entry (Text link without WhatsApp mention, DESIGN §2.8) -->
          <div class="mt-4 pt-2">
            <a
              href="/konsultasi/"
              class="link-more text-xs sm:text-sm"
            >
              Butuh telaah kebun langsung? Pelajari alur konsultasi &rarr;
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. Profil Pengelola: Arif Prabowo & Agritani -->
  <section class="py-16 sm:py-24 bg-[var(--color-surface)]" aria-labelledby="authority-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header (Standard Site-Wide Rhythm) -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-12">
        <div>
          <h2 id="authority-heading" class="section-headline">
            Integritas Sains &amp; Riset Terapan Lapangan
          </h2>
          <p class="section-subheading">
            Standar kurasi agronomi dan moderasi naskah Jurnal Tani yang dipimpin langsung oleh Arif Prabowo.
          </p>
        </div>
        <div class="shrink-0">
          <a href="/penulis/arif-prabowo/" class="link-more text-sm">
            Profil lengkap &amp; arsip panduan &rarr;
          </a>
        </div>
      </div>

      <!-- Balanced Editorial Grid (4 cols Author Identity + 8 cols Editorial Standards & Metrics) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left: Foto Profil & Identitas Penulis (4 cols) -->
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-4 sm:gap-6 lg:gap-4 items-start">
          <div class="shrink-0 w-full max-w-[260px] sm:max-w-[220px] lg:max-w-[280px]">
            <Picture
              src={arifPortrait}
              formats={['webp']}
              fallbackFormat="webp"
              widths={[240, 360, 560]}
              sizes="(min-width: 1024px) 18rem, (min-width: 640px) 14rem, 16rem"
              quality={85}
              alt="Foto Arif Prabowo, Konsultan Pertanian Senior Agritani"
              class="w-full aspect-[4/5] object-cover object-[50%_18%] rounded-[2px] border border-[var(--color-border)] bg-[var(--color-canvas)]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex-1 min-w-0 space-y-1">
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-[var(--color-text)] tracking-tight">
              Arif Prabowo
            </h3>
            <p class="text-xs sm:text-sm font-semibold text-[var(--color-soil)]">
              Konsultan Pertanian Senior · Pengelola Jurnal Tani
            </p>
            <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed pt-1">
              Praktisi budidaya lapangan tropis lebih dari 8 tahun; sales dan konsultan teknis produk hayati unggulan Agritani Official.
            </p>
          </div>
        </div>

        <!-- Right: Pernyataan Editorial & Metrik Kunci (8 cols) -->
        <div class="lg:col-span-8 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <p class="font-serif text-xl sm:text-2xl text-[var(--color-text)] leading-snug">
              Artikel Jurnal Tani ditulis dan dimoderasi langsung oleh Arif Prabowo; rujukan ilmiah terpercaya dicantumkan di akhir naskah bila tersedia.
            </p>
            <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
              Setiap pembahasan disusun berdasarkan observasi riil di lahan tropis Indonesia, telaah fisiologi tanaman teruji, dan kalibrasi rekomendasi dosis yang bertanggung jawab untuk melindungi tanaman petani dari risiko kerusakan serta pemborosan biaya input. Seluruh materi disajikan terbuka tanpa pungutan biaya demi mendukung kemandirian petani di sentra pangan Nusantara.
            </p>
          </div>

          <!-- Prinsip Lapangan Terbuka (Open Typography, No Card-Borders, DEC-019) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4 pt-1 text-xs sm:text-sm">
            <div>
              <span class="font-bold text-[var(--color-text)] block">Observasi Nyata Lapangan</span>
              <span class="text-[var(--color-text-muted)] leading-relaxed block mt-0.5">
                Diuji langsung pada komoditas pangan dan perkebunan di iklim tropis Nusantara sebelum dipublikasikan.
              </span>
            </div>
            <div>
              <span class="font-bold text-[var(--color-text)] block">Kalibrasi Dosis Bertanggung Jawab</span>
              <span class="text-[var(--color-text-muted)] leading-relaxed block mt-0.5">
                Rekomendasi takaran presisi untuk menjaga kelestarian hara tanah dan melindungi keselamatan tanaman.
              </span>
            </div>
          </div>

          <!-- 3 Kolom Poin Kunci Presisi -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-6 pt-6 border-t border-[var(--color-border)] text-[var(--color-text)]">
            <div class="flex items-baseline gap-3 sm:block">
              <span class="block shrink-0 font-serif text-2xl sm:text-3xl font-bold text-[var(--color-brand-strong)] tabular-nums">&gt;8 Tahun</span>
              <span class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-tight block sm:mt-1">Riset Lapangan Tropis</span>
            </div>
            <div class="flex items-baseline gap-3 sm:block">
              <span class="block shrink-0 font-serif text-2xl sm:text-3xl font-bold text-[var(--color-brand-strong)] tabular-nums">{allArticles.length} Panduan</span>
              <span class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-tight block sm:mt-1">Naskah Jurnal Terbit</span>
            </div>
            <div class="flex items-baseline gap-3 sm:block">
              <span class="block shrink-0 font-serif text-2xl sm:text-3xl font-bold text-[var(--color-brand-strong)] tabular-nums">Akses Terbuka</span>
              <span class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-tight block sm:mt-1">Edukasi Tanpa Biaya</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. Portal Artikel: Jurnal Tani & Riset Lapangan -->
  <section class="py-16 sm:py-24 bg-[var(--color-canvas)]" aria-labelledby="journal-heading">
    <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <h2 id="journal-heading" class="section-headline">
            Jurnal Tani & Riset Lapangan
          </h2>
          <p class="section-subheading">
            Panduan teknis budidaya, mitigasi patogen, dan manajemen hara berbasis pembuktian ilmiah terbuka.
          </p>
        </div>
        <div class="shrink-0">
          <a href="/jurnal/" class="link-more text-sm">
            Lihat seluruh arsip jurnal &rarr;
          </a>
        </div>
      </div>

      <!-- Editorial Magazine Layout: Lead Story (7/12) + Recent Dispatches (5/12) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        
        <!-- Lead Feature Story with Rich Topic Image -->
        {featuredArticle && (
          <article class="lg:col-span-7 lg:mt-3 flex flex-col justify-between group">
            <div>
              <a
                href={`/jurnal/${featuredArticle.data.slug}/`}
                class="block mb-5 rounded-[2px] overflow-hidden aspect-[16/9] relative bg-[var(--color-surface)]"
                tabindex="-1"
                aria-hidden="true"
              >
                <Picture
                  src={getArticleImage(featuredArticle.data)}
                  formats={['webp']}
                  fallbackFormat="webp"
                  widths={[480, 800, 1100]}
                  sizes="(min-width: 1024px) 42rem, 100vw"
                  quality={75}
                  alt={`Ilustrasi agronomi panduan ${featuredArticle.data.title}`}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <a
                href={`/jurnal/topik/${featuredArticle.data.topic}/`}
                class={`topic-${featuredArticle.data.topic} topic-link mb-2.5`}
              >
                <span class="topic-marker" aria-hidden="true"></span>
                <span>{topicName(featuredArticle.data.topic)}</span>
              </a>
              <h3 class="font-serif text-2xl sm:text-3xl lg:text-[28px] xl:text-[32px] font-bold text-[var(--color-text)] tracking-tight leading-[1.25]">
                <a
                  href={`/jurnal/${featuredArticle.data.slug}/`}
                  class="group-hover:text-[var(--color-brand-strong)] group-hover:underline group-hover:decoration-[var(--color-brand)]/40 group-hover:decoration-2 group-hover:underline-offset-4 transition-all duration-200"
                >
                  {featuredArticle.data.title}
                </a>
              </h3>
              <p class="mt-3 text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed line-clamp-3">
                {featuredArticle.data.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-[var(--color-border)] flex items-center gap-3 text-xs text-[var(--color-text-muted)] tabular-nums font-medium">
              <span>Arif Prabowo</span>
              <span aria-hidden="true">&middot;</span>
              <time datetime={featuredArticle.data.pubDate.toISOString()}>{dateFmt.format(featuredArticle.data.pubDate)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{getReadingTime(featuredArticle.body || '').text}</span>
            </div>
          </article>
        )}

        <!-- Stream of Recent Dispatches (Rich Rows with Thumbnails) -->
        <div class="lg:col-span-5 flex flex-col divide-y divide-[var(--color-border)] lg:border-l lg:border-[var(--color-border)] lg:pl-8 xl:pl-10">
          {recentDispatches.map((article) => (
            <article class="group flex gap-4 sm:gap-5 items-stretch py-5 first:pt-0 last:pb-0">
              <a
                href={`/jurnal/${article.data.slug}/`}
