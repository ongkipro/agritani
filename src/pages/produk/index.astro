---
/**
 * src/pages/produk/index.astro
 * Product catalog & comparison index (T-11, DESIGN §2.5, §4.2.3)
 * Invariants: no WhatsApp CTA, 2px radius, one card per product (DESIGN §3.3.3), no kickers/section dividers, 0/0/0 CSP, tabular numbers.
 * Prices come from src/data/products.json (checked 2026-09-30).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductCard from '../../components/ProductCard.astro';
import type { SeoInput } from '../../lib/seo';

const allProducts = await getCollection('products');
const allCommodities = await getCollection('commodities');
const commoditiesMap = new Map(allCommodities.map((c) => [c.id, c.data.name]));

// Sort order: aussie, kojien, bensu, saratoga
const order = ['aussie', 'kojien', 'bensu', 'saratoga'];
const sortedProducts = [...allProducts].sort((a, b) => {
  const indexA = order.indexOf(a.id);
  const indexB = order.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Produk', url: '/produk/' },
];

const seo: SeoInput = {
  title: 'Katalog Produk Pertanian: Aussie, BENSU, Kojien & Saratoga',
  description:
    'Katalog empat produk biostimulan dan aktivator imun Agritani: Aussie, Kojien, BENSU, dan Saratoga. Kemasan 500 ml dan 1 liter, dosis, dan komoditas.',
  canonicalPath: '/produk/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/produk/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <header class="mt-6 mb-6 sm:mt-8 sm:mb-8 max-w-3xl">
      <h1 class="pillar-title">Produk Agritani</h1>
      <p class="pillar-lede">
        Empat produk unggulan Agritani untuk ketahanan dan pemulihan tanaman, dengan teknologi asal Thailand dan Jepang. Pilih sesuai komoditas Anda, lalu buka rincian untuk dosis dan cara aplikasi.
      </p>
    </header>

    <nav class="mb-6 text-sm flex flex-wrap items-center gap-x-4 gap-y-2" aria-label="Pilih produk sesuai tanaman">
      <span class="font-semibold text-[var(--color-text)] shrink-0">Pilih sesuai tanaman:</span>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1.5">
        {[
          { id: 'aussie', label: 'Sawit & tanaman keras' },
          { id: 'kojien', label: 'Padi' },
          { id: 'bensu', label: 'Palawija & sayuran' },
          { id: 'saratoga', label: 'Pembungaan & pembuahan' },
        ].map((l) => (
          <li>
            <a href={`#${l.id}`} class="py-1 text-[var(--color-brand-strong)] underline underline-offset-4 decoration-[var(--color-border-control)] hover:decoration-[var(--color-brand)] inline-flex items-center min-h-[44px]">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 sm:gap-6" aria-label="Empat produk Agritani">
      {sortedProducts.map((product) => (
        <ProductCard product={product} commoditiesMap={commoditiesMap} />
      ))}
    </section>

    <p class="mt-4 mb-16 max-w-2xl text-xs text-[var(--color-text-muted)] leading-relaxed">
      Harga per 30 September 2026 dan dapat berubah sewaktu-waktu.
    </p>

    <section class="mb-16" aria-labelledby="heading-keaslian">
      <h2 id="heading-keaslian" class="section-title">Memeriksa keaslian kemasan</h2>
      <dl class="grid gap-6 sm:grid-cols-3 sm:gap-8 text-sm leading-relaxed max-w-5xl">
        <div>
          <dt class="font-semibold text-[var(--color-text)]">Segel ShieldedTag™</dt>
          <dd class="mt-1 text-[var(--color-text-muted)]">
            Tutup botol dikunci segel hologram yang robek saat dibuka pertama kali. Jangan terima kemasan dengan segel rusak.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-[var(--color-text)]">Sifat cairan</dt>
          <dd class="mt-1 text-[var(--color-text-muted)]">
            Cairan asli berupa konsentrat tanpa endapan kasar, beraroma khas fermentasi organik, dan larut merata dalam air tangki.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-[var(--color-text)]">Nomor izin edar</dt>
          <dd class="mt-1 text-[var(--color-text-muted)]">
            Formula terdaftar di Kementerian Pertanian Republik Indonesia. Nomor izin edar tercetak pada label botol.
          </dd>
        </div>
      </dl>
    </section>

    <section class="mb-16" aria-labelledby="heading-layanan-terkait">
      <h2 id="heading-layanan-terkait" class="section-title">Distribusi Resmi &amp; Panduan Lapangan</h2>
      <div class="grid gap-8 md:grid-cols-2 md:gap-12 max-w-5xl">
        <div>
          <h3 class="font-serif text-lg font-semibold text-[var(--color-text)]">Distribusi &amp; Keagenan Resmi</h3>
          <p class="mt-2 text-sm sm:text-base leading-relaxed text-[var(--color-text-muted)]">
            Agritani Official adalah distributor resmi dan utama penjualan daring produk hayati unggulan ini. Kami juga membuka kesempatan kerja sama keagenan bagi kios saprotan dan kelompok tani di wilayah Anda.
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
            <a href="/tentang-kami/" class="link-more text-sm">Profil Agritani &rarr;</a>
            <a href="/kemitraan-distributor/" class="link-more text-sm">Kemitraan wilayah &rarr;</a>
          </div>
        </div>

        <div>
          <h3 class="font-serif text-lg font-semibold text-[var(--color-text)]">Aplikasi Tepat &amp; Efisien</h3>
          <p class="mt-2 text-sm sm:text-base leading-relaxed text-[var(--color-text-muted)]">
            Hindari pemborosan pupuk dan aktivator imun dengan menghitung kebutuhan larutan per tangki secara presisi dan memeriksa jendela semprot BMKG sebelum aplikasi.
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2">
            <a href="/alat/kalkulator-dosis/" class="link-more text-sm">Kalkulator dosis &rarr;</a>
            <a href="/alat/cuaca-tani/" class="link-more text-sm">Prakiraan cuaca tani &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
