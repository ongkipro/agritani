---
/**
 * src/pages/produk/index.astro
 * Product Catalog & Comparison Index (T-11, DESIGN §2.5, §4.2.3)
 * Invariants: Zero WhatsApp CTAs (DESIGN §2.8), 2px radius, text contrast >= 7:1, 0/0/0 CSP, tabular numbers.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductRow from '../../components/ProductRow.astro';
import type { SeoInput } from '../../lib/seo';

const allProducts = await getCollection('products');
const allCommodities = await getCollection('commodities');
const commoditiesMap = new Map(allCommodities.map((c) => [c.id, c.data.name]));

// Sort order: aussie, kojien, bensu, saratoga
const order = ['aussie', 'kojien', 'bensu', 'saratoga'];
const sortedProducts = [...allProducts].sort((a, b) => {
  const indexA = order.indexOf(a.id);
  const indexB = order.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

const formatRupiah = (val: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Produk', url: '/produk/' },
];

const seo: SeoInput = {
  title: 'Katalog Produk Pertanian Resmi',
  description:
    'Katalog empat formula biostimulan dan aktivator imun Agritani: Aussie, Kojien, BENSU, dan Saratoga. Pilihan kemasan 500 ml dan 1 Liter, dosis aplikasi, dan sasaran komoditas.',
  canonicalPath: '/produk/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/produk/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (Editorial Canvas) -->
    <header class="my-8 sm:my-12">
      <div class="max-w-3xl space-y-4">
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)] tracking-tight leading-tight">
          Produk Agritani
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
          Empat formula biostimulan dan aktivator kekebalan sel tanaman berlisensi teknologi Thailand dan Jepang. Diformulasikan khusus untuk memperkokoh ketahanan tanaman terhadap infeksi patogen tular tanah dan memacu produktivitas panen di iklim tropis Indonesia.
        </p>
      </div>
    </header>

    <!-- Commodity Quick Filters / Anchor Jump -->
    <nav class="mb-10 sm:mb-12" aria-label="Navigasi cepat produk per jenis tanaman">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mr-1">
          Pilihan Cepat:
        </span>
        <a
          href="#aussie"
          class="inline-flex items-center px-3.5 py-2 min-h-[44px] text-xs sm:text-sm font-medium bg-[var(--color-surface)] hover:bg-[var(--color-tint)] border border-[var(--color-border-control)]/40 hover:border-[var(--color-brand)] text-[var(--color-text)] rounded-[2px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          Sawit & Tanaman Keras (Aussie)
        </a>
        <a
          href="#kojien"
          class="inline-flex items-center px-3.5 py-2 min-h-[44px] text-xs sm:text-sm font-medium bg-[var(--color-surface)] hover:bg-[var(--color-tint)] border border-[var(--color-border-control)]/40 hover:border-[var(--color-brand)] text-[var(--color-text)] rounded-[2px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          Spesialis Padi (Kojien)
        </a>
        <a
          href="#bensu"
          class="inline-flex items-center px-3.5 py-2 min-h-[44px] text-xs sm:text-sm font-medium bg-[var(--color-surface)] hover:bg-[var(--color-tint)] border border-[var(--color-border-control)]/40 hover:border-[var(--color-brand)] text-[var(--color-text)] rounded-[2px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          Pangan & Hortikultura (BENSU)
        </a>
        <a
          href="#saratoga"
          class="inline-flex items-center px-3.5 py-2 min-h-[44px] text-xs sm:text-sm font-medium bg-[var(--color-surface)] hover:bg-[var(--color-tint)] border border-[var(--color-border-control)]/40 hover:border-[var(--color-brand)] text-[var(--color-text)] rounded-[2px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          Serum Asam Amino (Saratoga)
        </a>
      </div>
    </nav>

    <!-- Desktop Technical Comparison Matrix (Visible on lg screens >= 1024px) -->
    <section class="hidden lg:block mb-14" aria-label="Tabel Spesifikasi dan Perbandingan Formula">
      <div class="flex items-baseline justify-between mb-3">
        <h2 class="text-xl font-bold font-serif text-[var(--color-brand)]">
          Matriks Perbandingan Formula
        </h2>
        <span class="text-xs text-[var(--color-text-muted)]">
          Distribusi resmi berizin Kementan RI
        </span>
      </div>

      <div class="overflow-x-auto border border-[var(--color-border-control)]/30 rounded-[2px] bg-[var(--color-surface)] shadow-2xs">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-[var(--color-tint)]/60 border-b border-[var(--color-border-control)]/20 text-xs font-bold uppercase tracking-wider text-[var(--color-text)]">
              <th scope="col" class="py-3 px-4">Formula</th>
              <th scope="col" class="py-3 px-4">Peran & Sasaran Masalah</th>
              <th scope="col" class="py-3 px-4">Komoditas Utama</th>
              <th scope="col" class="py-3 px-4">Kemasan & Harga Resmi</th>
              <th scope="col" class="py-3 px-4 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border-control)]/20">
            {sortedProducts.map((p) => {
              const d = p.data;
              const minPrice = d.variants && d.variants.length > 0
                ? Math.min(...d.variants.map((v) => v.price))
                : null;
              return (
                <tr class="hover:bg-[var(--color-tint)]/30 transition-colors">
                  <td class="py-4 px-4 font-bold font-serif text-[var(--color-brand)] text-base whitespace-nowrap">
                    <div>{d.name}</div>
                    <span class="block text-[11px] font-sans font-normal text-[var(--color-text-muted)]">
                      {d.tagline}
                    </span>
                  </td>
                  <td class="py-4 px-4 text-[var(--color-text)] text-xs sm:text-sm max-w-xs leading-relaxed">
                    {d.role}
                  </td>
                  <td class="py-4 px-4 text-[var(--color-text-muted)] text-xs">
                    <span class="block max-w-xs">
                      {d.commodities.slice(0, 4).map((c) => commoditiesMap.get(typeof c === 'string' ? c : c.id) || c).join(', ')}
                      {d.commodities.length > 4 && ` +${d.commodities.length - 4} lainnya`}
                    </span>
                  </td>
                  <td class="py-4 px-4 text-xs whitespace-nowrap">
                    {minPrice ? (
                      <div>
                        <div class="font-bold text-[var(--color-brand-strong)] tabular-nums text-sm">
                          Mulai {formatRupiah(minPrice)}
                        </div>
                        <span class="text-[var(--color-text-muted)] text-[11px]">
                          500 ml & 1 Liter
                        </span>
                      </div>
                    ) : (
                      <span class="text-[var(--color-text-muted)]">Mitra Resmi</span>
                    )}
                  </td>
                  <td class="py-4 px-4 text-right whitespace-nowrap">
                    <a
                      href={`/produk/${p.id}/`}
                      class="inline-flex items-center justify-center px-3.5 py-1.5 min-h-[44px] text-xs font-semibold text-[var(--color-brand-strong)] hover:text-[var(--color-brand)] underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
                    >
                      Buka Rincian →
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Product Rows List (Clean Editorial Flow) -->
    <section class="mb-16 divide-y divide-[var(--color-border-control)]/30" aria-label="Rincian Masing-Masing Produk">
      {sortedProducts.map((product) => (
        <ProductRow product={product} commoditiesMap={commoditiesMap} />
      ))}
    </section>

    <!-- Section: Keaslian Kemasan Resmi (Clean Editorial Design, No AI Slop Cards) -->
    <section class="mb-14 pt-8 border-t border-[var(--color-border-control)]/20" aria-labelledby="heading-keaslian">
      <div class="max-w-2xl mb-8">
        <h2 id="heading-keaslian" class="text-2xl font-bold font-serif text-[var(--color-brand)] tracking-tight">
          Verifikasi Keaslian Formula Resmi
        </h2>
        <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">
          Agritani menerapkan standar pengamanan fisik berjenjang untuk memastikan setiap petani menerima formula murni tanpa pemalsuan atau pengoplosan di rantai distribusi lapangan.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">
              Segel Fisik ShieldedTag™
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
            Setiap tutup botol dikunci dengan segel hologram anti-rusak khusus yang robek saat dibuka pertama kali. Jangan terima kemasan dengan segel rusak.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">
              Karakteristik Fisik Formula
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
            Formula asli berbentuk konsentrat bebas endapan kasar dengan aroma khas fermentasi organik stabil, larut sempurna dalam air tangki semprot.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">
              Registrasi Resmi Kementan
            </h3>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
            Seluruh formula didaftarkan dan diuji secara resmi di Kementerian Pertanian Republik Indonesia. Nomor izin edar fisik tercetak pada label botol.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
