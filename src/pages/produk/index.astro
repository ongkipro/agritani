---
/**
 * src/pages/produk/index.astro
 * Product Catalog & Comparison Index (T-11, DESIGN §2.5, §4.2.3)
 * Invariants: Zero WhatsApp CTAs (DESIGN §2.8), 2px radius, text contrast >= 7:1, 0/0/0 CSP.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductRow from '../../components/ProductRow.astro';
import type { SeoInput } from '../../lib/seo';

const allProducts = await getCollection('products');
const allCommodities = await getCollection('commodities');
const commoditiesMap = new Map(allCommodities.map((c) => [c.id, c.data.name]));

// Sort order: aussie, kojien, bensu, saratoga
const order = ['aussie', 'kojien', 'bensu', 'saratoga'];
const sortedProducts = [...allProducts].sort((a, b) => {
  const indexA = order.indexOf(a.id);
  const indexB = order.indexOf(b.id);
  return (indexA === -1 ? 99 : indexA) - (indexB === -1 ? 99 : indexB);
});

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Produk', url: '/produk/' },
];

const seo: SeoInput = {
  title: 'Katalog Produk Pertanian',
  description:
    'Katalog empat produk unggulan Agritani: Aussie, Kojien, BENSU, dan Saratoga. Panduan peran, dosis aplikasi, dan sasaran komoditas tanaman.',
  canonicalPath: '/produk/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/produk/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (Lapangan Canvas) -->
    <header class="my-8 sm:my-12 max-w-3xl">
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)] tracking-tight leading-tight mb-4">
        Produk Agritani
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        Empat produk unggulan Agritani menghadirkan teknologi biostimulan dan nutrisi tanaman teruji dari Thailand dan Jepang. Diformulasikan secara presisi untuk memperkuat ketahanan seluler alami tanaman serta mengoptimalkan produktivitas panen di iklim tropis Indonesia.
      </p>
    </header>

    <!-- Commodity Anchor Shortcuts -->
    <nav class="mb-12" aria-label="Navigasi cepat per komoditas">
      <p class="text-sm font-semibold text-[var(--color-text)] mb-3">
        Lompat ke produk sesuai tanaman Anda:
      </p>
      <div class="flex flex-wrap gap-2.5">
        <a
          href="#aussie"
          class="inline-flex items-center px-4 py-2.5 min-h-[44px] text-sm font-semibold bg-[var(--color-surface)] hover:bg-[var(--color-tint)] border border-[var(--color-border-control)]/40 hover:border-[var(--color-brand)] text-[var(--color-text)] rounded-[2px] transition-colors shadow-2xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          Sawit & Tanaman Keras (Aussie)
        </a>
        <a
          href="#kojien"
          class="inline-flex items-center px-4 py-2.5 min-h-[44px] text-sm font-semibold bg-[var(--color-surface)] hover:bg-[var(--color-tint)] border border-[var(--color-border-control)]/40 hover:border-[var(--color-brand)] text-[var(--color-text)] rounded-[2px] transition-colors shadow-2xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          Spesialis Padi (Kojien)
        </a>
        <a
          href="#bensu"
          class="inline-flex items-center px-4 py-2.5 min-h-[44px] text-sm font-semibold bg-[var(--color-surface)] hover:bg-[var(--color-tint)] border border-[var(--color-border-control)]/40 hover:border-[var(--color-brand)] text-[var(--color-text)] rounded-[2px] transition-colors shadow-2xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          Palawija & Sayuran (BENSU)
        </a>
        <a
          href="#saratoga"
          class="inline-flex items-center px-4 py-2.5 min-h-[44px] text-sm font-semibold bg-[var(--color-surface)] hover:bg-[var(--color-tint)] border border-[var(--color-border-control)]/40 hover:border-[var(--color-brand)] text-[var(--color-text)] rounded-[2px] transition-colors shadow-2xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
        >
          Semua Tanaman & Bunga (Saratoga)
        </a>
      </div>
    </nav>

    <!-- Desktop Comparison Table (Visible on lg screens >= 1024px) -->
    <section class="hidden lg:block mb-12" aria-label="Tabel Perbandingan Produk">
      <h2 class="text-xl font-bold font-serif text-[var(--color-brand)] mb-4">
        Tabel Perbandingan Produk
      </h2>
      <div class="overflow-x-auto border border-[var(--color-border)] rounded-[2px] bg-[var(--color-surface)] shadow-2xs">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-[var(--color-tint)] border-b border-[var(--color-border)] text-xs uppercase tracking-wider text-[var(--color-text)]">
              <th scope="col" class="py-3.5 px-4 font-bold">Produk</th>
              <th scope="col" class="py-3.5 px-4 font-bold">Peran Utama</th>
              <th scope="col" class="py-3.5 px-4 font-bold">Sasaran Komoditas</th>
              <th scope="col" class="py-3.5 px-4 font-bold">Bentuk & Aplikasi</th>
              <th scope="col" class="py-3.5 px-4 font-bold text-right">Rincian</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border)]">
            {sortedProducts.map((p) => {
              const d = p.data;
              return (
                <tr class="hover:bg-[var(--color-tint)]/40 transition-colors">
                  <td class="py-4 px-4 font-bold font-serif text-[var(--color-brand)] text-base whitespace-nowrap">
                    {d.name}
                  </td>
                  <td class="py-4 px-4 text-[var(--color-text)] font-medium max-w-xs text-xs sm:text-sm">
                    {d.role}
                  </td>
                  <td class="py-4 px-4 text-[var(--color-text-muted)] text-xs">
                    <span class="block max-w-xs">
                      {d.commodities.slice(0, 4).map((c) => commoditiesMap.get(typeof c === 'string' ? c : c.id) || c).join(', ')}
                      {d.commodities.length > 4 && ` +${d.commodities.length - 4} lainnya`}
                    </span>
                  </td>
                  <td class="py-4 px-4 text-[var(--color-text-muted)] text-xs whitespace-nowrap">
                    {d.applicationMethods.join(', ')}
                  </td>
                  <td class="py-4 px-4 text-right whitespace-nowrap">
                    <a
                      href={`/produk/${p.id}/`}
                      class="inline-flex items-center justify-center px-3 py-1.5 min-h-[44px] text-xs font-semibold text-[var(--color-brand-strong)] hover:text-[var(--color-brand)] underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]"
                    >
                      Buka Detail →
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Product Rows List -->
    <section class="mb-16 divide-y divide-[var(--color-border)]" aria-label="Daftar Rincian Produk">
      {sortedProducts.map((product) => (
        <ProductRow product={product} commoditiesMap={commoditiesMap} />
      ))}
    </section>

    <!-- Section: Cara Memastikan Produk Asli (OQ-8) -->
    <section class="max-w-4xl mb-12" aria-labelledby="heading-keaslian">
      <h2 id="heading-keaslian" class="text-2xl font-bold font-serif text-[var(--color-brand)] tracking-tight mb-3">
        Memastikan Keaslian Produk Resmi
      </h2>
      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed mb-6">
        Setiap produk biostimulan dan aktivator imun yang didistribusikan secara sah oleh PT Agritani Internasional dilengkapi dengan standar keamanan kemasan resmi untuk melindungi petani dari pemalsuan di lapangan:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="p-5 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] shadow-2xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">Segel ShieldedTag™</h3>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
            Setiap botol dan jeriken resmi memiliki segel fisik anti-rusak yang merekatkan tutup kemasan. Jangan terima kemasan dengan segel sobek.
          </p>
        </div>

        <div class="p-5 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] shadow-2xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">Karakter Fisik Formula</h3>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
            Cairan asli sedikit keruh alami beraroma khas hasil fermentasi organik. Variasi rona warna hijau muda hingga pekat adalah wajar dan aman.
          </p>
        </div>

        <div class="p-5 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] shadow-2xs">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-brand)] shrink-0" aria-hidden="true"></span>
            <h3 class="font-bold text-sm sm:text-base text-[var(--color-text)]">Izin Edar Kementan</h3>
          </div>
          <p class="text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed">
            Terdaftar resmi di Kementerian Pertanian Republik Indonesia. Nomor izin edar fisik tercetak pada label resmi setiap botol produk.
          </p>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-[var(--color-text-muted)]">
        Pilihlah salah satu produk di atas untuk membaca panduan dosis resmi dan rekomendasi waktu aplikasi lapangan.
      </p>
    </section>
  </div>
</BaseLayout>
