---
/**
 * src/pages/produk/[slug].astro
 * Product Detail Page (T-11, DESIGN §2.5, §4.2.3)
 * Invariants: no WhatsApp CTA on product pages (owner 2026-09-30), no cards/kickers/section dividers, 2px radius, 0/0/0 CSP, tabular numbers.
 * Variants & prices from src/data/products.json (owner-supplied, checked 2026-09-30).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getProductImage, getProductFieldPhotos } from '../../lib/product-images';
import type { SeoInput } from '../../lib/seo';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const p = product.data;

const allCommodities = await getCollection('commodities');
const commoditiesMap = new Map(allCommodities.map((c) => [c.id, c.data.name]));

// Get related articles based on matching commodities
const productCommodityIds = new Set(
  p.commodities.map((c) => (typeof c === 'string' ? c : c.id))
);

const allArticles = await getCollection('articles', (entry) => {
  if (entry.data.draft && !import.meta.env.PUBLIC_INCLUDE_DRAFTS) return false;
  return entry.data.commodities?.some((c) => {
    const cId = typeof c === 'string' ? c : c.id;
    return productCommodityIds.has(cId);
  });
});

// Newest 3 matching articles
const relatedArticles = allArticles
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Produk', url: '/produk/' },
  { name: p.name, url: `/produk/${product.id}/` },
];

const shortTitles: Record<string, string> = {
  aussie: 'Aussie — Aktivator Imun Batang & Akar',
  kojien: 'Kojien — Aktivator Imun Padi Spesialis',
  bensu: 'BENSU — Aktivator Regenerasi Sel',
  saratoga: 'Saratoga — Serum Asam Amino Bebas Amis',
};
const seoTitle = shortTitles[product.id] || `${p.name} — Formula Biostimulan Resmi`;

const functionDetails: Record<
  string,
  {
    mechanism: string;
    targetAction: string;
    agronomicNote: string;
    dosageGuide: { tank: string; hectare: string; timing: string };
  }
> = {
  aussie: {
    mechanism:
      'Aussie diformulasikan dengan senyawa biostimulan berbasis sulfur dan molibdenum untuk menstimulasi respon ketahanan sistemik (Systemic Acquired Resistance / SAR) pada tanaman berkayu.',
    targetAction:
      'Membantu memperkokoh dinding sel lignin pada pangkal batang dan perakaran kelapa sawit serta tanaman keras, sehingga meningkatkan daya tahan alami terhadap serangan jamur patogen tular tanah seperti Ganoderma.',
    agronomicNote:
      'Penggunaan teratur pada fase pemeliharaan membantu menjaga vaskular tanaman tetap aktif menyalurkan nutrisi dan menekan laju perkembangan gejala busuk pangkal batang.',
    dosageGuide: {
      tank: '30–50 ml per tangki 16 Liter (kocor batang/semprot)',
      hectare: '1–2 Liter per hektar per aplikasi',
      timing: 'Aplikasi rutin tiap 3–4 minggu pada piringan dan pangkal batang sawit.',
    },
  },
  kojien: {
    mechanism:
      'Kojien merupakan aktivator kekebalan sel tanaman berlisensi teknologi Thailand yang dirancang khusus untuk anatomi dan siklus fisiologis tanaman padi sawah maupun ladang.',
    targetAction:
      'Memicu biosintesis fitoaleksin alami dalam jaringan daun dan pelepah guna memperkokoh daya tahan tanaman terhadap tekanan penyakit blas (Pyricularia oryzae), hawar pelepah (Rhizoctonia solani), dan bercak coklat.',
    agronomicNote:
      'Menjaga daun bendera tetap tegak, hijau, dan sehat untuk fotosintesis optimal selama fase bunting hingga pengisian malai penuh.',
    dosageGuide: {
      tank: '20–30 ml per tangki 16 Liter air',
      hectare: '0,75–1 Liter per hektar',
      timing: 'Fase vegetatif akhir (30 HST) dan fase bunting/keluar malai (50–55 HST).',
    },
  },
  bensu: {
    mechanism:
      'BENSU menggabungkan fungsi pemicu kekebalan sel dan pemacu regenerasi sel jaringan (cell regeneration) berlisensi teknologi Thailand untuk tanaman pangan dan hortikultura.',
    targetAction:
      'Bekerja memulihkan jaringan tanaman yang mengalami kerusakan atau stres fisiologis pasca serangan hama/penyakit maupun cekaman cuaca ekstrem (kekeringan atau curah hujan tinggi).',
    agronomicNote:
      'Membantu merangsang kembali pertumbuhan tunas produktif dan percabangan aktif pada tanaman hortikultura seperti cabai, tomat, dan bawang merah.',
    dosageGuide: {
      tank: '25–35 ml per tangki 16 Liter air',
      hectare: '1 Liter per hektar',
      timing: 'Semprot kabut halus tiap 7–10 hari sekali pada pagi hari pukul 06.00–09.00.',
    },
  },
  saratoga: {
    mechanism:
      'Saratoga menghadirkan serum asam amino sistemik berbobot molekul rendah dengan teknologi Japanese Pro-Plant Complex yang diserap langsung oleh sel stomata tanpa pemborosan energi metabolisme.',
    targetAction:
      'Menyediakan prekursor asam amino esensial, chitosan, omega 3, dan vitamin B1 guna menjaga stabilitas hormon auksin dan giberelin saat tanaman memasuki fase transisi vegetatif ke generatif.',
    agronomicNote:
      'Bebas dari aroma amis yang umum pada pupuk asam amino hewani konvensional, sehingga aman dari risiko mengundang lalat buah atau hama serangga sekunder ke pertanaman.',
    dosageGuide: {
      tank: '20–30 ml per tangki 16 Liter air',
      hectare: '0,5–1 Liter per hektar',
      timing: 'Mulai awal pembungaan (primordia) dan diulang saat pembentukan bakal buah.',
    },
  },
};

const fDetail = functionDetails[product.id] || {
  mechanism: `${p.name} bekerja melalui stimulasi kekebalan endogen tanaman dan aktivasi metabolisme jaringan produktif.`,
  targetAction: 'Meningkatkan daya tahan terhadap patogen tular tanah dan cekaman lingkungan.',
  agronomicNote: 'Aplikasi tepat waktu membantu tanaman mempertahankan metabolisme normal pada fase pertumbuhan aktif.',
  dosageGuide: {
    tank: '25–30 ml per tangki 16 Liter',
    hectare: '1 Liter per hektar',
    timing: 'Aplikasi pagi atau sore hari.',
  },
};

const formatRupiah = (val: number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);

// No fallback prices: a product without variants in products.json shows no price block.
const variants = p.variants ?? [];

const fieldPhotos = getProductFieldPhotos(product.id);

const jump =
  'inline-flex items-center min-h-[44px] px-4 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] font-semibold text-[var(--color-brand-strong)] hover:border-[var(--color-brand-strong)] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]';

const seo: SeoInput = {
  title: seoTitle,
  description: p.summary,
  canonicalPath: `/produk/${product.id}/`,
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath={`/produk/${product.id}/`}>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <header class="mt-6 mb-10 sm:mt-8 sm:mb-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-5">
        <div class="card card-media aspect-square overflow-hidden max-w-[22rem] mx-auto lg:max-w-none">
          <Picture
            src={getProductImage(product.id)}
            formats={['webp']}
            widths={[320, 640]}
            sizes="(min-width: 1024px) 28rem, 22rem"
            quality={90}
            alt={`Kemasan ${p.name}`}
            class="w-full h-full object-cover"
            pictureAttributes={{ class: 'block w-full h-full' }}
            loading="eager"
          />
        </div>
      </div>

      <div class="lg:col-span-7 space-y-6">
        <div>
          <h1 class="pillar-title">{p.name}</h1>
          {p.tagline && <p class="mt-3 text-sm font-semibold text-[var(--color-soil)]">{p.tagline}</p>}
          <p class="mt-3 text-lg sm:text-xl text-[var(--color-text)] leading-snug">{p.role}</p>
        </div>

        <p class="text-base text-[var(--color-text-muted)] leading-relaxed">{p.summary}</p>

        {variants.length > 0 && (
          <section class="card p-5 sm:p-6" aria-labelledby="heading-harga">
            <h2 id="heading-harga" class="font-serif text-lg font-semibold text-[var(--color-text)]">Pilihan kemasan & harga</h2>
            <ul class="mt-3 divide-y divide-[var(--color-border)] tabular-nums">
              {variants.map((v) => {
                const savings = v.comparePrice ? v.comparePrice - v.price : 0;
                return (
                  <li class="flex items-baseline justify-between gap-4 py-3">
                    <span class="font-semibold text-[var(--color-text)]">{v.size}</span>
                    <span class="text-right">
                      <span class="font-serif text-xl font-semibold text-[var(--color-brand-strong)]">{formatRupiah(v.price)}</span>
                      {v.comparePrice && (
                        <span class="block text-xs text-[var(--color-text-muted)]">
                          <s>{formatRupiah(v.comparePrice)}</s>{savings > 0 && <> · hemat {formatRupiah(savings)}</>}
                        </span>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
            <p class="mt-3 text-xs text-[var(--color-text-muted)] leading-relaxed">
              Harga per 30 September 2026 dan dapat berubah sewaktu-waktu.
            </p>
          </section>
        )}

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div>
            <dt class="text-[var(--color-text-muted)]">Komoditas sasaran</dt>
            <dd class="mt-0.5 text-[var(--color-text)]">
              {p.commodities.map((c) => commoditiesMap.get(typeof c === 'string' ? c : c.id) || (typeof c === 'string' ? c : c.id)).join(', ')}
            </dd>
          </div>
          <div>
            <dt class="text-[var(--color-text-muted)]">Cara aplikasi</dt>
            <dd class="mt-0.5 text-[var(--color-text)]">{p.applicationMethods.join(' / ')}</dd>
          </div>
        </dl>
      </div>
    </header>

    <nav class="mb-12 sm:mb-16" aria-label="Bagian halaman produk">
      <ul class="flex flex-wrap gap-2 text-sm">
        <li><a href="#mekanisme" class={jump}>Cara kerja</a></li>
        <li><a href="#spesifikasi" class={jump}>Kandungan</a></li>
        <li><a href="#aplikasi-dosis" class={jump}>Dosis</a></li>
        {fieldPhotos.length > 0 && (
          <li><a href="#foto-lahan" class={jump}>Foto lahan</a></li>
        )}
        <li><a href="#keaslian" class={jump}>Keaslian</a></li>
        {relatedArticles.length > 0 && (
          <li><a href="#jurnal" class={jump}>Panduan terkait</a></li>
        )}
      </ul>
    </nav>

    <div class="space-y-16 sm:space-y-20 mb-16">
      <section id="mekanisme" class="scroll-mt-28 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start" aria-labelledby="heading-mekanisme">
        <div class="lg:col-span-7 space-y-4 text-base text-[var(--color-text)] leading-relaxed">
          <h2 id="heading-mekanisme" class="section-title">Cara kerja pada tanaman</h2>
          <p>{fDetail.mechanism}</p>
          <p>{fDetail.targetAction}</p>
          <p class="text-[var(--color-text-muted)]">{fDetail.agronomicNote}</p>
        </div>

        <div class="lg:col-span-5 card p-4 sm:p-6">
          <h3 class="font-serif text-xl font-semibold text-[var(--color-text)]">Sifat formula</h3>
          <dl class="mt-3 space-y-4 text-sm leading-relaxed">
            <div>
              <dt class="font-semibold text-[var(--color-text)]">Sistemik</dt>
              <dd class="mt-0.5 text-[var(--color-text-muted)]">Diserap melalui stomata daun dan diedarkan lewat jaringan pembuluh tanaman.</dd>
            </div>
            <div>
              <dt class="font-semibold text-[var(--color-text)]">Cocok untuk iklim tropis</dt>
              <dd class="mt-0.5 text-[var(--color-text-muted)]">Stabil pada kelembapan tinggi dan suhu siang hari di Indonesia.</dd>
            </div>
            <div>
              <dt class="font-semibold text-[var(--color-text)]">Tidak menutup stomata</dt>
              <dd class="mt-0.5 text-[var(--color-text-muted)]">Tidak meninggalkan kristal atau lapisan lilin pada permukaan daun.</dd>
            </div>
          </dl>
        </div>
      </section>

      <section id="spesifikasi" class="scroll-mt-28" aria-labelledby="heading-spesifikasi">
        <h2 id="heading-spesifikasi" class="section-title">Kandungan dan sifat fisik</h2>
        <dl class="max-w-3xl divide-y divide-[var(--color-border)] border-y border-[var(--color-border)] text-sm leading-relaxed">
          <div class="grid sm:grid-cols-[14rem_1fr] gap-x-6 gap-y-0.5 py-3">
            <dt class="text-[var(--color-text-muted)]">Bahan aktif & nutrisi</dt>
            <dd class="font-semibold text-[var(--color-text)]">{p.composition || 'Bahan organik dan biostimulan aktif berlisensi'}</dd>
          </div>
          <div class="grid sm:grid-cols-[14rem_1fr] gap-x-6 gap-y-0.5 py-3">
            <dt class="text-[var(--color-text-muted)]">Bentuk</dt>
            <dd class="font-semibold text-[var(--color-text)]">{p.form || 'Cairan konsentrat larut air'}</dd>
          </div>
          <div class="grid sm:grid-cols-[14rem_1fr] gap-x-6 gap-y-0.5 py-3">
            <dt class="text-[var(--color-text-muted)]">Kelarutan</dt>
            <dd class="font-semibold text-[var(--color-text)]">Larut dalam air tanpa menyumbat spuyer semprot</dd>
          </div>
          <div class="grid sm:grid-cols-[14rem_1fr] gap-x-6 gap-y-0.5 py-3">
            <dt class="text-[var(--color-text-muted)]">Pencampuran tangki</dt>
            <dd class="font-semibold text-[var(--color-text)]">Dapat dicampur pupuk daun & insektisida non-alkalis</dd>
          </div>
        </dl>
      </section>

      <section id="aplikasi-dosis" class="scroll-mt-28 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start" aria-labelledby="heading-dosis">
        <div class="lg:col-span-7">
          <h2 id="heading-dosis" class="section-title">Dosis dan cara aplikasi</h2>
          <table class="w-full text-left border-collapse text-sm">
            <tbody class="divide-y divide-[var(--color-border)] text-[var(--color-text)]">
              <tr>
                <th scope="row" class="py-3 pr-4 align-top font-semibold whitespace-nowrap">Tangki 16 L</th>
                <td class="py-3 tabular-nums">{fDetail.dosageGuide.tank}</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 align-top font-semibold whitespace-nowrap">Per hektar</th>
                <td class="py-3 tabular-nums">{fDetail.dosageGuide.hectare}</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 align-top font-semibold whitespace-nowrap">Waktu</th>
                <td class="py-3 leading-relaxed">{fDetail.dosageGuide.timing}</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 align-top font-semibold whitespace-nowrap">Cara</th>
                <td class="py-3">{p.applicationMethods.join(' atau ')}</td>
              </tr>
            </tbody>
          </table>
          <p class="mt-4 text-xs text-[var(--color-text-muted)] leading-relaxed">
            Ikuti selalu petunjuk pada label kemasan sebelum membuat larutan. Hindari menyemprot saat matahari terik di atas pukul 10.00 atau saat angin kencang.
          </p>
        </div>

        <div class="lg:col-span-5">
          <h3 class="font-serif text-xl font-semibold text-[var(--color-text)]">Sebelum mengisi tangki</h3>
          <div class="mt-3 grid gap-3">
            <a href="/alat/kalkulator-dosis/" class="card card-link block p-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]">
              <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Kalkulator dosis</span>
              <span class="mt-1 block text-sm text-[var(--color-text-muted)]">Hitung takaran per tangki sesuai luas lahan.</span>
            </a>
            <a href="/alat/cuaca-tani/" class="card card-link block p-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]">
              <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Cuaca Tani</span>
              <span class="mt-1 block text-sm text-[var(--color-text-muted)]">Prakiraan BMKG per 3 jam untuk memilih waktu semprot.</span>
            </a>
          </div>
        </div>
      </section>

      {fieldPhotos.length > 0 && (
        <section id="foto-lahan" class="scroll-mt-28" aria-labelledby="heading-foto">
          <h2 id="heading-foto" class="section-title">Foto lahan</h2>
          <p class="-mt-3 mb-6 max-w-2xl text-sm text-[var(--color-text-muted)] leading-relaxed">
            Foto ilustrasi kondisi lahan untuk komoditas sasaran, bukan dokumentasi hasil pemakaian produk.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {fieldPhotos.map((photo) => (
              <figure>
                <div class="aspect-4/3 overflow-hidden rounded-[2px] bg-[var(--color-tint)]">
                  <Picture
                    src={photo.image}
                    formats={['webp']}
                    widths={[300, 600]}
                    sizes="(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw"
                    quality={85}
                    alt={photo.caption}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <figcaption class="mt-2 text-xs text-[var(--color-text-muted)] leading-relaxed">
                  {photo.tag}. {photo.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <section id="keaslian" class="scroll-mt-28" aria-labelledby="heading-keaslian">
        <h2 id="heading-keaslian" class="section-title">Memeriksa keaslian kemasan</h2>
        <dl class="grid gap-6 sm:grid-cols-3 sm:gap-8 text-sm leading-relaxed max-w-5xl">
          <div>
            <dt class="font-semibold text-[var(--color-text)]">Segel ShieldedTag™</dt>
            <dd class="mt-1 text-[var(--color-text-muted)]">
              Pastikan segel tutup botol utuh dan tidak sobek saat dibeli. Segel meninggalkan bekas rusak bila dibuka paksa.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-[var(--color-text)]">Sifat cairan</dt>
            <dd class="mt-1 text-[var(--color-text-muted)]">
              Cairan asli beraroma khas fermentasi organik, larut merata dalam air, dan tidak menggumpal di dasar kemasan.
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-[var(--color-text)]">Nomor izin edar</dt>
            <dd class="mt-1 text-[var(--color-text-muted)]">
              Produk Agritani terdaftar di Kementerian Pertanian Republik Indonesia. Nomor izin edar tercetak pada label botol.
            </dd>
          </div>
        </dl>
      </section>

      {relatedArticles.length > 0 && (
        <section id="jurnal" class="scroll-mt-28" aria-labelledby="heading-jurnal">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6">
            <h2 id="heading-jurnal" class="section-title">Panduan terkait di Jurnal Tani</h2>
            <a href="/jurnal/" class="link-more text-sm mb-6">Semua artikel &rarr;</a>
          </div>
          <div class="divide-y divide-[var(--color-border)]">
            {relatedArticles.map((art) => <ArticleRow article={art} />)}
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>
