---
/**
 * src/pages/produk/[slug].astro
 * Product Detail Page (T-11, DESIGN §2.5, §4.2.3)
 * Invariants: Single WhatsApp CTA via ConsultPrompt, 2px radius, text contrast >= 7:1, 0/0/0 CSP.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ConsultPrompt from '../../components/ConsultPrompt.astro';
import type { SeoInput } from '../../lib/seo';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const p = product.data;

const allCommodities = await getCollection('commodities');
const commoditiesMap = new Map(allCommodities.map((c) => [c.id, c.data.name]));

// Get related articles based on matching commodities
const productCommodityIds = new Set(
  p.commodities.map((c) => (typeof c === 'string' ? c : c.id))
);

const allArticles = await getCollection('articles', (entry) => {
  if (entry.data.draft && !import.meta.env.PUBLIC_INCLUDE_DRAFTS) return false;
  return entry.data.commodities?.some((c) => {
    const cId = typeof c === 'string' ? c : c.id;
    return productCommodityIds.has(cId);
  });
});

// Take top 3 articles
const relatedArticles = allArticles.slice(0, 3);

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Produk', url: '/produk/' },
  { name: p.name, url: `/produk/${product.id}/` },
];

const shortTitles: Record<string, string> = {
  aussie: 'Aussie — Aktivator Imun',
  kojien: 'Kojien — Biostimulan Padi',
  bensu: 'BENSU — Aktivator Imun Sel',
  saratoga: 'Saratoga — Serum Asam Amino',
};
const seoTitle = shortTitles[product.id] || `${p.name} — Biostimulan`;

const seo: SeoInput = {
  title: seoTitle,
  description: p.summary,
  canonicalPath: `/produk/${product.id}/`,
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath={`/produk/${product.id}/`}>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <!-- Product Header (Lapangan Canvas) -->
    <header class="my-8 sm:my-12 max-w-3xl">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="inline-block px-2.5 py-1 text-xs font-semibold bg-[var(--color-tint)] text-[var(--color-brand-strong)] rounded-[2px]">
          Distribusi Resmi
        </span>
        {p.tagline && (
          <span class="text-sm font-medium text-[var(--color-text-muted)]">
            {p.tagline}
          </span>
        )}
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)] tracking-tight leading-tight mb-4">
        {p.name}
      </h1>

      <p class="text-lg sm:text-xl font-medium text-[var(--color-brand)] leading-snug mb-4">
        {p.role}
      </p>

      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        {p.summary}
      </p>

      <!-- Target Commodities Badges -->
      <div class="mt-6 pt-6 border-t border-[var(--color-border)]">
        <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-2">
          Komoditas Sasaran Rekomendasi
        </span>
        <div class="flex flex-wrap gap-2">
          {p.commodities.map((c) => {
            const cId = typeof c === 'string' ? c : c.id;
            const name = commoditiesMap.get(cId) || cId;
            return (
              <span class="inline-block px-3 py-1 text-xs font-semibold bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text)] rounded-[2px]">
                {name}
              </span>
            );
          })}
        </div>
      </div>
    </header>

    <!-- Sub-navigation Anchor Links -->
    <nav class="mb-10 p-3 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] sticky top-4 z-10 backdrop-blur-md" aria-label="Navigasi bagian produk">
      <ul class="flex flex-wrap items-center gap-1 sm:gap-2 text-sm font-medium">
        <li>
          <a
            href="#fungsi"
            class="inline-flex items-center px-3 py-2 min-h-[44px] text-[var(--color-text)] hover:text-[var(--color-brand)] hover:bg-[var(--color-surface-raised)] rounded-[2px] transition-colors"
          >
            Fungsi & Peran
          </a>
        </li>
        <li>
          <a
            href="#komposisi"
            class="inline-flex items-center px-3 py-2 min-h-[44px] text-[var(--color-text)] hover:text-[var(--color-brand)] hover:bg-[var(--color-surface-raised)] rounded-[2px] transition-colors"
          >
            Kandungan
          </a>
        </li>
        <li>
          <a
            href="#cara-pakai"
            class="inline-flex items-center px-3 py-2 min-h-[44px] text-[var(--color-text)] hover:text-[var(--color-brand)] hover:bg-[var(--color-surface-raised)] rounded-[2px] transition-colors"
          >
            Aplikasi & Dosis
          </a>
        </li>
        <li>
          <a
            href="#keaslian"
            class="inline-flex items-center px-3 py-2 min-h-[44px] text-[var(--color-text)] hover:text-[var(--color-brand)] hover:bg-[var(--color-surface-raised)] rounded-[2px] transition-colors"
          >
            Keaslian Kemasan
          </a>
        </li>
      </ul>
    </nav>

    <!-- Product Sections (Max-w-3xl for readable measure) -->
    <div class="space-y-12 max-w-3xl mb-16">
      
      <!-- Section: Fungsi & Peran -->
      <section id="fungsi" class="scroll-mt-28 space-y-4">
        <h2 class="text-2xl font-bold font-serif text-[var(--color-brand)] tracking-tight">
          Fungsi & Peran Tanaman
        </h2>
        <div class="p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-3 text-base text-[var(--color-text)] leading-relaxed">
          <p>
            {p.name} bekerja melalui stimulasi kekebalan endogen (*Systemic Acquired Resistance*) dan aktivasi metabolisme jaringan tanaman guna meningkatkan daya tahan terhadap patogen tular tanah maupun cekaman cuaca ekstrem.
          </p>
          <p class="text-sm text-[var(--color-text-muted)]">
            Aplikasi tepat waktu membantu tanaman mempertahankan metabolisme normal dan merangsang pembelahan sel produktif pada fase pertumbuhan aktif.
          </p>
        </div>
      </section>

      <!-- Section: Komposisi -->
      <section id="komposisi" class="scroll-mt-28 space-y-4">
        <h2 class="text-2xl font-bold font-serif text-[var(--color-brand)] tracking-tight">
          Kandungan Formulasi
        </h2>
        <div class="p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-3 text-sm sm:text-base text-[var(--color-text)]">
          <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1">
              Bahan Aktif & Nutrisi
            </span>
            <p class="font-medium text-base text-[var(--color-text)]">
              {p.composition || 'Bahan organik dan biostimulan berlisensi resmi.'}
            </p>
          </div>
          <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1">
              Bentuk Fisik Formula
            </span>
            <p class="text-[var(--color-text)]">
              {p.form || 'Cairan konsentrat larut air'}
            </p>
          </div>
        </div>
      </section>

      <!-- Section: Cara Pakai & Dosis -->
      <section id="cara-pakai" class="scroll-mt-28 space-y-4">
        <h2 class="text-2xl font-bold font-serif text-[var(--color-brand)] tracking-tight">
          Metode Aplikasi & Dosis Anjuran
        </h2>
        <div class="p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-4">
          <div>
            <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-2">
              Metode Aplikasi yang Dianjurkan
            </span>
            <ul class="space-y-1.5 text-sm sm:text-base text-[var(--color-text)]">
              {p.applicationMethods.map((method) => (
                <li class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-[var(--color-brand)]" aria-hidden="true"></span>
                  <span>{method}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-3 border-t border-[var(--color-border)]">
            <span class="block text-xs font-bold uppercase tracking-wider text-[var(--color-text-muted)] mb-1">
              Takaran & Dosis Lapangan
            </span>
            <p class="text-sm sm:text-base font-semibold text-[var(--color-brand)] tabular-nums">
              {p.dosage || 'Sesuai dosis anjuran pada label kemasan resmi'}
            </p>
            <p class="text-xs text-[var(--color-text-muted)] mt-1 leading-relaxed">
              Selalu periksa label resmi pada botol kemasan sebelum penyemprotan. Jangan melebihi konsentrasi anjuran teknis guna menjaga keseimbangan larutan semprot di tangki.
            </p>
          </div>
        </div>
      </section>

      <!-- Section: Keaslian Produk -->
      <section id="keaslian" class="scroll-mt-28 space-y-4">
        <h2 class="text-2xl font-bold font-serif text-[var(--color-brand)] tracking-tight">
          Keaslian Kemasan Resmi
        </h2>
        <div class="p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-3 text-sm sm:text-base text-[var(--color-text)]">
          <p>
            {p.authenticityCheck || 'Setiap kemasan resmi dilengkapi segel pengaman ShieldedTag untuk verifikasi keaslian.'}
          </p>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
            Pastikan segel penutup botol dalam kondisi utuh dan tidak rusak saat menerima produk dari jaringan kemitraan kios resmi PT Agritani Internasional.
          </p>
        </div>
      </section>

      <!-- Section: Related Articles (if available) -->
      {relatedArticles.length > 0 && (
        <section class="space-y-4 pt-6 border-t border-[var(--color-border)]">
          <h2 class="text-xl font-bold font-serif text-[var(--color-brand)] tracking-tight">
            Panduan Terkait di Jurnal Tani
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {relatedArticles.map((art) => (
              <a
                href={`/jurnal/${art.id}/`}
                class="p-4 bg-[var(--color-surface)] hover:bg-[var(--color-surface-raised)] border border-[var(--color-border)] hover:border-[var(--color-brand)] rounded-[2px] transition-colors flex flex-col justify-between"
              >
                <div>
                  <span class="block text-xs font-semibold text-[var(--color-brand)] mb-1">
                    {art.data.topic}
                  </span>
                  <h3 class="text-sm font-bold text-[var(--color-text)] line-clamp-2 leading-snug">
                    {art.data.title}
                  </h3>
                </div>
                <span class="text-xs text-[var(--color-text-muted)] mt-3">
                  Baca Panduan →
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Section: Single WhatsApp CTA (DESIGN §2.8) -->
      <section class="pt-6 border-t border-[var(--color-border)]">
        <ConsultPrompt
          source={`produk-${product.id}`}
          title="Tanya Dosis untuk Lahan Anda"
          description={`Dapatkan rekomendasi takaran dan panduan aplikasi produk ${p.name} yang disesuaikan dengan jenis tanaman serta luas lahan Anda langsung dari tim Agritani.`}
          label="Konsultasi Dosis via WhatsApp"
          variant="primary"
          fields={[{ label: 'Produk', value: p.name }]}
        />
      </section>

    </div>
  </div>
</BaseLayout>
