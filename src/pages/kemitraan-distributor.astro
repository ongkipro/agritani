---
/**
 * src/pages/kemitraan-distributor.astro
 * Distributor Partnership Page (T-12, DESIGN §2.3, §4.2.3)
 * Invariants: Single WhatsApp CTA flow, 0/0/0 CSP, 2px radius, text contrast >= 7:1.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PartnerForm from '../components/PartnerForm.astro';
import type { SeoInput } from '../lib/seo';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Kemitraan Distributor', url: '/kemitraan-distributor/' },
];

const seo: SeoInput = {
  title: 'Kemitraan Distributor & Kios Pertanian',
  description:
    'Peluang kemitraan distributor, kios saprotan, dan kelompok tani bersama PT Agritani Internasional. Pasokan resmi biostimulan dan pendampingan lapangan.',
  canonicalPath: '/kemitraan-distributor/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/kemitraan-distributor/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header (Lapangan Canvas) -->
    <header class="my-8 sm:my-12 max-w-3xl">
      <div class="inline-block px-2.5 py-1 text-xs font-semibold bg-[var(--color-tint)] text-[var(--color-brand-strong)] rounded-[2px] mb-3">
        Program Kemitraan Resmi
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--color-text)] tracking-tight leading-tight mb-4">
        Kemitraan Distributor & Kios
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed">
        PT Agritani Internasional membuka peluang kemitraan pasokan sarana produksi pertanian presisi bagi pemilik perkebunan, kios saprotan, dan distributor daerah di seluruh nusantara. Kami menjamin pasokan resmi langsung, perlindungan keaslian formula, serta panduan teknis lapangan.
      </p>
    </header>

    <!-- Partnership Flow 01 - 03 -->
    <section class="mb-12" aria-label="Alur Kemitraan">
      <h2 class="text-xl font-bold font-serif text-[var(--color-brand)] mb-6">
        Alur Kemitraan Distributor
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Step 01 -->
        <div class="p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-3">
          <div class="text-xs font-mono font-bold text-[var(--color-brand-strong)] tracking-widest uppercase">
            Tahap 01
          </div>
          <h3 class="text-lg font-bold text-[var(--color-text)]">
            Pengajuan Profil Usaha
          </h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Isi formulir pendaftaran di bawah dengan rincian wilayah kerja, jenis komoditas utama, dan estimasi luas lahan atau kapasitas kios Anda.
          </p>
        </div>

        <!-- Step 02 -->
        <div class="p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-3">
          <div class="text-xs font-mono font-bold text-[var(--color-brand-strong)] tracking-widest uppercase">
            Tahap 02
          </div>
          <h3 class="text-lg font-bold text-[var(--color-text)]">
            Verifikasi & Alokasi Wilayah
          </h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Sekretariat kemitraan PT Agritani Internasional akan memverifikasi kesiapan operasional dan ketersediaan kuota distribusi per kabupaten/kota.
          </p>
        </div>

        <!-- Step 03 -->
        <div class="p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-[2px] space-y-3">
          <div class="text-xs font-mono font-bold text-[var(--color-brand-strong)] tracking-widest uppercase">
            Tahap 03
          </div>
          <h3 class="text-lg font-bold text-[var(--color-text)]">
            Pasokan Resmi & Pendampingan
          </h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
            Akses langsung pasokan produk dengan proteksi segel ShieldedTag, materi teknis budidaya, dan jalur konsultasi prioritas bagi mitra.
          </p>
        </div>

      </div>
    </section>

    <!-- Application Form Section -->
    <section class="max-w-4xl mb-16" aria-label="Formulir Kemitraan">
      <div class="mb-6">
        <h2 class="text-2xl font-bold font-serif text-[var(--color-brand)] tracking-tight">
          Formulir Pengajuan Kemitraan
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] mt-1">
          Lengkapi isian berikut. Tombol kirim akan menyusun draf percakapan terstruktur secara otomatis untuk dikirimkan melalui WhatsApp resmi Agritani.
        </p>
      </div>

      <PartnerForm />
    </section>

  </div>
</BaseLayout>
