---
/**
 * src/pages/kemitraan-distributor.astro
 * Distributor Partnership Page (T-12, DESIGN §2.3, §4.2.3)
 * Invariants: Single WhatsApp CTA flow, 0/0/0 CSP, 2px radius, text contrast >= 7:1.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PartnerForm from '../components/PartnerForm.astro';
import { Picture } from 'astro:assets';
import kemitraanImage from '../assets/images/dummy/kemitraan.webp';
import type { SeoInput } from '../lib/seo';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Kemitraan Distributor', url: '/kemitraan-distributor/' },
];

const seo: SeoInput = {
  title: 'Kemitraan Distributor & Kios Pertanian',
  description:
    'Peluang kemitraan distributor, kios saprotan, dan kelompok tani bersama Agritani. Pasokan resmi biostimulan dan pendampingan lapangan.',
  canonicalPath: '/kemitraan-distributor/',
  breadcrumbs,
  pageType: 'website',
};
---

<BaseLayout seo={seo} currentPath="/kemitraan-distributor/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header with media (DESIGN §4.2.3; dummy image, OQ-5) -->
    <header class="my-8 sm:my-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[var(--color-text)] leading-tight tracking-[-0.015em] text-balance mb-4">
          Kemitraan Distributor & Kios
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-text-muted)] leading-relaxed max-w-[60ch]">
          Agritani membuka peluang kemitraan pasokan sarana produksi pertanian presisi bagi pemilik perkebunan, kios saprotan, dan distributor daerah di berbagai wilayah Indonesia. Kami menyediakan pasokan resmi langsung, perlindungan keaslian formula, serta panduan teknis lapangan.
        </p>
      </div>
      <div class="lg:col-span-5">
        <Picture
          src={kemitraanImage}
          formats={['webp']}
          quality={60}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 26rem, calc(100vw - 2rem)"
          alt="Tumpukan karung pasokan di gudang distribusi"
          class="w-full aspect-[3/2] object-cover rounded-[2px]"
          loading="eager"
        />
      </div>
    </header>

    <!-- Partnership flow: order carries meaning, so numbered list -->
    <section class="mb-16 grid grid-cols-1 lg:grid-cols-12 gap-x-12" aria-labelledby="alur-kemitraan">
      <h2 id="alur-kemitraan" class="lg:col-span-4 section-title !mb-2 lg:pt-4">
        Alur kemitraan distributor
      </h2>
      <ol class="lg:col-span-8 divide-y divide-[var(--color-border)]">
        <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-5">
          <span class="text-2xl font-serif font-bold text-[var(--color-soil)] tabular-nums leading-none pt-0.5" aria-hidden="true">1</span>
          <div class="space-y-1.5">
            <h3 class="font-serif text-lg font-semibold text-[var(--color-text)]">Pengajuan profil usaha</h3>
            <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-[60ch]">Isi formulir pendaftaran di bawah dengan rincian wilayah kerja, jenis komoditas utama, dan estimasi luas lahan atau kapasitas kios Anda.</p>
          </div>
        </li>
        <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-5">
          <span class="text-2xl font-serif font-bold text-[var(--color-soil)] tabular-nums leading-none pt-0.5" aria-hidden="true">2</span>
          <div class="space-y-1.5">
            <h3 class="font-serif text-lg font-semibold text-[var(--color-text)]">Verifikasi dan alokasi wilayah</h3>
            <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-[60ch]">Tim kemitraan Agritani akan memverifikasi kesiapan operasional dan ketersediaan kuota distribusi per kabupaten/kota.</p>
          </div>
        </li>
        <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-5">
          <span class="text-2xl font-serif font-bold text-[var(--color-soil)] tabular-nums leading-none pt-0.5" aria-hidden="true">3</span>
          <div class="space-y-1.5">
            <h3 class="font-serif text-lg font-semibold text-[var(--color-text)]">Pasokan resmi dan pendampingan</h3>
            <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed max-w-[60ch]">Akses langsung pasokan produk dengan proteksi segel ShieldedTag, materi teknis budidaya, dan jalur konsultasi prioritas bagi mitra.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- Application Form Section -->
    <section class="max-w-4xl mb-16" aria-label="Formulir Kemitraan">
      <div class="mb-6">
        <h2 class="section-title !mb-0">
          Formulir pengajuan kemitraan
        </h2>
        <p class="text-sm text-[var(--color-text-muted)] mt-1">
          Lengkapi isian berikut. Tombol kirim akan menyusun draf percakapan terstruktur secara otomatis untuk dikirimkan melalui WhatsApp resmi Agritani.
        </p>
      </div>

      <PartnerForm />
    </section>

  </div>
</BaseLayout>
