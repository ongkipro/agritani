---
/**
 * src/pages/404.astro
 * Not-found recovery page conforming to DESIGN §4.2.3, §3.3, DEC-019d, DEC-022.
 * Invariants:
 * - noindex: true
 * - BaseLayout noWhatsApp={true} (DESIGN §3.5.1, DEC-019d)
 * - Single .card per unit (DEC-019)
 * - No uppercase or shadow-* inside <main>
 * - Touch targets >= 44px, contrast >= 7:1
 * - Direct search input + popular query shortcuts + 6 core recovery cards + commodity quick links
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import type { SeoInput } from '../lib/seo';

const seo: SeoInput = {
  title: 'Halaman Tidak Ditemukan: Kembali ke Jurnal Tani dan Beranda',
  description:
    'Halaman yang Anda tuju tidak tersedia di situs Agritani. Kembali ke beranda atau telusuri Jurnal Tani untuk panduan budidaya dan penanganan hama.',
  noindex: true,
  canonicalPath: '/404/',
};

interface RecoveryItem {
  href: string;
  title: string;
  body: string;
  actionText: string;
}

const recoveryItems: RecoveryItem[] = [
  {
    href: '/jurnal/',
    title: 'Jurnal Tani',
    body: 'Arsip komprehensif telaah agronomi budidaya, penanganan OPT hama penyakit, dan pembenahan tanah lapangan.',
    actionText: 'Buka Jurnal Tani',
  },
  {
    href: '/alat/diagnosa-gejala/',
    title: 'Diagnosa Gejala Tanaman',
    body: 'Cocokkan tanda visual pada daun, buah, batang, atau perakaran untuk deteksi cepat kendala di lahan.',
    actionText: 'Mulai Diagnosa',
  },
  {
    href: '/alat/kalkulator-dosis/',
    title: 'Kalkulator Dosis & Semprot',
    body: 'Hitung kebutuhan takaran pupuk dan pestisida per tangki knapsack maupun per hektare.',
    actionText: 'Hitung Dosis',
  },
  {
    href: '/alat/kalender-tanam/',
    title: 'Kalender Tanam Komoditas',
    body: 'Rekomendasi jadwal teknis budidaya dari persiapan lahan, persemaian, vegetatif, hingga panen.',
    actionText: 'Lihat Kalender',
  },
  {
    href: '/alat/cuaca-tani/',
    title: 'Cuaca Tani & Jendela Semprot',
    body: 'Prakiraan cuaca hingga tingkat desa untuk panduan keselamatan dan efektivitas aplikasi semprot lapangan.',
    actionText: 'Cek Cuaca Desa',
  },
  {
    href: '/produk/',
    title: 'Produk Unggulan Agritani',
    body: 'Katalog spesifikasi pupuk dan biostimulan resmi: Aussie, BENSU, Saratoga, dan Kojien.',
    actionText: 'Lihat Katalog Produk',
  },
];

const popularSearches = [
  { label: 'Patek Cabai', q: 'patek cabai' },
  { label: 'Pemupukan Padi', q: 'pemupukan padi' },
  { label: 'Ulat Grayak', q: 'ulat grayak' },
  { label: 'Asam Humat', q: 'asam humat' },
  { label: 'Layu Fusarium', q: 'layu fusarium' },
  { label: 'Kutu Kebul', q: 'kutu kebul' },
];

const popularCommodities = [
  { name: 'Cabai', slug: 'cabai' },
  { name: 'Padi', slug: 'padi' },
  { name: 'Kelapa Sawit', slug: 'kelapa-sawit' },
  { name: 'Jagung', slug: 'jagung' },
  { name: 'Bawang Merah', slug: 'bawang-merah' },
  { name: 'Tomat', slug: 'tomat' },
];
---

<BaseLayout seo={seo} currentPath="/404/" noWhatsApp={true}>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 pt-10 sm:pt-14 pb-16 sm:pb-20">
    <header class="max-w-[50rem] mb-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[var(--color-text)] leading-tight tracking-[-0.015em] text-balance mb-4">
        Halaman yang Anda cari tidak tersedia
      </h1>
      <p class="pillar-lede">
        Tautan yang Anda buka mungkin telah dialihkan, diperbarui, atau salah ketik. Cari topiknya langsung atau pilih salah satu jalur di bawah ini.
      </p>
    </header>

    <div class="card p-4 sm:p-6 max-w-[52rem] mb-12">
      <SearchBox
        size="large"
        visibleLabel="Cari panduan agronomi, hama penyakit, atau nama komoditas"
        placeholder="Misalnya: patek cabai, dosis pupuk, kresek padi"
      />
      <p class="mt-3 text-sm leading-7">
        <span class="font-semibold text-[var(--color-text)] mr-2">Sering dicari:</span>
        {popularSearches.map((item) => (
          <a href={`/cari/?q=${encodeURIComponent(item.q)}`} class="inline-block mr-4 py-3 text-[var(--color-brand-strong)] underline underline-offset-4 decoration-[var(--color-border-control)] hover:decoration-[var(--color-brand)]">
            {item.label}
          </a>
        ))}
      </p>
    </div>

    <section aria-labelledby="heading-pemulihan" class="mb-12">
      <h2 id="heading-pemulihan" class="section-title">Jalur utama Agritani</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {recoveryItems.map((item) => (
          <a href={item.href} class="card card-link flex flex-col p-5 sm:p-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]">
            <span class="font-serif text-lg font-semibold text-[var(--color-brand-strong)] leading-snug">{item.title}</span>
            <span class="mt-1.5 text-sm leading-relaxed text-[var(--color-text-muted)]">{item.body}</span>
            <span class="link-more mt-auto pt-4 text-sm self-start">{item.actionText} &rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="heading-komoditas" class="mb-12">
      <h2 id="heading-komoditas" class="section-title">Panduan per komoditas</h2>
      <p class="text-sm leading-7">
        {popularCommodities.map((c) => (
          <a href={`/jurnal/komoditas/${c.slug}/`} class="inline-block mr-4 py-3 text-[var(--color-brand-strong)] hover:underline underline-offset-4">
            <span class="text-[var(--color-soil)]" aria-hidden="true">#</span>{c.name}
          </a>
        ))}
        <a href="/jurnal/" class="inline-block py-3 font-semibold text-[var(--color-brand-strong)] hover:underline underline-offset-4">Semua topik &amp; komoditas &rarr;</a>
      </p>
    </section>

    <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-3 min-h-[44px] rounded-[2px] bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white font-semibold text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-brand-strong)]">
      Kembali ke Beranda
    </a>
  </div>
</BaseLayout>
