---
/**
 * src/pages/tentang-kami.astro
 * Tentang Kami (DESIGN §4.2.3, DEC-021): who Agritani is, the four flagship products,
 * the agent/distributor opportunity with one WhatsApp CTA to the sales team, and a one-line manager note.
 * Invariants: one WhatsApp CTA (DESIGN §2.8), cards only for products (§3.3.3), no invented claims.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorAvatar from '../components/AuthorAvatar.astro';
import ProductCard from '../components/ProductCard.astro';
import ConsultPrompt from '../components/ConsultPrompt.astro';
import type { SeoInput } from '../lib/seo';
import tentangKamiImg from '../assets/images/dummy/tentang-kami.webp';

const breadcrumbs = [
  { name: 'Beranda', url: '/' },
  { name: 'Tentang Kami', url: '/tentang-kami/' },
];

const seo: SeoInput = {
  title: 'Tentang Kami',
  description:
    'Agritani Official, distributor resmi penjualan online produk unggulan Aussie, BENSU, Kojien, dan Saratoga. Terbuka kerja sama agen dan distributor di wilayah Anda.',
  canonicalPath: '/tentang-kami/',
  breadcrumbs,
  pageType: 'about',
};

const order = ['aussie', 'bensu', 'kojien', 'saratoga'];
const products = (await getCollection('products')).sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const commoditiesMap = new Map((await getCollection('commodities')).map((c) => [c.id, c.data.name]));
---

<BaseLayout seo={seo} currentPath="/tentang-kami/">
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbs} />

    <header class="mt-6 sm:mt-8 mb-8 max-w-[68ch]">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-semibold text-[var(--color-text)] leading-tight tracking-[-0.015em] text-balance mb-4">
        Tentang Agritani
      </h1>
      <p class="pillar-lede">
        Agritani Official adalah distributor resmi dan utama untuk penjualan online, baik di marketplace maupun platform lainnya, yang berdedikasi menjembatani inovasi hayati mutakhir dengan kebutuhan nyata petani Indonesia.
      </p>
    </header>

    <figure class="mb-12 sm:mb-16 max-w-[48rem]">
      <Image
        src={tentangKamiImg}
        alt="Lanskap perbukitan sawah terasering tropis di masa panen"
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 48rem, calc(100vw - 2rem)"
        quality={60}
        class="w-full h-auto object-cover"
        loading="eager"
      />
    </figure>

    <section class="mb-12 sm:mb-16" aria-labelledby="produk-unggulan-heading">
      <h2 id="produk-unggulan-heading" class="section-title">Produk unggulan Agritani</h2>
      <p class="-mt-3 mb-6 max-w-[60ch] text-base sm:text-[17px] leading-relaxed text-[var(--color-text)]">
        Agritani Official menghadirkan empat produk unggulan: Aussie, BENSU, Kojien, dan Saratoga. Pilih sesuai komoditas Anda, lalu buka rinciannya untuk dosis dan cara aplikasi.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 sm:gap-6">
        {products.map((product) => <ProductCard product={product} commoditiesMap={commoditiesMap} />)}
      </div>
      <p class="mt-4 text-xs text-[var(--color-text-muted)]">Harga per 30 September 2026 dan dapat berubah sewaktu-waktu.</p>
    </section>

    <section class="mb-12 sm:mb-16 max-w-[68ch]" aria-labelledby="agen-heading">
      <h2 id="agen-heading" class="section-title">Menjadi agen atau distributor</h2>
      <p class="text-base sm:text-[17px] leading-relaxed text-[var(--color-text)]">
        Saat ini kami membuka kesempatan kerja sama untuk menjadi agen atau distributor Agritani di wilayah Anda, dengan mengembangkan dan memasarkan produk-produk terbaik kami. Untuk penawaran dan harga terbaik bagi agen atau distributor, hubungi tim penjualan kami.
      </p>
      <div class="mt-6">
        <ConsultPrompt
          source="Web·TentangKami"
          variant="primary"
          headingLevel={3}
          title="Hubungi tim penjualan"
          description="Konsultasi produk, penawaran, dan harga agen atau distributor langsung lewat WhatsApp resmi Agritani."
          label="Chat tim penjualan via WhatsApp"
          fields={[{ label: 'Keperluan', value: 'Konsultasi / penawaran agen atau distributor' }]}
        />
      </div>
    </section>

    <section class="mb-12 sm:mb-16 max-w-[68ch]" aria-label="Pengelola Jurnal Tani">
      <p class="flex items-center gap-3 text-sm sm:text-base text-[var(--color-text-muted)]">
        <AuthorAvatar size={40} class="w-10 h-10 shrink-0" />
        <span>
          Jurnal Tani dikelola <strong class="font-semibold text-[var(--color-text)]">Arif Prabowo</strong>, Konsultan Pertanian Senior.{' '}
          <a href="/penulis/arif-prabowo/" class="font-semibold text-[var(--color-brand-strong)] underline underline-offset-4 py-3">Lihat profil</a>
        </span>
      </p>
    </section>
  </div>
</BaseLayout>
