---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { assertContentIntegrity } from '../../lib/content-integrity';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const symptoms = await getCollection('symptoms');
  const cropCalendars = await getCollection('cropCalendars');
  const commodities = await getCollection('commodities');

  const includeDrafts =
    import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;

  // Run content integrity assertion check
  assertContentIntegrity({
    articles: articles.map((a) => a.data),
    symptoms: symptoms.map((s) => s.data),
    cropCalendars: cropCalendars.map((c) => c.data),
    commodities: commodities.map((c) => c.data),
    isDraftPreview: includeDrafts,
  });

  // Filter publishable articles based on draft policy
  const visibleArticles = includeDrafts
    ? articles
    : articles.filter((a) => !a.data.draft);

  return visibleArticles.map((article) => {
    const artCommIds = article.data.commodities.map((c: any) =>
      typeof c === 'string' ? c : c.id
    );

    // Rank related articles: prioritize shared commodities, then shared tags, then topic
    // Articles with distinct commodities never cross-match
    const related = visibleArticles
      .filter((a) => a.data.slug !== article.data.slug)
      .map((a) => {
        const candCommIds = a.data.commodities.map((c: any) =>
          typeof c === 'string' ? c : c.id
        );
        const sharedCommodities = artCommIds.filter((c: string) =>
          candCommIds.includes(c)
        ).length;

        // Disjoint crop filter: don't cross-link different specific crops
        if (
          artCommIds.length > 0 &&
          candCommIds.length > 0 &&
          sharedCommodities === 0
        ) {
          return { article: a, score: 0 };
        }

        const candTags = (a.data.tags || []).map((t: string) => t.toLowerCase());
        const sharedTags = (article.data.tags || []).filter((t: string) =>
          candTags.includes(t.toLowerCase())
        ).length;

        const sameTopic = a.data.topic === article.data.topic ? 1 : 0;

        let score = 0;
        if (sharedCommodities > 0) {
          score = sharedCommodities * 100 + sharedTags * 10 + sameTopic;
        } else if (artCommIds.length === 0 && candCommIds.length === 0) {
          // Both are general crop articles
          score = sharedTags * 10 + sameTopic;
        } else if (artCommIds.length === 0 || candCommIds.length === 0) {
          // One is general crop, only match if meaningful shared tags exist
          if (sharedTags > 0) {
            score = sharedTags * 10 + sameTopic;
          }
        }

        return { article: a, score };
      })
      .filter((item) => item.score > 0)
      .sort((x, y) => y.score - x.score)
      .slice(0, 3)
      .map((item) => item.article);

    return {
      params: { slug: article.data.slug },
      props: { article, relatedArticles: related },
    };
  });
}

const { article, relatedArticles } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout
  article={article}
  headings={headings}
  relatedArticles={relatedArticles}
>
  <Content />
</ArticleLayout>
