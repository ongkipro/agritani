---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { assertContentIntegrity } from '../../lib/content-integrity';
import { buildRelatedMap } from '../../lib/related';
import { promoteDepths } from '../../lib/headings';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const symptoms = await getCollection('symptoms');
  const cropCalendars = await getCollection('cropCalendars');
  const commodities = await getCollection('commodities');

  const includeDrafts =
    import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;

  // Run content integrity assertion check
  assertContentIntegrity({
    articles: articles.map((a) => a.data),
    symptoms: symptoms.map((s) => s.data),
    cropCalendars: cropCalendars.map((c) => c.data),
    commodities: commodities.map((c) => c.data),
    isDraftPreview: includeDrafts,
  });

  // Filter publishable articles based on draft policy
  const visibleArticles = includeDrafts
    ? articles
    : articles.filter((a) => !a.data.draft);

  // Related reading: computed once across all visible articles so links spread (src/lib/related.ts).
  const commodityIds = (a: (typeof visibleArticles)[number]) =>
    a.data.commodities.map((c: any) => (typeof c === 'string' ? c : c.id));
  const relatedMap = buildRelatedMap(
    visibleArticles.map((a) => ({
      slug: a.data.slug,
      topic: a.data.topic,
      commodities: commodityIds(a),
      tags: a.data.tags ?? [],
    }))
  );
  const bySlug = new Map(visibleArticles.map((a) => [a.data.slug, a]));

  return visibleArticles.map((article) => ({
    params: { slug: article.data.slug },
    props: {
      article,
      relatedArticles: (relatedMap.get(article.data.slug) ?? []).map((s) => bySlug.get(s)!),
    },
  }));
}

const { article, relatedArticles } = Astro.props;
const { Content, headings } = await render(article);
// Same outline repair as the layout applies to the HTML (src/lib/headings.ts).
const promoted = promoteDepths(headings.map((h) => h.depth));
const tocHeadings = headings.map((h, i) => ({ ...h, depth: promoted[i] }));
---

<ArticleLayout
  article={article}
  headings={tocHeadings}
  relatedArticles={relatedArticles}
>
  <Content />
</ArticleLayout>
