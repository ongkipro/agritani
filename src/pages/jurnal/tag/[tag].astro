---
/**
 * src/pages/jurnal/tag/[tag].astro
 * Dynamic tag archive listing page for Jurnal Tani articles.
 */

import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import TopicSidebar from '../../../components/TopicSidebar.astro';
import { slugifyTag } from '../../../lib/tags';
import type { SeoInput } from '../../../lib/seo';

export async function getStaticPaths() {
  const includeDrafts =
    import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;

  const allArticles = await getCollection('articles');
  const visibleArticles = includeDrafts
    ? allArticles
    : allArticles.filter((a) => !a.data.draft);

  const tagMap = new Map<string, { rawTag: string; articles: any[] }>();

  for (const article of visibleArticles) {
    const tags = article.data.tags || [];
    for (const tag of tags) {
      const slug = slugifyTag(tag);
      if (!slug) continue;
      if (!tagMap.has(slug)) {
        tagMap.set(slug, { rawTag: tag, articles: [] });
      }
      tagMap.get(slug)!.articles.push(article);
    }
  }

  return Array.from(tagMap.entries()).map(([slug, { rawTag, articles }]) => {
    const sorted = articles.sort(
      (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    );

    return {
      params: { tag: slug },
      props: {
        tagSlug: slug,
        tagName: rawTag,
        articles: sorted,
      },
    };
  });
}

const { tagSlug, tagName, articles } = Astro.props;

// Display name: the tag itself, first letter capitalised, no "Tag:" or "#" (owner 2026-09-30).
const displayName = tagName.charAt(0).toUpperCase() + tagName.slice(1);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Jurnal Tani', url: '/jurnal/' },
  { name: displayName, url: `/jurnal/tag/${tagSlug}/` },
];

// Title: trim at a word boundary so it never ends mid-word (the SEO helper appends " - Agritani").
const clip = (text: string, max: number) =>
  text.length <= max ? text : text.slice(0, text.lastIndexOf(' ', max)).replace(/[\s,.;:–-]+$/, '');
const safeTitle = clip(displayName, 50);

const count = articles.length;
// 120–160 characters (check-seo window): long form first, shorter form for long tags, then clip at a word.
const descLong = `Kumpulan ${count} artikel Jurnal Tani tentang ${tagName}: panduan budidaya dan penanganan di lahan oleh Arif Prabowo, konsultan pertanian senior Agritani.`;
const descShort = `${count} artikel Jurnal Tani tentang ${tagName}: panduan budidaya dan penanganan di lahan oleh Arif Prabowo, konsultan pertanian Agritani.`;
const safeDesc = clip(descLong.length <= 160 ? descLong : descShort, 160);

const seo: SeoInput = {
  title: safeTitle,
  description: safeDesc,
  canonicalPath: `/jurnal/tag/${tagSlug}/`,
  breadcrumbs: breadcrumbItems,
  pageType: 'collection',
  // Thin tag archives stay out of the index until they hold 3+ published articles.
  noindex: articles.length < 3,
};
---

<BaseLayout seo={seo} currentPath={`/jurnal/tag/${tagSlug}/`} noWhatsApp>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbItems} />

    <!-- Same frame as topic/commodity hubs (DESIGN §4.1 C10, §3.3.2) -->
    <div class="flex flex-col lg:grid lg:grid-cols-12 lg:gap-x-12">
      <div class="lg:col-start-4 lg:col-span-9 lg:row-start-1">
        <header class="my-6 sm:my-10 pt-5 border-t border-[var(--color-border)] max-w-[68ch]">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-[var(--color-text)] mb-3 leading-tight text-balance">
            {displayName}
          </h1>
          <p class="text-base sm:text-lg text-[var(--color-text-muted)] font-serif leading-relaxed">
            {articles.length} artikel Jurnal Tani dengan tag ini.
          </p>
        </header>

        <section class="mt-8" aria-label={`Artikel dengan tag ${tagName}`}>
          <div class="divide-y divide-[var(--color-border)]">
            {articles.map((art) => (
              <ArticleRow article={art} />
            ))}
          </div>
        </section>
      </div>
    <!-- Sidebar after the content in DOM so the page H1 comes first; grid placement keeps it on the left at >=1024px -->
      <aside class="order-last my-8 lg:my-0 lg:mt-10 lg:col-start-1 lg:col-span-3 lg:row-start-1 lg:sticky lg:top-6 self-start">
        <TopicSidebar />
      </aside>
    </div>
  </div>
</BaseLayout>
