---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArticleList from '../../../components/ArticleList.astro';
import TopicSidebar from '../../../components/TopicSidebar.astro';
import CommodityPicker from '../../../components/CommodityPicker.astro';
import { TOPICS } from '../../../lib/topics';
import { fitText, TITLE_RANGE, DESC_RANGE, type SeoInput } from '../../../lib/seo';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Dummy topic headers (OQ-5), keyed by file name topik-<slug>.webp
const topicImages = import.meta.glob<{ default: ImageMetadata }>('../../../assets/images/dummy/topik-*.webp', { eager: true });

export async function getStaticPaths() {
  const topics = TOPICS.map((t) => ({ slug: t.slug, name: t.title }));

  const includeDrafts =
    import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;

  const allArticles = await getCollection('articles');
  const visibleArticles = includeDrafts
    ? allArticles
    : allArticles.filter((a) => !a.data.draft);

  return topics.map((t) => {
    const topicArticles = visibleArticles
      .filter((a) => a.data.topic === t.slug)
      .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

    return {
      params: { topik: t.slug },
      props: {
        topic: t,
        articles: topicArticles,
      },
    };
  });
}

const { topic, articles } = Astro.props;

// Fetch introductory text from pages collection if exists
const pageEntry = await getEntry('pages', `topik-${topic.slug}`);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Jurnal Tani', url: '/jurnal/' },
  { name: topic.name, url: `/jurnal/topik/${topic.slug}/` },
];

// SEO titles 55–70 chars with the " - Agritani" suffix (owner rule 2026-09-30); the H1 keeps topic.name.
const topicSeoTitles: Record<string, string> = {
  'proteksi-tanaman': 'Proteksi Tanaman: Pengendalian Hama & Penyakit Tanaman',
  'tanah-nutrisi': 'Tanah & Nutrisi Tanaman: Pemupukan dan Kesuburan Lahan',
  'budidaya': 'Teknik Budidaya & Pembibitan Tanaman Pangan dan Buah',
  'air-irigasi': 'Manajemen Air & Sistem Irigasi Lahan Pertanian',
  'pascapanen-agribisnis': 'Pascapanen & Agribisnis: Mutu Hasil Panen dan Usaha Tani',
  'sains-tanaman': 'Sains Tanaman & Fisiologi: Dasar Ilmiah Budidaya',
};

const seo: SeoInput = {
  title: topicSeoTitles[topic.slug] ?? fitText([topic.name, `${topic.name}: Artikel Jurnal Tani`, `${topic.name}: Kumpulan Artikel dan Panduan Jurnal Tani`], TITLE_RANGE, 11),
  description: fitText(
    [
      pageEntry?.data.description ?? '',
      `Kumpulan panduan teknis dan artikel ilmiah terapan tentang ${topic.name} oleh Arif Prabowo di Jurnal Tani Agritani.`,
      `Kumpulan panduan teknis dan artikel ilmiah terapan tentang ${topic.name} untuk petani Indonesia oleh Arif Prabowo di Jurnal Tani Agritani.`,
    ].filter(Boolean),
    DESC_RANGE,
  ),
  canonicalPath: `/jurnal/topik/${topic.slug}/`,
  breadcrumbs: breadcrumbItems,
  pageType: 'collection',
};

// Associated tool recommendation based on topic
const toolMap: Record<string, { label: string; href: string; desc: string }> = {
  'proteksi-tanaman': {
    label: 'Diagnosa Gejala',
    href: '/alat/diagnosa-gejala/',
    desc: 'Identifikasi gejala hama dan penyakit di tanaman Anda secara terstruktur.',
  },
  'tanah-nutrisi': {
    label: 'Kalkulator Dosis',
    href: '/alat/kalkulator-dosis/',
    desc: 'Hitung kebutuhan tangki dan konsentrasi larutan pupuk daun atau biostimulan.',
  },
  'budidaya': {
    label: 'Kalender Tanam',
    href: '/alat/kalender-tanam/',
    desc: 'Jadwalkan fase pertumbuhan komoditas pangan dan hortikultura dari tanggal tanam.',
  },
  'air-irigasi': {
    label: 'Cuaca Tani',
    href: '/alat/cuaca-tani/',
    desc: 'Pantau prakiraan hujan dan rekomendasi waktu penyemprotan tingkat desa.',
  },
};

const tool = toolMap[topic.slug];
const topicImage = Object.entries(topicImages).find(([path]) => path.endsWith(`topik-${topic.slug}.webp`))?.[1].default;
---

<BaseLayout seo={seo} noWhatsApp>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbItems} />

    <div class="lg:grid lg:grid-cols-12 lg:gap-x-12">
    <div class="min-w-0 lg:col-start-4 lg:col-span-9 lg:row-start-1">

    <header class={`topic-${topic.slug} my-6 sm:my-10 pt-5 border-t-[3px] border-[var(--topic)] grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center`}>
      <div class="lg:col-span-7 max-w-[68ch]">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-[var(--color-text)] mb-3 leading-tight text-balance">
          {topic.name}
        </h1>
        <p class="pillar-lede">
          {pageEntry ? pageEntry.body : seo.description}
        </p>
      </div>
      {topicImage && (
        <div class="lg:col-span-5">
        <Picture
          src={topicImage}
          formats={['webp']}
          fallbackFormat="webp"
          quality={60}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 26rem, calc(100vw - 2rem)"
          alt={`Ilustrasi topik ${topic.name} di Jurnal Tani Agritani`}
          class="w-full aspect-[16/9] object-cover rounded-[2px]"
          loading="eager"
          fetchpriority="high"
        />
        </div>
      )}
    </header>

    {tool && (
      <a href={tool.href} class="card card-link my-6 flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-6 p-4 sm:p-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]">
        <span>
          <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">{tool.label}</span>
          <span class="mt-1 block text-sm text-[var(--color-text-muted)]">{tool.desc}</span>
        </span>
        <span class="link-more text-sm shrink-0" aria-hidden="true">Buka alat &rarr;</span>
      </a>
    )}

    <!-- <1024px: commodity jump block in place of the sidebar (DESIGN §4.2.3) -->
    <CommodityPicker visible={6} class="lg:hidden mt-8" />

    <section class="mt-8" aria-labelledby="daftar-artikel-topik-heading">
      <h2 id="daftar-artikel-topik-heading" class="sr-only">
        Daftar Artikel {topic.name}
      </h2>

      <ArticleList
        articles={articles}
        initialCount={12}
        batchSize={12}
        listId={`topik-${topic.slug}`}
        hideTopic
        emptyMessage="Belum ada artikel yang diterbitkan untuk topik ini."
      />
    </section>
    </div>
    <!-- >=1024px only; after the content in DOM so the page H1 comes first; grid placement keeps it on the left -->
    <aside class="hidden lg:block lg:col-start-1 lg:col-span-3 lg:row-start-1 lg:self-start lg:sticky lg:top-6 lg:mt-10">
      <TopicSidebar currentTopic={topic.slug} />
    </aside>
    </div>
  </div>
</BaseLayout>
