---
import { getCollection, getEntry } from 'astro:content';
import { getVisibleArticles, getCommodityCounts, refId } from '../../../lib/journal';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArticleList from '../../../components/ArticleList.astro';
import TopicSidebar from '../../../components/TopicSidebar.astro';
import CommodityPicker from '../../../components/CommodityPicker.astro';
import ArticleProducts from '../../../components/ArticleProducts.astro';
import { fitText, TITLE_RANGE, DESC_RANGE, type SeoInput } from '../../../lib/seo';

export async function getStaticPaths() {
  // Hubs exist only for commodities with >= COMMODITY_HUB_MIN visible articles (same list as TopicSidebar/CommodityPicker).
  const [articles, hubs, commodities] = await Promise.all([getVisibleArticles(), getCommodityCounts(), getCollection('commodities')]);

  return hubs.map((h) => ({
    params: { komoditas: h.id },
    props: {
      commodity: commodities.find((c) => c.id === h.id)!.data,
      articles: articles.filter((a) => a.data.commodities.some((x) => refId(x) === h.id)),
    },
  }));
}

const { commodity, articles } = Astro.props;

// Fetch optional introductory text
const pageEntry = await getEntry('pages', `komoditas-${commodity.id}`);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Jurnal Tani', url: '/jurnal/' },
  { name: commodity.name, url: `/jurnal/komoditas/${commodity.id}/` },
];

const seo: SeoInput = {
  title: fitText([`${commodity.name}: Panduan Budidaya, Hama & Penyakit Tanaman`, `${commodity.name}: Panduan Budidaya & Hama`], TITLE_RANGE, 11),
  description: fitText(
    [
      pageEntry?.data.description ?? '',
      `Kumpulan panduan budidaya, pengendalian penyakit, dan rekomendasi perawatan tanaman ${commodity.name} teruji di lahan tropis Indonesia.`,
    ].filter(Boolean),
    DESC_RANGE,
  ),
  canonicalPath: `/jurnal/komoditas/${commodity.id}/`,
  breadcrumbs: breadcrumbItems,
  pageType: 'collection',
};
---

<BaseLayout seo={seo} noWhatsApp>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbItems} />

    <div class="lg:grid lg:grid-cols-12 lg:gap-x-12">
    <div class="min-w-0 lg:col-start-4 lg:col-span-9 lg:row-start-1">

    <header class="my-6 sm:my-8 max-w-[68ch]">
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--color-text)] mb-3 leading-tight">
        {commodity.name}: Panduan Budidaya & Penanganan
      </h1>
      <p class="pillar-lede">
        {pageEntry ? pageEntry.body : seo.description}
      </p>
    </header>

    <!-- Relevant tools for this commodity: link cards (DESIGN §3.3.3) -->
    <div class="my-6 grid gap-3 sm:grid-cols-2">
      <a href={`/alat/diagnosa-gejala/?k=${commodity.id}`} class="card card-link block p-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]">
        <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Diagnosa gejala {commodity.name.toLowerCase()}</span>
        <span class="mt-1 block text-sm text-[var(--color-text-muted)]">Cocokkan gejala di lahan dengan kemungkinan penyebabnya.</span>
      </a>
      <a href={`/alat/kalender-tanam/?k=${commodity.id}`} class="card card-link block p-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand)]">
        <span class="block font-serif text-lg font-semibold text-[var(--color-brand-strong)]">Kalender tanam {commodity.name.toLowerCase()}</span>
        <span class="mt-1 block text-sm text-[var(--color-text-muted)]">Jadwal fase dari tanggal tanam Anda.</span>
      </a>
    </div>

    <!-- <1024px: jump to another commodity hub, in place of the sidebar (DESIGN §4.2.3) -->
    <CommodityPicker visible={6} current={commodity.id} class="lg:hidden mt-8" />

    <!-- Article Listing -->
    <section class="mt-8" aria-labelledby="daftar-artikel-komoditas-heading">
      <h2 id="daftar-artikel-komoditas-heading" class="font-serif text-xl font-semibold text-[var(--color-text)] mb-4">
        {articles.length} artikel tentang {commodity.name.toLowerCase()}
      </h2>

      <ArticleList
        articles={articles}
        initialCount={12}
        batchSize={12}
        listId={`komoditas-${commodity.id}`}
        imageBy="none"
        emptyMessage="Belum ada artikel yang diterbitkan untuk komoditas ini."
      />
    </section>

    <!-- Products for this commodity: same cards as the article page (DESIGN §3.3.3, §4.3.8) -->
    <ArticleProducts topic="" commodities={[commodity.id]} />

    </div>
    <!-- >=1024px only; after the content in DOM so the page H1 comes first; grid placement keeps it on the left -->
    <aside class="hidden lg:block lg:col-start-1 lg:col-span-3 lg:row-start-1 lg:self-start lg:sticky lg:top-6 lg:mt-10">
      <TopicSidebar currentCommodity={commodity.id} />
    </aside>
    </div>
  </div>
</BaseLayout>
