---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArticleList from '../../../components/ArticleList.astro';
import ArticleRow from '../../../components/ArticleRow.astro';
import TopicSidebar from '../../../components/TopicSidebar.astro';
import { TOPICS, topicName } from '../../../lib/topics';
import type { SeoInput } from '../../../lib/seo';

export async function getStaticPaths() {
  const includeDrafts =
    import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;

  const allArticles = await getCollection('articles');
  const commodities = await getCollection('commodities');

  const visibleArticles = includeDrafts
    ? allArticles
    : allArticles.filter((a) => !a.data.draft);

  // Commodity hubs are ONLY created when commodity has >= 3 published (or visible) articles
  const validCommodities = commodities.filter((c) => {
    const count = visibleArticles.filter((a) =>
      a.data.commodities.some((x: any) => (typeof x === 'string' ? x : x.id) === c.id)
    ).length;
    return count >= 3;
  });

  return validCommodities.map((c) => {
    const commodityArticles = visibleArticles
      .filter((a) =>
        a.data.commodities.some((x: any) => (typeof x === 'string' ? x : x.id) === c.id)
      )
      .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

    return {
      params: { komoditas: c.id },
      props: {
        commodity: c.data,
        articles: commodityArticles,
      },
    };
  });
}

const { commodity, articles } = Astro.props;

// Fetch optional introductory text
const pageEntry = await getEntry('pages', `komoditas-${commodity.id}`);

// Group articles by topic if multiple topics exist (T-31 Butir 2a)
const distinctTopics = Array.from(new Set(articles.map((a: any) => a.data.topic)));
const hasMultipleTopics = distinctTopics.length >= 2;

const groupedArticles = hasMultipleTopics
  ? TOPICS.map((t) => ({
      topic: t,
      articles: articles.filter((a: any) => a.data.topic === t.slug),
    })).filter((g) => g.articles.length > 0)
  : [];

// Relevant products for this commodity (max 2, order: aussie, kojien, bensu, saratoga) (T-31 Butir 2b)
const allProducts = await getCollection('products');
const productOrder = ['aussie', 'kojien', 'bensu', 'saratoga'];
const relevantProducts = productOrder
  .map((id) => allProducts.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => {
    if (!p) return false;
    return p.data.commodities.some((c: any) => (typeof c === 'string' ? c : c.id) === commodity.id);
  })
  .slice(0, 2);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Jurnal Tani', url: '/jurnal/' },
  { name: commodity.name, url: `/jurnal/komoditas/${commodity.id}/` },
];

const seo: SeoInput = {
  title: `${commodity.name}: Panduan Budidaya & Penanganan Hama`,
  description:
    pageEntry?.data.description ||
    `Kumpulan panduan budidaya, pengendalian penyakit, dan rekomendasi perawatan tanaman ${commodity.name} teruji di lahan tropis Indonesia.`,
  canonicalPath: `/jurnal/komoditas/${commodity.id}/`,
  breadcrumbs: breadcrumbItems,
  pageType: 'collection',
};
---

<BaseLayout seo={seo} noWhatsApp>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbItems} />

    <div class="flex flex-col lg:grid lg:grid-cols-12 lg:gap-x-12">
    <aside class="order-last my-8 lg:my-0 lg:mt-10 lg:col-start-1 lg:col-span-3 lg:row-start-1 lg:sticky lg:top-6 self-start">
      <TopicSidebar currentCommodity={commodity.id} />
    </aside>
    <div class="lg:col-start-4 lg:col-span-9 lg:row-start-1">

    <header class="my-6 sm:my-8 max-w-[68ch]">
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--color-text)] mb-3 leading-tight">
        {commodity.name}: Panduan Budidaya & Penanganan
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] font-serif leading-relaxed">
        {pageEntry ? pageEntry.body : seo.description}
      </p>
    </header>

    <!-- Relevant Tools for this Commodity -->
    <div class="my-6 flex flex-wrap gap-4 text-xs font-semibold">
      <a
        href={`/alat/diagnosa-gejala/?k=${commodity.id}`}
        class="px-4 py-2.5 rounded-[2px] bg-[var(--color-tint)] text-[var(--color-text)] hover:bg-[var(--color-harvest)] transition-colors min-h-[44px] flex items-center"
      >
        Diagnosa Gejala {commodity.name} →
      </a>
      <a
        href={`/alat/kalender-tanam/?k=${commodity.id}`}
        class="px-4 py-2.5 rounded-[2px] border border-[var(--color-border-control)] text-[var(--color-text)] hover:bg-[var(--color-tint)] transition-colors min-h-[44px] flex items-center"
      >
        Kalender Tanam {commodity.name} →
      </a>
    </div>

    <!-- Article Listing -->
    <section class="mt-8" aria-labelledby="daftar-artikel-komoditas-heading">
      <div class="flex items-center justify-between mb-6">
        <h2 id="daftar-artikel-komoditas-heading" class="text-sm font-bold text-[var(--color-soil)]">
          Daftar Artikel ({articles.length} pembahasan)
        </h2>
      </div>

      {hasMultipleTopics ? (
        <div class="space-y-10">
          {groupedArticles.map((group) => (
            <div class="space-y-4" aria-labelledby={`topic-group-${group.topic.slug}`}>
              <h2
                id={`topic-group-${group.topic.slug}`}
                class={`topic-${group.topic.slug} flex items-center gap-2 text-base sm:text-lg font-bold text-[var(--color-soil)]`}
              >
                <span class="w-2.5 h-2.5 rounded-full bg-[var(--topic)]" aria-hidden="true"></span>
                <span>{topicName(group.topic.slug)}</span>
                <span class="text-xs font-normal text-[var(--color-text-muted)]">({group.articles.length})</span>
              </h2>
              <div class="space-y-2">
                {group.articles.map((article: any) => (
                  <ArticleRow article={article} imageBy="topic" />
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <ArticleList
          articles={articles}
          initialCount={6}
          batchSize={6}
          listId={`komoditas-${commodity.id}`}
          emptyMessage="Belum ada artikel yang diterbitkan untuk komoditas ini."
        />
      )}
    </section>

    <!-- Relevant Products (T-31 Butir 2b) -->
    {relevantProducts.length > 0 && (
      <section class="mt-12 pt-8 border-t border-[var(--color-border)]" aria-labelledby="produk-relevan-heading">
        <h2 id="produk-relevan-heading" class="font-serif text-2xl font-bold text-[var(--color-text)] mb-6">
          Produk yang relevan
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          {relevantProducts.map((prod) => (
            <div class="flex flex-col justify-between group">
              <div>
                <h3 class="font-serif text-xl font-bold text-[var(--color-brand-strong)] group-hover:text-[var(--color-brand)] transition-colors">
                  <a href={`/produk/${prod.id}/`}>{prod.data.name}</a>
                </h3>
                <p class="text-xs font-semibold text-[var(--color-soil)] mt-1">
                  {prod.data.tagline || prod.data.role}
                </p>
                <p class="text-sm text-[var(--color-text-muted)] mt-2 leading-relaxed">
                  {prod.data.role}
                </p>
              </div>
              <div class="mt-3">
                <a href={`/produk/${prod.id}/`} class="link-more text-xs">
                  Lihat spesifikasi &amp; dosis &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    </div>
    </div>
  </div>
</BaseLayout>
