---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import TopicSidebar from '../../components/TopicSidebar.astro';
import type { SeoInput } from '../../lib/seo';

const includeDrafts =
  import.meta.env.PUBLIC_INCLUDE_DRAFTS === 'true' || import.meta.env.DEV;

const allArticles = await getCollection('articles');

// Filter according to draft mode
const visibleArticles = includeDrafts
  ? allArticles
  : allArticles.filter((a) => !a.data.draft);

// Sort by pubDate descending
const sortedArticles = visibleArticles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const pageSize = 30;
const articlesPage1 = sortedArticles.slice(0, pageSize);
const totalPages = Math.ceil(sortedArticles.length / pageSize);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Jurnal Tani', url: '/jurnal/' },
];

const seo: SeoInput = {
  title: 'Jurnal Tani: Panduan Agronomi',
  description:
    'Panduan agronomi dan riset pertanian terapan oleh Prof. Arif Prabowo. Solusi ilmiah praktis untuk masalah tanaman pangan, hortikultura, dan perkebunan.',
  canonicalPath: '/jurnal/',
  breadcrumbs: breadcrumbItems,
  pageType: 'collection',
};
---

<BaseLayout seo={seo}>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbItems} />

    <div class="lg:grid lg:grid-cols-12 lg:gap-x-12">

    <!-- Page Header -->
    <header class="my-6 sm:my-8 max-w-[68ch] lg:col-start-4 lg:col-span-9 lg:row-start-1">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-[var(--color-text)] mb-3 leading-tight">
        Jurnal Tani
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-muted)] font-serif leading-relaxed">
        Ruang belajar dan rujukan agronomi yang diasuh oleh <strong>Prof. Arif Prabowo</strong>. Mengulas sains proteksi tanaman tropis, kesuburan tanah alami, dan efisiensi budidaya langsung dari temuan di lahan.
      </p>
    </header>

    <aside class="my-6 lg:my-0 lg:pt-10 lg:col-start-1 lg:col-span-3 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-24 self-start">
      <TopicSidebar />
    </aside>

    <!-- Articles List -->
    <section class="lg:col-start-4 lg:col-span-9 lg:row-start-2" aria-labelledby="daftar-artikel-heading">
      <h2 id="daftar-artikel-heading" class="sr-only">
        Daftar Artikel Jurnal Tani
      </h2>

      {articlesPage1.length > 0 ? (
        <div class="divide-y divide-[var(--color-border)]">
          {articlesPage1.map((article) => (
            <ArticleRow article={article} />
          ))}
        </div>
      ) : (
        <div class="py-12 text-center text-[var(--color-text-muted)]">
          <p>Belum ada artikel yang diterbitkan untuk saat ini.</p>
        </div>
      )}

      <!-- Pagination Controls -->
      {totalPages > 1 && (
        <nav class="my-10 flex items-center justify-between border-t border-[var(--color-border)] pt-4" aria-label="Paginasi artikel">
          <span class="text-xs text-[var(--color-text-muted)]">
            Halaman 1 dari {totalPages}
          </span>
          <a
            href="/jurnal/halaman/2/"
            class="px-4 py-2 rounded-[2px] font-semibold text-xs text-white min-h-[44px] flex items-center bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)]"
          >
            Halaman Berikutnya →
          </a>
        </nav>
      )}
    </section>
    </div>
  </div>
</BaseLayout>
