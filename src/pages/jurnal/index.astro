---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleList from '../../components/ArticleList.astro';
import CommodityPicker from '../../components/CommodityPicker.astro';
import TopicSidebar from '../../components/TopicSidebar.astro';
import { getVisibleArticles, JOURNAL_PAGE_SIZE } from '../../lib/journal';
import type { SeoInput } from '../../lib/seo';

// Page 1 of the archive: the newest JOURNAL_PAGE_SIZE articles; /jurnal/halaman/2/ continues at the next one.
const sortedArticles = await getVisibleArticles();
const pageArticles = sortedArticles.slice(0, JOURNAL_PAGE_SIZE);
const totalPages = Math.ceil(sortedArticles.length / JOURNAL_PAGE_SIZE);

const breadcrumbItems = [
  { name: 'Beranda', url: '/' },
  { name: 'Jurnal Tani', url: '/jurnal/' },
];

const seo: SeoInput = {
  title: 'Jurnal Tani: Panduan Agronomi, Hama & Budidaya Tanaman',
  description:
    'Panduan agronomi dan riset pertanian terapan oleh Arif Prabowo. Solusi ilmiah praktis untuk masalah tanaman pangan, hortikultura, dan perkebunan.',
  canonicalPath: '/jurnal/',
  breadcrumbs: breadcrumbItems,
  pageType: 'collection',
};
---

<BaseLayout seo={seo} noWhatsApp>
  <div class="max-w-[72rem] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
    <Breadcrumb items={breadcrumbItems} />

    <div class="lg:grid lg:grid-cols-12 lg:gap-x-12">
      <div class="min-w-0 lg:col-start-4 lg:col-span-9 lg:row-start-1">
        <header class="my-6 sm:my-8 max-w-[68ch]">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-[var(--color-text)] mb-3 leading-tight">
            Jurnal Tani
          </h1>
          <p class="text-base sm:text-lg text-[var(--color-text-muted)] font-serif leading-relaxed">
            Ruang belajar dan rujukan agronomi yang dikelola oleh <strong>Arif Prabowo</strong>. Mengulas sains proteksi tanaman tropis, kesuburan tanah alami, dan efisiensi budidaya langsung dari temuan di lahan.
          </p>
        </header>

        <!-- <1024px: commodity jump block in place of the sidebar (DESIGN §4.2.3 item 2) -->
        <CommodityPicker visible={6} class="lg:hidden mb-8" />

        <section aria-labelledby="daftar-artikel-heading">
          <h2 id="daftar-artikel-heading" class="font-serif text-xl font-semibold text-[var(--color-text)]">
            Artikel terbaru
          </h2>
          <p class="mt-1 text-sm text-[var(--color-text-muted)]">
            {pageArticles.length} dari {sortedArticles.length} artikel terbit, terbaru lebih dulu.
          </p>

          <ArticleList
            articles={pageArticles}
            initialCount={10}
            batchSize={10}
            listId="jurnal-index"
            eagerFirst
          />

          {totalPages > 1 && (
            <nav class="mt-10" aria-label="Halaman arsip Jurnal Tani">
              <p class="text-sm text-[var(--color-text-muted)]">Halaman 1 dari {totalPages}</p>
              <ul class="mt-3 flex flex-wrap gap-2" role="list">
                {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
                  <li>
                    <a
                      href={p === 1 ? '/jurnal/' : `/jurnal/halaman/${p}/`}
                      aria-current={p === 1 ? 'page' : undefined}
                      class:list={[
                        'inline-flex items-center justify-center min-w-[44px] min-h-[44px] px-2 rounded-[2px] border text-sm font-semibold tabular-nums transition-colors',
                        p === 1
                          ? 'border-[var(--color-brand-strong)] bg-[var(--color-brand-strong)] text-white'
                          : 'border-[var(--color-border-control)] text-[var(--color-text)] hover:bg-[var(--color-tint)] hover:border-[var(--color-brand)]',
                      ]}
                    >{p}</a>
                  </li>
                ))}
              </ul>
              <a href="/jurnal/halaman/2/" rel="next" class="mt-4 inline-flex items-center min-h-[44px] px-4 rounded-[2px] bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white text-sm font-semibold">
                Halaman berikutnya &rarr;
              </a>
            </nav>
          )}
        </section>
      </div>

      <!-- >=1024px only; after the content in DOM so the page H1 comes first (DESIGN §3.3.4) -->
      <aside class="hidden lg:block lg:col-start-1 lg:col-span-3 lg:row-start-1 lg:self-start lg:sticky lg:top-6 lg:mt-10">
        <TopicSidebar />
      </aside>
    </div>
  </div>
</BaseLayout>
