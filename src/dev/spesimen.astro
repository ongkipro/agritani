---
import '../styles/global.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Spesimen Desain & Token — Agritani (Dev Only)</title>
  </head>
  <body class="bg-[var(--color-canvas)] text-[var(--color-text)] p-4 sm:p-8 max-w-[72rem] mx-auto">
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-brand)] mb-2">
        Spesimen Desain & Token — Agritani
      </h1>
      <p class="text-[var(--color-text-muted)] text-base">
        Halaman pengujian token warna, tipografi, dan kontras WCAG (hanya aktif di mode dev).
      </p>
    </header>

    <!-- 1. Palet Warna -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 font-['Newsreader'] italic">1. Palet Warna & Token</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        <div class="p-4 rounded-[2px] bg-[var(--color-brand)] text-white">
          <div class="font-bold text-sm">--color-brand</div>
          <div class="text-xs opacity-90">#1A6335 (7.3:1)</div>
        </div>
        <div class="p-4 rounded-[2px] bg-[var(--color-brand-hover)] text-white">
          <div class="font-bold text-sm">--color-brand-hover</div>
          <div class="text-xs opacity-90">#14502B (9.5:1)</div>
        </div>
        <div class="p-4 rounded-[2px] bg-[var(--color-brand-strong)] text-white">
          <div class="font-bold text-sm">--color-brand-strong</div>
          <div class="text-xs opacity-90">#0F5C33</div>
        </div>
        <div class="p-4 rounded-[2px] bg-[var(--color-harvest)] text-[var(--color-text)]">
          <div class="font-bold text-sm">--color-harvest</div>
          <div class="text-xs opacity-90">#F2B632 (9.1:1)</div>
        </div>
        <div class="p-4 rounded-[2px] bg-[var(--color-soil)] text-white">
          <div class="font-bold text-sm">--color-soil</div>
          <div class="text-xs opacity-90">#5C3A1E (9.5:1)</div>
        </div>
        <div class="p-4 rounded-[2px] bg-[var(--color-surface)] border border-[var(--color-border-control)] text-[var(--color-text)]">
          <div class="font-bold text-sm">--color-surface</div>
          <div class="text-xs text-[var(--color-text-muted)]">#FFFFFF</div>
        </div>
        <div class="p-4 rounded-[2px] bg-[var(--color-tint)] border border-[var(--color-border)] text-[var(--color-text)]">
          <div class="font-bold text-sm">--color-tint</div>
          <div class="text-xs text-[var(--color-text-muted)]">#EEF3E6</div>
        </div>
        <div class="p-4 rounded-[2px] bg-[var(--color-harvest-tint)] border border-[var(--color-harvest)] text-[var(--color-text)]">
          <div class="font-bold text-sm">--color-harvest-tint</div>
          <div class="text-xs text-[var(--color-text-muted)]">#FBF3DC</div>
        </div>
        <div class="p-4 rounded-[2px] bg-[var(--color-danger)] text-white">
          <div class="font-bold text-sm">--color-danger</div>
          <div class="text-xs opacity-90">#9B1C1C (7.7:1)</div>
        </div>
      </div>
    </section>

    <!-- 2. Tipografi -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 font-['Newsreader'] italic">2. Tipografi</h2>
      
      <div class="space-y-6 bg-[var(--color-surface)] p-6 rounded-[2px] border border-[var(--color-border)]">
        <div>
          <div class="text-xs uppercase text-[var(--color-text-muted)] font-semibold mb-1">Display & H1 — Plus Jakarta Sans 800</div>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--color-brand)] leading-tight">
            Sains Pertanian Presisi untuk Kemakmuran Petani
          </h1>
        </div>

        <div>
          <div class="text-xs uppercase text-[var(--color-text-muted)] font-semibold mb-1">Editorial Heading — Newsreader 600</div>
          <h2 class="text-2xl sm:text-3xl font-semibold font-['Newsreader'] text-[var(--color-text)]">
            Pengendalian <span class="italic">Ganoderma boninense</span> pada Kelapa Sawit Berbasis Aktivator Imun
          </h2>
        </div>

        <div>
          <div class="text-xs uppercase text-[var(--color-text-muted)] font-semibold mb-1">Editorial Italic — Newsreader 600 Italic</div>
          <p class="text-xl font-['Newsreader'] italic text-[var(--color-text-muted)]">
            "Pendekatan terpadu antara sanitasi mekanis dan biostimulan imun tanaman memberikan perlindungan vaskular berkelanjutan."
          </p>
        </div>

        <div>
          <div class="text-xs uppercase text-[var(--color-text-muted)] font-semibold mb-1">Body Text — Plus Jakarta Sans 400 (68ch measure)</div>
          <p class="text-base sm:text-lg text-[var(--color-text)] max-w-[68ch] leading-relaxed">
            Penyakit busuk pangkal batang yang disebabkan oleh jamur Ganoderma boninense merupakan salah satu ancaman patologis paling destruktif pada perkebunan kelapa sawit di Indonesia. Gejala awal sering kali tidak terdeteksi pada daun pupus sebelum sebagian besar jaringan vaskular pangkal batang mengalami nekrosis ireversibel.
          </p>
        </div>

        <div>
          <div class="text-xs uppercase text-[var(--color-text-muted)] font-semibold mb-1">Technical Numbers (tabular-nums) — Plus Jakarta Sans</div>
          <div class="font-sans [font-variant-numeric:tabular-nums] text-lg space-y-1">
            <div>Dosis standar: <span class="font-semibold">2,5 ml/L</span> per tangki 16 L = <span class="font-semibold">40,0 ml</span></div>
            <div>Luas lahan uji: <span class="font-semibold">10.000 m²</span> (1,00 ha)</div>
            <div>Estimasi panen: <span class="font-semibold">12–26 Feb 2027</span> (HST 110)</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Komponen Dasar -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold mb-4 font-['Newsreader'] italic">3. Tombol & Kontrol Form</h2>
      <div class="flex flex-wrap gap-4 items-center p-6 bg-[var(--color-surface)] rounded-[2px] border border-[var(--color-border)]">
        <button class="px-5 py-2.5 min-h-[44px] bg-[var(--color-brand)] hover:bg-[var(--color-brand-hover)] text-white font-semibold rounded-[2px] transition-colors">
          Tombol Primer
        </button>
        <button class="px-5 py-2.5 min-h-[44px] bg-[var(--color-harvest)] hover:bg-[var(--color-harvest-hover)] text-[var(--color-text)] font-semibold rounded-[2px] transition-colors">
          Tombol Aksen
        </button>
        <button class="px-5 py-2.5 min-h-[44px] border border-[var(--color-brand-strong)] text-[var(--color-brand-strong)] hover:bg-[var(--color-tint)] font-semibold rounded-[2px] transition-colors">
          Tombol Sekunder
        </button>

        <label class="flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="sample" checked class="w-5 h-5 accent-[var(--color-brand)] border-[var(--color-border-control)]" />
          Pilihan Aktif
        </label>
        <label class="flex items-center gap-2 text-sm font-medium">
          <input type="radio" name="sample" class="w-5 h-5 accent-[var(--color-brand)] border-[var(--color-border-control)]" />
          Pilihan Lain
        </label>
      </div>
    </section>
  </body>
</html>
