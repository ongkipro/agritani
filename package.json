{
  "name": "agritani",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-commodities.mjs && astro build && pagefind --site dist && node scripts/check-seo.mjs && node scripts/check-csp.mjs && node scripts/check-placeholders.mjs && node scripts/check-links.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:commodities": "node scripts/check-commodities.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs && node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.143.1"
  }
}
